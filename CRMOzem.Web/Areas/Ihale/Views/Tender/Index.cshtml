@using CRMOzem.Core.Models
@model IEnumerable<Tender>
@{
    ViewData["Title"] = "İhale Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="fa-solid fa-gavel me-2"></i> İhale Listesi</h2>
    <button class="btn btn-primary shadow-sm" id="btnAddTender">
        <i class="fa fa-plus me-1"></i> Yeni İhale
    </button>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>İhale Adı</th>
                    <th>Kayıt No</th>
                    <th>Tarih</th>
                    <th>Süre</th>
                    <th>Toplam</th>
                    <th class="text-center" style="width: 210px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center p-4 text-muted">
                            <i class="fa fa-info-circle me-1"></i> Henüz ihale kaydı bulunmamaktadır.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.RegistrationNumber</td>
                            <td>@item.TenderDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@item.DurationMonths ay</td>
                            <td>@item.OverallCost.ToString("C2")</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-info me-1 btnDetails" data-id="@item.Id" title="Detay">
                                    <i class="fa fa-eye"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-warning me-1 btnEdit" data-id="@item.Id" title="Düzenle">
                                    <i class="fa fa-pen"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger btnDelete" data-id="@item.Id" title="Sil">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- GLOBAL MODAL -->
<div class="modal fade" id="globalModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content" id="modalContent"></div>
    </div>
</div>

@section Scripts {
    <script>
        // Create
        $("#btnAddTender").on("click", function () {
            $.get("/Ihale/Tender/Create", function (html) {
                $("#modalContent").html(html);
                $("#globalModal").modal("show");
            });
        });

        // Edit
        $(document).on("click", ".btnEdit", function () {
            const id = $(this).data("id");
            $.get("/Ihale/Tender/Edit/" + id, function (html) {
                $("#modalContent").html(html);
                $("#globalModal").modal("show");
            });
        });

        // Details
        $(document).on("click", ".btnDetails", function () {
            const id = $(this).data("id");
            $.get("/Ihale/Tender/Details/" + id, function (html) {
                $("#modalContent").html(html);
                $("#globalModal").modal("show");
            });
        });

        // Delete
        $(document).on("click", ".btnDelete", function () {
            if (!confirm("Bu ihaleyi silmek istediğinize emin misiniz?")) return;
            const id = $(this).data("id");
            $.post("/Ihale/Tender/Delete", { id }, function (res) {
                if (res.success) location.reload();
                else alert(res.message || "Silme sırasında hata oluştu.");
            });
        });
    </script>
}