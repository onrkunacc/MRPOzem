@using CRMOzem.Core.Models
@model IEnumerable<Tender>
@{
    ViewData["Title"] = "İhale Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var todayIso = DateTime.Now.ToString("yyyy-MM-dd");
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="fw-bold mb-0">
            <i class="fa-solid fa-gavel me-2 text-primary"></i> İhale Listesi
        </h2>
        <div class="text-muted small">İhale kayıtlarını yönetin, hesapları görüntüleyin ve rapor alın.</div>
    </div>

    <div class="d-flex gap-2">
        <div class="btn-group" role="group" aria-label="Quick filters">
            <button type="button" class="btn btn-outline-secondary btnQuickFilter" data-range="today">Bugün</button>
            <button type="button" class="btn btn-outline-secondary btnQuickFilter" data-range="week">Bu Hafta</button>
            <button type="button" class="btn btn-outline-secondary btnQuickFilter" data-range="month">Bu Ay</button>
            <button type="button" class="btn btn-outline-secondary" id="btnResetFilters">Sıfırla</button>
        </div>

        <button class="btn btn-primary shadow-sm" id="btnAddTender">
            <i class="fa fa-plus me-1"></i> Yeni İhale
        </button>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small">Toplam Kayıt</div>
                        <div class="fs-4 fw-bold" id="statCount">@Model.Count()</div>
                    </div>
                    <div class="rounded-circle p-2 bg-light">
                        <i class="fa-solid fa-list-check text-secondary"></i>
                    </div>
                </div>
                <div class="mt-3 text-muted small">
                    Liste üzerindeki filtreler uygulanınca bu değerler otomatik güncellenir.
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small">Görünen İhale Toplamı</div>
                        <div class="fs-4 fw-bold" id="statSum">0</div>
                    </div>
                    <div class="rounded-circle p-2 bg-light">
                        <i class="fa-solid fa-coins text-secondary"></i>
                    </div>
                </div>
                <div class="mt-3 text-muted small">
                    Toplam, görünür satırlardaki “Genel Toplam” alanından hesaplanır.
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small">Gün Sonu Raporları</div>
                <div class="d-flex gap-2 mt-2">
                    <a class="btn btn-outline-success w-100" href="/Ihale/Tender/ExportExcel?date=@todayIso">
                        <i class="fa-solid fa-file-excel me-1"></i> Bugün Excel
                    </a>
                    <a class="btn btn-outline-danger w-100" href="/Ihale/Tender/ExportPdf?date=@todayIso">
                        <i class="fa-solid fa-file-pdf me-1"></i> Bugün PDF
                    </a>
                </div>
                <div class="text-muted small mt-2">Tarih parametresi ile farklı gün raporu alabilirsiniz.</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="row g-2 align-items-center mb-3">
            <div class="col-lg-6">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" id="txtSearch" class="form-control" placeholder="İhale adı / kayıt no ile ara...">
                </div>
            </div>
            <div class="col-lg-6 text-lg-end">
                <span class="badge text-bg-light border" id="badgeInfo">Filtre yok</span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle" id="tenderTable">
                <thead class="table-light">
                    <tr>
                        <th>İhale Adı</th>
                        <th>Kayıt No</th>
                        <th>Tarih</th>
                        <th>Süre</th>
                        <th class="text-end">Toplam</th>
                        <th class="text-center" style="width: 210px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center p-4 text-muted">
                                <i class="fa fa-info-circle me-1"></i> Henüz ihale kaydı bulunmamaktadır.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.OrderByDescending(x => x.TenderDate))
                        {
                            <tr data-date="@item.TenderDate.ToString("yyyy-MM-dd")"
                                data-name="@item.Name"
                                data-reg="@item.RegistrationNumber"
                                data-total="@item.OverallCost">
                                <td class="fw-semibold">@item.Name</td>
                                <td><span class="badge text-bg-light border">@item.RegistrationNumber</span></td>
                                <td>@item.TenderDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@item.DurationMonths ay</td>
                                <td class="text-end fw-semibold">@item.OverallCost.ToString("C2")</td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <button class="btn btn-sm btn-outline-info btnDetails" data-id="@item.Id" title="Detay">
                                            <i class="fa fa-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-warning btnEdit" data-id="@item.Id" title="Düzenle">
                                            <i class="fa fa-pen"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger btnDelete" data-id="@item.Id" title="Sil">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- GLOBAL MODAL -->
<div class="modal fade" id="globalModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content" id="modalContent"></div>
    </div>
</div>

@section Scripts {
    <script>
        (function(){

          // ---- Helpers ----
          function parseDateIso(d){
            const parts = (d || "").split("-");
            if(parts.length !== 3) return null;
            return new Date(parseInt(parts[0]), parseInt(parts[1])-1, parseInt(parts[2]));
          }

          function startOfWeek(date){
            const d = new Date(date);
            const day = (d.getDay() + 6) % 7; // Mon=0
            d.setDate(d.getDate() - day);
            d.setHours(0,0,0,0);
            return d;
          }
          function endOfWeek(date){
            const d = startOfWeek(date);
            d.setDate(d.getDate() + 7);
            return d;
          }
          function startOfMonth(date){ return new Date(date.getFullYear(), date.getMonth(), 1); }
          function endOfMonth(date){ return new Date(date.getFullYear(), date.getMonth()+1, 1); }

          function formatCurrencyTry(val){
            try { return new Intl.NumberFormat("tr-TR", { style:"currency", currency:"TRY" }).format(val); }
            catch { return val.toFixed(2); }
          }

          function updateStats(){
            const rows = $("#tenderTable tbody tr:visible");
            $("#statCount").text(rows.length);

            let sum = 0;
            rows.each(function(){
              const t = parseFloat($(this).data("total") || "0");
              if(!isNaN(t)) sum += t;
            });
            $("#statSum").text(formatCurrencyTry(sum));
          }

          // ---- Search + Filters ----
          let activeRange = null;

          function applyFilters(){
            const q = ($("#txtSearch").val() || "").toLowerCase().trim();
            const now = new Date();
            const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());

            const fromTo = (() => {
              if(activeRange === "today") return { from: today, to: new Date(today.getTime() + 24*3600*1000) };
              if(activeRange === "week")  return { from: startOfWeek(today), to: endOfWeek(today) };
              if(activeRange === "month") return { from: startOfMonth(today), to: endOfMonth(today) };
              return null;
            })();

            $("#tenderTable tbody tr").each(function(){
              const $tr = $(this);
              const name = String($tr.data("name") || "").toLowerCase();
              const reg  = String($tr.data("reg")  || "").toLowerCase();
              const dateIso = String($tr.data("date") || "");
              const d = parseDateIso(dateIso);

              const matchesSearch = !q || name.includes(q) || reg.includes(q);
              let matchesRange = true;
              if(fromTo && d) matchesRange = (d >= fromTo.from && d < fromTo.to);

              $tr.toggle(matchesSearch && matchesRange);
            });

            const badge = $("#badgeInfo");
            const pieces = [];
            if(activeRange === "today") pieces.push("Bugün");
            if(activeRange === "week")  pieces.push("Bu Hafta");
            if(activeRange === "month") pieces.push("Bu Ay");
            if(q) pieces.push(`Arama: "${q}"`);
            badge.text(pieces.length ? pieces.join(" • ") : "Filtre yok");

            updateStats();
          }

          $("#txtSearch").on("input", applyFilters);

          $(".btnQuickFilter").on("click", function(){
            activeRange = $(this).data("range");
            $(".btnQuickFilter").removeClass("active");
            $(this).addClass("active");
            applyFilters();
          });

          $("#btnResetFilters").on("click", function(){
            activeRange = null;
            $(".btnQuickFilter").removeClass("active");
            $("#txtSearch").val("");
            applyFilters();
          });

          applyFilters();

          // ---- Critical: numeric normalize (TR virgül -> .) ----
          function normalizeNumericInputs($form) {
            $form.find("input[type='number']").each(function () {
              let v = $(this).val();
              if (v === null || v === undefined) return;
              v = v.toString().trim();
              if (!v) return;

              // boşlukları at, binlik ayraç noktalarını temizle, virgülü noktaya çevir
              v = v.replace(/\s/g, "")
                   .replace(/\.(?=\d{3}(\D|$))/g, "") // 1.234 -> 1234
                   .replace(/,/g, ".");               // 0,685 -> 0.685

              $(this).val(v);
            });
          }

          // ---- Critical: reindex collections before serialize ----
          function reindexCollection(tableSelector, prefix){
            const $rows = $(`${tableSelector} tbody tr`);
            $rows.each(function(newIndex){
              $(this).find("input,select,textarea").each(function(){
                const name = this.getAttribute("name");
                if(!name) return;

                // ör: Tender.Tests[5].Multiplier -> Tender.Tests[0].Multiplier
                const re = new RegExp("^" + prefix.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "\\[(\\d+)\\]\\.");
                if(re.test(name)){
                  this.setAttribute("name", name.replace(re, `${prefix}[${newIndex}].`));
                }
              });
            });
          }

          // ---- Modal form submit (tek yerde yönetilir) ----
          $(document).off("submit", "#tenderForm").on("submit", "#tenderForm", function(e){
              e.preventDefault();

              const $form = $(this);

              // 1) reindex (silinen satırlar sonrası binder sağlam)
              reindexCollection("#testTable", "Tender.Tests");
              reindexCollection("#extraTable", "Tender.ExtraCosts");
              reindexCollection("#personnelTable", "Tender.Personnels");

              // 2) numeric normalize (0,6 -> 0.6)
              normalizeNumericInputs($form);

              const $btn = $form.find("button[type=submit]");
              $btn.prop("disabled", true).addClass("disabled");

              $.ajax({
                url: $form.data("action"),
                type: "POST",
                data: $form.serialize(),
                success: function(res){
                  if (res?.success) location.reload();
                  else alert(res?.message || "İşlem sırasında hata oluştu.");
                },
                error: function(xhr){
                  try {
                    const res = JSON.parse(xhr.responseText);
                    if (res?.errors) {
                      const firstKey = Object.keys(res.errors)[0] || "";
                      const firstMsg = firstKey ? (res.errors[firstKey] || []).join(", ") : "";
                      alert((res.message || "Doğrulama hatası") + (firstKey ? `\n${firstKey}: ${firstMsg}` : ""));
                    } else alert(res?.message || "İşlem sırasında hata oluştu.");
                  } catch { alert("İşlem sırasında hata oluştu."); }
                },
                complete: function(){
                  $btn.prop("disabled", false).removeClass("disabled");
                }
              });
          });

          // ---- CRUD modal load ----
          $("#btnAddTender").on("click", function () {
              $.get("/Ihale/Tender/Create", function (html) {
                  $("#modalContent").html(html);
                  $("#globalModal").modal("show");
              });
          });

          $(document).on("click", ".btnEdit", function () {
              const id = $(this).data("id");
              $.get("/Ihale/Tender/Edit/" + id, function (html) {
                  $("#modalContent").html(html);
                  $("#globalModal").modal("show");
              });
          });

          $(document).on("click", ".btnDetails", function () {
              const id = $(this).data("id");
              $.get("/Ihale/Tender/Details/" + id, function (html) {
                  $("#modalContent").html(html);
                  $("#globalModal").modal("show");
              });
          });

          $(document).on("click", ".btnDelete", function () {
              if (!confirm("Bu ihaleyi silmek istediğinize emin misiniz?")) return;
              const id = $(this).data("id");
              $.post("/Ihale/Tender/Delete", { id }, function (res) {
                  if (res.success) location.reload();
                  else alert(res.message || "Silme sırasında hata oluştu.");
              });
          });

        })();
    </script>
}