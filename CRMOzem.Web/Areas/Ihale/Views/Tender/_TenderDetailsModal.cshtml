@model CRMOzem.Core.ViewModels.TenderViewModel
@{
    var dateIso = Model.Tender.TenderDate.ToString("yyyy-MM-dd");
}

<div class="modal-header">
    <div class="w-100">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
            <div>
                <h5 class="modal-title mb-0">
                    <i class="fa-solid fa-clipboard-list me-2 text-primary"></i>
                    İhale Detayı — @Model.Tender.Name
                </h5>
                <div class="text-muted small">
                    Kayıt No: <span class="fw-semibold">@Model.Tender.RegistrationNumber</span>
                    • Tarih: @Model.Tender.TenderDate.ToString("dd.MM.yyyy HH:mm")
                    • Süre: @Model.Tender.DurationMonths ay
                </div>
            </div>

            <div class="d-flex gap-2">
                <a class="btn btn-outline-success"
                   href="/Ihale/Tender/ExportExcel?date=@dateIso" target="_blank">
                    <i class="fa-solid fa-file-excel me-1"></i> Excel
                </a>
                <a class="btn btn-outline-danger"
                   href="/Ihale/Tender/ExportPdf?date=@dateIso" target="_blank">
                    <i class="fa-solid fa-file-pdf me-1"></i> PDF
                </a>
                <button type="button" class="btn btn-light border" data-bs-dismiss="modal">
                    Kapat
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal-body">

    <!-- COST SUMMARY -->
    <div class="row g-3 mb-3">
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Test Toplamı</div>
                    <div class="fs-5 fw-bold">@Model.TotalTestCost.ToString("C2")</div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Ek Gider Toplamı</div>
                    <div class="fs-5 fw-bold">@Model.TotalExtraCost.ToString("C2")</div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Personel Toplamı</div>
                    <div class="fs-5 fw-bold">@Model.TotalPersonnelCost.ToString("C2")</div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-0 border-start border-4 border-primary">
                <div class="card-body">
                    <div class="text-muted small">Genel Toplam</div>
                    <div class="fs-4 fw-bold">@Model.OverallCost.ToString("C2")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- GENERAL INFO -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-lg-4">
                    <div class="text-muted small">İhale Şekli</div>
                    <div class="fw-semibold">@Model.Tender.Type</div>
                </div>
                <div class="col-lg-4">
                    <div class="text-muted small">Kayıt No</div>
                    <div class="fw-semibold">@Model.Tender.RegistrationNumber</div>
                </div>
                <div class="col-lg-4">
                    <div class="text-muted small">Süre</div>
                    <div class="fw-semibold">@Model.Tender.DurationMonths ay</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabTests" type="button">
                Testler (@Model.Tests.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabExtras" type="button">
                Ek Giderler (@Model.ExtraCosts.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabPersonnel" type="button">
                Personel (@Model.Personnels.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <!-- TESTS -->
        <div class="tab-pane fade show active" id="tabTests">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Ad</th>
                            <th class="text-end">Puan</th>
                            <th class="text-end">Miktar</th>
                            <th class="text-end">Çarpan</th>
                            <th class="text-end">Toplam</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Tests.Any())
                        {
                            <tr><td colspan="5" class="text-muted text-center py-3">Test kaydı yok.</td></tr>
                        }
                        else
                        {
                            @foreach (var t in Model.Tests)
                            {
                                <tr>
                                    <td class="fw-semibold">@t.Name</td>
                                    <td class="text-end">@t.SutPoint</td>
                                    <td class="text-end">@t.Quantity</td>
                                    <td class="text-end">@t.Multiplier</td>
                                    <td class="text-end fw-semibold">@t.TotalSutPrice.ToString("C2")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- EXTRAS -->
        <div class="tab-pane fade" id="tabExtras">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Ad</th>
                            <th class="text-end">Adet</th>
                            <th class="text-end">Birim</th>
                            <th>Döviz</th>
                            <th class="text-end">Kur</th>
                            <th class="text-end">Toplam</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.ExtraCosts.Any())
                        {
                            <tr><td colspan="6" class="text-muted text-center py-3">Ek gider kaydı yok.</td></tr>
                        }
                        else
                        {
                            @foreach (var e in Model.ExtraCosts)
                            {
                                <tr>
                                    <td class="fw-semibold">@e.Name</td>
                                    <td class="text-end">@e.Quantity</td>
                                    <td class="text-end">@e.UnitPrice.ToString("N2")</td>
                                    <td>@e.Currency</td>
                                    <td class="text-end">@e.ExchangeRate.ToString("N4")</td>
                                    <td class="text-end fw-semibold">@e.Total.ToString("C2")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- PERSONNEL -->
        <div class="tab-pane fade" id="tabPersonnel">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Görev</th>
                            <th class="text-end">Sayı</th>
                            <th>Öğrenim</th>
                            <th>Ücret Açıklaması</th>
                            <th class="text-end">Birim Ücret</th>
                            <th class="text-end">İhale Toplam</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Personnels.Any())
                        {
                            <tr><td colspan="6" class="text-muted text-center py-3">Personel kaydı yok.</td></tr>
                        }
                        else
                        {
                            @foreach (var p in Model.Personnels)
                            {
                                <tr>
                                    <td class="fw-semibold">@p.Role</td>
                                    <td class="text-end">@p.Count</td>
                                    <td>@p.Education</td>
                                    <td>@p.FeeDescription</td>
                                    <td class="text-end">@p.UnitFee.ToString("C2")</td>
                                    <td class="text-end fw-semibold">@p.TotalForTender(Model.Tender.DurationMonths).ToString("C2")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

</div>