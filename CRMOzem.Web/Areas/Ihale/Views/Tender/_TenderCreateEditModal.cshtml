@model CRMOzem.Core.ViewModels.TenderViewModel

<div class="modal-header">
    <h5 class="modal-title">@(Model.Tender?.Id > 0 ? "İhale Düzenle" : "Yeni İhale")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<form id="tenderForm">
    <div class="modal-body">
        <ul class="nav nav-tabs mb-3" role="tablist">
            <li class="nav-item"><button type="button" class="nav-link active" data-bs-toggle="tab" data-bs-target="#generalTab">Genel Bilgiler</button></li>
            <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#testsTab">Testler</button></li>
            <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#extrasTab">Ek Giderler</button></li>
            <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#personnelTab">Personel</button></li>
        </ul>

        <div class="tab-content">
            <!-- GENEL -->
            <div class="tab-pane fade show active" id="generalTab">
                <div class="row">
                    <div class="col-md-6 mb-2">
                        <label class="form-label">İhale Adı</label>
                        <input name="Tender.Name" value="@Model.Tender?.Name" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="form-label">İhale Şekli</label>
                        <input name="Tender.Type" value="@Model.Tender?.Type" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="form-label">Kayıt No</label>
                        <input name="Tender.RegistrationNumber" value="@Model.Tender?.RegistrationNumber" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="form-label">İhale Tarihi</label>
                        @{
                            var dt = Model?.Tender?.TenderDate == default ? (DateTime?)null : Model.Tender.TenderDate;
                            var iso = dt.HasValue ? dt.Value.ToString("yyyy-MM-ddTHH:mm") : "";
                        }
                        <input name="Tender.TenderDate" type="datetime-local" class="form-control" step="60" value="@iso" />
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="form-label">Süre (Ay)</label>
                        <input name="Tender.DurationMonths" value="@Model.Tender?.DurationMonths" class="form-control" />
                    </div>
                </div>
            </div>

            <!-- TESTLER -->
            <div class="tab-pane fade" id="testsTab">
                <div class="d-flex justify-content-between mb-2">
                    <h6>Test Listesi</h6>
                    <button type="button" class="btn btn-success btn-sm" id="addTestRow">+ Ekle</button>
                </div>
                <table class="table table-bordered" id="testTable">
                    <thead>
                        <tr>
                            <th>S.NO</th>
                            <th>SUT KODU</th>
                            <th>Tetkik Adı</th>
                            <th>SUT Puanı</th>
                            <th>Miktar</th>
                            <th>Çarpan</th>
                            <th>Sil</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Tests.Count; i++)
                        {
                            <tr>
                                <td><input name="Tender.Tests[@i].OrderNo" class="form-control" value="@Model.Tests[i].OrderNo" /></td>
                                <td><input name="Tender.Tests[@i].SutCode" class="form-control" value="@Model.Tests[i].SutCode" /></td>
                                <td><input name="Tender.Tests[@i].Name" class="form-control" value="@Model.Tests[i].Name" /></td>
                                <td><input name="Tender.Tests[@i].SutPoint" class="form-control" value="@Model.Tests[i].SutPoint" /></td>
                                <td><input name="Tender.Tests[@i].Quantity" class="form-control" value="@Model.Tests[i].Quantity" /></td>
                                <td><input name="Tender.Tests[@i].Multiplier" class="form-control" value="@Model.Tests[i].Multiplier" /></td>
                                <td><button type="button" class="btn btn-danger btn-sm remove-row">X</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- EK GİDERLER -->
            <div class="tab-pane fade" id="extrasTab">
                <div class="d-flex justify-content-between mb-2">
                    <h6>Ek Giderler</h6>
                    <button type="button" class="btn btn-success btn-sm" id="addExtraRow">+ Ekle</button>
                </div>
                <table class="table table-bordered" id="extraTable">
                    <thead>
                        <tr>
                            <th>Ad</th>
                            <th>Adet</th>
                            <th>Birim Fiyat</th>
                            <th>Döviz</th>
                            <th>Kur</th>
                            <th>Sil</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.ExtraCosts.Count; i++)
                        {
                            <tr>
                                <td><input name="Tender.ExtraCosts[@i].Name" class="form-control" value="@Model.ExtraCosts[i].Name" /></td>
                                <td><input name="Tender.ExtraCosts[@i].Quantity" class="form-control" value="@Model.ExtraCosts[i].Quantity" /></td>
                                <td><input name="Tender.ExtraCosts[@i].UnitPrice" class="form-control" value="@Model.ExtraCosts[i].UnitPrice" /></td>
                                <td><input name="Tender.ExtraCosts[@i].Currency" class="form-control" value="@Model.ExtraCosts[i].Currency" /></td>
                                <td><input name="Tender.ExtraCosts[@i].ExchangeRate" class="form-control" value="@Model.ExtraCosts[i].ExchangeRate" /></td>
                                <td><button type="button" class="btn btn-danger btn-sm remove-row">X</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- PERSONEL -->
            <div class="tab-pane fade" id="personnelTab">
                <div class="d-flex justify-content-between mb-2">
                    <h6>Personel Giderleri</h6>
                    <button type="button" class="btn btn-success btn-sm" id="addPersonnelRow">+ Ekle</button>
                </div>
                <table class="table table-bordered" id="personnelTable">
                    <thead>
                        <tr>
                            <th>Görev</th>
                            <th>Sayısı</th>
                            <th>Öğrenim</th>
                            <th>Ücret Açıklaması</th>
                            <th>Birim Ücret</th>
                            <th>Sil</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Personnels.Count; i++)
                        {
                            <tr>
                                <td><input name="Tender.Personnels[@i].Role" class="form-control" value="@Model.Personnels[i].Role" /></td>
                                <td><input name="Tender.Personnels[@i].Count" class="form-control" value="@Model.Personnels[i].Count" /></td>
                                <td><input name="Tender.Personnels[@i].Education" class="form-control" value="@Model.Personnels[i].Education" /></td>
                                <td><input name="Tender.Personnels[@i].FeeDescription" class="form-control" value="@Model.Personnels[i].FeeDescription" /></td>
                                <td><input name="Tender.Personnels[@i].UnitFee" class="form-control" value="@Model.Personnels[i].UnitFee" /></td>
                                <td><button type="button" class="btn btn-danger btn-sm remove-row">X</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
    </div>
</form>

<script>
    (function(){
      $(document).on("click", ".remove-row", function(){ $(this).closest("tr").remove(); });

      function nextIndex(tableSelector, inputPrefix){
        const rows = document.querySelectorAll(`${tableSelector} tbody tr`);
        if (rows.length === 0) return 0;
        let max = -1;
        rows.forEach(r => {
          const any = r.querySelector(`input[name^='${inputPrefix}']`);
          if(!any) return;
          const m = any.name.match(/\[(\d+)\]/);
          if(m) max = Math.max(max, parseInt(m[1],10));
        });
        return max + 1;
      }

      $("#addTestRow").on("click", function(){
        const i = nextIndex("#testTable","Tender.Tests[");
        $("#testTable tbody").append(`
          <tr>
            <td><input name="Tender.Tests[${i}].OrderNo"    class="form-control" value="${i+1}" /></td>
            <td><input name="Tender.Tests[${i}].SutCode"    class="form-control" /></td>
            <td><input name="Tender.Tests[${i}].Name"       class="form-control" /></td>
            <td><input name="Tender.Tests[${i}].SutPoint"   class="form-control" value="0" /></td>
            <td><input name="Tender.Tests[${i}].Quantity"   class="form-control" value="1" /></td>
            <td><input name="Tender.Tests[${i}].Multiplier" class="form-control" value="1" /></td>
            <td><button type="button" class="btn btn-danger btn-sm remove-row">X</button></td>
          </tr>`);
      });

      $("#addExtraRow").on("click", function(){
        const i = nextIndex("#extraTable","Tender.ExtraCosts[");
        $("#extraTable tbody").append(`
          <tr>
            <td><input name="Tender.ExtraCosts[${i}].Name"         class="form-control" /></td>
            <td><input name="Tender.ExtraCosts[${i}].Quantity"     class="form-control" value="1" /></td>
            <td><input name="Tender.ExtraCosts[${i}].UnitPrice"    class="form-control" value="0" /></td>
            <td><input name="Tender.ExtraCosts[${i}].Currency"     class="form-control" value="TRY" /></td>
            <td><input name="Tender.ExtraCosts[${i}].ExchangeRate" class="form-control" value="1" /></td>
            <td><button type="button" class="btn btn-danger btn-sm remove-row">X</button></td>
          </tr>`);
      });

      $("#addPersonnelRow").on("click", function(){
        const i = nextIndex("#personnelTable","Tender.Personnels[");
        $("#personnelTable tbody").append(`
          <tr>
            <td><input name="Tender.Personnels[${i}].Role"           class="form-control" /></td>
            <td><input name="Tender.Personnels[${i}].Count"          class="form-control" value="1" /></td>
            <td><input name="Tender.Personnels[${i}].Education"      class="form-control" /></td>
            <td><input name="Tender.Personnels[${i}].FeeDescription" class="form-control" /></td>
            <td><input name="Tender.Personnels[${i}].UnitFee"        class="form-control" value="0" /></td>
            <td><button type="button" class="btn btn-danger btn-sm remove-row">X</button></td>
          </tr>`);
      });

      $("#tenderForm").on("submit", function(e){
        e.preventDefault();
        $.ajax({
          url: "@Url.Action(Model.Tender?.Id > 0 ? "Edit" : "Create")",
          type: "POST",
          data: $(this).serialize(),
          success: function(res){
            if (res?.success) location.reload();
            else alert(res?.message || "İşlem sırasında hata oluştu.");
          },
          error: function(xhr){
            try {
              const res = JSON.parse(xhr.responseText);
              if (res?.errors) {
                const firstKey = Object.keys(res.errors)[0] || "";
                const firstMsg = firstKey ? res.errors[firstKey].join(", ") : "";
                alert((res.message || "Doğrulama hatası") + (firstKey ? `\n${firstKey}: ${firstMsg}` : ""));
              } else {
                alert(res?.message || "İşlem sırasında hata oluştu.");
              }
            } catch { alert("İşlem sırasında hata oluştu."); }
          }
        });
      });
    })();
</script>