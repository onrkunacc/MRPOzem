@{
    ViewData["Title"] = "İhale Dosyaları Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var folderName = ViewBag.FolderName as string ?? "Ana Klasör";
    var folders = ViewBag.Folders as List<string> ?? new List<string>();
    var currentFolder = ViewBag.CurrentFolder as string ?? "";
    var breadcrumbs = (ViewBag.Breadcrumbs as List<string>) ?? new List<string>();
}

<h2 class="text-dark fw-bold mt-3">İhale Dosyaları Yönetim</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<!-- Breadcrumb (Klasör Yolu) -->
<nav aria-label="breadcrumb">
    <ol class="breadcrumb bg-light p-3 rounded">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", new { folderName = "" })">Ana Klasör</a></li>
        @{
            var fullPath = "";
            foreach (var part in breadcrumbs)
            {
                fullPath = string.IsNullOrEmpty(fullPath) ? part : $"{fullPath}/{part}";
                <li class="breadcrumb-item"><a href="@Url.Action("Index", new { folderName = fullPath })">@part</a></li>
            }
        }
    </ol>
</nav>

<!-- Klasör ve Dosya Yönetim Alanı -->
<div class="card shadow-sm mb-4">
    <div class="card-body">

        <!-- Klasör Oluşturma -->
        <div class="input-group mb-3">
            <input type="text" id="newFolderName" class="form-control rounded-start" placeholder="Yeni Klasör Adı">
            &nbsp;&nbsp;
            <button class="btn btn-primary btn-group-sm" onclick="createFolder()">📁 Klasör Oluştur</button>
        </div>

        <!-- Dosya Yükleme -->
        <div class="input-group">
            <input type="file" id="fileInput" class="form-control rounded-start">
            &nbsp;&nbsp;
            <button class="btn btn-success btn-group-sm" onclick="uploadFile()">📂 Dosya Yükle</button>
        </div>

    </div>
</div>

<!-- Alt Klasörler -->
<h5 class="mt-4 text-dark fw-bold"><i class="fas fa-folder-open me-2"></i> Alt Klasörler</h5>
<div class="row">
    @foreach (var folder in folders)
    {
        <div class="col-md-3 mb-3">
            <div class="card text-center shadow-sm folder-card" onclick="navigateFolder('@folder')" style="cursor:pointer;">
                <div class="card-body py-4">
                    <i class="fas fa-folder fa-3x text-warning"></i>
                    <p class="mt-2 mb-0 fw-bold">@folder</p>
                </div>
            </div>
        </div>
    }
</div>

<!-- Dosya Listesi -->
<h5 class="mt-4 text-dark fw-bold"><i class="fas fa-file-alt me-2"></i> Dosyalar</h5>
<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Dosya Adı</th>
            <th style="width: 100px;">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var fileUrl in Model as List<string>)
        {
            var fileName = System.IO.Path.GetFileName(new Uri(fileUrl).AbsolutePath);
            <tr>
                <td><a href="@fileUrl" target="_blank" class="text-decoration-none">@fileName</a></td>
                <td>
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" name="fileName" value="@fileName" />
                        <input type="hidden" name="folderName" value="@ViewBag.CurrentFolder" />
                        <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Klasör ve Dosya Yönetim Scriptleri -->
<script>
    function normalizeFolderName(name) {
        return name
            .replace(/ı/g, "i")
            .replace(/İ/g, "I")
            .replace(/ç/g, "c")
            .replace(/Ç/g, "C")
            .replace(/ğ/g, "g")
            .replace(/Ğ/g, "G")
            .replace(/ş/g, "s")
            .replace(/Ş/g, "S")
            .replace(/ö/g, "o")
            .replace(/Ö/g, "O")
            .replace(/ü/g, "u")
            .replace(/Ü/g, "U");
    }

    function createFolder() {
        let folderName = document.getElementById('newFolderName').value;
        folderName = normalizeFolderName(folderName);

        if (!folderName) {
            alert('Lütfen klasör adını girin');
            return;
        }

        const currentFolder = '@currentFolder';
        window.location.href = '@Url.Action("CreateFolder", "BidDocument")'
            + `?parentFolder=${encodeURIComponent(currentFolder)}&folderName=${encodeURIComponent(folderName)}`;
    }

    function uploadFile() {
        const fileInput = document.getElementById('fileInput');
        if (fileInput.files.length === 0) {
            alert('Lütfen bir dosya seçin');
            return;
        }

        const currentFolder = '@ViewBag.CurrentFolder';

        const formData = new FormData();
        formData.append("file", fileInput.files[0]);
        formData.append("folderName", currentFolder);

        fetch('@Url.Action("Upload", "BidDocument")', {
            method: 'POST',
            body: formData
        }).then(() => window.location.reload());
    }

    function navigateFolder(folder) {
        const currentFolder = '@currentFolder';
        const targetFolder = currentFolder ? `${currentFolder}/${folder}` : folder;

        window.location.href = '@Url.Action("Index", "BidDocument")' + '?folderName=' + encodeURIComponent(targetFolder);
    }
</script>

<style>
    .folder-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .folder-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.15);
    }
    .breadcrumb {
        background-color: #f8f9fa;
        border-radius: 5px;
    }
</style>
