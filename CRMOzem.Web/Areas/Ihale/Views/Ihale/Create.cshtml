@model Ihale
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "İhaleyi Düzenle" : "Yeni İhale";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/tendercss.css" />

<div class="page-header">
    <div>
        <h1 class="page-title">@ViewData["Title"]</h1>
        <p class="page-sub">@(isEdit ? Model.IhaleAdi : "Yeni ihale maliyet hesabı başlatın")</p>
    </div>
    <a asp-area="Ihale" asp-controller="Ihale" asp-action="Index" class="btn btn-outline">← Geri</a>
</div>

<div class="form-card">
    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
        @Html.AntiForgeryToken()

        @if (isEdit)
        {
            <input type="hidden" asp-for="Id" />
        }

        <div class="form-section">
            <h3 class="section-title">🏷 İhale Bilgileri</h3>
            <div class="form-grid-2">
                <div class="form-group">
                    <label asp-for="IhaleAdi">İhale Adı *</label>
                    <input asp-for="IhaleAdi" class="form-control" placeholder="İhale adını girin" required />
                    <span asp-validation-for="IhaleAdi" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="IhaleKayitNo">İhale Kayıt No</label>
                    <input asp-for="IhaleKayitNo" class="form-control" placeholder="2026/149644" />
                </div>
                <div class="form-group">
                    <label asp-for="IhaleTarihi">İhale Tarihi</label>
                    <input asp-for="IhaleTarihi" type="date" class="form-control"
                           value="@Model.IhaleTarihi?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="form-group">
                    <label asp-for="IhaleSaati">İhale Saati</label>
                    <input asp-for="IhaleSaati" type="time" class="form-control"
                           value="@Model.IhaleSaati?.ToString(@"hh\:mm")" />
                </div>
                <div class="form-group">
                    <label asp-for="IhaleSekli">İhale Şekli</label>
                    <select asp-for="IhaleSekli" class="form-control">
                        <option value="HİZMET">HİZMET</option>
                        <option value="MAL ALIMI">MAL ALIMI</option>
                        <option value="YAPIM">YAPIM</option>
                        <option value="DANIŞMANLIK">DANIŞMANLIK</option>
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="IhaleSuresiGun">İhale Süresi (Gün)</label>
                    <input asp-for="IhaleSuresiGun" type="number" class="form-control" min="1" />
                </div>
            </div>
        </div>

        <div class="form-section">
            <h3 class="section-title">📑 Şartname Yapısı</h3>
            <div class="form-grid-2">
                <div class="form-group">
                    <label asp-for="KisimSayisi">Şartname Kısım Sayısı *</label>
                    <input asp-for="KisimSayisi" type="number" class="form-control"
                           min="1" max="99" required />
                    <span asp-validation-for="KisimSayisi" class="field-error"></span>
                    <small class="form-hint">
                        Şartname kaç kısımdan oluşuyorsa o sayıyı girin. Kalem ve gider girişlerinde
                        her satırı bir kısma atayabilecek, özet ile Excel/PDF çıktılarında kısım
                        kısım maliyet görebileceksiniz. Tek kısımlı ihalelerde <strong>1</strong> bırakın.
                    </small>
                </div>
                <div class="form-group">
                    <div class="kisim-bilgi-kutu">
                        <strong>Kısma atanmayan satırlar ne olur?</strong>
                        <p>
                            Birden fazla kısma ortak hizmet eden personel ya da gider için kısım
                            seçmeyin. Bu satırlar kısımlara dağıtılmaz; özet ve çıktılarda ayrı bir
                            <em>Ortak Giderler</em> bloğunda toplanır.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-section">
            <h3 class="section-title">📊 Finansal Parametreler</h3>
            <div class="form-grid-3">
                <div class="form-group">
                    <label asp-for="GenelGiderOran">Genel Gider Oranı</label>
                    <div class="input-group">
                        <input asp-for="GenelGiderOran" type="number" class="form-control"
                               step="0.01" min="0" max="1" placeholder="0.10" />
                        <span class="input-addon">%</span>
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="KarOran">Kar Oranı</label>
                    <div class="input-group">
                        <input asp-for="KarOran" type="number" class="form-control"
                               step="0.01" min="0" max="1" placeholder="0.15" />
                        <span class="input-addon">%</span>
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="KDVOran">KDV Oranı</label>
                    <div class="input-group">
                        <input asp-for="KDVOran" type="number" class="form-control"
                               step="0.01" min="0" max="1" placeholder="0.20" />
                        <span class="input-addon">%</span>
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="KurUSD">USD Kuru (₺)</label>
                    <input asp-for="KurUSD" type="number" class="form-control"
                           step="0.01" min="0" placeholder="50.00" />
                </div>
                <div class="form-group">
                    <label asp-for="KurEUR">EUR Kuru (₺)</label>
                    <input asp-for="KurEUR" type="number" class="form-control"
                           step="0.01" min="0" placeholder="60.00" />
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a asp-area="Ihale" asp-controller="Ihale" asp-action="Index" class="btn btn-outline">İptal</a>
            <button type="submit" class="btn btn-primary">
                @(isEdit ? "💾 Kaydet" : "İhale Oluştur")
            </button>
        </div>
    </form>
</div>

<style>
    .form-hint {
        display: block;
        margin-top: 6px;
        font-size: 12px;
        line-height: 1.5;
        color: #718096;
    }

    .kisim-bilgi-kutu {
        background: #f8f9fc;
        border: 1px solid #e3e8f0;
        border-left: 3px solid #0ea5e9;
        border-radius: 8px;
        padding: 12px 14px;
        height: 100%;
    }

    .kisim-bilgi-kutu strong {
        display: block;
        font-size: 12.5px;
        color: #1a202c;
        margin-bottom: 5px;
    }

    .kisim-bilgi-kutu p {
        margin: 0;
        font-size: 12px;
        line-height: 1.55;
        color: #4a5568;
    }
</style>
