        if (!gorevUnvan)                          { showFeedback('personelFeedback','Görev / Unvan zorunludur.','error'); return; }
        if (isNaN(birimFiyat) || birimFiyat <= 0) { showFeedback('personelFeedback','Aylık Brüt Ücret geçerli giriniz.','error'); return; }
        const data = {
            ihaleId: IHALE_ID, birimId: parseInt(document.getElementById('p_birimId').value) || null,
            gorevUnvan, sayi: parseInt(document.getElementById('p_sayi').value) || 1,
            egitimDurumu: document.getElementById('p_egitim').value.trim(),
            ucretTipi:    document.getElementById('p_ucretTipi').value,
            birimFiyatAylik: birimFiyat,
            aciklama:     document.getElementById('p_aciklama').value.trim()
        };
        try {
            const res = await fetch(`${BASE}/PersonelEkle`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(data) });
            if (!res.ok) throw new Error();
            const r = await res.json();
            if (r.success) {
                if (devamEt) { showFeedback('personelFeedback',`"${gorevUnvan}" kaydedildi.`,'success'); personelFormSifirla(); }
