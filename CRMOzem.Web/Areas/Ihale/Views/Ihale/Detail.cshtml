    function klIptal(id) {
        const vr = document.querySelector(`.kl-row-view[data-id="${id}"]`);
        const er = document.querySelector(`.kl-row-edit[data-id="${id}"]`);
        if (!vr || !er) return;
        er.style.display = 'none'; vr.style.display = '';
    }
    function klCanlıHesapla(er) {
        const miktar  = parseFloat(er.querySelector('.kl-edit-testMiktari-raw')?.value) || 0;
        const fiyat   = parseFloat(er.querySelector('.kl-edit-sutFiyat-raw')?.value)    || 0;
        const carpan  = parseFloat(er.querySelector('.kl-edit-sutCarpan-raw')?.value)   || 0;
        const topSut  = miktar * fiyat;
        const topFiyat = topSut * carpan;
        const p1 = er.querySelector('.kl-edit-toplamSut-preview');
        const p2 = er.querySelector('.kl-edit-preview');
        if (p1) p1.textContent = formatTR(topSut, 2);
        if (p2) p2.textContent = formatTR(topFiyat, 2) + ' ₺';
    }
    async function klKaydet(id, btn) {
        const er = document.querySelector(`.kl-row-edit[data-id="${id}"]`);
        if (!er) return;
        const tetkikAdi   = er.querySelector('.kl-edit-tetkikAdi')?.value.trim();
        const testMiktari = parseFloat(er.querySelector('.kl-edit-testMiktari-raw')?.value);
        const sutFiyat    = parseFloat(er.querySelector('.kl-edit-sutFiyat-raw')?.value);
        const sutCarpan   = parseFloat(er.querySelector('.kl-edit-sutCarpan-raw')?.value);
        if (!tetkikAdi) { alert('Tetkik Adı zorunludur.'); return; }
        const data = {
            id, ihaleId: IHALE_ID,
            birimId:  parseInt(er.querySelector('.kl-edit-birimId')?.value) || null,
            siraNo:   parseInt(er.querySelector('.kl-edit-siraNo')?.value)  || 1,
            sutKodu:  er.querySelector('.kl-edit-sutKodu')?.value.trim()    || '',
            tetkikAdi, testMiktari: isNaN(testMiktari) ? 0 : testMiktari,
            sutFiyat:  isNaN(sutFiyat)  ? 0 : sutFiyat,
            sutCarpan: isNaN(sutCarpan) ? 0 : sutCarpan,
        };
        const orig = btn.textContent; btn.disabled = true; btn.textContent = '⏳';
        try {
            const res = await fetch(`${BASE}/KalemGuncelle`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(data) });
            if (!res.ok) throw new Error();
            const r = await res.json();
            if (r.success) {
                const vr = document.querySelector(`.kl-row-view[data-id="${id}"]`);
                const topSut   = data.testMiktari * data.sutFiyat;
                const topFiyat = topSut * data.sutCarpan;
                vr.querySelector('.kl-sutkodu').textContent      = data.sutKodu || '-';
                vr.querySelector('.kl-tetkik').textContent       = tetkikAdi;
                vr.querySelector('.kl-miktar').textContent       = formatTR(data.testMiktari, 0);
                vr.querySelector('.kl-sutfiyat').textContent     = formatTR(data.sutFiyat, 4);
                vr.querySelector('.kl-carpan').textContent       = formatTR(data.sutCarpan, 3);
                vr.querySelector('.kl-toplamSut').textContent    = formatTR(topSut, 2);
                vr.querySelector('.kl-toplamSutFiyat').textContent = formatTR(topFiyat, 2);
                klIptal(id);
            } else { alert('Güncelleme başarısız.'); }
        } catch { alert('Güncelleme sırasında hata oluştu.'); }
        finally { btn.disabled = false; btn.textContent = orig; }
    }

