@using System.Globalization
@using System.Text.Json
@model Ihale

@{
    ViewData["Title"] = "İhale Detayı";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var birimler = ViewBag.Birimler as List<Birim> ?? new();

    var pageData = new
    {
        ihaleId = Model.Id,
        kurUSD = Model.KurUSD,
        kurEUR = Model.KurEUR
    };

    var birimlerJsonStr = JsonSerializer.Serialize(
        birimler.Select(b => new { id = b.Id, kod = b.BirimKodu, ad = b.BirimAdi }).ToList()
    );
}

<link rel="stylesheet" href="~/css/tendercss.css" />

<div class="page-header">
    <div>
        <h1 class="page-title">@Model.IhaleAdi</h1>
        <p class="page-sub">
            @if (!string.IsNullOrEmpty(Model.IhaleKayitNo))
            {
                <span>🔖 @Model.IhaleKayitNo &nbsp;</span>
            }
            @if (Model.IhaleTarihi.HasValue)
            {
                <span>📅 @Model.IhaleTarihi.Value.ToString("dd.MM.yyyy") &nbsp;</span>
            }
            <span>⏱ @Model.IhaleSuresiGun gün</span>
        </p>
    </div>
    <div class="header-actions">
        <a asp-area="Ihale" asp-controller="Ihale" asp-action="Ozet" asp-route-id="@Model.Id" class="btn btn-primary">📊 Özet Görüntüle</a>
        <a asp-area="Ihale" asp-controller="Ihale" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline">Düzenle</a>
        <a asp-area="Ihale" asp-controller="Ihale" asp-action="Index" class="btn btn-ghost">← Geri</a>
    </div>
</div>

<div class="params-bar">
    <div class="pbar-item"><span>Genel Gider</span><strong>%@((Model.GenelGiderOran * 100).ToString("0"))</strong></div>
    <div class="pbar-item"><span>Kar</span><strong>%@((Model.KarOran * 100).ToString("0"))</strong></div>
    <div class="pbar-item"><span>KDV</span><strong>%@((Model.KDVOran * 100).ToString("0"))</strong></div>
    <div class="pbar-item"><span>USD</span><strong>@Model.KurUSD.ToString("N4") ₺</strong></div>
    <div class="pbar-item"><span>EUR</span><strong>@Model.KurEUR.ToString("N4") ₺</strong></div>
    <div class="pbar-item"><span>Süre</span><strong>@Model.IhaleSuresiGun gün</strong></div>
</div>

<div class="tab-wrapper">
    <nav class="tab-nav">
        <button type="button" class="tab-btn active" data-tab="personel">👤 Personel Giderleri</button>
        <button type="button" class="tab-btn" data-tab="ekgider">💼 Ek Giderler</button>
        <button type="button" class="tab-btn" data-tab="kalemler">🔬 İhale Kalemleri</button>
    </nav>

    <!-- ── PERSONEL ───────────────────────────────────────────────── -->
    <div class="tab-panel active" id="tab-personel">
        <div class="panel-toolbar">
            <span class="panel-count">@Model.PersonelGiderler.Count kayıt</span>
            <button type="button" class="btn btn-sm btn-primary" onclick="showModal('personelModal')">+ Personel Ekle</button>
        </div>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Birim</th>
                        <th>Görev/Unvan</th>
                        <th>Sayı</th>
                        <th>Ücret Tipi</th>
                        <th>Aylık Brüt (₺)</th>
                        <th>Süre (gün)</th>
                        <th class="text-right">Toplam (₺)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="personelTableBody">
                    @foreach (var p in Model.PersonelGiderler)
                    {
                        <tr data-id="@p.Id">
                            <td><span class="badge-birim">@(p.Birim?.BirimKodu ?? "-")</span></td>
                            <td>@p.GorevUnvan</td>
                            <td>@p.Sayi</td>
                            <td><span class="tag">@p.UcretTipi</span></td>
                            <td>@p.BirimFiyatAylik.ToString("N2")</td>
                            <td>@Model.IhaleSuresiGun</td>
                            <td class="text-right font-mono">@p.ToplamTRY.ToString("N2")</td>
                            <td><button type="button" class="btn btn-danger btn-xs" onclick="personelSil(@p.Id, this)">✕</button></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="6"><strong>TOPLAM</strong></td>
                        <td class="text-right font-mono"><strong>@Model.PersonelGiderler.Sum(p => p.ToplamTRY).ToString("N2") ₺</strong></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- ── EK GİDER ──────────────────────────────────────────────── -->
    <div class="tab-panel" id="tab-ekgider">
        <div class="panel-toolbar">
            <span class="panel-count">@Model.EkGiderler.Count kayıt</span>
            <button type="button" class="btn btn-sm btn-primary" onclick="showModal('ekGiderModal')">+ Gider Ekle</button>
        </div>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Birim</th>
                        <th>Gider Adı</th>
                        <th>Kategori</th>
                        <th>Miktar</th>
                        <th>Birim Fiyat</th>
                        <th>Para Birimi</th>
                        <th>Kur</th>
                        <th class="text-right">Tutar (₺)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="ekGiderTableBody">
                    @foreach (var e in Model.EkGiderler)
                    {
                        <tr data-id="@e.Id">
                            <td><span class="badge-birim">@(e.Birim?.BirimKodu ?? "-")</span></td>
                            <td>@e.GiderAdi</td>
                            <td>@e.Kategori</td>
                            <td>@e.Miktar</td>
                            <td>@e.BirimFiyat.ToString("N4")</td>
                            <td><span class="tag">@e.ParaBirimi</span></td>
                            <td>@e.Kur.ToString("N4")</td>
                            <td class="text-right font-mono">@e.TutarTRY.ToString("N2")</td>
                            <td><button type="button" class="btn btn-danger btn-xs" onclick="ekGiderSil(@e.Id, this)">✕</button></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="7"><strong>TOPLAM</strong></td>
                        <td class="text-right font-mono"><strong>@Model.EkGiderler.Sum(e => e.TutarTRY).ToString("N2") ₺</strong></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- ── KALEMLER ───────────────────────────────────────────────── -->
    <div class="tab-panel" id="tab-kalemler">
        <div class="panel-toolbar">
            <span class="panel-count">@Model.IhaleKalemler.Count kalem</span>
            <button type="button" class="btn btn-sm btn-primary" onclick="showModal('kalemTopluModal')">+ Kalem Ekle</button>
        </div>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Birim</th>
                        <th>SUT Kodu</th>
                        <th>Tetkik Adı</th>
                        <th>Test Miktarı</th>
                        <th>SUT Fiyat</th>
                        <th>SUT Çarpan</th>
                        <th class="text-right">Toplam SUT</th>
                        <th class="text-right">Toplam SUT Fiyat</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in Model.IhaleKalemler.OrderBy(x => x.SiraNo))
                    {
                        <tr data-id="@k.Id">
                            <td>@k.SiraNo</td>
                            <td><span class="badge-birim">@(k.Birim?.BirimKodu ?? "-")</span></td>
                            <td>@k.SutKodu</td>
                            <td>@k.TetkikAdi</td>
                            <td>@k.TestMiktari.ToString("N0")</td>
                            <td>@k.SutFiyat.ToString("N4")</td>
                            <td>@k.SutCarpan.ToString("N3")</td>
                            <td class="text-right font-mono">@k.ToplamSUT.ToString("N2")</td>
                            <td class="text-right font-mono">@k.ToplamSutFiyat.ToString("N2")</td>
                            <td><button type="button" class="btn btn-danger btn-xs" onclick="kalemSil(@k.Id, this)">✕</button></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="7"><strong>TOPLAM</strong></td>
                        <td class="text-right font-mono"><strong>@Model.IhaleKalemler.Sum(k => k.ToplamSUT).ToString("N2")</strong></td>
                        <td class="text-right font-mono"><strong>@Model.IhaleKalemler.Sum(k => k.ToplamSutFiyat).ToString("N2") ₺</strong></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════
     MODAL: Personel
════════════════════════════════════════════════════════════════════ -->
<div class="th-modal-overlay" id="personelModal" aria-hidden="true">
    <div class="th-modal" role="dialog" aria-modal="true">
        <div class="th-modal-header">
            <h3>Personel Gideri Ekle</h3>
            <button type="button" onclick="closeModal('personelModal')" class="th-modal-close">✕</button>
        </div>
        <div class="th-modal-body">
            <!-- Bildirim alanı -->
            <div id="personelFeedback" class="modal-feedback" style="display:none;"></div>
            <div class="form-grid-2">
                <div class="form-group">
                    <label>Birim</label>
                    <select id="p_birimId" class="form-control">
                        <option value="">-- Seçin --</option>
                        @foreach (var b in birimler)
                        {
                            <option value="@b.Id">@b.BirimKodu – @b.BirimAdi</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Görev / Unvan *</label>
                    <input id="p_gorevUnvan" class="form-control" placeholder="Personel, Teknik Personel..." />
                </div>
                <div class="form-group">
                    <label>Sayı</label>
                    <input id="p_sayi" type="number" class="form-control" value="1" min="1" />
                </div>
                <div class="form-group">
                    <label>Eğitim Durumu</label>
                    <input id="p_egitim" class="form-control" placeholder="Lisans, Önlisans..." />
                </div>
                <div class="form-group">
                    <label>Ücret Tipi</label>
                    <select id="p_ucretTipi" class="form-control">
                        <option>Brut (Aylik)</option>
                        <option>Net (Aylik)</option>
                        <option>Günlük</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Aylık Brüt Ücret (₺) *</label>
                    <input id="p_birimFiyat" class="form-control numeric-input" placeholder="0,00" autocomplete="off" />
                    <input type="hidden" id="p_birimFiyat_raw" />
                </div>
                <div class="form-group" style="grid-column:span 2">
                    <label>Açıklama</label>
                    <input id="p_aciklama" class="form-control" />
                </div>
            </div>
        </div>
        <div class="th-modal-footer">
            <button type="button" onclick="closeModal('personelModal')" class="btn btn-outline">Kapat</button>
            <button type="button" onclick="personelEkle(true)" class="btn btn-ghost">Kaydet ve Devam Et</button>
            <button type="button" onclick="personelEkle(false)" class="btn btn-primary">Kaydet ve Kapat</button>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════
     MODAL: Ek Gider
════════════════════════════════════════════════════════════════════ -->
<div class="th-modal-overlay" id="ekGiderModal" aria-hidden="true">
    <div class="th-modal" role="dialog" aria-modal="true">
        <div class="th-modal-header">
            <h3>Ek Gider Ekle</h3>
            <button type="button" onclick="closeModal('ekGiderModal')" class="th-modal-close">✕</button>
        </div>
        <div class="th-modal-body">
            <!-- Bildirim alanı -->
            <div id="ekGiderFeedback" class="modal-feedback" style="display:none;"></div>
            <div class="form-grid-2">
                <div class="form-group">
                    <label>Birim</label>
                    <select id="e_birimId" class="form-control">
                        <option value="">-- Seçin --</option>
                        @foreach (var b in birimler)
                        {
                            <option value="@b.Id">@b.BirimKodu – @b.BirimAdi</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Gider Adı *</label>
                    <input id="e_giderAdi" class="form-control" placeholder="Reaktif, Kit, Cihaz..." />
                </div>
                <div class="form-group">
                    <label>Kategori</label>
                    <input id="e_kategori" class="form-control" placeholder="Sarf, Ekipman, Kira..." />
                </div>
                <div class="form-group">
                    <label>Miktar</label>
                    <input id="e_miktar" class="form-control numeric-input" placeholder="0,0000" autocomplete="off" />
                    <input type="hidden" id="e_miktar_raw" />
                </div>
                <div class="form-group">
                    <label>Birim Fiyat *</label>
                    <input id="e_birimFiyat" class="form-control numeric-input" placeholder="0,0000" autocomplete="off" />
                    <input type="hidden" id="e_birimFiyat_raw" />
                </div>
                <div class="form-group">
                    <label>Para Birimi</label>
                    <select id="e_paraBirimi" class="form-control" onchange="kurGuncelle(this)">
                        <option value="TRY">TRY</option>
                        <option value="USD">USD</option>
                        <option value="EUR">EUR</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Kur</label>
                    <input id="e_kur" class="form-control numeric-input" placeholder="1,00" autocomplete="off" />
                    <input type="hidden" id="e_kur_raw" />
                </div>
                <div class="form-group" style="grid-column:span 2">
                    <label>Açıklama</label>
                    <input id="e_aciklama" class="form-control" />
                </div>
            </div>
        </div>
        <div class="th-modal-footer">
            <button type="button" onclick="closeModal('ekGiderModal')" class="btn btn-outline">Kapat</button>
            <button type="button" onclick="ekGiderEkle(true)" class="btn btn-ghost">Kaydet ve Devam Et</button>
            <button type="button" onclick="ekGiderEkle(false)" class="btn btn-primary">Kaydet ve Kapat</button>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════
     MODAL: Toplu Kalem Girişi (3-in-1)
════════════════════════════════════════════════════════════════════ -->
<div class="th-modal-overlay" id="kalemTopluModal" aria-hidden="true">
    <div class="th-modal th-modal--wide" role="dialog" aria-modal="true">
        <div class="th-modal-header">
            <h3>İhale Kalemleri Ekle</h3>
            <button type="button" onclick="closeModal('kalemTopluModal')" class="th-modal-close">✕</button>
        </div>

        <div class="th-modal-body" style="padding:0;">

            <div class="ktab-nav">
                <button type="button" class="ktab-btn active" data-ktab="inline">📝 Satır Satır</button>
                <button type="button" class="ktab-btn" data-ktab="paste">📋 Yapıştır</button>
                <button type="button" class="ktab-btn" data-ktab="import">📂 Excel / CSV</button>
            </div>

            <!-- ── SEKME 1: Inline ──────────────────────────────── -->
            <div class="ktab-panel active" id="ktab-inline">
                <div style="padding:14px 20px 8px;">
                    <p class="ktab-hint">Satırları doldurun. <kbd>Enter</kbd> ile yeni satır ekleyin.</p>
                </div>
                <div style="overflow-x:auto;">
                    <table class="kinline-table">
                        <thead>
                            <tr>
                                <th style="width:36px">#</th>
                                <th style="width:80px">Birim</th>
                                <th style="width:90px">SUT Kodu</th>
                                <th>Tetkik Adı *</th>
                                <th style="width:100px">Miktar</th>
                                <th style="width:100px">SUT Fiyat</th>
                                <th style="width:90px">SUT Çarpan</th>
                                <th style="width:30px"></th>
                            </tr>
                        </thead>
                        <tbody id="inlineBody"></tbody>
                    </table>
                </div>
                <div style="padding:8px 20px 14px;">
                    <button type="button" class="btn btn-ghost btn-sm" onclick="inlineSatirEkle()">+ Satır Ekle</button>
                </div>
            </div>

            <!-- ── SEKME 2: Yapıştır ────────────────────────────── -->
            <div class="ktab-panel" id="ktab-paste">
                <div style="padding:14px 20px 10px;">
                    <p class="ktab-hint">
                        Excel'den satırları kopyalayıp aşağıya yapıştırın.<br>
                        <strong>Sütun sırası:</strong> SıraNo · SUT Kodu · Tetkik Adı · Test Miktarı · SUT Fiyat · SUT Çarpan
                    </p>
                    <textarea id="pasteArea" class="form-control"
                              style="height:180px;font-family:monospace;font-size:13px;resize:vertical;"
                              placeholder="Excel'den kopyalayıp buraya yapıştırın (Ctrl+V)..."></textarea>
                    <button type="button" class="btn btn-outline btn-sm" style="margin-top:10px;" onclick="parsePaste()">Önizle →</button>
                </div>
                <div id="pastePreview" style="display:none;overflow-x:auto;padding:0 20px 14px;">
                    <p class="ktab-hint" id="pastePreviewInfo"></p>
                    <table class="kinline-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th style="width:90px">Birim</th>
                                <th>SUT Kodu</th>
                                <th>Tetkik Adı</th>
                                <th>Miktar</th>
                                <th>SUT Fiyat</th>
                                <th>Çarpan</th>
                            </tr>
                        </thead>
                        <tbody id="pastePreviewBody"></tbody>
                    </table>
                </div>
            </div>

            <!-- ── SEKME 3: Excel/CSV ───────────────────────────── -->
            <div class="ktab-panel" id="ktab-import">
                <div style="padding:14px 20px 10px;">
                    <p class="ktab-hint">
                        <strong>Desteklenen format:</strong> .xlsx veya .csv<br>
                        <strong>Sütun sırası:</strong> SıraNo · SUT Kodu · Tetkik Adı · Test Miktarı · SUT Fiyat · SUT Çarpan<br>
                        İlk satır başlık ise otomatik atlanır.
                    </p>
                    <div class="import-drop-zone" id="dropZone" onclick="document.getElementById('fileInput').click()">
                        <span style="font-size:2rem;">📂</span>
                        <span>Dosyayı buraya sürükleyin veya tıklayın</span>
                        <span style="font-size:12px;color:#a0aec0;">.xlsx veya .csv</span>
                    </div>
                    <input type="file" id="fileInput" accept=".csv,.xlsx" style="display:none" onchange="handleFile(this)">
                </div>
                <div id="importPreview" style="display:none;overflow-x:auto;padding:0 20px 14px;">
                    <p class="ktab-hint" id="importPreviewInfo"></p>
                    <table class="kinline-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th style="width:90px">Birim</th>
                                <th>SUT Kodu</th>
                                <th>Tetkik Adı</th>
                                <th>Miktar</th>
                                <th>SUT Fiyat</th>
                                <th>Çarpan</th>
                            </tr>
                        </thead>
                        <tbody id="importPreviewBody"></tbody>
                    </table>
                </div>
            </div>

        </div>

        <div class="th-modal-footer" style="justify-content:space-between;align-items:center;">
            <span id="kalemSaveInfo" style="font-size:13px;color:#4a5568;"></span>
            <div style="display:flex;gap:8px;">
                <button type="button" onclick="closeModal('kalemTopluModal')" class="btn btn-outline">İptal</button>
                <button type="button" onclick="kalemTopluKaydet()" class="btn btn-primary" id="btnKalemKaydet">💾 Tümünü Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════
     STİLLER
════════════════════════════════════════════════════════════════════ -->
<style>
    .th-modal--wide {
        max-width: 980px;
    }

    /* Bildirim alanı */
    .modal-feedback {
        padding: 10px 14px;
        border-radius: 8px;
        margin-bottom: 14px;
        font-size: 13px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .modal-feedback.success {
            background: #d1fae5;
            border: 1px solid #6ee7b7;
            color: #065f46;
        }

        .modal-feedback.error {
            background: #fee2e2;
            border: 1px solid #fca5a5;
            color: #991b1b;
        }

    /* Sayısal input gösterimi */
    .numeric-display {
        text-align: right;
        font-family: 'Courier New', monospace;
        letter-spacing: -.01em;
    }

    .ktab-nav {
        display: flex;
        border-bottom: 1px solid #e3e8f0;
        background: #f8f9fc;
        padding: 0 20px;
        gap: 4px;
    }

    .ktab-btn {
        padding: 10px 18px;
        background: transparent;
        border: none;
        border-bottom: 2px solid transparent;
        color: #4a5568;
        cursor: pointer;
        font-size: 13.5px;
        font-weight: 500;
        transition: all .15s;
    }

        .ktab-btn:hover {
            color: #1a202c;
        }

        .ktab-btn.active {
            color: #3b82f6;
            border-bottom-color: #3b82f6;
        }

    .ktab-panel {
        display: none;
    }

        .ktab-panel.active {
            display: block;
        }

    .ktab-hint {
        font-size: 13px;
        color: #4a5568;
        margin: 0 0 10px;
        line-height: 1.6;
    }

        .ktab-hint strong {
            color: #1a202c;
        }

    kbd {
        background: #eef2f7;
        border: 1px solid #d0d7e3;
        border-radius: 4px;
        padding: 1px 6px;
        font-size: 12px;
        font-family: monospace;
    }

    .kinline-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .kinline-table th {
            background: #f8f9fc;
            padding: 7px 8px;
            text-align: left;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: #a0aec0;
            border-bottom: 2px solid #e3e8f0;
            white-space: nowrap;
        }

        .kinline-table td {
            padding: 3px 4px;
            border-bottom: 1px solid #f0f4f8;
            vertical-align: middle;
        }

        .kinline-table tbody tr:hover td {
            background: #f8faff;
        }

    .kcell {
        width: 100%;
        border: 1px solid transparent;
        border-radius: 6px;
        padding: 6px 8px;
        font-size: 13px;
        background: transparent;
        outline: none;
        color: #1a202c;
        transition: border-color .15s, background .15s;
    }

        .kcell:focus {
            border-color: #3b82f6;
            background: #fff;
            box-shadow: 0 0 0 2px rgba(59,130,246,.12);
        }

    .kcell-select {
        width: 100%;
        border: 1px solid transparent;
        border-radius: 6px;
        padding: 5px 4px;
        font-size: 12px;
        background: transparent;
        outline: none;
        color: #1a202c;
    }

        .kcell-select:focus {
            border-color: #3b82f6;
            background: #fff;
        }

    .krow-del {
        background: transparent;
        border: none;
        color: #a0aec0;
        cursor: pointer;
        padding: 4px;
        border-radius: 4px;
        font-size: 14px;
        line-height: 1;
    }

        .krow-del:hover {
            background: #fee2e2;
            color: #ef4444;
        }

    .import-drop-zone {
        border: 2px dashed #d0d7e3;
        border-radius: 12px;
        padding: 36px 20px;
        text-align: center;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        color: #4a5568;
        font-size: 14px;
        transition: border-color .2s, background .2s;
    }

        .import-drop-zone:hover,
        .import-drop-zone.drag-over {
            border-color: #3b82f6;
            background: #eff6ff;
            color: #2563eb;
        }

    .krow-error td {
        background: #fff5f5 !important;
    }
</style>

<!-- ═══════════════════════════════════════════════════════════════════
     SCRIPT
════════════════════════════════════════════════════════════════════ -->
<script>
    const pageData = @Html.Raw(JsonSerializer.Serialize(pageData));
    const IHALE_ID = pageData.ihaleId;
    const BASE     = '/Ihale/Ihale';
    const BIRIMLER = @Html.Raw(birimlerJsonStr);

    // ══════════════════════════════════════════════════════════════════════
    // SAYISAL FORMAT YARDIMCILARI
    // ══════════════════════════════════════════════════════════════════════

    // Ham sayıyı al (hidden field veya parse)
    function getRaw(hiddenId) {
        const val = document.getElementById(hiddenId)?.value;
        return val ? parseFloat(val) : 0;
    }

    // Türkçe formatla göster: 1.234.567,89
    function formatTR(val, decimals = 2) {
        if (isNaN(val) || val === null || val === '') return '';
        return Number(val).toLocaleString('tr-TR', {
            minimumFractionDigits: decimals,
            maximumFractionDigits: decimals
        });
    }

    // Türkçe string'den ham sayıya çevir: "1.234,56" → 1234.56
    function parseTR(str) {
        if (!str) return NaN;
        // Noktaları kaldır (binlik), virgülü noktaya çevir (ondalık)
        const cleaned = str.replace(/\./g, '').replace(',', '.');
        return parseFloat(cleaned);
    }

    // Numeric input başlat
    function initNumericInput(inputId, hiddenId, decimals = 2) {
        const input = document.getElementById(inputId);
        if (!input) return;

        input.classList.add('numeric-display');

        input.addEventListener('focus', function () {
            // Odaklanınca raw değeri göster (düzenleme için)
            const raw = getRaw(hiddenId);
            if (!isNaN(raw) && raw !== 0) {
                this.value = String(raw).replace('.', ',');
            } else {
                this.value = '';
            }
            this.select();
        });

        input.addEventListener('blur', function () {
            const raw = parseTR(this.value);
            if (!isNaN(raw)) {
                document.getElementById(hiddenId).value = raw;
                this.value = formatTR(raw, decimals);
            } else {
                document.getElementById(hiddenId).value = '';
                this.value = '';
            }
        });

        input.addEventListener('keydown', function (e) {
            // Sadece rakam, virgül, nokta, backspace, delete, tab, ok tuşlarına izin ver
            const allowed = ['Backspace', 'Delete', 'Tab', 'ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Enter', 'Home', 'End'];
            if (allowed.includes(e.key)) return;
            if (e.key === ',' || e.key === '.') return;
            if (e.ctrlKey || e.metaKey) return; // Ctrl+C, Ctrl+V vb.
            if (!/^\d$/.test(e.key)) e.preventDefault();
        });
    }

    // ── Ana tab sistemi ──────────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', function () {
        // Numeric input'ları başlat
        initNumericInput('p_birimFiyat', 'p_birimFiyat_raw', 2);
        initNumericInput('e_miktar',     'e_miktar_raw',     4);
        initNumericInput('e_birimFiyat', 'e_birimFiyat_raw', 4);
        initNumericInput('e_kur',        'e_kur_raw',        4);

        // Varsayılan değerler
        document.getElementById('e_miktar_raw').value     = '1';
        document.getElementById('e_miktar').value         = formatTR(1, 4);
        document.getElementById('e_kur_raw').value        = '1';
        document.getElementById('e_kur').value            = formatTR(1, 4);

        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
                btn.classList.add('active');
                document.getElementById('tab-' + btn.dataset.tab)?.classList.add('active');
            });
        });

        document.querySelectorAll('.th-modal-overlay').forEach(overlay => {
            overlay.addEventListener('click', e => { if (e.target === overlay) closeModal(overlay.id); });
        });

        document.addEventListener('keydown', e => {
            if (e.key === 'Escape')
                document.querySelectorAll('.th-modal-overlay.open').forEach(o => closeModal(o.id));
        });

        const dz = document.getElementById('dropZone');
        if (dz) {
            dz.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('drag-over'); });
            dz.addEventListener('dragleave', () => dz.classList.remove('drag-over'));
            dz.addEventListener('drop', e => {
                e.preventDefault();
                dz.classList.remove('drag-over');
                if (e.dataTransfer.files[0]) processFile(e.dataTransfer.files[0]);
            });
        }
    });

    // ── Ktab sekme sistemi ───────────────────────────────────────────────
    document.querySelectorAll('.ktab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.ktab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.ktab-panel').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById('ktab-' + btn.dataset.ktab)?.classList.add('active');
        });
    });

    // ── Modal aç/kapat ───────────────────────────────────────────────────
    window.showModal = function (id) {
        const el = document.getElementById(id);
        if (!el) return;
        el.classList.add('open');
        el.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        if (id === 'kalemTopluModal') kalemModalAc();
    };

    window.closeModal = function (id) {
        const el = document.getElementById(id);
        if (!el) return;
        el.classList.remove('open');
        el.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
    };

    // Modal açılınca feedback gizle
    function hideFeedback(feedbackId) {
        const fb = document.getElementById(feedbackId);
        if (fb) { fb.style.display = 'none'; fb.className = 'modal-feedback'; fb.innerHTML = ''; }
    }

    function showFeedback(feedbackId, message, type = 'success') {
        const fb = document.getElementById(feedbackId);
        if (!fb) return;
        fb.className = `modal-feedback ${type}`;
        fb.innerHTML = (type === 'success' ? '✓ ' : '✕ ') + message;
        fb.style.display = 'flex';
        if (type === 'success') {
            setTimeout(() => { fb.style.display = 'none'; }, 3000);
        }
    }

    function kalemModalAc() {
        document.querySelectorAll('.ktab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.ktab-panel').forEach(p => p.classList.remove('active'));
        document.querySelector('.ktab-btn[data-ktab="inline"]').classList.add('active');
        document.getElementById('ktab-inline').classList.add('active');
        inlineReset();
        pasteReset();
        importReset();
        document.getElementById('kalemSaveInfo').innerHTML = '';
        const btn = document.getElementById('btnKalemKaydet');
        btn.disabled = false;
        btn.textContent = '💾 Tümünü Kaydet';
    }

    // ── Personel formu sıfırla ───────────────────────────────────────────
    function personelFormSifirla() {
        document.getElementById('p_birimId').value    = '';
        document.getElementById('p_gorevUnvan').value = '';
        document.getElementById('p_sayi').value       = '1';
        document.getElementById('p_egitim').value     = '';
        document.getElementById('p_ucretTipi').value  = 'Brut (Aylik)';
        document.getElementById('p_birimFiyat').value = '';
        document.getElementById('p_birimFiyat_raw').value = '';
        document.getElementById('p_aciklama').value   = '';
        document.getElementById('p_gorevUnvan').focus();
    }

    // ── Ek gider formu sıfırla ───────────────────────────────────────────
    function ekGiderFormSifirla() {
        document.getElementById('e_birimId').value      = '';
        document.getElementById('e_giderAdi').value     = '';
        document.getElementById('e_kategori').value     = '';
        document.getElementById('e_miktar').value       = formatTR(1, 4);
        document.getElementById('e_miktar_raw').value   = '1';
        document.getElementById('e_birimFiyat').value   = '';
        document.getElementById('e_birimFiyat_raw').value = '';
        document.getElementById('e_paraBirimi').value   = 'TRY';
        document.getElementById('e_kur').value          = formatTR(1, 4);
        document.getElementById('e_kur_raw').value      = '1';
        document.getElementById('e_aciklama').value     = '';
        document.getElementById('e_giderAdi').focus();
    }

    // ── Yardımcı ─────────────────────────────────────────────────────────
    function birimSelectHTML(inputId, currentVal) {
        const opts = BIRIMLER.map(b =>
            `<option value="${b.id}" ${currentVal == b.id ? 'selected' : ''}>${b.kod} – ${b.ad}</option>`
        ).join('');
        return `<select class="kcell-select" id="${inputId}"><option value="">-</option>${opts}</select>`;
    }

    // ══════════════════════════════════════════════════════════════════════
    // SEKME 1: Inline
    // ══════════════════════════════════════════════════════════════════════
    let inlineRowCount = 0;

    function inlineReset() {
        inlineRowCount = 0;
        document.getElementById('inlineBody').innerHTML = '';
        for (let i = 0; i < 5; i++) inlineSatirEkle();
    }

    function inlineSatirEkle() {
        inlineRowCount++;
        const n = inlineRowCount;
        const tbody = document.getElementById('inlineBody');
        const tr = document.createElement('tr');
        tr.id = `irow_${n}`;
        tr.innerHTML = `
            <td style="text-align:center;color:#a0aec0;font-size:12px;padding:4px 6px;">${n}</td>
            <td>${birimSelectHTML(`kb_${n}`, '')}</td>
            <td><input class="kcell" id="ks_${n}" placeholder="P1234" /></td>
            <td><input class="kcell" id="kt_${n}" placeholder="Tetkik adı..." /></td>
            <td><input class="kcell" id="km_${n}" type="number" value="0" min="0" style="text-align:right;" /></td>
            <td><input class="kcell" id="kf_${n}" type="number" value="0" step="0.0001" style="text-align:right;" /></td>
            <td><input class="kcell" id="kc_${n}" type="number" value="0.593" step="0.001" style="text-align:right;" /></td>
            <td><button type="button" class="krow-del" onclick="document.getElementById('irow_${n}').remove()">✕</button></td>
        `;
        tbody.appendChild(tr);

        tr.querySelector(`#kt_${n}`).addEventListener('keydown', e => {
            if (e.key === 'Enter') {
                inlineSatirEkle();
                setTimeout(() => document.getElementById(`kt_${inlineRowCount}`)?.focus(), 50);
            }
        });
    }

    function inlineVeriTopla() {
        const rows = [];
        let sira = 1;
        document.querySelectorAll('#inlineBody tr').forEach(tr => {
            const n = tr.id.replace('irow_', '');
            const tetkik = document.getElementById(`kt_${n}`)?.value.trim();
            if (!tetkik) return;
            rows.push({
                siraNo:      sira++,
                birimId:     parseInt(document.getElementById(`kb_${n}`)?.value) || null,
                sutKodu:     document.getElementById(`ks_${n}`)?.value.trim() || '',
                tetkikAdi:   tetkik,
                testMiktari: parseFloat(document.getElementById(`km_${n}`)?.value) || 0,
                sutFiyat:    parseFloat(document.getElementById(`kf_${n}`)?.value) || 0,
                sutCarpan:   parseFloat(document.getElementById(`kc_${n}`)?.value) || 0.593,
            });
        });
        return rows;
    }

    // ══════════════════════════════════════════════════════════════════════
    // SEKME 2: Yapıştır
    // ══════════════════════════════════════════════════════════════════════
    let pasteRows = [];

    function pasteReset() {
        document.getElementById('pasteArea').value = '';
        document.getElementById('pastePreview').style.display = 'none';
        pasteRows = [];
    }

    function parsePaste() {
        const raw = document.getElementById('pasteArea').value.trim();
        if (!raw) { alert('Önce yapıştırma alanına veri girin.'); return; }
        pasteRows = parseTabular(raw);
        renderPreview('pastePreviewBody', 'pastePreviewInfo', pasteRows);
        document.getElementById('pastePreview').style.display = 'block';
    }

    // ══════════════════════════════════════════════════════════════════════
    // SEKME 3: Excel/CSV
    // ══════════════════════════════════════════════════════════════════════
    let importRows = [];

    function importReset() {
        document.getElementById('importPreview').style.display = 'none';
        document.getElementById('fileInput').value = '';
        importRows = [];
    }

    function handleFile(input) {
        if (input.files.length) processFile(input.files[0]);
    }

    async function processFile(file) {
        const name = file.name.toLowerCase();
        if (name.endsWith('.csv')) {
            const text  = await file.text();
            const sep   = text.indexOf('\t') > -1 ? '\t' : ',';
            const lines = text.split('\n').filter(l => l.trim());
            const raw   = lines.map(l => l.split(sep).join('\t')).join('\n');
            importRows  = parseTabular(raw);
        } else if (name.endsWith('.xlsx')) {
            if (typeof XLSX === 'undefined') {
                alert('Excel okuma için sayfada SheetJS kütüphanesi gerekli.\nLütfen dosyayı CSV olarak kaydedin.');
                return;
            }
            const buf = await file.arrayBuffer();
            const wb  = XLSX.read(buf);
            const ws  = wb.Sheets[wb.SheetNames[0]];
            const arr = XLSX.utils.sheet_to_json(ws, { header: 1 });
            const raw = arr.map(r => r.join('\t')).join('\n');
            importRows = parseTabular(raw);
        } else {
            alert('Sadece .xlsx veya .csv dosyası yükleyebilirsiniz.');
            return;
        }
        renderPreview('importPreviewBody', 'importPreviewInfo', importRows);
        document.getElementById('importPreview').style.display = 'block';
    }

    // ── Ortak: parse + önizleme ──────────────────────────────────────────
    function parseTabular(raw) {
        const lines = raw.split('\n').filter(l => l.trim());
        const rows  = [];
        lines.forEach((line, idx) => {
            const cols = line.split('\t');
            if (idx === 0 && isNaN(parseFloat(cols[0]))) return;
            if (cols.length < 3) return;
            rows.push({
                siraNo:      parseInt(cols[0]) || (rows.length + 1),
                sutKodu:     (cols[1] || '').trim(),
                tetkikAdi:   (cols[2] || '').trim(),
                testMiktari: parseFloat((cols[3] || '0').replace(',', '.')) || 0,
                sutFiyat:    parseFloat((cols[4] || '0').replace(',', '.')) || 0,
                sutCarpan:   parseFloat((cols[5] || '0.593').replace(',', '.')) || 0.593,
                birimId:     null,
            });
        });
        return rows;
    }

    function renderPreview(tbodyId, infoId, rows) {
        const tbody = document.getElementById(tbodyId);
        tbody.innerHTML = '';

        rows.forEach((r, idx) => {
            const tr = document.createElement('tr');
            if (!r.tetkikAdi) tr.classList.add('krow-error');
            const selId = `prev_birim_${tbodyId}_${idx}`;
            tr.innerHTML = `
                <td>${r.siraNo}</td>
                <td>${birimSelectHTML(selId, r.birimId)}</td>
                <td>${r.sutKodu || '-'}</td>
                <td>${r.tetkikAdi || '<span style="color:#ef4444">Boş!</span>'}</td>
                <td style="text-align:right">${formatTR(r.testMiktari, 0)}</td>
                <td style="text-align:right">${formatTR(r.sutFiyat, 4)}</td>
                <td style="text-align:right">${r.sutCarpan}</td>
            `;
            tbody.appendChild(tr);

            setTimeout(() => {
                const sel = document.getElementById(selId);
                if (sel) sel.addEventListener('change', () => {
                    rows[idx].birimId = parseInt(sel.value) || null;
                });
            }, 0);
        });

        const valid   = rows.filter(r => r.tetkikAdi).length;
        const invalid = rows.length - valid;
        document.getElementById(infoId).innerHTML =
            `<strong>${rows.length}</strong> satır · ` +
            `<strong style="color:#10b981">${valid}</strong> geçerli` +
            (invalid > 0 ? ` · <strong style="color:#ef4444">${invalid}</strong> atlanacak` : '');
    }

    // ══════════════════════════════════════════════════════════════════════
    // TOPLU KAYDET
    // ══════════════════════════════════════════════════════════════════════
    async function kalemTopluKaydet() {
        const activeTab = document.querySelector('.ktab-btn.active').dataset.ktab;
        let rows = [];

        if      (activeTab === 'inline') rows = inlineVeriTopla();
        else if (activeTab === 'paste')  rows = pasteRows.filter(r => r.tetkikAdi);
        else if (activeTab === 'import') rows = importRows.filter(r => r.tetkikAdi);

        if (rows.length === 0) { alert('Kaydedilecek geçerli satır bulunamadı.'); return; }

        const btn  = document.getElementById('btnKalemKaydet');
        const info = document.getElementById('kalemSaveInfo');
        btn.disabled    = true;
        btn.textContent = `⏳ Kaydediliyor... (0/${rows.length})`;

        let ok = 0, err = 0;
        for (const row of rows) {
            try {
                const res = await fetch(`${BASE}/KalemEkle`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ihaleId: IHALE_ID, ...row })
                });
                if (!res.ok) throw new Error();
                const result = await res.json();
                result.success ? ok++ : err++;
            } catch { err++; }
            btn.textContent = `⏳ Kaydediliyor... (${ok + err}/${rows.length})`;
        }

        btn.disabled    = false;
        btn.textContent = '💾 Tümünü Kaydet';

        if (err === 0) {
            info.innerHTML = `<span style="color:#10b981">✓ ${ok} kalem kaydedildi</span>`;
            setTimeout(() => { closeModal('kalemTopluModal'); location.reload(); }, 700);
        } else {
            info.innerHTML = `<span style="color:#10b981">${ok} başarılı</span> · <span style="color:#ef4444">${err} hatalı</span>`;
        }
    }

    // ══════════════════════════════════════════════════════════════════════
    // TEKLİ İŞLEMLER
    // ══════════════════════════════════════════════════════════════════════
    function kurGuncelle(sel) {
        const kurMap = { TRY: 1, USD: Number(pageData.kurUSD), EUR: Number(pageData.kurEUR) };
        const val = kurMap[sel.value] ?? 1;
        document.getElementById('e_kur_raw').value = val;
        document.getElementById('e_kur').value     = formatTR(val, 4);
    }

    // ── Personel Ekle ─────────────────────────────────────────────────────
    async function personelEkle(devamEt = false) {
        const gorevUnvan = document.getElementById('p_gorevUnvan').value.trim();
        const birimFiyat = getRaw('p_birimFiyat_raw');

        if (!gorevUnvan)                          { showFeedback('personelFeedback', 'Görev / Unvan zorunludur.', 'error'); return; }
        if (isNaN(birimFiyat) || birimFiyat <= 0) { showFeedback('personelFeedback', 'Aylık Brüt Ücret geçerli giriniz.', 'error'); return; }

        const data = {
            ihaleId:         IHALE_ID,
            birimId:         parseInt(document.getElementById('p_birimId').value) || null,
            gorevUnvan,
            sayi:            parseInt(document.getElementById('p_sayi').value) || 1,
            egitimDurumu:    document.getElementById('p_egitim').value.trim(),
            ucretTipi:       document.getElementById('p_ucretTipi').value,
            birimFiyatAylik: birimFiyat,
            aciklama:        document.getElementById('p_aciklama').value.trim()
        };

        try {
            const res = await fetch(`${BASE}/PersonelEkle`, {
                method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(data)
            });
            if (!res.ok) throw new Error();
            const r = await res.json();
            if (r.success) {
                if (devamEt) {
                    showFeedback('personelFeedback', `"${gorevUnvan}" kaydedildi.`, 'success');
                    personelFormSifirla();
                } else {
                    closeModal('personelModal');
                    location.reload();
                }
            } else {
                showFeedback('personelFeedback', 'Kayıt başarısız.', 'error');
            }
        } catch {
            showFeedback('personelFeedback', 'Personel kaydı sırasında hata oluştu.', 'error');
        }
    }

    async function personelSil(id, btn) {
        if (!confirm('Silmek istiyor musunuz?')) return;
        try {
            const res = await fetch(`${BASE}/PersonelSil?id=${id}`, { method:'POST' });
            if (!res.ok) throw new Error();
            const r = await res.json();
            if (r.success) btn.closest('tr')?.remove();
        } catch { alert('Silme işlemi sırasında hata oluştu.'); }
    }

    // ── Ek Gider Ekle ────────────────────────────────────────────────────
    async function ekGiderEkle(devamEt = false) {
        const giderAdi   = document.getElementById('e_giderAdi').value.trim();
        const miktar     = getRaw('e_miktar_raw');
        const birimFiyat = getRaw('e_birimFiyat_raw');
        const kur        = getRaw('e_kur_raw');

        if (!giderAdi)                            { showFeedback('ekGiderFeedback', 'Gider Adı zorunludur.', 'error'); return; }
        if (isNaN(birimFiyat) || birimFiyat <= 0) { showFeedback('ekGiderFeedback', 'Birim Fiyat geçerli giriniz.', 'error'); return; }
        if (isNaN(miktar)     || miktar <= 0)     { showFeedback('ekGiderFeedback', 'Miktar geçerli giriniz.', 'error'); return; }
        if (isNaN(kur)        || kur <= 0)        { showFeedback('ekGiderFeedback', 'Kur geçerli giriniz.', 'error'); return; }

        const data = {
            ihaleId:    IHALE_ID,
            birimId:    parseInt(document.getElementById('e_birimId').value) || null,
            giderAdi,
            kategori:   document.getElementById('e_kategori').value.trim(),
            miktar,
            birimFiyat,
            paraBirimi: document.getElementById('e_paraBirimi').value,
            kur,
            aciklama:   document.getElementById('e_aciklama').value.trim()
        };

        try {
            const res = await fetch(`${BASE}/EkGiderEkle`, {
                method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(data)
            });
            if (!res.ok) throw new Error();
            const r = await res.json();
            if (r.success) {
                if (devamEt) {
                    showFeedback('ekGiderFeedback', `"${giderAdi}" kaydedildi.`, 'success');
                    ekGiderFormSifirla();
                } else {
                    closeModal('ekGiderModal');
                    location.reload();
                }
            } else {
                showFeedback('ekGiderFeedback', 'Kayıt başarısız.', 'error');
            }
        } catch {
            showFeedback('ekGiderFeedback', 'Ek gider kaydı sırasında hata oluştu.', 'error');
        }
    }

    async function ekGiderSil(id, btn) {
        if (!confirm('Silmek istiyor musunuz?')) return;
        try {
            const res = await fetch(`${BASE}/EkGiderSil?id=${id}`, { method:'POST' });
            if (!res.ok) throw new Error();
            const r = await res.json();
            if (r.success) btn.closest('tr')?.remove();
        } catch { alert('Silme işlemi sırasında hata oluştu.'); }
    }

    async function kalemSil(id, btn) {
        if (!confirm('Silmek istiyor musunuz?')) return;
        try {
            const res = await fetch(`${BASE}/KalemSil?id=${id}`, { method:'POST' });
            if (!res.ok) throw new Error();
            const r = await res.json();
            if (r.success) btn.closest('tr')?.remove();
        } catch { alert('Silme işlemi sırasında hata oluştu.'); }
    }
</script>
