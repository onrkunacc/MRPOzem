<!-- ═══════════════════════════════════════════════════════════════════
     SCRIPT
════════════════════════════════════════════════════════════════════ -->
<script>
    const pageData = @Html.Raw(JsonSerializer.Serialize(pageData));
    const IHALE_ID = pageData.ihaleId;
    const BASE     = '/Ihale/Ihale';
    const BIRIMLER = @Html.Raw(birimlerJsonStr);
    const SURE_GUN = @Model.IhaleSuresiGun;

    // ── Format yardımcıları ──────────────────────────────────────────────
    function getRaw(hiddenId) {
        const v = document.getElementById(hiddenId)?.value;
        return v ? parseFloat(v) : 0;
    }
    function formatTR(val, dec = 2) {
        if (isNaN(val) || val === null) return '';
        return Number(val).toLocaleString('tr-TR', { minimumFractionDigits: dec, maximumFractionDigits: dec });
    }
    function parseTR(str) {
        if (!str) return NaN;
        return parseFloat(str.replace(/\./g, '').replace(',', '.'));
    }
    function numericKeydown(e) {
        const ok = ['Backspace','Delete','Tab','ArrowLeft','ArrowRight','ArrowUp','ArrowDown','Enter','Home','End'];
        if (ok.includes(e.key) || e.ctrlKey || e.metaKey || e.key === ',' || e.key === '.') return;
        if (!/^\d$/.test(e.key)) e.preventDefault();
    }

    // Modal id-bazlı numeric input başlat
    function initNumericInput(inputId, hiddenId, dec = 2) {
        const inp = document.getElementById(inputId);
        if (!inp) return;
        inp.classList.add('numeric-display');
        inp.addEventListener('focus', function () {
            const r = getRaw(hiddenId);
            this.value = (!isNaN(r) && r !== 0) ? String(r).replace('.', ',') : '';
            this.select();
        });
        inp.addEventListener('blur', function () {
            const r = parseTR(this.value);
            if (!isNaN(r)) { document.getElementById(hiddenId).value = r; this.value = formatTR(r, dec); }
            else { document.getElementById(hiddenId).value = ''; this.value = ''; }
        });
        inp.addEventListener('keydown', numericKeydown);
    }

    // Satır-içi numeric input başlat (class ile)
    function initRowNumeric(inp, hid, dec = 4, onChangeFn) {
        if (!inp || inp._numericInited) return;
        inp._numericInited = true;
        inp.classList.add('numeric-display');
        inp.addEventListener('focus', function () {
            const r = parseFloat(hid.value);
            this.value = (!isNaN(r) && r !== 0) ? String(r).replace('.', ',') : '';
            this.select();
        });
        inp.addEventListener('blur', function () {
            const r = parseTR(this.value);
            if (!isNaN(r)) { hid.value = r; this.value = formatTR(r, dec); }
            else { hid.value = ''; this.value = ''; }
            if (onChangeFn) onChangeFn();
        });
        inp.addEventListener('input', () => { if (onChangeFn) onChangeFn(); });
        inp.addEventListener('keydown', numericKeydown);
    }

    // ── DOMContentLoaded ─────────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', function () {
        initNumericInput('p_birimFiyat', 'p_birimFiyat_raw', 2);
        initNumericInput('e_miktar',     'e_miktar_raw',     0);
        initNumericInput('e_birimFiyat', 'e_birimFiyat_raw', 2);
        initNumericInput('e_kur',        'e_kur_raw',        2);

        document.getElementById('e_miktar_raw').value = '1';
        document.getElementById('e_miktar').value     = formatTR(1, 0);
        document.getElementById('e_kur_raw').value    = '1';
        document.getElementById('e_kur').value        = formatTR(1, 2);

        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
                btn.classList.add('active');
                document.getElementById('tab-' + btn.dataset.tab)?.classList.add('active');
            });
        });
        document.querySelectorAll('.ktab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.ktab-btn').forEach(b => b.classList.remove('active'));
                document.querySelectorAll('.ktab-panel').forEach(p => p.classList.remove('active'));
                btn.classList.add('active');
                document.getElementById('ktab-' + btn.dataset.ktab)?.classList.add('active');
            });
        });
        document.querySelectorAll('.th-modal-overlay').forEach(o => {
            o.addEventListener('click', e => { if (e.target === o) closeModal(o.id); });
        });
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') document.querySelectorAll('.th-modal-overlay.open').forEach(o => closeModal(o.id));
        });
        const dz = document.getElementById('dropZone');
        if (dz) {
            dz.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('drag-over'); });
            dz.addEventListener('dragleave', () => dz.classList.remove('drag-over'));
            dz.addEventListener('drop', e => { e.preventDefault(); dz.classList.remove('drag-over'); if (e.dataTransfer.files[0]) processFile(e.dataTransfer.files[0]); });
        }
    });

    // ── Modal ────────────────────────────────────────────────────────────
    window.showModal = function (id) {
        const el = document.getElementById(id);
        if (!el) return;
        el.classList.add('open'); el.setAttribute('aria-hidden','false');
        document.body.style.overflow = 'hidden';
        if (id === 'kalemTopluModal') kalemModalAc();
    };
    window.closeModal = function (id) {
        const el = document.getElementById(id);
        if (!el) return;
        el.classList.remove('open'); el.setAttribute('aria-hidden','true');
        document.body.style.overflow = '';
    };
    function showFeedback(fbId, msg, type = 'success') {
        const fb = document.getElementById(fbId);
        if (!fb) return;
        fb.className = `modal-feedback ${type}`;
        fb.innerHTML = (type === 'success' ? '✓ ' : '✕ ') + msg;
        fb.style.display = 'flex';
        if (type === 'success') setTimeout(() => { fb.style.display = 'none'; }, 3000);
    }
    function kurGuncelle(sel) {
        const m = { TRY: 1, USD: Number(pageData.kurUSD), EUR: Number(pageData.kurEUR) };
        const v = m[sel.value] ?? 1;
        document.getElementById('e_kur_raw').value = v;
        document.getElementById('e_kur').value     = formatTR(v, 2);
    }
    function birimSelectHTML(inputId, currentVal) {
        const opts = BIRIMLER.map(b =>
            `<option value="${b.id}"${currentVal == b.id ? ' selected' : ''}>${b.kod} – ${b.ad}</option>`
        ).join('');
        return `<select class="kcell-select" id="${inputId}"><option value="">-</option>${opts}</select>`;
    }

    // ══════════════════════════════════════════════════════════════════════
    // PERSONEL INLINE DÜZENLEME
    // ══════════════════════════════════════════════════════════════════════
    function prDuzenle(id) {
        document.querySelectorAll('.pr-row-edit').forEach(r => { if (r.style.display !== 'none') prIptal(parseInt(r.dataset.id)); });
        const vr = document.querySelector(`.pr-row-view[data-id="${id}"]`);
        const er = document.querySelector(`.pr-row-edit[data-id="${id}"]`);
        if (!vr || !er) return;
        vr.style.display = 'none';
        er.style.display = '';
        const inp = er.querySelector('.pr-edit-birimFiyat');
        const hid = er.querySelector('.pr-edit-birimFiyat-raw');
        initRowNumeric(inp, hid, 2, () => prCanlıHesapla(er));
        prCanlıHesapla(er);
        er.querySelector('.pr-edit-gorevUnvan')?.focus();
    }
    function prIptal(id) {
        const vr = document.querySelector(`.pr-row-view[data-id="${id}"]`);
        const er = document.querySelector(`.pr-row-edit[data-id="${id}"]`);
        if (!vr || !er) return;
        er.style.display = 'none'; vr.style.display = '';
    }
    function prCanlıHesapla(er) {
        const fiyat  = parseFloat(er.querySelector('.pr-edit-birimFiyat-raw')?.value) || 0;
        const sayi   = parseInt(er.querySelector('.pr-edit-sayi')?.value) || 1;
        const toplam = sayi * fiyat * SURE_GUN / 30;
        const prev   = er.querySelector('.pr-edit-preview');
        if (prev) prev.textContent = formatTR(toplam, 2) + ' ₺';
    }
    async function prKaydet(id, btn) {
        const er = document.querySelector(`.pr-row-edit[data-id="${id}"]`);
        if (!er) return;
        const gorevUnvan = er.querySelector('.pr-edit-gorevUnvan')?.value.trim();
        const birimFiyat = parseFloat(er.querySelector('.pr-edit-birimFiyat-raw')?.value);
        const sayi       = parseInt(er.querySelector('.pr-edit-sayi')?.value) || 1;
        if (!gorevUnvan)                          { alert('Görev / Unvan zorunludur.'); return; }
        if (isNaN(birimFiyat) || birimFiyat <= 0) { alert('Aylık Brüt Ücret geçerli giriniz.'); return; }
        const data = {
            id, ihaleId: IHALE_ID,
            birimId:         parseInt(er.querySelector('.pr-edit-birimId')?.value) || null,
            gorevUnvan, sayi,
            ucretTipi:       er.querySelector('.pr-edit-ucretTipi')?.value,
            birimFiyatAylik: birimFiyat,
        };
        const orig = btn.textContent; btn.disabled = true; btn.textContent = '⏳';
        try {
            const res = await fetch(`${BASE}/PersonelGuncelle`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(data) });
            if (!res.ok) throw new Error();
            const r = await res.json();
            if (r.success) {
                const vr = document.querySelector(`.pr-row-view[data-id="${id}"]`);
                const toplam = sayi * birimFiyat * SURE_GUN / 30;
                vr.querySelector('.pr-gorev').textContent  = gorevUnvan;
                vr.querySelector('.pr-sayi').textContent   = sayi;
                vr.querySelector('.pr-ucret').textContent  = data.ucretTipi;
                vr.querySelector('.pr-fiyat').textContent  = formatTR(birimFiyat, 2);
                vr.querySelector('.pr-toplam').textContent = formatTR(toplam, 2);
                prIptal(id);
            } else { alert('Güncelleme başarısız.'); }
        } catch { alert('Güncelleme sırasında hata oluştu.'); }
        finally { btn.disabled = false; btn.textContent = orig; }
    }

    // ══════════════════════════════════════════════════════════════════════
    // EK GİDER INLINE DÜZENLEME
    // ══════════════════════════════════════════════════════════════════════
    function egDuzenle(id) {
        document.querySelectorAll('.eg-row-edit').forEach(r => { if (r.style.display !== 'none') egIptal(parseInt(r.dataset.id)); });
        const vr = document.querySelector(`.eg-row-view[data-id="${id}"]`);
        const er = document.querySelector(`.eg-row-edit[data-id="${id}"]`);
        if (!vr || !er) return;
        vr.style.display = 'none'; er.style.display = '';
        const fields = [
            { inp: '.eg-edit-miktar',     hid: '.eg-edit-miktar-raw',     dec: 0 },
            { inp: '.eg-edit-birimFiyat', hid: '.eg-edit-birimFiyat-raw', dec: 2 },
            { inp: '.eg-edit-kur',        hid: '.eg-edit-kur-raw',        dec: 2 },
        ];
        fields.forEach(({ inp: s, hid: h, dec }) => {
            const inp = er.querySelector(s); const hid = er.querySelector(h);
            if (inp && hid) initRowNumeric(inp, hid, dec, () => egCanlıHesapla(er));
        });
        const pb = er.querySelector('.eg-edit-paraBirimi');
        if (pb && !pb._pbInited) {
            pb._pbInited = true;
            pb.addEventListener('change', function () {
                const m = { TRY: 1, USD: Number(pageData.kurUSD), EUR: Number(pageData.kurEUR) };
                const v = m[this.value] ?? 1;
                er.querySelector('.eg-edit-kur-raw').value = v;
                er.querySelector('.eg-edit-kur').value     = formatTR(v, 4);
                egCanlıHesapla(er);
            });
        }
        egCanlıHesapla(er);
        er.querySelector('.eg-edit-giderAdi')?.focus();
    }
    function egIptal(id) {
        const vr = document.querySelector(`.eg-row-view[data-id="${id}"]`);
        const er = document.querySelector(`.eg-row-edit[data-id="${id}"]`);
        if (!vr || !er) return;
        er.style.display = 'none'; vr.style.display = '';
    }
    function egCanlıHesapla(er) {
        const m = parseFloat(er.querySelector('.eg-edit-miktar-raw')?.value)     || 0;
        const f = parseFloat(er.querySelector('.eg-edit-birimFiyat-raw')?.value) || 0;
        const k = parseFloat(er.querySelector('.eg-edit-kur-raw')?.value)        || 1;
        const p = er.querySelector('.eg-edit-preview');
        if (p) p.textContent = formatTR(m * f * k, 2) + ' ₺';
    }
    async function egKaydet(id, btn) {
        const er = document.querySelector(`.eg-row-edit[data-id="${id}"]`);
        if (!er) return;
        const giderAdi   = er.querySelector('.eg-edit-giderAdi')?.value.trim();
        const miktar     = parseFloat(er.querySelector('.eg-edit-miktar-raw')?.value);
        const birimFiyat = parseFloat(er.querySelector('.eg-edit-birimFiyat-raw')?.value);
        const kur        = parseFloat(er.querySelector('.eg-edit-kur-raw')?.value);
        if (!giderAdi)                            { alert('Gider Adı zorunludur.'); return; }
        if (isNaN(birimFiyat) || birimFiyat <= 0) { alert('Birim Fiyat geçerli giriniz.'); return; }
        if (isNaN(miktar)     || miktar <= 0)     { alert('Miktar geçerli giriniz.'); return; }
        if (isNaN(kur)        || kur <= 0)        { alert('Kur geçerli giriniz.'); return; }
        const data = {
            id, ihaleId: IHALE_ID,
            birimId:    parseInt(er.querySelector('.eg-edit-birimId')?.value) || null,
            giderAdi,
            kategori:   er.querySelector('.eg-edit-kategori')?.value.trim() || '',
            miktar, birimFiyat,
            paraBirimi: er.querySelector('.eg-edit-paraBirimi')?.value,
            kur, aciklama: ''
        };
        const orig = btn.textContent; btn.disabled = true; btn.textContent = '⏳';
        try {
            const res = await fetch(`${BASE}/EkGiderGuncelle`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(data) });
            if (!res.ok) throw new Error();
            const r = await res.json();
            if (r.success) {
                const vr = document.querySelector(`.eg-row-view[data-id="${id}"]`);
                vr.querySelector('.eg-miktar').textContent     = formatTR(miktar, 4);
                vr.querySelector('.eg-birimfiyat').textContent = formatTR(birimFiyat, 4);
                vr.querySelector('.eg-kur').textContent        = formatTR(kur, 4);
                vr.querySelector('.eg-tutar').innerHTML        = `<strong>${formatTR(miktar * birimFiyat * kur, 2)}</strong>`;
                egIptal(id);
            } else { alert('Güncelleme başarısız.'); }
        } catch { alert('Güncelleme sırasında hata oluştu.'); }
        finally { btn.disabled = false; btn.textContent = orig; }
    }

