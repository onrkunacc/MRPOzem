@using System.Globalization
@using System.Text.Json
@model Ihale

@{
    ViewData["Title"] = "İhale Detayı";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var birimler = ViewBag.Birimler as List<Birim> ?? new();

    var pageData = new
    {
        ihaleId = Model.Id,
        kurUSD = Model.KurUSD,
        kurEUR = Model.KurEUR
    };

    var birimlerJsonStr = JsonSerializer.Serialize(
        birimler.Select(b => new { id = b.Id, kod = b.BirimKodu, ad = b.BirimAdi }).ToList()
    );
}

<link rel="stylesheet" href="~/css/tendercss.css" />
<div class="page-header">
    <div>
        <h1 class="page-title">@Model.IhaleAdi</h1>
        <p class="page-sub">
            @if (!string.IsNullOrEmpty(Model.IhaleKayitNo))
            {
                <span>🔖 @Model.IhaleKayitNo &nbsp;</span>
            }
            @if (Model.IhaleTarihi.HasValue)
            {
                <span>📅 @Model.IhaleTarihi.Value.ToString("dd.MM.yyyy") &nbsp;</span>
            }
            <span>⏱ @Model.IhaleSuresiGun gün</span>
        </p>
    </div>
    <div class="header-actions">
        <a asp-area="Ihale" asp-controller="Ihale" asp-action="Ozet" asp-route-id="@Model.Id" class="btn btn-primary">📊 Özet Görüntüle</a>
        <a asp-area="Ihale" asp-controller="Ihale" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline">Düzenle</a>
        <a asp-area="Ihale" asp-controller="Ihale" asp-action="Index" class="btn btn-ghost">← Geri</a>
    </div>
</div>

<div class="params-bar">
    <div class="pbar-item"><span>Genel Gider</span><strong>%@((Model.GenelGiderOran * 100).ToString("0"))</strong></div>
    <div class="pbar-item"><span>Kar</span><strong>%@((Model.KarOran * 100).ToString("0"))</strong></div>
    <div class="pbar-item"><span>KDV</span><strong>%@((Model.KDVOran * 100).ToString("0"))</strong></div>
    <div class="pbar-item"><span>USD</span><strong>@Model.KurUSD.ToString("N2") ₺</strong></div>
    <div class="pbar-item"><span>EUR</span><strong>@Model.KurEUR.ToString("N2") ₺</strong></div>
    <div class="pbar-item"><span>Süre</span><strong>@Model.IhaleSuresiGun gün</strong></div>
</div>

<div class="tab-wrapper">
    <nav class="tab-nav">
        <button type="button" class="tab-btn active" data-tab="personel">👤 Personel Giderleri</button>
        <button type="button" class="tab-btn" data-tab="ekgider">💼 Ek Giderler</button>
        <button type="button" class="tab-btn" data-tab="kalemler">🔬 İhale Kalemleri</button>
    </nav>

    <!-- ══ PERSONEL ══════════════════════════════════════════════════ -->
    <div class="tab-panel active" id="tab-personel">
        <div class="panel-toolbar">
            <span class="panel-count">@Model.PersonelGiderler.Count kayıt</span>
            <button type="button" class="btn btn-sm btn-primary" onclick="showModal('personelModal')">+ Personel Ekle</button>
        </div>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Birim</th>
                        <th>Görev/Unvan</th>
                        <th>Sayı</th>
                        <th>Ücret Tipi</th>
                        <th class="text-right">Aylık Brüt (₺)</th>
                        <th class="text-right">Süre (gün)</th>
                        <th class="text-right">Toplam (₺)</th>
                        <th style="width:80px"></th>
                    </tr>
                </thead>
                <tbody id="personelTableBody">
                    @foreach (var p in Model.PersonelGiderler)
                    {
                        <!-- Görünüm -->
                        <tr data-id="@p.Id" class="pr-row-view">
                            <td><span class="badge-birim">@(p.Birim?.BirimKodu ?? "-")</span></td>
                            <td class="pr-gorev">@p.GorevUnvan</td>
                            <td class="pr-sayi">@p.Sayi</td>
                            <td><span class="tag pr-ucret">@p.UcretTipi</span></td>
                            <td class="text-right font-mono pr-fiyat">@p.BirimFiyatAylik.ToString("N2")</td>
                            <td class="text-right pr-sure">@Model.IhaleSuresiGun</td>
                            <td class="text-right font-mono pr-toplam">@p.ToplamTRY.ToString("N2")</td>
                            <td>
                                <div style="display:flex;gap:4px;">
                                    <button type="button" class="btn btn-outline btn-xs" onclick="prDuzenle(@p.Id)" title="Düzenle">✏️</button>
                                    <button type="button" class="btn btn-danger btn-xs" onclick="personelSil(@p.Id, this)" title="Sil">✕</button>
                                </div>
                            </td>
                        </tr>
                        <!-- Düzenleme -->
                        <tr data-id="@p.Id" class="pr-row-edit" style="display:none;">
                            <td>
                                <select class="kcell-select pr-edit-birimId">
                                    <option value="">-</option>
                                    @foreach (var b in birimler)
                                    {
                                        if (p.BirimId == b.Id)
                                        {
                                            <option value="@b.Id" selected>@b.BirimKodu</option>
                                        }
                                        else
                                        {
                                            <option value="@b.Id">@b.BirimKodu</option>
                                        }
                                    }
                                </select>
                            </td>
                            <td><input class="kcell pr-edit-gorevUnvan" value="@p.GorevUnvan" /></td>
                            <td><input class="kcell pr-edit-sayi" type="number" value="@p.Sayi" min="1" style="width:50px;" /></td>
                            <td>
                                <select class="kcell-select pr-edit-ucretTipi">
                                    @foreach (var ut in new[] { "Brut (Aylik)", "Net (Aylik)", "Günlük" })
                                    {
                                        if (p.UcretTipi == ut)
                                        {
                                            <option value="@ut" selected>@ut</option>
                                        }
                                        else
                                        {
                                            <option value="@ut">@ut</option>
                                        }
                                    }
                                </select>
                            </td>
                            <td>
                                <input class="kcell pr-edit-birimFiyat numeric-input"
                                       value="@p.BirimFiyatAylik.ToString("N2", CultureInfo.GetCultureInfo("tr-TR"))"
                                       autocomplete="off" style="text-align:right;" />
                                <input type="hidden" class="pr-edit-birimFiyat-raw"
                                       value="@p.BirimFiyatAylik.ToString(CultureInfo.InvariantCulture)" />
                            </td>
                            <td class="text-right" style="color:#a0aec0;font-size:.8rem;">@Model.IhaleSuresiGun</td>
                            <td class="text-right font-mono pr-edit-preview" style="color:#f59e0b;font-size:.8rem;white-space:nowrap;"></td>
                            <td>
                                <div style="display:flex;gap:4px;">
                                    <button type="button" class="btn btn-primary btn-xs" onclick="prKaydet(@p.Id, this)" title="Kaydet">💾</button>
                                    <button type="button" class="btn btn-ghost btn-xs" onclick="prIptal(@p.Id)" title="İptal">✕</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="6"><strong>TOPLAM</strong></td>
                        <td class="text-right font-mono"><strong>@Model.PersonelGiderler.Sum(p => p.ToplamTRY).ToString("N2") ₺</strong></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- ══ EK GİDER ═════════════════════════════════════════════════ -->
    <div class="tab-panel" id="tab-ekgider">
        <div class="panel-toolbar">
            <span class="panel-count">@Model.EkGiderler.Count kayıt</span>
            <button type="button" class="btn btn-sm btn-primary" onclick="showModal('ekGiderModal')">+ Gider Ekle</button>
        </div>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Birim</th>
                        <th>Gider Adı</th>
                        <th>Kategori</th>
                        <th class="text-right">Miktar</th>
                        <th class="text-right">Birim Fiyat</th>
                        <th>Para Birimi</th>
                        <th class="text-right">Kur</th>
                        <th class="text-right">Tutar (₺)</th>
                        <th style="width:80px"></th>
                    </tr>
                </thead>
                <tbody id="ekGiderTableBody">
                    @foreach (var e in Model.EkGiderler)
                    {
                        <!-- Görünüm -->
                        <tr data-id="@e.Id" class="eg-row-view">
                            <td><span class="badge-birim">@(e.Birim?.BirimKodu ?? "-")</span></td>
                            <td>@e.GiderAdi</td>
                            <td>@(e.Kategori ?? "-")</td>
                            <td class="text-right font-mono eg-miktar">@e.Miktar.ToString("N0")</td>
                            <td class="text-right font-mono eg-birimfiyat">@e.BirimFiyat.ToString("N2")</td>
                            <td><span class="tag eg-parabir">@e.ParaBirimi</span></td>
                            <td class="text-right font-mono eg-kur">@e.Kur.ToString("N2")</td>
                            <td class="text-right font-mono eg-tutar"><strong>@e.TutarTRY.ToString("N2")</strong></td>
                            <td>
                                <div style="display:flex;gap:4px;">
                                    <button type="button" class="btn btn-outline btn-xs" onclick="egDuzenle(@e.Id)" title="Düzenle">✏️</button>
                                    <button type="button" class="btn btn-danger btn-xs" onclick="ekGiderSil(@e.Id, this)" title="Sil">✕</button>
                                </div>
                            </td>
                        </tr>
                        <!-- Düzenleme -->
                        <tr data-id="@e.Id" class="eg-row-edit" style="display:none;">
                            <td>
                                <select class="kcell-select eg-edit-birimId">
                                    <option value="">-</option>
                                    @foreach (var b in birimler)
                                    {
                                        if (e.BirimId == b.Id)
                                        {
                                            <option value="@b.Id" selected>@b.BirimKodu</option>
                                        }
                                        else
                                        {
                                            <option value="@b.Id">@b.BirimKodu</option>
                                        }
                                    }
                                </select>
                            </td>
                            <td><input class="kcell eg-edit-giderAdi" value="@e.GiderAdi" /></td>
                            <td><input class="kcell eg-edit-kategori" value="@(e.Kategori ?? "")" /></td>
                            <td>
                                <input class="kcell eg-edit-miktar numeric-input"
                                       value="@e.Miktar.ToString("N0", CultureInfo.GetCultureInfo("tr-TR"))"
                                       autocomplete="off" style="text-align:right;" />
                                <input type="hidden" class="eg-edit-miktar-raw"
                                       value="@e.Miktar.ToString(CultureInfo.InvariantCulture)" />
                            </td>
                            <td>
                                <input class="kcell eg-edit-birimFiyat numeric-input"
                                       value="@e.BirimFiyat.ToString("N2", CultureInfo.GetCultureInfo("tr-TR"))"
                                       autocomplete="off" style="text-align:right;" />
                                <input type="hidden" class="eg-edit-birimFiyat-raw"
                                       value="@e.BirimFiyat.ToString(CultureInfo.InvariantCulture)" />
                            </td>
                            <td>
                                <select class="kcell-select eg-edit-paraBirimi">
                                    @foreach (var pb in new[] { "TRY", "USD", "EUR" })
                                    {
                                        if (e.ParaBirimi == pb)
                                        {
                                            <option value="@pb" selected>@pb</option>
                                        }
                                        else
                                        {
                                            <option value="@pb">@pb</option>
                                        }
                                    }
                                </select>
                            </td>
                            <td>
                                <input class="kcell eg-edit-kur numeric-input"
                                       value="@e.Kur.ToString("N2", CultureInfo.GetCultureInfo("tr-TR"))"
                                       autocomplete="off" style="text-align:right;" />
                                <input type="hidden" class="eg-edit-kur-raw"
                                       value="@e.Kur.ToString(CultureInfo.InvariantCulture)" />
                            </td>
                            <td class="text-right font-mono eg-edit-preview" style="color:#f59e0b;font-size:.8rem;white-space:nowrap;"></td>
                            <td>
                                <div style="display:flex;gap:4px;">
                                    <button type="button" class="btn btn-primary btn-xs" onclick="egKaydet(@e.Id, this)" title="Kaydet">💾</button>
                                    <button type="button" class="btn btn-ghost btn-xs" onclick="egIptal(@e.Id)" title="İptal">✕</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="7"><strong>TOPLAM</strong></td>
                        <td class="text-right font-mono"><strong>@Model.EkGiderler.Sum(e => e.TutarTRY).ToString("N2") ₺</strong></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- ══ KALEMLER ═════════════════════════════════════════════════ -->
    <div class="tab-panel" id="tab-kalemler">
        <div class="panel-toolbar">
            <span class="panel-count">@Model.IhaleKalemler.Count kalem</span>
            <button type="button" class="btn btn-sm btn-primary" onclick="showModal('kalemTopluModal')">+ Kalem Ekle</button>
        </div>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Birim</th>
                        <th>SUT Kodu</th>
                        <th>Tetkik Adı</th>
                        <th class="text-right">Test Miktarı</th>
                        <th class="text-right">SUT Fiyat</th>
                        <th class="text-right">SUT Çarpan</th>
                        <th class="text-right">Toplam SUT</th>
                        <th class="text-right">Toplam SUT Fiyat</th>
                        <th style="width:80px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in Model.IhaleKalemler.OrderBy(x => x.SiraNo))
                    {
                        <!-- Görünüm -->
                        <tr data-id="@k.Id" class="kl-row-view">
                            <td>@k.SiraNo</td>
                            <td><span class="badge-birim">@(k.Birim?.BirimKodu ?? "-")</span></td>
                            <td class="kl-sutkodu">@k.SutKodu</td>
                            <td class="kl-tetkik">@k.TetkikAdi</td>
                            <td class="text-right font-mono kl-miktar">@k.TestMiktari.ToString("N0")</td>
                            <td class="text-right font-mono kl-sutfiyat">@k.SutFiyat.ToString("N2")</td>
                            <td class="text-right font-mono kl-carpan">@k.SutCarpan.ToString("N3")</td>
                            <td class="text-right font-mono kl-toplamSut">@k.ToplamSUT.ToString("N2")</td>
                            <td class="text-right font-mono kl-toplamSutFiyat">@k.ToplamSutFiyat.ToString("N2")</td>
                            <td>
                                <div style="display:flex;gap:4px;">
                                    <button type="button" class="btn btn-outline btn-xs" onclick="klDuzenle(@k.Id)" title="Düzenle">✏️</button>
                                    <button type="button" class="btn btn-danger btn-xs" onclick="kalemSil(@k.Id, this)" title="Sil">✕</button>
                                </div>
                            </td>
                        </tr>
                        <!-- Düzenleme -->
                        <tr data-id="@k.Id" class="kl-row-edit" style="display:none;">
                            <td>
                                <input class="kcell kl-edit-siraNo" type="number"
                                       value="@k.SiraNo" min="1" style="width:45px;text-align:center;" />
                            </td>
                            <td>
                                <select class="kcell-select kl-edit-birimId">
                                    <option value="">-</option>
                                    @foreach (var b in birimler)
                                    {
                                        if (k.BirimId == b.Id)
                                        {
                                            <option value="@b.Id" selected>@b.BirimKodu</option>
                                        }
                                        else
                                        {
                                            <option value="@b.Id">@b.BirimKodu</option>
                                        }
                                    }
                                </select>
                            </td>
                            <td><input class="kcell kl-edit-sutKodu" value="@(k.SutKodu ?? "")" placeholder="P1234" /></td>
                            <td><input class="kcell kl-edit-tetkikAdi" value="@k.TetkikAdi" /></td>
                            <td>
                                <input class="kcell kl-edit-testMiktari numeric-input"
                                       value="@k.TestMiktari.ToString("N0", CultureInfo.GetCultureInfo("tr-TR"))"
                                       autocomplete="off" style="text-align:right;" />
                                <input type="hidden" class="kl-edit-testMiktari-raw"
                                       value="@k.TestMiktari.ToString(CultureInfo.InvariantCulture)" />
                            </td>
                            <td>
                                <input class="kcell kl-edit-sutFiyat numeric-input"
                                       value="@k.SutFiyat.ToString("N2", CultureInfo.GetCultureInfo("tr-TR"))"
                                       autocomplete="off" style="text-align:right;" />
                                <input type="hidden" class="kl-edit-sutFiyat-raw"
                                       value="@k.SutFiyat.ToString(CultureInfo.InvariantCulture)" />
                            </td>
                            <td>
                                <input class="kcell kl-edit-sutCarpan numeric-input"
                                       value="@k.SutCarpan.ToString("N3", CultureInfo.GetCultureInfo("tr-TR"))"
                                       autocomplete="off" style="text-align:right;" />
                                <input type="hidden" class="kl-edit-sutCarpan-raw"
                                       value="@k.SutCarpan.ToString(CultureInfo.InvariantCulture)" />
                            </td>
                            <td class="text-right font-mono kl-edit-toplamSut-preview" style="color:#a0aec0;font-size:.8rem;"></td>
                            <td class="text-right font-mono kl-edit-preview" style="color:#f59e0b;font-size:.8rem;white-space:nowrap;"></td>
                            <td>
                                <div style="display:flex;gap:4px;">
                                    <button type="button" class="btn btn-primary btn-xs" onclick="klKaydet(@k.Id, this)" title="Kaydet">💾</button>
                                    <button type="button" class="btn btn-ghost btn-xs" onclick="klIptal(@k.Id)" title="İptal">✕</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <!-- Birim bazlı ara toplamlar -->
                    @foreach (var birimGrup in Model.IhaleKalemler
                                        .Where(k => k.BirimId != null)
                                        .GroupBy(k => new { k.BirimId, k.Birim?.BirimKodu, k.Birim?.BirimAdi })
                                        .OrderBy(g => g.Key.BirimKodu))
                    {
                        <tr class="tfoot-birim-row">
                            <td colspan="7" style="text-align:right; color:#4a5568; font-size:.8rem; padding-right:8px;">
                                <span class="badge-birim">@birimGrup.Key.BirimKodu</span>
                                @birimGrup.Key.BirimAdi ara toplamı
                            </td>
                            <td class="text-right font-mono" style="color:#4a5568; font-size:.85rem;">
                                @birimGrup.Sum(k => k.ToplamSUT).ToString("N2")
                            </td>
                            <td class="text-right font-mono" style="color:#4a5568; font-size:.85rem;">
                                @birimGrup.Sum(k => k.ToplamSutFiyat).ToString("N2")
                            </td>
                            <td></td>
                        </tr>
                    }
                    <!-- Birimi olmayan kalemlerin toplamı -->
                    @if (Model.IhaleKalemler.Any(k => k.BirimId == null))
                    {
                        <tr class="tfoot-birim-row">
                            <td colspan="7" style="text-align:right; color:#a0aec0; font-size:.8rem;">
                                <span class="badge-birim" style="background:#f3f4f6;color:#6b7280;">-</span>
                                Birimsiz ara toplamı
                            </td>
                            <td class="text-right font-mono" style="color:#4a5568; font-size:.85rem;">
                                @Model.IhaleKalemler.Where(k => k.BirimId == null).Sum(k => k.ToplamSUT).ToString("N2")
                            </td>
                            <td class="text-right font-mono" style="color:#4a5568; font-size:.85rem;">
                                @Model.IhaleKalemler.Where(k => k.BirimId == null).Sum(k => k.ToplamSutFiyat).ToString("N2")
                            </td>
                            <td></td>
                        </tr>
                    }
                    <!-- Genel toplam -->
                    <tr class="tfoot-total-row">
                        <td colspan="7"><strong>GENEL TOPLAM</strong></td>
                        <td class="text-right font-mono"><strong>@Model.IhaleKalemler.Sum(k => k.ToplamSUT).ToString("N2")</strong></td>
                        <td class="text-right font-mono"><strong>@Model.IhaleKalemler.Sum(k => k.ToplamSutFiyat).ToString("N2") ₺</strong></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<!-- ═══ MODAL: Personel ══════════════════════════════════════════════ -->
<div class="th-modal-overlay" id="personelModal" aria-hidden="true">
    <div class="th-modal" role="dialog" aria-modal="true">
        <div class="th-modal-header">
            <h3>Personel Gideri Ekle</h3>
            <button type="button" onclick="closeModal('personelModal')" class="th-modal-close">✕</button>
        </div>
        <div class="th-modal-body">
            <div id="personelFeedback" class="modal-feedback" style="display:none;"></div>
            <div class="form-grid-2">
                <div class="form-group">
                    <label>Birim</label>
                    <select id="p_birimId" class="form-control">
                        <option value="">-- Seçin --</option>
                        @foreach (var b in birimler)
                        {
                            <option value="@b.Id">@b.BirimKodu – @b.BirimAdi</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Görev / Unvan *</label>
                    <input id="p_gorevUnvan" class="form-control" placeholder="Personel, Teknik Personel..." />
                </div>
                <div class="form-group">
                    <label>Sayı</label>
                    <input id="p_sayi" type="number" class="form-control" value="1" min="1" />
                </div>
                <div class="form-group">
                    <label>Eğitim Durumu</label>
                    <input id="p_egitim" class="form-control" placeholder="Lisans, Önlisans..." />
                </div>
                <div class="form-group">
                    <label>Ücret Tipi</label>
                    <select id="p_ucretTipi" class="form-control">
                        <option>Brut (Aylik)</option>
                        <option>Net (Aylik)</option>
                        <option>Günlük</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Aylık Brüt Ücret (₺) *</label>
                    <input id="p_birimFiyat" class="form-control numeric-input" placeholder="0,00" autocomplete="off" />
                    <input type="hidden" id="p_birimFiyat_raw" />
                </div>
                <div class="form-group" style="grid-column:span 2">
                    <label>Açıklama</label>
                    <input id="p_aciklama" class="form-control" />
                </div>
            </div>
        </div>
        <div class="th-modal-footer">
            <button type="button" onclick="closeModal('personelModal')" class="btn btn-outline">Kapat</button>
            <button type="button" onclick="personelEkle(true)" class="btn btn-ghost">Kaydet ve Devam Et</button>
            <button type="button" onclick="personelEkle(false)" class="btn btn-primary">Kaydet ve Kapat</button>
        </div>
    </div>
</div>

