@model List<IhaleListeSatir>
@{
    ViewData["Title"] = "İhaleler";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var now = DateTime.Now;
    var bugun = now.Date;

    // Kart gövdesi Ihale nesnesiyle çalışıyor; özet rakamlar Id ile eşleştirilir.
    var ihaleler = Model.Select(x => x.Ihale).ToList();
    var ozetMap = Model.ToDictionary(x => x.Ihale.Id);

    // Yaklaşan ihaleler (gelecek 30 gün)
    var yaklasanList = ihaleler
        .Where(x => x.IhaleTarihi.HasValue && x.IhaleTarihi.Value.Date >= bugun
                                           && x.IhaleTarihi.Value.Date <= bugun.AddDays(30))
        .OrderBy(x => x.IhaleTarihi)
        .ToList();

    // ═══ TÜM İHALELER — KALAN GÜNE GÖRE SIRALAMA ═══
    // 1) Gelecek ihaleler: en yakın tarih başta
    // 2) Geçmiş ihaleler: en yeni tamamlanan başta
    // 3) Tarihi belirlenmemiş olanlar en sonda
    var tumIhaleler = ihaleler
        .Select(x => new
        {
            Ihale = x,
            Gun = x.IhaleTarihi.HasValue ? (int?)(x.IhaleTarihi.Value.Date - bugun).Days : null
        })
        .OrderBy(x => x.Gun == null ? 2 : (x.Gun.Value >= 0 ? 0 : 1))
        .ThenBy(x => x.Gun.HasValue ? Math.Abs(x.Gun.Value) : int.MaxValue)
        .Select(x => x.Ihale)
        .ToList();

    string GetStatusClass(DateTime? tarih)
    {
        if (!tarih.HasValue) return "status-none";
        var d = (tarih.Value.Date - bugun).Days;
        if (d < 0) return "status-past";
        if (d == 0) return "status-today";
        if (d == 1) return "status-tomorrow";
        if (d <= 3) return "status-soon";
        if (d <= 7) return "status-week";
        if (d <= 30) return "status-month";
        return "status-future";
    }

    string FormatSaat(TimeSpan? saat) => saat.HasValue ? saat.Value.ToString(@"hh\:mm") : "";

    string GetStatusText(DateTime? tarih, TimeSpan? saat)
    {
        if (!tarih.HasValue) return "Tarih belirlenmemiş";
        var d = (tarih.Value.Date - bugun).Days;
        var saatStr = FormatSaat(saat);
        if (d < 0) return $"{Math.Abs(d)} gün önce tamamlandı";
        if (d == 0) return string.IsNullOrEmpty(saatStr) ? "BUGÜN" : $"BUGÜN · {saatStr}";
        if (d == 1) return string.IsNullOrEmpty(saatStr) ? "YARIN" : $"YARIN · {saatStr}";
        if (d <= 30) return $"{d} gün kaldı";
        return tarih.Value.ToString("dd.MM.yyyy");
    }

    string GetUrgencyLabel(int days)
    {
        if (days == 0) return "BUGÜN";
        if (days == 1) return "YARIN";
        if (days <= 3) return "ACİL";
        if (days <= 7) return "BU HAFTA";
        return "BU AY";
    }
}

