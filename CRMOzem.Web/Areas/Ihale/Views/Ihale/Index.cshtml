<link rel="stylesheet" href="~/css/tender-upcoming.css" asp-append-version="true" />

<style>
    /* ═══════════════ TÜM İHALELER CAROUSEL ═══════════════ */
    .ihale-carousel { margin-top: 1.5rem; }

    .carousel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: .6rem;
    }

    .carousel-head .ihale-section-title { margin: 0; }

    .carousel-nav {
        display: flex;
        align-items: center;
        gap: .5rem;
    }

    .carousel-counter {
        font-size: .78rem;
        font-weight: 600;
        color: #64748b;
        font-variant-numeric: tabular-nums;
        min-width: 58px;
        text-align: right;
    }

    .carousel-btn {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #4f46e5;
        font-size: 1.15rem;
        line-height: 1;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background .15s, border-color .15s, transform .15s, opacity .15s;
        padding: 0;
    }
    .carousel-btn:hover:not(:disabled) {
        background: #eef2ff;
        border-color: #c7d2fe;
        transform: translateY(-1px);
    }
    .carousel-btn:active:not(:disabled) { transform: translateY(0); }
    .carousel-btn:disabled { opacity: .35; cursor: default; }
    .carousel-btn:focus-visible { outline: 2px solid #6366f1; outline-offset: 2px; }

    /* 30 sn otomatik dönüş göstergesi */
    .carousel-progress {
        height: 2px;
        background: #f1f5f9;
        border-radius: 999px;
        overflow: hidden;
        margin-bottom: .75rem;
    }
    .carousel-progress-fill {
        height: 100%;
        width: 0;
        background: linear-gradient(90deg, #6366f1, #8b5cf6);
        border-radius: 999px;
    }
    .carousel-progress-fill.running {
        animation: carouselProgress 30s linear forwards;
    }
    @@keyframes carouselProgress { from { width: 0; } to { width: 100%; } }

    .carousel-viewport {
        overflow: hidden;
        /* kart gölgeleri kırpılmasın */
        margin: 0 -.5rem;
        padding: .25rem 0 .5rem;
    }

    .carousel-track {
        display: flex;
        transition: transform .45s cubic-bezier(.4, 0, .2, 1);
        will-change: transform;
    }

    .carousel-slide {
        flex: 0 0 20%;          /* varsayılan: 5 kart */
        max-width: 20%;
        padding: 0 .5rem;
        box-sizing: border-box;
        display: flex;
    }
    .carousel-slide > .ihale-card {
        width: 100%;
        height: 100%;
        margin: 0;
    }

    @@media (max-width: 1500px) { .carousel-slide { flex-basis: 25%;     max-width: 25%; } }
    @@media (max-width: 1200px) { .carousel-slide { flex-basis: 33.3333%; max-width: 33.3333%; } }
    @@media (max-width: 900px)  { .carousel-slide { flex-basis: 50%;     max-width: 50%; } }
    @@media (max-width: 600px)  { .carousel-slide { flex-basis: 100%;    max-width: 100%; } }

    .carousel-dots {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: .4rem;
        flex-wrap: wrap;
        margin-top: .5rem;
    }
    .carousel-dot {
        width: 8px;
        height: 8px;
        border-radius: 999px;
        border: 0;
        background: #cbd5e1;
        cursor: pointer;
        padding: 0;
        transition: width .25s, background .2s;
    }
    .carousel-dot:hover { background: #94a3b8; }
    .carousel-dot.active { width: 22px; background: #6366f1; }
    .carousel-dot:focus-visible { outline: 2px solid #6366f1; outline-offset: 2px; }

    .carousel-hint {
        text-align: center;
        font-size: .7rem;
        color: #94a3b8;
        margin-top: .45rem;
    }

    @@media (prefers-reduced-motion: reduce) {
        .carousel-track { transition: none; }
        .carousel-progress-fill.running { animation: none; }
    }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">İhaleler</h1>
        <p class="page-sub">Tüm ihale maliyet hesaplamalarınız</p>
    </div>
    <a asp-area="Ihale" asp-controller="Ihale" asp-action="Create" class="btn btn-primary">+ Yeni İhale</a>
</div>

@if (Model.Any() && yaklasanList.Any())
{
    <!-- ═══ YAKLAŞAN İHALELER TABLOSU ═══ -->
    <div class="upcoming-table-card">
        <div class="upcoming-table-head">
            <div>
                <h4>⏳ Yaklaşan İhaleler</h4>
                <p class="upcoming-table-sub">Önümüzdeki 30 gün içerisinde gerçekleşecek ihaleler</p>
            </div>
            <span class="upcoming-table-count">@yaklasanList.Count ihale</span>
        </div>

        <div class="upcoming-table-wrap">
            <table class="upcoming-table">
                <thead>
                    <tr>
                        <th class="th-urgency">Durum</th>
                        <th>İhale Adı</th>
                        <th class="th-date">Tarih</th>
                        <th class="th-time">Saat</th>
                        <th>Kayıt No</th>
                        <th>Şekil</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in yaklasanList)
                    {
                        var days = (u.IhaleTarihi.Value.Date - bugun).Days;
                        string rowClass = days == 0 ? "row-today"
                                          : days == 1 ? "row-tomorrow"
                                          : days <= 3 ? "row-soon"
                                          : days <= 7 ? "row-week"
                                          : "row-month";
                        string urgencyLabel = GetUrgencyLabel(days);

                        <tr class="@rowClass">
                            <td class="td-urgency">
                                <span class="urgency-badge urgency-@rowClass">
                                    @if (days == 0)
                                    {
                                        <span class="urgency-pulse"></span>
                                    }
                                    <span class="urgency-days">@days</span>
                                    <span class="urgency-label">@urgencyLabel</span>
                                </span>
                            </td>
                            <td>
                                <div class="ihale-name-cell">@u.IhaleAdi</div>
                            </td>
                            <td class="td-date">
                                <strong>@u.IhaleTarihi.Value.ToString("dd.MM.yyyy")</strong>
                                <div class="td-date-day">@u.IhaleTarihi.Value.ToString("dddd", new System.Globalization.CultureInfo("tr-TR"))</div>
                            </td>
                            <td class="td-time">
                                @if (u.IhaleSaati.HasValue)
                                {
                                    <span class="time-chip">🕒 @u.IhaleSaati.Value.ToString(@"hh\:mm")</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(u.IhaleKayitNo))
                                {
                                    <span class="kayit-no-chip">@u.IhaleKayitNo</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td>
                                <span class="sekil-chip">@(u.IhaleSekli ?? "HİZMET")</span>
                            </td>
                            <td class="text-end">
                                <a asp-area="Ihale" asp-controller="Ihale" asp-action="Detail" asp-route-id="@u.Id"
                                   class="btn btn-outline btn-sm">Detay →</a>
                                <a asp-area="Ihale" asp-controller="Ihale" asp-action="Ozet" asp-route-id="@u.Id"
                                    class="btn btn-outline btn-sm">Özet →</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon">📋</div>
        <h3>Henüz ihale yok</h3>
        <p>İlk ihalenizi oluşturun, maliyet hesaplamaya başlayın.</p>
        <a asp-area="Ihale" asp-controller="Ihale" asp-action="Create" class="btn btn-primary">İhale Oluştur</a>
    </div>
}
else
{
    <!-- ═══ TÜM İHALELER — CAROUSEL ═══ -->
    <div class="ihale-carousel" id="ihaleCarousel">

        <div class="carousel-head">
            <h4 class="ihale-section-title">Tüm İhaleler <span class="text-muted" style="font-weight:500;font-size:.8rem">(@tumIhaleler.Count)</span></h4>
            <div class="carousel-nav">
                <span class="carousel-counter" id="carouselCounter">—</span>
                <button type="button" class="carousel-btn" id="carouselPrev" aria-label="Önceki ihaleler">&#8249;</button>
                <button type="button" class="carousel-btn" id="carouselNext" aria-label="Sonraki ihaleler">&#8250;</button>
            </div>
        </div>

        <div class="carousel-progress" id="carouselProgressWrap">
            <div class="carousel-progress-fill" id="carouselProgress"></div>
        </div>

        <div class="carousel-viewport" id="carouselViewport">
            <div class="carousel-track" id="carouselTrack">
                @foreach (var ihale in tumIhaleler)
                {
                    var statusClass = GetStatusClass(ihale.IhaleTarihi);
                    var statusText = GetStatusText(ihale.IhaleTarihi, ihale.IhaleSaati);
                    ozetMap.TryGetValue(ihale.Id, out var ozet);

                    <div class="carousel-slide">
                        <div class="ihale-card @statusClass">
                            <div class="card-header">
                                <span class="card-badge">@(ihale.IhaleSekli ?? "HİZMET")</span>
                                <span class="card-date">@ihale.OlusturmaTarihi.ToString("dd.MM.yyyy")</span>
                            </div>

                            <h3 class="card-title">@ihale.IhaleAdi</h3>

                            <div class="card-status-chip">
                                @if (statusClass == "status-today")
                                {
                                    <span class="status-dot pulsing"></span>
                                }
                                else
                                {
                                    <span class="status-dot"></span>
                                }
                                <span>@statusText</span>
                            </div>

                            <div class="card-meta">
                                @if (!string.IsNullOrEmpty(ihale.IhaleKayitNo))
                                {
                                    <span class="meta-item">🔖 @ihale.IhaleKayitNo</span>
                                }
                                @if (ihale.IhaleTarihi.HasValue)
                                {
                                    <span class="meta-item">📅 @ihale.IhaleTarihi.Value.ToString("dd.MM.yyyy")</span>
                                    @if (ihale.IhaleSaati.HasValue)
                                    {
                                        <span class="meta-item meta-time">🕒 @ihale.IhaleSaati.Value.ToString(@"hh\:mm")</span>
                                    }
                                }
                                <span class="meta-item">⏱ @ihale.IhaleSuresiGun gün</span>
                                <span class="meta-item meta-kisim">📑 @ihale.KisimSayisi kısım</span>
                            </div>

                            @if (ozet != null)
                            {
                                <div class="card-kisim">
                                    <div class="card-kisim-head">
                                        <span class="ck-label">Kısım durumu</span>
                                        <span class="ck-oran @(ozet.EksikKisimVar ? "eksik" : "tam")">
                                            @ozet.DoluKisimAdedi / @ozet.KisimSayisi
                                        </span>
                                    </div>

                                    <div class="ck-noktalar">
                                        @for (var n = 1; n <= ozet.KisimSayisi && n <= 24; n++)
                                        {
                                            var dolu = ozet.DoluKisimlar.Contains(n);
                                            <span class="ck-nokta @(dolu ? "dolu" : "")"
                                                  title="@n. Kısım — @(dolu ? "veri girilmiş" : "boş")">@n</span>
                                        }
                                        @if (ozet.KisimSayisi > 24)
                                        {
                                            <span class="ck-nokta fazla">+@(ozet.KisimSayisi - 24)</span>
                                        }
                                        @if (ozet.OrtakKayitAdedi > 0)
                                        {
                                            <span class="ck-nokta ortak" title="@ozet.OrtakKayitAdedi kayıt hiçbir kısma atanmamış">Ortak</span>
                                        }
                                    </div>

                                    @if (ozet.TanimDisiKisimlar.Any())
                                    {
                                        <div class="ck-uyari">
                                            ⚠ Tanım dışı kısım: @string.Join(", ", ozet.TanimDisiKisimlar)
                                        </div>
                                    }

                                    <div class="ck-rakamlar">
                                        <span><strong>@ozet.KalemAdedi.ToString("N0")</strong> kalem</span>
                                        <span><strong>@ozet.TestMiktari.ToString("N0")</strong> test</span>
                                        <span><strong>@ozet.ToplamSutPuani.ToString("N0")</strong> SUT</span>
                                        @if (ozet.GenelToplam > 0)
                                        {
                                            <span class="ck-tutar"><strong>@ozet.GenelToplam.ToString("N0")</strong> ₺</span>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="card-params">
                                <div class="param">
                                    <span class="param-label">KDV</span>
                                    <span class="param-value">%@((ihale.KDVOran * 100).ToString("0"))</span>
                                </div>
                                <div class="param">
                                    <span class="param-label">Kar</span>
                                    <span class="param-value">%@((ihale.KarOran * 100).ToString("0"))</span>
                                </div>
                                <div class="param">
                                    <span class="param-label">USD</span>
                                    <span class="param-value">@ihale.KurUSD ₺</span>
                                </div>
                                <div class="param">
                                    <span class="param-label">EUR</span>
                                    <span class="param-value">@ihale.KurEUR ₺</span>
                                </div>
                            </div>

                            <div class="card-actions">
                                <a asp-area="Ihale" asp-controller="Ihale" asp-action="Detail" asp-route-id="@ihale.Id" class="btn btn-outline btn-sm">Detay</a>
                                <a asp-area="Ihale" asp-controller="Ihale" asp-action="Ozet" asp-route-id="@ihale.Id" class="btn btn-ghost btn-sm">Özet</a>
                                <a asp-area="Ihale" asp-controller="Ihale" asp-action="Edit" asp-route-id="@ihale.Id" class="btn btn-ghost btn-sm">Düzenle</a>
                                <form asp-area="Ihale" asp-controller="Ihale" asp-action="Delete" asp-route-id="@ihale.Id" method="post" style="display:inline"
                                      onsubmit="return confirm('Bu ihaleyi silmek istiyor musunuz?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="carousel-dots" id="carouselDots"></div>
        <div class="carousel-hint" id="carouselHint">Fareyi üzerine getirince otomatik geçiş durur</div>
    </div>
}

@section Scripts {
<script>
(function () {
    const AUTOPLAY_MS = 30000; // 30 saniye

    document.addEventListener('DOMContentLoaded', init, { once: true });

    function init() {
        const root      = document.getElementById('ihaleCarousel');
        if (!root) return;

        const viewport  = document.getElementById('carouselViewport');
        const track     = document.getElementById('carouselTrack');
        const prevBtn   = document.getElementById('carouselPrev');
        const nextBtn   = document.getElementById('carouselNext');
        const counter   = document.getElementById('carouselCounter');
        const dotsWrap  = document.getElementById('carouselDots');
        const progress  = document.getElementById('carouselProgress');
        const progWrap  = document.getElementById('carouselProgressWrap');
        const hint      = document.getElementById('carouselHint');

        if (!viewport || !track) return;

        const slides = Array.from(track.querySelectorAll('.carousel-slide'));
        const total  = slides.length;
        if (total === 0) return;

        let page = 0;
        let pageCount = 1;
        let timer = null;
        let paused = false;

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Ekranda kaç kart görünüyor? (CSS breakpoint'lerinden bağımsız ölçüm)
        function perView() {
            const vw = viewport.clientWidth;
            const sw = slides[0].getBoundingClientRect().width;
            if (!sw) return 1;
            return Math.max(1, Math.round(vw / sw));
        }

        function recalc() {
            const pv = perView();
            pageCount = Math.max(1, Math.ceil(total / pv));
            if (page > pageCount - 1) page = pageCount - 1;
            buildDots();
            apply();
        }

        function buildDots() {
            if (!dotsWrap) return;
            dotsWrap.innerHTML = '';
            if (pageCount <= 1) return;
            for (let i = 0; i < pageCount; i++) {
                const b = document.createElement('button');
                b.type = 'button';
                b.className = 'carousel-dot' + (i === page ? ' active' : '');
                b.setAttribute('aria-label', (i + 1) + '. sayfa');
                b.addEventListener('click', () => { goTo(i); restart(); });
                dotsWrap.appendChild(b);
            }
        }

        function apply() {
            // Son sayfada boşluk kalmasın: sağa dayalı hizala
            const maxOffset = Math.max(0, track.scrollWidth - viewport.clientWidth);
            const offset    = Math.min(page * viewport.clientWidth, maxOffset);
            track.style.transform = `translateX(${-offset}px)`;

            // Sayaç: görünen kart aralığı
            const pv    = perView();
            const first = Math.min(page * pv + 1, total);
            const last  = Math.min(first + pv - 1, total);
            if (counter) counter.textContent = `${first}–${last} / ${total}`;

            // Oklar
            const single = pageCount <= 1;
            if (prevBtn) { prevBtn.disabled = single; prevBtn.style.display = single ? 'none' : ''; }
            if (nextBtn) { nextBtn.disabled = single; nextBtn.style.display = single ? 'none' : ''; }
            if (progWrap) progWrap.style.display = single ? 'none' : '';
            if (hint)     hint.style.display     = single ? 'none' : '';

            // Aktif nokta
            if (dotsWrap) {
                dotsWrap.querySelectorAll('.carousel-dot').forEach((d, i) => {
                    d.classList.toggle('active', i === page);
                });
            }

            // Görünmeyen kartlar tab sırasına girmesin
            const pvNow = perView();
            slides.forEach((s, i) => {
                const visible = i >= page * pvNow && i < page * pvNow + pvNow;
                s.querySelectorAll('a, button').forEach(el => {
                    if (visible) el.removeAttribute('tabindex');
                    else el.setAttribute('tabindex', '-1');
                });
            });
        }

        function goTo(i) {
            page = ((i % pageCount) + pageCount) % pageCount; // döngüsel
            apply();
        }
        const next = () => goTo(page + 1);
        const prev = () => goTo(page - 1);

        // ---- Otomatik geçiş (30 sn) ----
        function startProgress() {
            if (!progress || reduceMotion) return;
            progress.classList.remove('running');
            void progress.offsetWidth; // reflow — animasyonu baştan başlat
            progress.classList.add('running');
        }
        function stopProgress() {
            if (!progress) return;
            progress.classList.remove('running');
            progress.style.width = '0';
        }
        function startAuto() {
            stopAuto();
            if (pageCount <= 1 || paused || reduceMotion) return;
            startProgress();
            timer = setInterval(() => { next(); startProgress(); }, AUTOPLAY_MS);
        }
        function stopAuto() {
            if (timer) { clearInterval(timer); timer = null; }
            stopProgress();
        }
        function restart() { stopAuto(); startAuto(); }

        // ---- Olaylar ----
        if (nextBtn) nextBtn.addEventListener('click', () => { next(); restart(); });
        if (prevBtn) prevBtn.addEventListener('click', () => { prev(); restart(); });

        // Fare üzerindeyken dur
        root.addEventListener('mouseenter', () => { paused = true;  stopAuto(); });
        root.addEventListener('mouseleave', () => { paused = false; startAuto(); });
        root.addEventListener('focusin',    () => { paused = true;  stopAuto(); });
        root.addEventListener('focusout',   (e) => {
            if (!root.contains(e.relatedTarget)) { paused = false; startAuto(); }
        });

        // Sekme arka plandayken boşa dönmesin
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) stopAuto(); else if (!paused) startAuto();
        });

        // Klavye okları
        root.addEventListener('keydown', e => {
            if (e.key === 'ArrowRight') { next(); restart(); }
            if (e.key === 'ArrowLeft')  { prev(); restart(); }
        });

        // Dokunmatik kaydırma
        let touchX = null;
        viewport.addEventListener('touchstart', e => {
            touchX = e.touches[0].clientX; paused = true; stopAuto();
        }, { passive: true });
        viewport.addEventListener('touchend', e => {
            if (touchX === null) return;
            const dx = e.changedTouches[0].clientX - touchX;
            if (Math.abs(dx) > 45) { dx < 0 ? next() : prev(); }
            touchX = null; paused = false; restart();
        }, { passive: true });

        // Pencere boyutu değişince yeniden hesapla
        let rt = null;
        window.addEventListener('resize', () => {
            clearTimeout(rt);
            rt = setTimeout(() => { recalc(); restart(); }, 150);
        });

        recalc();
        startAuto();
    }
})();
</script>
}
