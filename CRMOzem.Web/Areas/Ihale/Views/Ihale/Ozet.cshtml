                                    <td class="text-right font-mono">@k.ToplamSUT.ToString("N2")</td>
                                    <td class="text-right font-mono"><strong>@k.ToplamSutFiyat.ToString("N2")</strong></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            @* Birim bazlı ara toplamlar *@
                            @foreach (var birimGrup in Model.Ihale.IhaleKalemler
                                                .Where(k => k.BirimId != null)
                                                .GroupBy(k => new { k.BirimId, Kod = k.Birim == null ? null : k.Birim.BirimKodu })
                                                .OrderBy(g => g.Key.Kod))
