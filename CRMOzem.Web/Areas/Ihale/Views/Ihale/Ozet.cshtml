                                    <td class="text-right font-mono" style="color:#4a5568;">@birimGrup.Sum(k => k.TestMiktari).ToString("N0")</td>
                                    <td></td>
                                    <td></td>
                                    <td class="text-right font-mono" style="color:#4a5568;">@birimGrup.Sum(k => k.ToplamSUT).ToString("N2")</td>
                                    <td class="text-right font-mono" style="color:#4a5568;">@birimGrup.Sum(k => k.ToplamSutFiyat).ToString("N2")</td>
                                </tr>
                            }
                            @* Genel toplam *@
                            <tr>
                                <td colspan="4"><strong>GENEL TOPLAM</strong></td>
                                <td class="text-right font-mono"><strong>@toplamTestMiktari.ToString("N0")</strong></td>
                                <td></td>
                                <td></td>
                                <td class="text-right font-mono"><strong>@toplamSutPuan.ToString("N2")</strong></td>
                                <td class="text-right font-mono"><strong>@Model.ToplamSutFiyat.ToString("N2") ₺</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }

    </div><!-- /accordion-body -->
</div>

<!-- ═══════════════════════════════════════════════════════════════
     STİLLER
══════════════════════════════════════════════════════════════ -->
