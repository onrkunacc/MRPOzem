@model OzetViewModel
@{
    ViewData["Title"] = "Maliyet Özeti";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Kalemlerden türetilen toplamlar
    var toplamTestMiktari = Model.Ihale.IhaleKalemler.Sum(k => k.TestMiktari);
    var toplamSutPuan     = Model.Ihale.IhaleKalemler.Sum(k => k.ToplamSUT);

    // Birim bazlı test / puan — Birim Bazlı Özet tablosunda eşleştirmek için
    var kalemBirimMap = Model.Ihale.IhaleKalemler
        .GroupBy(k => k.Birim?.BirimKodu ?? "-")
        .ToDictionary(
            g => g.Key,
            g => new
            {
                Test = g.Sum(x => x.TestMiktari),
                Puan = g.Sum(x => x.ToplamSUT)
            });
}
<link rel="stylesheet" href="~/css/tendercss.css" />

<style>
    /* ══ KISIM BAZLI ÖZET ══════════════════════════════════════ */
    .badge-kisim {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 6px;
        background: #eef2ff;
        color: #4338ca;
        border: 1px solid #c7d2fe;
        font-size: 11.5px;
        font-weight: 700;
        white-space: nowrap;
    }

        .badge-kisim.ortak {
            background: #f3f4f6;
            color: #6b7280;
            border-color: #e5e7eb;
            border-style: dashed;
        }

    .kisim-bos td { color: #a0aec0; background: #fcfcfd; }

    .kisim-tanim-disi td { background: #fff5f5; }

    .kisim-ortak-row td {
        background: #f8f9fc;
        border-top: 1px solid #e3e8f0;
    }

    .kisim-etiket-uyari {
        margin-left: 6px;
        font-size: 10.5px;
        font-weight: 700;
        color: #b91c1c;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .kisim-etiket-bos {
        margin-left: 6px;
        font-size: 10.5px;
        color: #a0aec0;
    }

    .kisim-pay {
        display: inline-block;
        padding: 1px 8px;
        border-radius: 999px;
        background: #eef2ff;
        color: #4338ca;
        font-size: 11.5px;
        font-weight: 700;
    }

    .kisim-uyari {
        margin: 0 0 14px;
        padding: 10px 14px;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 8px;
        color: #92400e;
        font-size: 12.5px;
        line-height: 1.55;
    }

    .kisim-bar-wrap { margin-top: 16px; }

    .kisim-bar {
        display: flex;
        height: 12px;
        border-radius: 999px;
        overflow: hidden;
        background: #f1f5f9;
        border: 1px solid #e3e8f0;
    }

    .kisim-bar-seg {
        height: 100%;
        background: #4338ca;
        border-right: 1px solid #fff;
    }

        .kisim-bar-seg:nth-child(2n) { background: #6366f1; }
        .kisim-bar-seg:nth-child(3n) { background: #818cf8; }
        .kisim-bar-seg:last-child { border-right: none; }
        .kisim-bar-seg.ortak { background: #cbd5e1; }

    .kisim-bar-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 9px;
        font-size: 11.5px;
        color: #4a5568;
    }

    .kisim-legend-item {
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

        .kisim-legend-item i {
            width: 9px;
            height: 9px;
            border-radius: 2px;
            background: #4338ca;
            display: inline-block;
        }

        .kisim-legend-item.ortak i { background: #cbd5e1; }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Maliyet Özeti</h1>
        <p class="page-sub">@Model.Ihale.IhaleAdi</p>
    </div>
    <div class="header-actions">
        <a asp-area="Ihale" asp-controller="Ihale" asp-action="ExcelIndir" asp-route-id="@Model.Ihale.Id"
           class="btn btn-outline" title="Excel İndir">
            📥 Excel
        </a>
        <a asp-area="Ihale" asp-controller="Ihale" asp-action="PdfIndir" asp-route-id="@Model.Ihale.Id"
           class="btn btn-outline" title="PDF İndir">
            📄 PDF
        </a>
        <button onclick="window.print()" class="btn btn-outline">🖨 Yazdır</button>
        <a asp-area="Ihale" asp-controller="Ihale" asp-action="Detail" asp-route-id="@Model.Ihale.Id" class="btn btn-ghost">← Detay</a>
    </div>
</div>

<!-- ── Üst Bilgi Kartları ─────────────────────────────────────────── -->
<div class="ozet-info-grid">
    <div class="info-card">
        <span class="info-label">İhale</span>
        <span class="info-value">@Model.Ihale.IhaleAdi</span>
    </div>
    <div class="info-card">
        <span class="info-label">Kayıt No</span>
        <span class="info-value">@(Model.Ihale.IhaleKayitNo ?? "—")</span>
    </div>
    <div class="info-card">
        <span class="info-label">İhale Tarihi</span>
        <span class="info-value">@(Model.Ihale.IhaleTarihi?.ToString("dd.MM.yyyy") ?? "—")</span>
    </div>
    <div class="info-card">
        <span class="info-label">Süre</span>
        <span class="info-value">@Model.Ihale.IhaleSuresiGun gün (@(Model.Ihale.IhaleSuresiGun / 30) ay)</span>
    </div>
    <div class="info-card">
        <span class="info-label">İhale Şekli</span>
        <span class="info-value">@(Model.Ihale.IhaleSekli ?? "HİZMET")</span>
    </div>
    <div class="info-card">
        <span class="info-label">Genel Gider Oranı</span>
        <span class="info-value">%@((Model.Ihale.GenelGiderOran * 100).ToString("0.##"))</span>
    </div>
    <div class="info-card">
        <span class="info-label">Şartname Kısım Sayısı</span>
        <span class="info-value">
            @Model.Ihale.KisimSayisi
            @if (Model.KisimKirilimiVar)
            {
                <text>(@Model.KisimOzetler.Count(x => x.KayitVar) kısımda veri var)</text>
            }
        </span>
    </div>
</div>

<!-- ── Kalem Özet Şeridi ──────────────────────────────────────────── -->
<div class="kalem-ozet-bar">
    <div class="kozet-item">
        <span class="kozet-label">Kalem Sayısı</span>
        <span class="kozet-value">@Model.Ihale.IhaleKalemler.Count</span>
    </div>
    <div class="kozet-item kozet-item--test">
        <span class="kozet-label">Toplam Test Miktarı</span>
        <span class="kozet-value">@toplamTestMiktari.ToString("N0")</span>
    </div>
    <div class="kozet-item kozet-item--puan">
        <span class="kozet-label">Toplam SUT Puanı</span>
        <span class="kozet-value">@toplamSutPuan.ToString("N2")</span>
    </div>
    <div class="kozet-item kozet-item--tutar">
        <span class="kozet-label">Toplam SUT Fiyat</span>
        <span class="kozet-value">@Model.ToplamSutFiyat.ToString("N2") ₺</span>
    </div>
    <div class="kozet-item kozet-item--oran">
        <span class="kozet-label">Maliyet / SUT Puanı</span>
        <span class="kozet-value">@Model.ToplamMaliyetSutPuani.ToString("N4")</span>
    </div>
</div>

<!-- ── Ana Grid: Maliyet + Grafik ────────────────────────────────── -->
<div class="ozet-main-grid">

    <!-- Maliyet Dökümü -->
    <div class="ozet-totals-card">
        <h3 class="card-section-title">📊 Maliyet Dökümü</h3>
        <div class="maliyet-rows">
            <div class="maliyet-row">
                <span class="maliyet-label"><span class="maliyet-dot" style="background:#3b82f6;"></span>Personel Toplam</span>
                <span class="amount">@Model.PersonelToplam.ToString("N2") ₺</span>
            </div>
            <div class="maliyet-row">
                <span class="maliyet-label"><span class="maliyet-dot" style="background:#10b981;"></span>Ek Gider Toplam</span>
                <span class="amount">@Model.EkGiderToplam.ToString("N2") ₺</span>
            </div>
            <div class="maliyet-row subtotal">
                <span class="maliyet-label">Ara Toplam</span>
                <span class="amount">@((Model.PersonelToplam + Model.EkGiderToplam).ToString("N2")) ₺</span>
            </div>
            <div class="maliyet-row">
                <span class="maliyet-label">
                    <span class="maliyet-dot" style="background:#f59e0b;"></span>
                    Genel Gider <span class="maliyet-badge">%@((Model.Ihale.GenelGiderOran * 100).ToString("0"))</span>
                </span>
                <span class="amount">@Model.GenelGider.ToString("N2") ₺</span>
            </div>
            <div class="maliyet-row">
                <span class="maliyet-label">
                    <span class="maliyet-dot" style="background:#8b5cf6;"></span>
                    Toplam SUT Fiyat <span class="maliyet-badge">Çarpanlı</span>
                </span>
                <span class="amount">@Model.ToplamSutFiyat.ToString("N2") ₺</span>
            </div>
            <div class="maliyet-row grand-total">
                <span class="maliyet-label">GENEL TOPLAM</span>
                <span class="amount">@Model.GenelToplam.ToString("N2") ₺</span>
            </div>
            <div class="maliyet-divider"></div>
            <div class="maliyet-row ratio">
                <span class="maliyet-label">Toplam Test Miktarı</span>
                <span class="amount">@toplamTestMiktari.ToString("N0")</span>
            </div>
            <div class="maliyet-row ratio">
                <span class="maliyet-label">Toplam SUT Puanı</span>
                <span class="amount">@Model.ToplamSutPuani.ToString("N2")</span>
            </div>
            <div class="maliyet-row ratio ratio-highlight">
                <span class="maliyet-label">Maliyet / SUT Puanı</span>
                <span class="amount">@Model.ToplamMaliyetSutPuani.ToString("N4")</span>
            </div>
        </div>
    </div>

    <!-- Donut Grafik -->
    <div class="ozet-bar-card">
        <h3 class="card-section-title">📈 Genel Dağılım</h3>
        @{
            var toplamMaliyet = Model.PersonelToplam + Model.EkGiderToplam + Model.GenelGider + Model.ToplamSutFiyat;
            var pPct = toplamMaliyet > 0 ? (double)(Model.PersonelToplam / toplamMaliyet * 100) : 0;
            var ePct = toplamMaliyet > 0 ? (double)(Model.EkGiderToplam / toplamMaliyet * 100) : 0;
            var gPct = toplamMaliyet > 0 ? (double)(Model.GenelGider / toplamMaliyet * 100) : 0;
            var sPct = toplamMaliyet > 0 ? (double)(Model.ToplamSutFiyat / toplamMaliyet * 100) : 0;
        }
        <div class="donut-wrap">
            <canvas id="ozetChart" width="200" height="200"></canvas>
            <div class="donut-center">
                <span class="donut-total-label">Toplam</span>
                <span class="donut-total-value">@toplamMaliyet.ToString("N0") ₺</span>
            </div>
        </div>
        <div class="chart-legend">
            <div class="chart-legend-item">
                <span class="chart-legend-dot" style="background:#3b82f6;"></span>
                <div class="chart-legend-info">
                    <span class="chart-legend-label">Personel</span>
                    <span class="chart-legend-pct">%@pPct.ToString("0.0")</span>
                </div>
                <span class="chart-legend-amount">@Model.PersonelToplam.ToString("N0") ₺</span>
            </div>
            <div class="chart-legend-item">
                <span class="chart-legend-dot" style="background:#10b981;"></span>
                <div class="chart-legend-info">
                    <span class="chart-legend-label">Ek Gider</span>
                    <span class="chart-legend-pct">%@ePct.ToString("0.0")</span>
                </div>
                <span class="chart-legend-amount">@Model.EkGiderToplam.ToString("N0") ₺</span>
            </div>
            <div class="chart-legend-item">
                <span class="chart-legend-dot" style="background:#f59e0b;"></span>
                <div class="chart-legend-info">
                    <span class="chart-legend-label">Genel Gider</span>
                    <span class="chart-legend-pct">%@gPct.ToString("0.0")</span>
                </div>
                <span class="chart-legend-amount">@Model.GenelGider.ToString("N0") ₺</span>
            </div>
            <div class="chart-legend-item">
                <span class="chart-legend-dot" style="background:#8b5cf6;"></span>
                <div class="chart-legend-info">
                    <span class="chart-legend-label">SUT Fiyat</span>
                    <span class="chart-legend-pct">%@sPct.ToString("0.0")</span>
                </div>
                <span class="chart-legend-amount">@Model.ToplamSutFiyat.ToString("N0") ₺</span>
            </div>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════════════════════════
   KISIM BAZLI ÖZET
   Kısma atanmamış satırlar kısımlara dağıtılmaz; "Ortak Giderler"
   satırında toplanır. Dip toplam = kısımlar + ortak = genel toplam.
══════════════════════════════════════════════════════════════════ *@
@if (Model.KisimKirilimiVar)
{
    <div class="section-card">
        <h3 class="card-section-title">📑 Kısım Bazlı Özet</h3>

        @if (Model.TanimDisiKisimVar)
        {
            <div class="kisim-uyari">
                <strong>Dikkat:</strong> Şartnamede @Model.Ihale.KisimSayisi kısım tanımlı,
                ancak veride bu aralığın dışında kısım numarası kullanılmış. İlgili satırlar
                aşağıda <em>tanım dışı</em> olarak işaretlendi; maliyetleri dip toplama dahildir.
            </div>
        }

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Kısım</th>
                        <th class="text-right">Kalem</th>
                        <th class="text-right">Test Miktarı</th>
                        <th class="text-right">SUT Puanı</th>
                        <th class="text-right">Personel (₺)</th>
                        <th class="text-right">Ek Gider (₺)</th>
                        <th class="text-right">Genel Gider (₺)</th>
                        <th class="text-right">SUT Fiyat (₺)</th>
                        <th class="text-right">Toplam Maliyet (₺)</th>
                        <th class="text-right">Pay</th>
                        <th class="text-right">Maliyet / SUT</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ks in Model.KisimOzetler)
                    {
                        <tr class="@(ks.KayitVar ? "" : "kisim-bos") @(ks.TanimDisi ? "kisim-tanim-disi" : "")">
                            <td>
                                <span class="badge-kisim">@ks.Ad</span>
                                @if (ks.TanimDisi)
                                {
                                    <span class="kisim-etiket-uyari">tanım dışı</span>
                                }
                                @if (!ks.KayitVar)
                                {
                                    <span class="kisim-etiket-bos">veri yok</span>
                                }
                            </td>
                            <td class="text-right font-mono">@(ks.KalemAdedi > 0 ? ks.KalemAdedi.ToString("N0") : "—")</td>
                            <td class="text-right font-mono">@(ks.TestMiktari > 0 ? ks.TestMiktari.ToString("N0") : "—")</td>
                            <td class="text-right font-mono">@(ks.ToplamSutPuani > 0 ? ks.ToplamSutPuani.ToString("N2") : "—")</td>
                            <td class="text-right font-mono">@(ks.PersonelTRY > 0 ? ks.PersonelTRY.ToString("N2") : "—")</td>
                            <td class="text-right font-mono">@(ks.EkGiderTRY > 0 ? ks.EkGiderTRY.ToString("N2") : "—")</td>
                            <td class="text-right font-mono">@(ks.GenelGider > 0 ? ks.GenelGider.ToString("N2") : "—")</td>
                            <td class="text-right font-mono">@(ks.ToplamSutFiyat > 0 ? ks.ToplamSutFiyat.ToString("N2") : "—")</td>
                            <td class="text-right font-mono"><strong>@ks.ToplamMaliyet.ToString("N2")</strong></td>
                            <td class="text-right font-mono">
                                @if (ks.KayitVar)
                                {
                                    <span class="kisim-pay">%@ks.PayYuzde.ToString("N1")</span>
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </td>
                            <td class="text-right font-mono">@(ks.MaliyetSutPuani > 0 ? ks.MaliyetSutPuani.ToString("N4") : "—")</td>
                        </tr>
                    }

                    @if (Model.OrtakGiderVar)
                    {
                        <tr class="kisim-ortak-row">
                            <td>
                                <span class="badge-kisim ortak">Ortak Giderler</span>
                                <span class="kisim-etiket-bos">kısımlara dağıtılmadı</span>
                            </td>
                            <td class="text-right font-mono">@(Model.OrtakOzet.KalemAdedi > 0 ? Model.OrtakOzet.KalemAdedi.ToString("N0") : "—")</td>
                            <td class="text-right font-mono">@(Model.OrtakOzet.TestMiktari > 0 ? Model.OrtakOzet.TestMiktari.ToString("N0") : "—")</td>
                            <td class="text-right font-mono">@(Model.OrtakOzet.ToplamSutPuani > 0 ? Model.OrtakOzet.ToplamSutPuani.ToString("N2") : "—")</td>
                            <td class="text-right font-mono">@(Model.OrtakOzet.PersonelTRY > 0 ? Model.OrtakOzet.PersonelTRY.ToString("N2") : "—")</td>
                            <td class="text-right font-mono">@(Model.OrtakOzet.EkGiderTRY > 0 ? Model.OrtakOzet.EkGiderTRY.ToString("N2") : "—")</td>
                            <td class="text-right font-mono">@(Model.OrtakOzet.GenelGider > 0 ? Model.OrtakOzet.GenelGider.ToString("N2") : "—")</td>
                            <td class="text-right font-mono">@(Model.OrtakOzet.ToplamSutFiyat > 0 ? Model.OrtakOzet.ToplamSutFiyat.ToString("N2") : "—")</td>
                            <td class="text-right font-mono"><strong>@Model.OrtakOzet.ToplamMaliyet.ToString("N2")</strong></td>
                            <td class="text-right font-mono"><span class="kisim-pay">%@Model.OrtakOzet.PayYuzde.ToString("N1")</span></td>
                            <td class="text-right font-mono">—</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td><strong>GENEL TOPLAM</strong></td>
                        <td class="text-right font-mono"><strong>@Model.Ihale.IhaleKalemler.Count.ToString("N0")</strong></td>
                        <td class="text-right font-mono"><strong>@toplamTestMiktari.ToString("N0")</strong></td>
                        <td class="text-right font-mono"><strong>@toplamSutPuan.ToString("N2")</strong></td>
                        <td class="text-right font-mono"><strong>@Model.PersonelToplam.ToString("N2")</strong></td>
                        <td class="text-right font-mono"><strong>@Model.EkGiderToplam.ToString("N2")</strong></td>
                        <td class="text-right font-mono"><strong>@Model.GenelGider.ToString("N2")</strong></td>
                        <td class="text-right font-mono"><strong>@Model.ToplamSutFiyat.ToString("N2")</strong></td>
                        <td class="text-right font-mono"><strong>@Model.GenelToplam.ToString("N2")</strong></td>
                        <td class="text-right font-mono"><strong>%100,0</strong></td>
                        <td class="text-right font-mono"><strong>@Model.ToplamMaliyetSutPuani.ToString("N4")</strong></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        @* Kısımların görsel payı *@
        @if (Model.GenelToplam > 0)
        {
            <div class="kisim-bar-wrap">
                <div class="kisim-bar">
                    @foreach (var ks in Model.KisimOzetler.Where(x => x.KayitVar))
                    {
                        <div class="kisim-bar-seg"
                             style="width:@(((double)(ks.ToplamMaliyet / Model.GenelToplam) * 100).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%;"
                             title="@ks.Ad — @ks.ToplamMaliyet.ToString("N2") ₺ (%@ks.PayYuzde.ToString("N1"))"></div>
                    }
                    @if (Model.OrtakGiderVar)
                    {
                        <div class="kisim-bar-seg ortak"
                             style="width:@(((double)(Model.OrtakOzet.ToplamMaliyet / Model.GenelToplam) * 100).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%;"
                             title="Ortak Giderler — @Model.OrtakOzet.ToplamMaliyet.ToString("N2") ₺"></div>
                    }
                </div>
                <div class="kisim-bar-legend">
                    @foreach (var ks in Model.KisimOzetler.Where(x => x.KayitVar))
                    {
                        <span class="kisim-legend-item"><i></i>@ks.KisaAd · %@ks.PayYuzde.ToString("N1")</span>
                    }
                    @if (Model.OrtakGiderVar)
                    {
                        <span class="kisim-legend-item ortak"><i></i>Ortak · %@Model.OrtakOzet.PayYuzde.ToString("N1")</span>
                    }
                </div>
            </div>
        }
    </div>
}

<!-- ── Birim Bazlı Özet ───────────────────────────────────────────── -->
<div class="section-card">
    <h3 class="card-section-title">🔬 Birim Bazlı Özet</h3>
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Birim Kodu</th>
                    <th>Birim Adı</th>
                    <th class="text-right">Test Miktarı</th>
                    <th class="text-right">SUT Puanı</th>
                    <th class="text-right">Personel (₺)</th>
                    <th class="text-right">Ek Gider (₺)</th>
                    <th class="text-right">SUT Fiyat (₺)</th>
                    <th class="text-right">Toplam Maliyet (₺)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.BirimOzetler)
                {
                    kalemBirimMap.TryGetValue(b.BirimKodu ?? "-", out var km);
                    <tr>
                        <td><span class="badge-birim">@b.BirimKodu</span></td>
                        <td>@b.BirimAdi</td>
                        <td class="text-right font-mono">@(km != null ? km.Test.ToString("N0") : "—")</td>
                        <td class="text-right font-mono">@(km != null ? km.Puan.ToString("N2") : "—")</td>
                        <td class="text-right font-mono">@b.PersonelTRY.ToString("N2")</td>
                        <td class="text-right font-mono">@b.EkGiderTRY.ToString("N2")</td>
                        <td class="text-right font-mono">@b.ToplamSUT.ToString("N2")</td>
                        <td class="text-right font-mono">@b.ToplamMaliyet.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="2"><strong>GENEL TOPLAM</strong></td>
                    <td class="text-right font-mono"><strong>@toplamTestMiktari.ToString("N0")</strong></td>
                    <td class="text-right font-mono"><strong>@toplamSutPuan.ToString("N2")</strong></td>
                    <td class="text-right font-mono"><strong>@Model.BirimOzetler.Sum(b => b.PersonelTRY).ToString("N2")</strong></td>
                    <td class="text-right font-mono"><strong>@Model.BirimOzetler.Sum(b => b.EkGiderTRY).ToString("N2")</strong></td>
                    <td class="text-right font-mono"><strong>@Model.BirimOzetler.Sum(b => b.ToplamSUT).ToString("N2")</strong></td>
                    <td class="text-right font-mono"><strong>@Model.BirimOzetler.Sum(b => b.ToplamMaliyet).ToString("N2")</strong></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════
     DETAYLI ÖZET (Accordion)
══════════════════════════════════════════════════════════════════ -->
<div class="section-card" style="padding:0; overflow:hidden;">

    <!-- Accordion başlık -->
    <button type="button" class="accordion-header" onclick="toggleAccordion()" id="accordionBtn">
        <span>📋 Detaylı Özet — Personel, Ek Giderler ve Kalemler</span>
        <span class="accordion-arrow" id="accordionArrow">▼</span>
    </button>

    <div class="accordion-body" id="accordionBody">

        <!-- ── Personel ──────────────────────────────────────────── -->
        @if (Model.Ihale.PersonelGiderler.Any())
        {
            <div class="detail-section">
                <div class="detail-section-header">
                    <span>👤 Personel Giderleri</span>
                    <span class="detail-section-total">
                        @Model.Ihale.PersonelGiderler.Count kayıt — Toplam: @Model.PersonelToplam.ToString("N2") ₺
                    </span>
                </div>
                <div class="table-wrap">
                    <table class="data-table detail-table">
                        <thead>
                            <tr>
                                <th>Birim</th>
                                <th>Görev / Unvan</th>
                                <th>Sayı</th>
                                <th>Eğitim</th>
                                <th>Ücret Tipi</th>
                                <th class="text-right">Aylık Brüt (₺)</th>
                                <th class="text-right">Süre (gün)</th>
                                <th class="text-right">Toplam (₺)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Ihale.PersonelGiderler)
                            {
                                <tr>
                                    <td><span class="badge-birim">@(p.Birim?.BirimKodu ?? "-")</span></td>
                                    <td>@p.GorevUnvan</td>
                                    <td>@p.Sayi</td>
                                    <td>@(p.EgitimDurumu ?? "-")</td>
                                    <td><span class="tag">@p.UcretTipi</span></td>
                                    <td class="text-right font-mono">@p.BirimFiyatAylik.ToString("N2")</td>
                                    <td class="text-right">@Model.Ihale.IhaleSuresiGun</td>
                                    <td class="text-right font-mono"><strong>@p.ToplamTRY.ToString("N2")</strong></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="7"><strong>TOPLAM</strong></td>
                                <td class="text-right font-mono"><strong>@Model.PersonelToplam.ToString("N2") ₺</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }

        <!-- ── Ek Giderler ───────────────────────────────────────── -->
        @if (Model.Ihale.EkGiderler.Any())
        {
            <div class="detail-section">
                <div class="detail-section-header">
                    <span>💼 Ek Giderler</span>
                    <span class="detail-section-total">
                        @Model.Ihale.EkGiderler.Count kayıt — Toplam: @Model.EkGiderToplam.ToString("N2") ₺
                    </span>
                </div>
                <div class="table-wrap">
                    <table class="data-table detail-table">
                        <thead>
                            <tr>
                                <th>Birim</th>
                                <th>Gider Adı</th>
                                <th>Kategori</th>
                                <th class="text-right">Miktar</th>
                                <th class="text-right">Birim Fiyat</th>
                                <th>Para Birimi</th>
                                <th class="text-right">Kur</th>
                                <th class="text-right">Tutar (₺)</th>
                                <th>Açıklama</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in Model.Ihale.EkGiderler)
                            {
                                <tr>
                                    <td><span class="badge-birim">@(e.Birim?.BirimKodu ?? "-")</span></td>
                                    <td>@e.GiderAdi</td>
                                    <td>@(e.Kategori ?? "-")</td>
                                    <td class="text-right font-mono">@e.Miktar.ToString("N4")</td>
                                    <td class="text-right font-mono">@e.BirimFiyat.ToString("N4")</td>
                                    <td><span class="tag">@e.ParaBirimi</span></td>
                                    <td class="text-right font-mono">@e.Kur.ToString("N4")</td>
                                    <td class="text-right font-mono"><strong>@e.TutarTRY.ToString("N2")</strong></td>
                                    <td style="color:#a0aec0; font-size:.8rem;">@(e.Aciklama ?? "-")</td>
