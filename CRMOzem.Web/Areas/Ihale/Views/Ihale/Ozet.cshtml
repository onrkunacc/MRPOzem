        }

    @@media print {
        .kalem-ozet-bar { break-inside: avoid; }
    }
</style>

<!-- ═══════════════════════════════════════════════════════════════
     SCRIPT
══════════════════════════════════════════════════════════════ -->
<script>
    // ── Accordion ───────────────────────────────────────────────────────
    function toggleAccordion() {
        const body  = document.getElementById('accordionBody');
        const arrow = document.getElementById('accordionArrow');
        const isOpen = body.classList.contains('open');
        body.classList.toggle('open', !isOpen);
        arrow.classList.toggle('open', !isOpen);
    }

    // ── Donut Grafik ────────────────────────────────────────────────────
    (function () {
        const canvas = document.getElementById('ozetChart');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');

        const data = [
            { label: 'Personel',    value: @Model.PersonelToplam.ToString("F2", System.Globalization.CultureInfo.InvariantCulture),  color: '#3b82f6' },
            { label: 'Ek Gider',    value: @Model.EkGiderToplam.ToString("F2", System.Globalization.CultureInfo.InvariantCulture),   color: '#10b981' },
            { label: 'Genel Gider', value: @Model.GenelGider.ToString("F2", System.Globalization.CultureInfo.InvariantCulture),      color: '#f59e0b' },
            { label: 'SUT Fiyat',   value: @Model.ToplamSutFiyat.ToString("F2", System.Globalization.CultureInfo.InvariantCulture),  color: '#8b5cf6' },
        ];

        const total = data.reduce((s, d) => s + d.value, 0);
        if (total <= 0) {
            ctx.fillStyle = '#e3e8f0';
            ctx.beginPath();
            ctx.arc(100, 100, 85, 0, Math.PI * 2);
            ctx.fill();
            return;
        }

        const cx = 100, cy = 100, r = 85, inner = 52;
        let angle = -Math.PI / 2;
        const slices = [];

        data.forEach(d => {
            if (d.value <= 0) return;
            const sweep = (d.value / total) * Math.PI * 2;
            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.arc(cx, cy, r, angle, angle + sweep);
            ctx.closePath();
            ctx.fillStyle = d.color;
            ctx.fill();
            ctx.strokeStyle = '#fff';
            ctx.lineWidth = 2.5;
            ctx.stroke();
            slices.push({ start: angle, end: angle + sweep, ...d });
            angle += sweep;
        });

        // Delik
        ctx.beginPath();
        ctx.arc(cx, cy, inner, 0, Math.PI * 2);
        ctx.fillStyle = '#fff';
        ctx.fill();

        // Tooltip
        canvas.addEventListener('mousemove', function (e) {
            const rect = canvas.getBoundingClientRect();
            const mx = e.clientX - rect.left;
            const my = e.clientY - rect.top;
            const dx = mx - cx, dy = my - cy;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < inner || dist > r) { canvas.title = ''; return; }
            let a = Math.atan2(dy, dx) - (-Math.PI / 2);
            if (a < 0) a += Math.PI * 2;
            for (const s of slices) {
                let end = s.end;
                if (s.start > s.end) end += Math.PI * 2;
                let aa = a;
                if (s.start < 0 && aa > Math.PI) aa -= Math.PI * 2;
                if (aa >= s.start && aa <= end) {
                    const pct = (s.value / total * 100).toFixed(1);
                    canvas.title = `${s.label}: ${s.value.toLocaleString('tr-TR', {minimumFractionDigits:2})} ₺ (%${pct})`;
                    return;
                }
            }
            canvas.title = '';
        });
    })();
</script>
