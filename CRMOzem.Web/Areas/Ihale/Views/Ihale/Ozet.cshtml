        {
            <div class="detail-section">
                <div class="detail-section-header">
                    <span>🔬 İhale Kalemleri</span>
                    <span class="detail-section-total">
                        @Model.Ihale.IhaleKalemler.Count kalem —
                        @toplamTestMiktari.ToString("N0") test —
                        @toplamSutPuan.ToString("N2") puan —
                        @Model.ToplamSutFiyat.ToString("N2") ₺
                    </span>
                </div>
                <div class="table-wrap">
                    <table class="data-table detail-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Birim</th>
                                <th>SUT Kodu</th>
                                <th>Tetkik Adı</th>
                                <th class="text-right">Test Miktarı</th>
                                <th class="text-right">SUT Fiyat</th>
                                <th class="text-right">SUT Çarpan</th>
                                <th class="text-right">Toplam SUT</th>
                                <th class="text-right">Toplam SUT Fiyat</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var k in Model.Ihale.IhaleKalemler.OrderBy(x => x.SiraNo))
                            {
                                <tr>
                                    <td>@k.SiraNo</td>
                                    <td><span class="badge-birim">@(k.Birim?.BirimKodu ?? "-")</span></td>
                                    <td>@(k.SutKodu ?? "-")</td>
                                    <td>@k.TetkikAdi</td>
                                    <td class="text-right font-mono">@k.TestMiktari.ToString("N0")</td>
                                    <td class="text-right font-mono">@k.SutFiyat.ToString("N4")</td>
