@model BillingCycleReportViewModel

@{
    ViewData["Title"] = "Ekstre Rapor Detayı";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <h2 class="text-center text-primary">
        @ViewBag.UserName - @Model.MonthName @Model.Year Ekstre Detayı
    </h2>
    <hr />

    <div class="alert alert-info text-center">
        <h5 class="fw-bold">📊 Toplam Tutar: <span class="text-success">@Model.TotalAmount.ToString("C")</span></h5>
    </div>

    @if (Model.ExpenseDetails != null && Model.ExpenseDetails.Any())
    {
        <table class="table table-hover shadow-sm">
            <thead class="table-dark text-white text-center">
                <tr>
                    <th>Tarih</th>
                    <th>Kategori</th>
                    <th>Açıklama</th>
                    <th>Ödeme Yöntemi</th>
                    <th>Tutar (₺)</th>
                </tr>
            </thead>
            <tbody class="text-center">
                @foreach (var item in Model.ExpenseDetails.OrderBy(d => d.Date))
                {
                    <tr>
                        <td>@item.Date.ToString("dd.MM.yyyy")</td>
                        <td>@item.Category</td>
                        <td>@item.Description</td>
                        <td>@item.PaymentMethod</td>
                        <td>@item.Amount.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-warning text-center">
            Bu döneme ait masraf kaydı bulunmamaktadır.
        </div>
    }

    <div class="text-center mt-4">
        <a href="@Url.Action("Index", "AdminBillingCycle", new { area = "Admin" })" class="btn btn-outline-secondary">
            ⬅️ Geri Dön
        </a>
    </div>
</div>

