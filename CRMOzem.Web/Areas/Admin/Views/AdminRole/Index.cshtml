@model List<IdentityRole>
@{
    ViewData["Title"] = "Rol Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header text-white text-center">
            <h3 class="mb-0">Rol Yönetimi</h3>
        </div>

        <div class="card-body">
            <a href="@Url.Action("Create", "AdminRole")" class="btn btn-primary mb-3">
                <i class="fas fa-plus"></i> Yeni Rol Ekle
            </a>

            <div class="table-responsive">
                <table class="table table-bordered align-middle text-center">
                    <thead class="bg-secondary text-white">
                        <tr>
                            <th>Rol Adı</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in Model)
                        {
                            <tr>
                                <td class="fw-bold">@role.Name</td>
                                <td>
                                    <button type="button" class="btn btn-danger btn-sm px-3" onclick="deleteRole('@role.Id')">
                                        <i class="fas fa-trash"></i> Sil
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    function deleteRole(roleId) {
        if (!confirm("Bu rolü silmek istediğinizden emin misiniz?")) {
            return;
        }

        fetch(`/Admin/AdminRole/Delete/${roleId}`, {
            method: "DELETE",
            headers: {
                "Content-Type": "application/json",
                "X-Requested-With": "XMLHttpRequest"
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
                location.reload();
            } else {
                alert("Silme işlemi başarısız oldu: " + data.message);
            }
        })
        .catch(error => console.error("Silme hatası:", error));
    }
</script>
