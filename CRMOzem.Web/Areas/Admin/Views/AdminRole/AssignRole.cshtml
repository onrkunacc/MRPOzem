@model ApplicationUser
@{
    ViewData["Title"] = "Rol Ata";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var roles = ViewBag.Roles as List<IdentityRole>;
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header text-white text-center">
            <h3 class="mb-0">@Model.FullName Kullanıcısına Rol Ata</h3>
        </div>

        <div class="card-body">
            <form asp-action="AssignRole" method="post">
                <input type="hidden" name="userId" value="@Model.Id">

                <div class="mb-3">
                    <label class="form-label">Rol Seç</label>
                    <select name="role" class="form-control">
                        @foreach (var role in roles)
                        {
                            <option value="@role.Name">@role.Name</option>
                        }
                    </select>
                </div>

                <!-- Butonlar -->
                <div class="text-center mt-3">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="fas fa-user-tag"></i> Rol Ata
                    </button>
                    <a href="@Url.Action("Index", "AdminUser")" class="btn btn-outline-secondary px-4">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>
