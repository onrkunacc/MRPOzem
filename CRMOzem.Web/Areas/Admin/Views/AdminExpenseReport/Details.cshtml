@model CRMOzem.Core.ViewModels.ExpenseReportViewModel
@{
    ViewData["Title"] = $"{Model.MonthYear.ToString("MMMM yyyy")} Masraf Detayları";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4"> 
    <h2 class="text-center font-weight-bold">@Model.MonthYear.ToString("MMMM yyyy") Masraf Raporu</h2>
    <hr />

   <h4 class="text-left text-dark font-weight-bold">Rapor Sahibi : @Model.UserName</h4>

    <table class="table table-striped table-hover mt-3">
        <thead class="bg-dark text-white">
            <tr>
                <th>Tarih</th>
                <th>Kategori</th>
                <th>Açıklama</th>
                <th>Ödeme Yöntemi</th>
                <th class="text-right">Tutar (₺)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var detail in Model.ExpenseDetails.OrderBy(d => d.Date))
            {
                <tr>
                    <td>@detail.Date.ToString("dd.MM.yyyy")</td>
                    <td>@detail.Category</td>
                    <td>@detail.Description</td>
                    <td>@detail.PaymentMethod</td>
                    <td class="text-right">@detail.Amount.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>

    <h4 class="text-right text-danger font-weight-bold">
        Toplam Tutar : @Model.TotalAmount.ToString("C")
    </h4>
    <!-- Geri Dön Butonu -->
    <div class="text-center mt-4">
        <a href="@Url.Action("Index", "AdminExpenseReport")" class="btn btn-secondary">
            <i class="fa fa-arrow-left"></i> Geri Dön
        </a>
    </div>
</div>

