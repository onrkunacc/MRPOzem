@model AdminExpenseDetailsVm
@using System.Globalization

@{
    ViewData["Title"] = $"{Model.UserName} - {Model.MonthYear:MMMM yyyy} Detay";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var tr = CultureInfo.GetCultureInfo("tr-TR");
    var initials = string.Concat((Model.UserName ?? "??")
        .Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2).Select(x => x[0]));
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin-expense.css" asp-append-version="true" />

<div class="ad-wrapper">

    <!-- ═══ ÜST BAŞLIK ═══ -->
    <div class="ad-greeting" style="display:flex; align-items:center; gap:1rem; flex-wrap:wrap;">
        <div class="user-avatar-lg">@initials</div>
        <div style="flex:1;">
            <h1>@Model.UserName</h1>
            <p>@Model.MonthYear.ToString("MMMM yyyy", tr) — Masraf detayları</p>
        </div>
        <a href="@Url.Action("Index")" class="btn-detail-back">
            <i class="fe fe-arrow-left"></i> Listeye Dön
        </a>
    </div>

    <!-- ═══ KPI ŞERİT ═══ -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-6 col-xl-3">
            <div class="kpi-card kpi-primary">
                <div class="kpi-icon">💰</div>
                <div class="kpi-label">Toplam Tutar</div>
                <div class="kpi-value">@Model.Toplam.ToString("N0", tr) ₺</div>
                <div class="kpi-sub">Tüm masraflar</div>
            </div>
        </div>
        <div class="col-6 col-md-6 col-xl-3">
            <div class="kpi-card kpi-success">
                <div class="kpi-icon">🔢</div>
                <div class="kpi-label">İşlem Sayısı</div>
                <div class="kpi-value">@Model.IslemSayisi</div>
                <div class="kpi-sub">masraf kalemi</div>
            </div>
        </div>
        <div class="col-6 col-md-6 col-xl-3">
            <div class="kpi-card kpi-info">
                <div class="kpi-icon">📊</div>
                <div class="kpi-label">Ortalama İşlem</div>
                <div class="kpi-value">@Model.OrtalamaIslem.ToString("N0", tr) ₺</div>
                <div class="kpi-sub">işlem başına</div>
            </div>
        </div>
        <div class="col-6 col-md-6 col-xl-3">
            <div class="kpi-card kpi-warning">
                <div class="kpi-icon">💎</div>
                <div class="kpi-label">En Yüksek İşlem</div>
                @if (Model.EnYuksek != null)
                {
                    <div class="kpi-value">@Model.EnYuksek.Tutar.ToString("N0", tr) ₺</div>
                    <div class="kpi-sub" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                        @Model.EnYuksek.Kategori
                    </div>
                }
                else
                {
                    <div class="kpi-value">—</div>
                    <div class="kpi-sub">Veri yok</div>
                }
            </div>
        </div>
    </div>

    <!-- ═══ KATEGORİ DAĞILIM ═══ -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-xl-5">
            <div class="glass-card no-hover">
                <div class="section-title">
                    <h5>🥧 Kategori Dağılımı</h5>
                </div>
                <div id="categoryDonut" style="min-height: 280px;"></div>
            </div>
        </div>
        <div class="col-12 col-xl-7">
            <div class="glass-card no-hover">
                <div class="section-title">
                    <h5>📂 Kategori Detayı</h5>
                </div>
                @if (Model.KategoriDagilim.Any())
                {
                    <div class="category-list">
                        @foreach (var c in Model.KategoriDagilim)
                        {
                            <div class="category-row">
                                <div class="category-info">
                                    <div class="category-name">@c.Kategori</div>
                                    <div class="category-meta">@c.IslemSayisi işlem</div>
                                </div>
                                <div class="category-bar-wrap">
                                    <div class="category-bar" style="width: @c.Yuzde%;"></div>
                                </div>
                                <div class="category-amount">
                                    <div class="fw-bold">@c.Toplam.ToString("N0", tr) ₺</div>
                                    <div class="text-muted small">%@c.Yuzde.ToString("N1", tr)</div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <div class="icon">📭</div>
                        <div>Kategori verisi yok.</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ═══ DETAY TABLO ═══ -->
    <div class="glass-card no-hover">
        <div class="section-title">
            <h5>📜 Masraf Detayları</h5>
            <span class="badge-soft">@Model.Detaylar.Count kayıt</span>
        </div>

        @if (Model.Detaylar.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle ae-table">
                    <thead>
                        <tr>
                            <th>Tarih</th>
                            <th>Kategori</th>
                            <th>Açıklama</th>
                            <th>Ödeme</th>
                            <th class="text-end">Tutar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Detaylar)
                        {
                            <tr class="@(d.YuksekRank.HasValue ? "row-highlight" : "")">
                                <td>@d.Tarih.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <span class="category-chip">@d.Kategori</span>
                                </td>
                                <td>
                                    @d.Aciklama
                                    @if (d.YuksekRank.HasValue)
                                    {
                                        var rankClass = d.YuksekRank.Value switch
                                        {
                                            1 => "top-rank-1",
                                            2 => "top-rank-2",
                                            _ => "top-rank-3"
                                        };
                                        <span class="top-rank-badge @rankClass">TOP @d.YuksekRank</span>
                                    }
                                </td>
                                <td>@d.OdemeYontemi</td>
                                <td class="text-end fw-semibold">@d.Tutar.ToString("N2", tr) ₺</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="text-end fw-bold">GENEL TOPLAM</td>
                            <td class="text-end fw-bold text-primary">@Model.Toplam.ToString("N2", tr) ₺</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="icon">📭</div>
                <div>Bu raporda detay yok.</div>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script>
        (function () {
            const categories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            Model.KategoriDagilim.Select(c => new { name = c.Kategori, val = c.Toplam })
                    ));

            if (categories.length > 0) {
                new ApexCharts(document.querySelector('#categoryDonut'), {
                    chart: { type: 'donut', height: 280, fontFamily: 'inherit' },
                    series: categories.map(x => x.val),
                    labels: categories.map(x => x.name),
                    colors: ['#667eea', '#764ba2', '#f093fb', '#f5576c', '#4facfe',
                             '#00f2fe', '#11998e', '#38ef7d', '#fa709a', '#fee140'],
                    legend: { position: 'bottom', fontSize: '11px', markers: { width: 10, height: 10 } },
                    dataLabels: { enabled: false },
                    plotOptions: {
                        pie: {
                            donut: {
                                size: '62%',
                                labels: {
                                    show: true,
                                    value: { fontSize: '16px', fontWeight: 700, color: '#1a202c',
                                        formatter: v => new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 }).format(v) + ' ₺' },
                                    total: {
                                        show: true, label: 'Toplam', fontSize: '11px',
                                        formatter: w => new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 })
                                            .format(w.globals.seriesTotals.reduce((a, b) => a + b, 0)) + ' ₺'
                                    }
                                }
                            }
                        }
                    },
                    tooltip: {
                        y: { formatter: v => new Intl.NumberFormat('tr-TR').format(v) + ' ₺' }
                    }
                }).render();
            } else {
                document.querySelector('#categoryDonut').innerHTML =
                    '<div class="empty-state" style="padding-top:60px;"><div class="icon">📭</div><div>Veri yok</div></div>';
            }
        })();
    </script>
}