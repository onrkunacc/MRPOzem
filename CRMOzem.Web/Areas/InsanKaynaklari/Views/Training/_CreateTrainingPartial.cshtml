@model TrainingCreateViewModel

<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-4">
            <div class="modal-header bg-gradient-green text-white">
                <h5 class="modal-title d-flex align-items-center gap-2">
                    <i class="bi bi-plus-circle"></i> Yeni Eğitim Oluştur
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <!-- FORM ALANI: ID/NAME/CLASS/INPUT’LAR AYNI KALDI -->
                <form asp-area="InsanKaynaklari" asp-controller="Training" asp-action="Create" method="post" id="trainingForm">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Eğitim Başlığı</label>
                            <input type="text" name="Title" class="form-control form-control-lg" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tarih</label>
                            <input type="date" name="TrainingDate" class="form-control form-control-lg" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Açıklama</label>
                            <textarea name="Description" class="form-control" rows="3" placeholder="Eğitim hakkında kısa açıklama..."></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Google Drive Linki</label>
                            <input type="url" name="Link" class="form-control" placeholder="https://drive.google.com/..." required />
                        </div>

                        <!-- Kullanıcı seçimi: ID/btn/id’ler KORUNDU -->
                        <div class="col-12 mt-4">
                            <label class="form-label fw-semibold fs-5">Eğitim Alacak Kullanıcılar</label>
                            <div class="card shadow-sm border-0">
                                <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-md-5">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <input type="text" id="userSearch" class="form-control form-control-sm w-75" placeholder="🔍 Kullanıcı ara..." />
                                                <button type="button" id="selectAll" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-check2-all"></i> Tümünü Seç
                                                </button>
                                            </div>
                                            <ul id="availableUsers" class="list-group border rounded list-scroll">
                                                @foreach (var u in Model.AvailableUsers ?? new List<SelectListItem>())
                                                {
                                                    <li class="list-group-item d-flex align-items-center user-item" data-id="@u.Value" style="cursor:pointer;">
                                                        <input type="checkbox" class="form-check-input me-2 user-checkbox" />
                                                        <span class="user-name flex-grow-1">@u.Text</span>
                                                    </li>
                                                }
                                            </ul>
                                        </div>

                                        <div class="col-md-2 d-flex flex-column align-items-center justify-content-center gap-2">
                                            <button type="button" id="btnAddSelected" class="btn btn-success w-75">
                                                <i class="bi bi-arrow-right-circle"></i> Aktar
                                            </button>
                                            <button type="button" id="btnRemoveSelected" class="btn btn-danger w-75">
                                                <i class="bi bi-arrow-left-circle"></i> Geri Al
                                            </button>
                                        </div>

                                        <div class="col-md-5">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="fw-semibold text-success">Seçilen Kullanıcılar</span>
                                                <button type="button" id="clearAll" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-x-circle"></i> Tümünü Kaldır
                                                </button>
                                            </div>
                                            <ul id="selectedUsers" class="list-group border rounded list-scroll"></ul>
                                            <small class="text-muted mt-2 d-block" id="selectedCount">0 kullanıcı seçildi</small>
                                        </div>
                                    </div>

                                    <input type="hidden" id="SelectedUserIdsString" name="SelectedUserIdsString" />
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 form-check mt-3">
                            <input type="checkbox" name="IsPublished" class="form-check-input" id="isPublishedCheck" />
                            <label for="isPublishedCheck" class="form-check-label">Yayınla</label>
                        </div>

                        <div class="col-12 mt-4">
                            <h5 class="fw-bold text-primary"><i class="bi bi-ui-checks"></i> Eğitim Sınavı</h5>
                            <p class="text-muted small mb-3">Eğitim içeriğine dayalı sınav sorularını ekleyiniz.</p>

                            <div id="questions-container" class="d-flex flex-column gap-3"></div>

                            <div class="text-end mt-3">
                                <button type="button" id="add-question-btn" class="btn btn-outline-success">
                                    <i class="bi bi-plus-circle"></i> Soru Ekle
                                </button>
                            </div>
                        </div>
                    </div>

                    <input type="hidden" id="SelectedUserIdsString" name="SelectedUserIdsString" />
                    <div class="text-end mt-4">
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-check2"></i> Kaydet
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>