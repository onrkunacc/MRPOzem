@model HrTrainingListViewModel

@{
    ViewData["Title"] = "Eğitimler";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/HrTrainingList.css" />

<div class="container-fluid py-3 py-md-4">
    <div class="page-header d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 text-center text-md-start">
        <div>
            <h2 class="mb-1">📘 Eğitim Listesi</h2>
            <p class="text-muted mb-0">Yayın durumunu yönetin, içerikleri düzenleyin.</p>
        </div>
        <button id="openCreateModal" class="btn btn-primary mt-2 mt-md-0 px-4 py-2 shadow-sm">
            <i class="bi bi-plus-circle"></i> Yeni Eğitim
        </button>
    </div>

    @if (Model.Trainings == null || !Model.Trainings.Any())
    {
        <div class="alert alert-info text-center shadow-sm w-75 mx-auto mt-4">
            Henüz herhangi bir eğitim bulunmamaktadır.
        </div>
    }
    else
    {
        <div class="training-grid mt-3">
            @foreach (var t in Model.Trainings)
            {
                <div class="card training-card shadow-sm border-0">
                    <div class="card-body d-flex flex-column gap-3">
                        <div>
                            <div class="d-flex align-items-start justify-content-between gap-3">
                                <h5 class="card-title mb-0">@t.Title</h5>
                                <div class="status-chip">
                                    <span class="dot @(t.IsPublished ? "dot-published" : "dot-draft")"></span>
                                    <span>@(t.IsPublished ? "Yayınlandı" : "Taslak")</span>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(t.Description))
                            {
                                <p class="text-muted mt-2 mb-0 line-clamp-2">@t.Description</p>
                            }

                            <p class="mt-3 mb-0 d-flex align-items-center gap-2 text-secondary">
                                <i class="bi bi-calendar3"></i>
                                <strong>@t.TrainingDate.ToString("dd MMM yyyy")</strong>
                            </p>
                        </div>

                        <div class="training-actions d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center justify-content-between gap-2">
                            <div class="btn-group">
                                <button class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#editModal-@t.Id">
                                    <i class="bi bi-pencil"></i> Düzenle
                                </button>
                                <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal-@t.Id">
                                    <i class="bi bi-trash"></i> Sil
                                </button>
                            </div>

                            <form asp-area="InsanKaynaklari" asp-controller="Training" asp-action="TogglePublish" asp-route-id="@t.Id" method="post" class="m-0">
                                <button type="submit" class="btn btn-warning btn-sm text-dark">
                                    @(t.IsPublished ? "Yayından Kaldır" : "Yayınla")
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Düzenle Modal -->
                <div class="modal fade" id="editModal-@t.Id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content rounded-4">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title">Eğitim Düzenle</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <form asp-area="InsanKaynaklari" asp-controller="Training" asp-action="Edit" asp-route-id="@t.Id" method="post">
                                    <div class="row g-3">
                                        <div class="col-12">
                                            <label class="form-label">Eğitim Başlığı</label>
                                            <input type="text" name="Title" value="@t.Title" class="form-control" required />
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">Açıklama</label>
                                            <textarea name="Description" class="form-control">@t.Description</textarea>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Tarih</label>
                                            <input type="date" name="TrainingDate" value="@t.TrainingDate.ToString("yyyy-MM-dd")" class="form-control" required />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Google Drive Link</label>
                                            <input type="url" name="Link" value="@t.Link" class="form-control" required />
                                        </div>
                                        <div class="col-12 form-check mt-2">
                                            <input type="checkbox" name="IsPublished" class="form-check-input" @(t.IsPublished ? "checked" : "") id="pub-@t.Id" />
                                            <label class="form-check-label" for="pub-@t.Id">Yayınla</label>
                                        </div>
                                    </div>
                                    <div class="text-end mt-3">
                                        <button type="submit" class="btn btn-primary">Kaydet</button>
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sil Modal -->
                <div class="modal fade" id="deleteModal-@t.Id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content rounded-4">
                            <div class="modal-header bg-danger text-white">
                                <h5 class="modal-title">Eğitimi Sil</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p><strong>@t.Title</strong> eğitimini silmek istediğinize emin misiniz?</p>
                            </div>
                            <div class="modal-footer">
                                <form asp-area="InsanKaynaklari" asp-controller="Training" asp-action="Delete" asp-route-id="@t.Id" method="post">
                                    <button type="submit" class="btn btn-danger">Evet, Sil</button>
                                </form>
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Dinamik modal container -->
<div id="createModalContainer"></div>

@section Scripts {
    <!-- Var olan JS BLOĞUNA DOKUNMADIM -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const openButton = document.getElementById("openCreateModal");

            openButton.addEventListener("click", function () {
                fetch('@Url.Action("Create", "Training", new { area = "InsanKaynaklari" })')
                    .then(response => {
                        if (!response.ok) throw new Error("Sunucu hatası");
                        return response.text();
                    })
                    .then(html => {
                        const container = document.getElementById("createModalContainer");
                        container.innerHTML = html;

                        const modalEl = container.querySelector(".modal");
                        const modal = new bootstrap.Modal(modalEl);
                        modal.show();

                        // Mevcut init fonksiyonlarını aynen çağırıyoruz
                        initUserSelection();
                        initQuestionBuilder();

                        modalEl.addEventListener("hidden.bs.modal", () => {
                            container.innerHTML = "";
                        });
                    })
                    .catch(err => {
                        console.error("Modal yüklenemedi:", err);
                        alert("Eğitim oluşturma ekranı yüklenemedi.");
                    });
            });
        });

        function initUserSelection() {
            const availableList = document.getElementById("availableUsers");
            const selectedList = document.getElementById("selectedUsers");
            const hiddenInput = document.getElementById("SelectedUserIdsString");
            const searchInput = document.getElementById("userSearch");
            const selectAllBtn = document.getElementById("selectAll");
            const clearAllBtn = document.getElementById("clearAll");
            const btnAdd = document.getElementById("btnAddSelected");
            const btnRemove = document.getElementById("btnRemoveSelected");
            const selectedCount = document.getElementById("selectedCount");

            if (!availableList || !selectedList || !hiddenInput) return;

            availableList.addEventListener("click", e => {
                const li = e.target.closest("li");
                if (!li) return;

                const checkbox = li.querySelector(".user-checkbox");
                checkbox.checked = !checkbox.checked;
                li.classList.toggle("bg-primary", checkbox.checked);
                li.classList.toggle("text-white", checkbox.checked);
            });

            selectedList.addEventListener("click", e => {
                const li = e.target.closest("li");
                if (!li) return;

                const checkbox = li.querySelector(".user-checkbox");
                checkbox.checked = !checkbox.checked;
                li.classList.toggle("bg-danger", checkbox.checked);
                li.classList.toggle("text-white", checkbox.checked);
            });

            btnAdd.addEventListener("click", () => {
                availableList.querySelectorAll(".user-checkbox:checked").forEach(chk => {
                    const li = chk.closest("li");
                    chk.checked = false;
                    li.classList.remove("bg-primary", "text-white");
                    selectedList.appendChild(li);
                });
                updateHiddenInput();
            });

            btnRemove.addEventListener("click", () => {
                selectedList.querySelectorAll(".user-checkbox:checked").forEach(chk => {
                    const li = chk.closest("li");
                    chk.checked = false;
                    li.classList.remove("bg-danger", "text-white");
                    availableList.appendChild(li);
                });
                updateHiddenInput();
            });

            selectAllBtn.addEventListener("click", () => {
                availableList.querySelectorAll("li").forEach(li => {
                    selectedList.appendChild(li);
                });
                updateHiddenInput();
            });

            clearAllBtn.addEventListener("click", () => {
                selectedList.querySelectorAll("li").forEach(li => {
                    availableList.appendChild(li);
                });
                updateHiddenInput();
            });

            searchInput.addEventListener("keyup", e => {
                const filter = e.target.value.toLowerCase();
                availableList.querySelectorAll("li").forEach(li => {
                    li.style.display = li.textContent.toLowerCase().includes(filter) ? "" : "none";
                });
            });

            function updateHiddenInput() {
                const ids = Array.from(selectedList.querySelectorAll("li"))
                    .map(li => li.dataset.id);
                hiddenInput.value = ids.join(",");
                if (selectedCount)
                    selectedCount.textContent = `${ids.length} kullanıcı seçildi`;
            }

            updateHiddenInput();
        }

        function initQuestionBuilder() {
            const container = document.getElementById("questions-container");
            const addBtn = document.getElementById("add-question-btn");
            if (!addBtn || !container) return;

            let questionCount = 0;

            addBtn.addEventListener("click", () => {
                questionCount++;
                const qHtml = `
                <div class="card shadow-sm border-0 question-card position-relative">
                    <div class="card-body p-4 bg-light rounded-3">
                        <button type="button" class="btn-close position-absolute top-0 end-0 mt-3 me-3 remove-question" title="Soruyu Kaldır"></button>
                        <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-question-circle"></i> Soru ${questionCount}</h6>

                        <input type="text" name="Questions[${questionCount - 1}].QuestionText"
                               class="form-control mb-3" placeholder="Soru metni" required />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <input type="text" name="Questions[${questionCount - 1}].OptionA"
                                       class="form-control" placeholder="A şıkkı" required />
                            </div>
                            <div class="col-md-6">
                                <input type="text" name="Questions[${questionCount - 1}].OptionB"
                                       class="form-control" placeholder="B şıkkı" required />
                            </div>
                            <div class="col-md-6">
                                <input type="text" name="Questions[${questionCount - 1}].OptionC"
                                       class="form-control" placeholder="C şıkkı" required />
                            </div>
                            <div class="col-md-6">
                                <input type="text" name="Questions[${questionCount - 1}].OptionD"
                                       class="form-control" placeholder="D şıkkı" required />
                            </div>
                        </div>

                        <div class="mt-3">
                            <label class="fw-semibold me-2">✅ Doğru Şık:</label>
                            <select name="Questions[${questionCount - 1}].CorrectOption" class="form-select w-auto d-inline-block">
                                <option value="A">A</option>
                                <option value="B">B</option>
                                <option value="C">C</option>
                                <option value="D">D</option>
                            </select>
                        </div>
                    </div>
                </div>`;

                container.insertAdjacentHTML('beforeend', qHtml);
                bindRemoveButtons();
            });

            function bindRemoveButtons() {
                container.querySelectorAll(".remove-question").forEach(btn => {
                    btn.onclick = () => {
                        btn.closest(".question-card").remove();
                    };
                });
            }
        }
    </script>
}