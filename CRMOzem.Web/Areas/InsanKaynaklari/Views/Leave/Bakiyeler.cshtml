@model CRMOzem.Core.ViewModels.LeaveBalanceListVm
@{
    ViewData["Title"] = "İzin Bakiyeleri";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("~/Views/Shared/_KotaDesignSystem.cshtml")
@await Html.PartialAsync("_IzinNav", "Bakiyeler")

<style>
    /* ── Durum şeridi: yılın neresindeyiz, tek cümle ─────────────── */
    .bk-durum {
        display: flex; align-items: flex-start; gap: 11px;
        padding: 14px 18px; border-radius: var(--kt-r-md);
        font-size: 13.5px; line-height: 1.5; margin-bottom: 16px;
    }
        .bk-durum i { font-size: 16px; margin-top: 1px; flex-shrink: 0; }
    .bk-durum.iyi { background: var(--kt-pos-50); border: 1px solid #a7f3d0; color: var(--kt-pos-700); }
    .bk-durum.dikkat { background: var(--kt-warn-50); border: 1px solid #fde68a; color: var(--kt-warn-700); }
    .bk-durum.uyari { background: var(--kt-warn-50); border: 1px solid #fde68a; color: var(--kt-warn-700); }

    /* ── Üç adımlı yıl hazırlama rehberi ─────────────────────────── */
    .bk-adimlar {
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
        background: var(--kt-border); border: 1px solid var(--kt-border);
        border-radius: var(--kt-r-md); overflow: hidden;
    }
    @@media (max-width: 860px) { .bk-adimlar { grid-template-columns: 1fr; } }

    .bk-adim { background: var(--kt-paper); padding: 15px 17px; }

        .bk-adim .no {
            display: inline-flex; align-items: center; justify-content: center;
            width: 21px; height: 21px; border-radius: 50%;
            background: var(--kt-ink-900); color: #fff;
            font-size: 11px; font-weight: 700; margin-right: 8px;
        }

        .bk-adim .baslik {
            font-size: 13.5px; font-weight: 700; color: var(--kt-ink-900);
            display: flex; align-items: center;
        }

        .bk-adim .metin {
            font-size: 12.5px; color: var(--kt-ink-500);
            margin: 7px 0 11px; padding-left: 29px; line-height: 1.55;
        }

        .bk-adim .eylem { padding-left: 29px; }

    .bk-adim.tamam { background: var(--kt-pos-50); }
    .bk-adim.tamam .no { background: var(--kt-pos); }

    /* ── Tablo ───────────────────────────────────────────────────── */
    .bk-oran {
        height: 5px; background: var(--kt-bg-soft); border-radius: 999px;
        overflow: hidden; margin-top: 5px; min-width: 70px;
    }
        .bk-oran > i { display: block; height: 100%; border-radius: 999px; background: var(--kt-primary); }
        .bk-oran.dolu > i { background: var(--kt-neg); }
        .bk-oran.yuksek > i { background: var(--kt-warn); }

    .bk-sat-eksik { background: #fffdf5; }

    .bk-rozet {
        font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px;
        text-transform: uppercase; letter-spacing: .04em; white-space: nowrap;
    }
    .bk-manuel { background: var(--kt-primary-50); color: var(--kt-primary-700); }
    .bk-oto { background: var(--kt-bg-soft); color: var(--kt-ink-500); }
    .bk-yok { background: var(--kt-warn-50); color: var(--kt-warn-700); }

    .bk-eylem { display: flex; gap: 6px; justify-content: flex-end; flex-wrap: nowrap; }
    .bk-eylem .kt-btn { white-space: nowrap; }
</style>

<div class="kt-page" style="padding-top:0;">

    @if (TempData["Success"] != null)
    {
        <div class="kt-card" style="border-left:3px solid var(--kt-pos); padding:12px 18px; font-size:13.5px;">
            <i class="fas fa-circle-check" style="color:var(--kt-pos); margin-right:7px;"></i>@TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="kt-card" style="border-left:3px solid var(--kt-neg); padding:12px 18px; font-size:13.5px;">
            <i class="fas fa-circle-exclamation" style="color:var(--kt-neg); margin-right:7px;"></i>@TempData["Error"]
        </div>
    }

    @* ═══ YIL SEÇİMİ + DURUM ═══ *@
    <div class="kt-card">
        <div class="kt-flex-between" style="margin-bottom:14px; flex-wrap:wrap; gap:12px;">
            <div>
                <div style="font-size:16px; font-weight:700; color:var(--kt-ink-900);">
                    @Model.Year Yılı İzin Bakiyeleri
                </div>
                <div style="font-size:12.5px; color:var(--kt-ink-500); margin-top:2px;">
                    @Model.Balances.Count çalışan · toplam @Model.ToplamHakedis gün hakediş
                </div>
            </div>
            <form method="get" style="display:inline;">
                <select name="yil" class="kt-select" style="width:130px;" onchange="this.form.submit()">
                    @foreach (var y in Model.AvailableYears)
                    {
                        <option value="@y" selected="@(y == Model.Year)">@y yılı</option>
                    }
                </select>
            </form>
        </div>

        <div class="bk-durum @Model.DurumSinifi">
            <i class="fas @(Model.DurumSinifi == "iyi" ? "fa-circle-check" : "fa-triangle-exclamation")"></i>
            <span>@Model.DurumCumlesi</span>
        </div>

        @* ═══ ÜÇ ADIMLI REHBER ═══ *@
        @{
            var adim1Tamam = Model.IseGirisEksikSayisi == 0;
            var adim2Tamam = Model.HakedisGirilmemisSayisi == 0 && Model.Balances.Count > 0;
        }

        <div class="bk-adimlar">
            <div class="bk-adim @(adim1Tamam ? "tamam" : "")">
                <div class="baslik">
                    <span class="no">@(adim1Tamam ? "✓" : "1")</span> İşe Giriş Tarihleri
                </div>
                <div class="metin">
                    Hakediş kıdemden hesaplanıyor. İşe giriş tarihi girilmemiş çalışanın
                    hakedişi otomatik hesaplanamaz.
                    @if (!adim1Tamam)
                    {
                        <strong style="display:block; margin-top:4px; color:var(--kt-warn-700);">
                            @Model.IseGirisEksikSayisi çalışanda tarih eksik
                        </strong>
                    }
                </div>
                <div class="eylem">
                    <a class="kt-btn kt-btn-sm @(adim1Tamam ? "kt-btn-ghost" : "kt-btn-primary")"
                       asp-action="Personel">
                        <i class="fas fa-id-card"></i> Personel Özlük
                    </a>
                </div>
            </div>

            <div class="bk-adim @(adim2Tamam ? "tamam" : "")">
                <div class="baslik">
                    <span class="no">@(adim2Tamam ? "✓" : "2")</span> Yılı Toplu Oluştur
                </div>
                <div class="metin">
                    Tüm aktif çalışanlar için @Model.Year hakedişini kıdemlerine göre yazar.
                    <strong>Elle girilmiş kayıtlara dokunmaz.</strong>
                    Yıl başında bir kez çalıştırmanız yeterli.
                </div>
                <div class="eylem">
                    <button type="button" class="kt-btn kt-btn-sm @(adim2Tamam ? "kt-btn-ghost" : "kt-btn-dark")"
                            onclick="yilAc()">
                        <i class="fas fa-wand-magic-sparkles"></i> @Model.Year Yılını Hazırla
                    </button>
                </div>
            </div>

            <div class="bk-adim">
                <div class="baslik">
                    <span class="no">3</span> İstisnaları Elle Düzelt
                </div>
                <div class="metin">
                    Sözleşmeyle fazla gün verilen ya da devri farklı hesaplanan çalışanda
                    satırdaki <strong>Düzenle</strong> ile hakedişi elle girin.
                    Elle girilen kayıt <strong>kilitlenir</strong>, toplu hesaplama onu ezmez.
                </div>
                <div class="eylem">
                    <span style="font-size:11.5px; color:var(--kt-ink-400);">
                        <i class="fas fa-arrow-down"></i> Aşağıdaki tablodan
                    </span>
                </div>
            </div>
        </div>
    </div>

    @* ═══ ÖZET ═══ *@
    <div class="kt-kpi-grid">
        <div class="kt-kpi accent-primary">
            <div class="kt-kpi-head">
                <div class="kt-kpi-label">Toplam Hakediş</div>
                <div class="kt-kpi-icon"><i class="fas fa-calendar-check"></i></div>
            </div>
            <div class="kt-kpi-value">@Model.ToplamHakedis</div>
            <div class="kt-kpi-foot">gün · @Model.Balances.Count çalışan</div>
        </div>
        <div class="kt-kpi accent-neg">
            <div class="kt-kpi-head">
                <div class="kt-kpi-label">Kullanılan</div>
                <div class="kt-kpi-icon"><i class="fas fa-plane-departure"></i></div>
            </div>
            <div class="kt-kpi-value">@Model.ToplamKullanilan</div>
            <div class="kt-kpi-foot">gün onaylı izin</div>
        </div>
        <div class="kt-kpi accent-warn">
            <div class="kt-kpi-head">
                <div class="kt-kpi-label">Bekleyen</div>
                <div class="kt-kpi-icon"><i class="fas fa-hourglass-half"></i></div>
            </div>
            <div class="kt-kpi-value">@Model.ToplamBekleyen</div>
            <div class="kt-kpi-foot">gün karar bekliyor</div>
        </div>
        <div class="kt-kpi @(Model.EksiBakiyeSayisi > 0 ? "accent-neg" : "accent-pos")">
            <div class="kt-kpi-head">
                <div class="kt-kpi-label">Kalan</div>
                <div class="kt-kpi-icon"><i class="fas fa-piggy-bank"></i></div>
            </div>
            <div class="kt-kpi-value">@Model.ToplamKalan</div>
            <div class="kt-kpi-foot">
                @if (Model.EksiBakiyeSayisi > 0)
                {
                    <span style="color:var(--kt-neg);">@Model.EksiBakiyeSayisi kişide eksi bakiye</span>
                }
                else
                {
                    <text>gün</text>
                }
            </div>
        </div>
    </div>

    @* ═══ ARAÇ ÇUBUĞU ═══ *@
    <div class="kt-card" style="padding:12px 18px; display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
        <input type="text" id="bkAra" class="kt-input" placeholder="Çalışan ara..." style="width:210px;" />

        <select id="bkSuzgec" class="kt-select" style="width:195px;" title="Süzgeç">
            <option value="">Tüm çalışanlar</option>
            <option value="eksik">Hakedişi girilmemiş</option>
            <option value="elle">Elle girilmiş (kilitli)</option>
            <option value="eksi">Bakiyesi eksiye düşmüş</option>
            <option value="asgari">Kanuni asgarinin altında</option>
        </select>

        <div style="margin-left:auto;">
            <button type="button" class="kt-btn kt-btn-dark" onclick="yilAc()">
                <i class="fas fa-wand-magic-sparkles"></i> @Model.Year Yılını Hazırla
            </button>
        </div>
    </div>

    @* ═══ TABLO ═══ *@
    <div class="kt-card kt-card-flush">
        <div class="kt-table-wrap">
            <table class="kt-table" id="bkTablo">
                <thead>
                    <tr>
                        <th>Çalışan</th>
                        <th class="text-center">Kıdem</th>
                        <th class="text-center">Hakediş</th>
                        <th class="text-center">Devreden</th>
                        <th class="text-center">Toplam</th>
                        <th class="text-center">Kullanılan</th>
                        <th class="text-center">Bekleyen</th>
                        <th class="text-center">Kalan</th>
                        <th class="text-center" style="width:1%;">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Balances)
                    {
                        var oranCls = b.UsagePercent >= 100 ? "dolu" : b.UsagePercent >= 75 ? "yuksek" : "";

                        var etiketler = new List<string>();
                        if (!b.HasRecord) { etiketler.Add("eksik"); }
                        if (b.ManuelGirildi) { etiketler.Add("elle"); }
                        if (b.RemainingDays < 0) { etiketler.Add("eksi"); }
                        if (b.AsgariAltinda) { etiketler.Add("asgari"); }

                        <tr data-ara="@($"{b.FullName} {b.Title} {b.Departman}".ToLowerInvariant())"
                            data-etiket="@string.Join(" ", etiketler)"
                            class="@(b.HasRecord ? "" : "bk-sat-eksik")">
                            <td class="kt-cell-primary">
                                @b.FullName
                                <div style="font-size:11px; color:var(--kt-ink-400);">
                                    @(b.Title ?? "—")
                                    @if (!string.IsNullOrWhiteSpace(b.Departman))
                                    {
                                        <text> · @b.Departman</text>
                                    }
                                </div>
                            </td>

                            <td class="text-center">
                                @if (b.IseGirisEksik)
                                {
                                    <span style="color:var(--kt-warn); font-size:11.5px;">
                                        <i class="fas fa-triangle-exclamation"></i> tarih yok
                                    </span>
                                }
                                else
                                {
                                    <strong>@b.KidemYili</strong>
                                    <div style="font-size:10.5px; color:var(--kt-ink-400);">yıl</div>
                                }
                            </td>

                            <td class="text-center">
                                <strong style="font-size:15px;">@b.TotalDays</strong>
                                <div style="margin-top:3px;">
                                    @if (!b.HasRecord)
                                    {
                                        <span class="bk-rozet bk-yok">girilmedi</span>
                                    }
                                    else if (b.ManuelGirildi)
                                    {
                                        <span class="bk-rozet bk-manuel" title="Toplu hesaplama bu kaydı ezmez">
                                            elle · kilitli
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="bk-rozet bk-oto" title="Kıdemden hesaplandı">kıdemden</span>
                                    }
                                </div>
                                @if (b.AsgariAltinda)
                                {
                                    <div style="font-size:10.5px; color:var(--kt-neg); margin-top:3px;"
                                         title="@b.HakedisAciklamasi">
                                        kanuni: @b.OnerilenHakedis
                                    </div>
                                }
                            </td>

                            <td class="text-center">@(b.CarriedOverDays > 0 ? b.CarriedOverDays.ToString() : "—")</td>
                            <td class="text-center"><strong>@b.Entitlement</strong></td>

                            <td class="text-center">
                                @b.UsedDays
                                <div class="bk-oran @oranCls">
                                    <i style="width:@(Math.Min(b.UsagePercent, 100).ToString("F0", System.Globalization.CultureInfo.InvariantCulture))%"></i>
                                </div>
                            </td>

                            <td class="text-center">
                                @if (b.PendingDays > 0)
                                {
                                    <span style="color:var(--kt-warn); font-weight:700;">@b.PendingDays</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <td class="text-center">
                                <strong class="@(b.RemainingDays > 0 ? "kt-money-pos" : b.RemainingDays < 0 ? "kt-money-neg" : "")"
                                        style="font-size:15px;">@b.RemainingDays</strong>
                            </td>

                            @* ═══ ETİKETLİ BUTONLAR ═══ *@
                            <td class="text-center">
                                <div class="bk-eylem">
                                    <button type="button" class="kt-btn kt-btn-sm kt-btn-ghost"
                                            onclick="bkAc('@b.UserId', '@Html.Raw(b.FullName.Replace("'", "\\'"))', @b.TotalDays, @b.CarriedOverDays, @b.OnerilenHakedis, '@Html.Raw((b.HakedisAciklamasi ?? "").Replace("'", "\\'"))')">
                                        <i class="fas fa-pen"></i> Düzenle
                                    </button>

                                    @if (!b.IseGirisEksik)
                                    {
                                        <form asp-action="OtomatikHesapla" method="post" style="display:inline;"
                                              onsubmit="return confirm('@Html.Raw(b.FullName.Replace("'", "\\'")) için kıdeme göre @b.OnerilenHakedis gün hakediş yazılacak ve kayıt \'kıdemden\' olarak işaretlenecek. Devam?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@b.UserId" />
                                            <input type="hidden" name="yil" value="@Model.Year" />
                                            <input type="hidden" name="devriAktar" value="true" />
                                            <button type="submit" class="kt-btn kt-btn-sm kt-btn-ghost"
                                                    title="Kıdeme göre @b.OnerilenHakedis gün yaz">
                                                <i class="fas fa-calculator"></i> Kıdemden
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="text-right">
                            <span style="font-size:11px; color:var(--kt-ink-500); text-transform:uppercase; letter-spacing:.06em;">
                                Toplam
                            </span>
                        </td>
                        <td class="text-center">@Model.ToplamHakedis</td>
                        <td class="text-center">@Model.ToplamKullanilan</td>
                        <td class="text-center">@Model.ToplamBekleyen</td>
                        <td class="text-center">@Model.ToplamKalan</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div id="bkSonucYok" style="display:none; padding:34px 20px; text-align:center;
                                    color:var(--kt-ink-400); font-size:13px;">
            <i class="fas fa-magnifying-glass" style="margin-right:6px;"></i>
            Bu süzgece uyan çalışan yok
        </div>
    </div>
</div>

@* ═══ HAKEDİŞ MODAL ═══ *@
<div class="kt-modal-backdrop" id="bkModal">
    <div class="kt-modal kt-modal-sm">
        <div class="kt-modal-head">
            <h5 class="kt-modal-title"><i class="fas fa-pen"></i> Hakedişi Elle Gir</h5>
            <button type="button" class="kt-modal-close" onclick="bkKapat()">&times;</button>
        </div>
        <form asp-action="BakiyeKaydet" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" id="bkUserId" />
            <input type="hidden" name="yil" value="@Model.Year" />
            <div class="kt-modal-body">
                <p style="font-size:13px; color:var(--kt-ink-500); margin:0 0 14px;">
                    <strong id="bkAd" style="color:var(--kt-ink-900);"></strong> · @Model.Year yılı
                </p>

                <div id="bkOneri" class="kt-hint"
                     style="margin:0 0 14px; padding:10px 12px; background:var(--kt-bg); border-radius:var(--kt-r-sm);">
                    <i class="fas fa-circle-info"></i>
                    <span id="bkOneriMetin"></span>
                </div>

                <div class="row g-3">
                    <div class="col-6">
                        <div class="kt-form-group">
                            <label class="kt-label">Hakediş (gün) <span class="req">*</span></label>
                            <input type="number" name="hakedis" id="bkHakedis" class="kt-input" min="0" max="365" required />
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="kt-form-group">
                            <label class="kt-label">Devreden (gün)</label>
                            <input type="number" name="devreden" id="bkDevreden" class="kt-input" min="0" max="365" />
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="kt-form-group">
                            <label class="kt-label">Neden elle giriliyor?</label>
                            <input type="text" name="aciklama" class="kt-input" maxlength="500"
                                   placeholder="Örn: sözleşme gereği 5 gün ilave" />
                        </div>
                    </div>
                </div>

                <div class="kt-hint" style="background:var(--kt-primary-50); color:var(--kt-primary-700);
                                            padding:10px 12px; border-radius:var(--kt-r-sm);">
                    <i class="fas fa-lock"></i>
                    Kaydettiğinizde bu çalışan <strong>"elle · kilitli"</strong> olarak işaretlenir.
                    "@Model.Year Yılını Hazırla" işlemi bu kaydın üzerine yazmaz.
                </div>
            </div>
            <div class="kt-modal-foot">
                <button type="button" class="kt-btn kt-btn-ghost" onclick="bkKapat()">Vazgeç</button>
                <button type="submit" class="kt-btn kt-btn-primary"><i class="fas fa-floppy-disk"></i> Kaydet ve Kilitle</button>
            </div>
        </form>
    </div>
</div>

@* ═══ YIL HAZIRLA MODAL ═══ *@
<div class="kt-modal-backdrop" id="yilModal">
    <div class="kt-modal kt-modal-sm">
        <div class="kt-modal-head">
            <h5 class="kt-modal-title"><i class="fas fa-wand-magic-sparkles"></i> @Model.Year Yılını Hazırla</h5>
            <button type="button" class="kt-modal-close" onclick="yilKapat()">&times;</button>
        </div>
        <form asp-action="YilOlustur" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="yil" value="@Model.Year" />
            <div class="kt-modal-body">
                <p style="font-size:13px; color:var(--kt-ink-700); margin:0 0 14px;">
                    İşe giriş tarihi girilmiş <strong>tüm aktif çalışanlar</strong> için @Model.Year yılı
                    hakedişi kıdemlerine göre hesaplanıp kaydedilecek.
                </p>

                @if (Model.IseGirisEksikSayisi > 0)
                {
                    <div style="background:var(--kt-warn-50); border:1px solid #fde68a; color:var(--kt-warn-700);
                                padding:10px 13px; border-radius:var(--kt-r-sm); margin-bottom:14px; font-size:12.5px;">
                        <i class="fas fa-triangle-exclamation"></i>
                        <strong>@Model.IseGirisEksikSayisi çalışanın işe giriş tarihi yok</strong> —
                        bu kişiler atlanacak. Personel Özlük ekranından tarihleri girip tekrar çalıştırın.
                    </div>
                }

                <label class="kt-chip" style="display:flex; gap:9px; width:100%; cursor:pointer; padding:11px 13px;">
                    <input type="checkbox" name="devriAktar" value="true" checked
                           style="width:16px; height:16px; accent-color:var(--kt-primary);" />
                    <span style="text-align:left;">
                        Geçen yıldan kalan günleri devret
                        <small style="display:block; font-size:11.5px; color:var(--kt-ink-400);">
                            @(Model.Year - 1) yılında kullanılmayan günler "devreden" olarak eklenir
                        </small>
                    </span>
                </label>

                <label class="kt-chip" style="display:flex; gap:9px; width:100%; cursor:pointer; padding:11px 13px; margin-top:8px;">
                    <input type="checkbox" name="manuelleriEz" value="true"
                           style="width:16px; height:16px; accent-color:var(--kt-neg);" />
                    <span style="text-align:left;">
                        Elle girilmiş hakedişleri de üzerine yaz
                        <small style="display:block; font-size:11.5px; color:var(--kt-neg);">
                            İşaretlemezseniz "elle · kilitli" kayıtlara dokunulmaz — normalde işaretlemeyin
                        </small>
                    </span>
                </label>

                <div class="kt-hint" style="margin-top:12px;">
                    <i class="fas fa-scale-balanced"></i>
                    <strong>Kıdem kuralı:</strong> 1–5 yıl 14 gün · 5–15 yıl 20 gün · 15+ yıl 26 gün.
                    18 yaş altı ve 50 yaş üstü en az 20 gün alır.
                    İlk yılını doldurmayan çalışan 0 gün alır.
                </div>
            </div>
            <div class="kt-modal-foot">
                <button type="button" class="kt-btn kt-btn-ghost" onclick="yilKapat()">Vazgeç</button>
                <button type="submit" class="kt-btn kt-btn-dark"><i class="fas fa-check"></i> Hazırla</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function bkAc(id, ad, hakedis, devreden, oneri, aciklama) {
        document.getElementById('bkUserId').value = id;
        document.getElementById('bkAd').textContent = ad;
        document.getElementById('bkHakedis').value = hakedis;
        document.getElementById('bkDevreden').value = devreden;
        document.getElementById('bkOneriMetin').textContent = aciklama
            ? ('Kıdeme göre öneri: ' + oneri + ' gün — ' + aciklama)
            : ('Kıdeme göre öneri: ' + oneri + ' gün');
        document.getElementById('bkModal').classList.add('open');
        document.body.style.overflow = 'hidden';
    }
    function bkKapat() {
        document.getElementById('bkModal').classList.remove('open');
        document.body.style.overflow = '';
    }
    function yilAc() {
        document.getElementById('yilModal').classList.add('open');
        document.body.style.overflow = 'hidden';
    }
    function yilKapat() {
        document.getElementById('yilModal').classList.remove('open');
        document.body.style.overflow = '';
    }

    ['bkModal', 'yilModal'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.addEventListener('click', function (e) {
            if (e.target.id === id) { bkKapat(); yilKapat(); }
        });
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { bkKapat(); yilKapat(); }
    });

    // ── Arama + süzgeç ──
    (function () {
        var ara = document.getElementById('bkAra');
        var suzgec = document.getElementById('bkSuzgec');
        var tablo = document.getElementById('bkTablo');
        var yok = document.getElementById('bkSonucYok');
        if (!tablo) return;

        function uygula() {
            var q = ara ? ara.value.trim().toLowerCase() : '';
            var e = suzgec ? suzgec.value : '';
            var gorunen = 0;

            tablo.querySelectorAll('tbody tr').forEach(function (tr) {
                var okQ = !q || (tr.dataset.ara || '').indexOf(q) !== -1;
                var okE = !e || (tr.dataset.etiket || '').split(' ').indexOf(e) !== -1;
                var uyan = okQ && okE;
                tr.style.display = uyan ? '' : 'none';
                if (uyan) gorunen++;
            });

            tablo.style.display = gorunen > 0 ? '' : 'none';
            if (yok) yok.style.display = gorunen > 0 ? 'none' : 'block';
        }

        if (ara) ara.addEventListener('input', uygula);
        if (suzgec) suzgec.addEventListener('change', uygula);
    })();
</script>
}
