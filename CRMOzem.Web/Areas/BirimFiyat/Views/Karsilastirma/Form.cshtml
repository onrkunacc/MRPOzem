@using CRMOzem.Core.Enums
@model CRMOzem.Web.Areas.BirimFiyat.Models.KarsilastirmaFormVm
@{
    ViewData["Title"] = Model.Baslik;
    var k = Model.Karsilastirma;
    var tr = new System.Globalization.CultureInfo("tr-TR");
}

<link rel="stylesheet" href="~/css/birim-fiyat.css" asp-append-version="true" />    

<style>
    .bf-form-wrap { max-width: 980px; }

    .bf-secenek-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 9px;
    }

    .bf-secenek {
        position: relative;
        border: 1px solid var(--bf-border-str);
        border-radius: var(--bf-r-sm);
        padding: 11px 13px 11px 36px;
        cursor: pointer;
        background: var(--bf-surface);
        transition: border-color .15s, background .15s;
        display: block;
    }

    .bf-secenek:hover { border-color: var(--bf-primary); background: var(--bf-primary-sf); }

    .bf-secenek input { position: absolute; left: 13px; top: 14px; margin: 0; }

    .bf-secenek-ad { font-size: 12.5px; font-weight: 700; color: var(--bf-text); }
    .bf-secenek-not { font-size: 11px; color: var(--bf-muted); margin-top: 3px; line-height: 1.45; }

    .bf-secenek input:checked ~ .bf-secenek-ad { color: var(--bf-primary-dk); }

    .bf-secenek:has(input:checked) {
        border-color: var(--bf-primary);
        background: var(--bf-primary-sf);
        box-shadow: 0 0 0 1px var(--bf-primary);
    }

    .bf-taraf-grid {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 14px;
        align-items: center;
    }

    .bf-taraf-ok {
        width: 34px; height: 34px;
        border-radius: 50%;
        background: var(--bf-navy);
        color: #fff;
        display: flex; align-items: center; justify-content: center;
        flex: 0 0 34px;
        margin-top: 10px;
    }

    @@media (max-width: 640px) {
        .bf-taraf-grid { grid-template-columns: 1fr; }
        .bf-taraf-ok { transform: rotate(90deg); margin: 0 auto; }
    }
</style>

<div class="bf-wrap bf-form-wrap">

    <div class="bf-head">
        <div class="bf-head-left">
            <div class="bf-head-icon"><i class="fe fe-@(Model.Yeni ? "plus" : "edit-3")"></i></div>
            <div>
                <h1>@Model.Baslik</h1>
                <div class="bf-head-sub">
                    @(Model.Yeni
                        ? "Karşılaştırmayı oluşturduktan sonra iki Excel dosyasını yükleyeceksiniz."
                        : "Kuralları değiştirirseniz karşılaştırmayı yeniden hesaplamanız gerekir.")
                </div>
            </div>
        </div>
        <div class="bf-head-actions">
            <a asp-action="Index" asp-route-klasorId="@k.KlasorId" class="bf-btn">
                <i class="fe fe-arrow-left"></i> Listeye dön
            </a>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="bf-note bf-note-danger">
            <i class="fe fe-x-circle"></i>
            <div>
                @foreach (var hata in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@hata.ErrorMessage</div>
                }
            </div>
        </div>
    }

    <form asp-action="Kaydet" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Karsilastirma.Id" />
        <input type="hidden" asp-for="Karsilastirma.Durum" />
        <input type="hidden" asp-for="Karsilastirma.OlusturmaTarihi" />
        <input type="hidden" asp-for="Karsilastirma.OlusturanKullanici" />

        <!-- ══ Tanım ══ -->
        <div class="bf-section">
            <div class="bf-section-title">Tanım</div>

            <div class="bf-field">
                <label class="bf-label">Karşılaştırma Adı <span class="bf-req">*</span></label>
                <input asp-for="Karsilastirma.Ad" class="bf-input" maxlength="250"
                       placeholder="Örn: Abbott 2026 1. Yarıyıl · Denizli Devlet Hastanesi" autofocus />
                <div class="bf-hint">Listede ve raporlarda bu adla görünecek.</div>
            </div>

            <div class="bf-grid-2">
                <div class="bf-field">
                    <label class="bf-label">Klasör</label>
                    <select asp-for="Karsilastirma.KlasorId" asp-items="Model.Klasorler" class="bf-select"></select>
                </div>

                <div class="bf-field">
                    <label class="bf-label">Hastane <span class="bf-faint">(opsiyonel)</span></label>
                    <select asp-for="Karsilastirma.HospitalID" asp-items="Model.Hastaneler" class="bf-select"></select>
                </div>
            </div>

            <div class="bf-field">
                <label class="bf-label">İhale <span class="bf-faint">(opsiyonel)</span></label>
                <input asp-for="Karsilastirma.IhaleAdi" class="bf-input" maxlength="300"
                       placeholder="Hangi ihale karşılığında yapıldıysa yazın" />
                <div class="bf-hint">Şimdilik serbest metin. İhale listesinden seçilebilir hale getirmek için İhale modelini bana gönderin.</div>
            </div>

            <div class="bf-field">
                <label class="bf-label">Açıklama</label>
                <textarea asp-for="Karsilastirma.Aciklama" class="bf-textarea" maxlength="2000"
                          placeholder="Bu karşılaştırmanın amacı, kapsamı, dikkat edilecek noktalar…"></textarea>
            </div>
        </div>

        <!-- ══ Taraflar ══ -->
        <div class="bf-section">
            <div class="bf-section-title">Taraflar</div>

            <div class="bf-taraf-grid">
                <div>
                    <div class="bf-field" style="margin-bottom:8px;">
                        <label class="bf-label">Tedarikçi Tarafı</label>
                        <input asp-for="Karsilastirma.TedarikciEtiket" class="bf-input" maxlength="100" placeholder="Abbott" />
                    </div>
                    <div class="bf-field" style="margin-bottom:0;">
                        <label class="bf-label">Para Birimi</label>
                        <select asp-for="Karsilastirma.TedarikciParaBirimi" class="bf-select">
                            <option value="USD">USD — Amerikan Doları</option>
                            <option value="TRY">TRY — Türk Lirası</option>
                        </select>
                    </div>
                </div>

                <div class="bf-taraf-ok"><i class="fe fe-arrow-right"></i></div>

                <div>
                    <div class="bf-field" style="margin-bottom:8px;">
                        <label class="bf-label">Bizim Taraf</label>
                        <input asp-for="Karsilastirma.BizEtiket" class="bf-input" maxlength="100" placeholder="ÖZEM" />
                    </div>
                    <div class="bf-field" style="margin-bottom:0;">
                        <label class="bf-label">Para Birimi</label>
                        <select asp-for="Karsilastirma.BizParaBirimi" class="bf-select">
                            <option value="TRY">TRY — Türk Lirası</option>
                            <option value="USD">USD — Amerikan Doları</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="bf-hint" style="margin-top:10px;">
                Bu adlar ekranlarda ve Excel çıktısında kolon başlığı olarak kullanılır.
            </div>
        </div>

        <!-- ══ Eşleştirme kuralı ══ -->
        <div class="bf-section">
            <div class="bf-section-title">Eşleştirme Kuralı</div>

            @{
                var kurallar = new (EslestirmeKurali Deger, string Ad, string Not)[]
                {
                    (EslestirmeKurali.ReferansVeAy, "Referans no + aynı ay",
                        "Önerilen. Faturalar birkaç gün kayabildiği için pratikte en çok tutan yöntem."),
                    (EslestirmeKurali.SadeceReferans, "Sadece referans no",
                        "Tarihe bakılmaz. Dosyalarda tarih kolonu yoksa bunu seçin."),
                    (EslestirmeKurali.ReferansVeTarih, "Referans no + birebir tarih",
                        "Yalnızca günü günü tutan satırlar eşleşir. En katı kural."),
                    (EslestirmeKurali.ReferansVeEnYakinOnceki, "Referans no + en yakın önceki",
                        "Bizim fatura tarihimizden önceki en yakın tedarikçi fiyatı alınır.")
                };
            }

            <div class="bf-secenek-grid">
                @foreach (var kural in kurallar)
                {
                    <label class="bf-secenek">
                        <input type="radio" name="Karsilastirma.EslestirmeKurali"
                               value="@((int)kural.Deger)"
                               checked="@(k.EslestirmeKurali == kural.Deger)" />
                        <div class="bf-secenek-ad">@kural.Ad</div>
                        <div class="bf-secenek-not">@kural.Not</div>
                    </label>
                }
            </div>
        </div>

        <!-- ══ Kur ══ -->
        <div class="bf-section">
            <div class="bf-section-title">Kur Dönüşümü</div>

            @{
                var kurSecenekleri = new (KurKaynagi Deger, string Ad, string Not)[]
                {
                    (KurKaynagi.TcmbFaturaTarihi, "TCMB — fatura tarihindeki kur",
                        "Önerilen. Her satır kendi fatura tarihinin TCMB döviz satış kuruyla çevrilir."),
                    (KurKaynagi.SabitKur, "Sabit kur",
                        "Tüm satırlar için tek kur kullanılır."),
                    (KurKaynagi.ExcelKolonu, "Excel'deki kur kolonu",
                        "Dosyada kur kolonu varsa o kullanılır. Yükleme adımında eşleştirirsiniz.")
                };
            }

            <div class="bf-secenek-grid">
                @foreach (var kaynak in kurSecenekleri)
                {
                    <label class="bf-secenek">
                        <input type="radio" name="Karsilastirma.KurKaynagi"
                               value="@((int)kaynak.Deger)"
                               checked="@(k.KurKaynagi == kaynak.Deger)"
                               onchange="bfKurDegisti()" />
                        <div class="bf-secenek-ad">@kaynak.Ad</div>
                        <div class="bf-secenek-not">@kaynak.Not</div>
                    </label>
                }
            </div>

            <div class="bf-grid-2" style="margin-top:14px;">
                <div class="bf-field" id="bfSabitKurAlan" style="display:none;">
                    <label class="bf-label">Sabit Kur (USD/TRY) <span class="bf-req">*</span></label>
                    <input asp-for="Karsilastirma.SabitKur" class="bf-input" type="number" step="0.0001" min="0"
                           placeholder="Örn: 42,1500" />
                    <div class="bf-hint">1 USD kaç TL? Ondalık ayracı olarak nokta kullanın.</div>
                </div>

                <div class="bf-field">
                    <label class="bf-label">Tolerans (%)</label>
                    <input asp-for="Karsilastirma.ToleransYuzde" class="bf-input" type="number" step="0.01" min="0" max="100" />
                    <div class="bf-hint">
                        Bu yüzdenin altındaki sapmalar "fark yok" sayılır ve işaretlenmez.
                        Kur yuvarlamaları için 0,5–2 arası makul.
                    </div>
                </div>
            </div>
        </div>

        <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:18px;">
            <a asp-action="Index" asp-route-klasorId="@k.KlasorId" class="bf-btn">Vazgeç</a>
            <button type="submit" class="bf-btn bf-btn-primary">
                <i class="fe fe-save"></i> @(Model.Yeni ? "Oluştur ve dosya yüklemeye geç" : "Kaydet")
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function bfKurDegisti() {
            var sabitSecili = document.querySelector('input[name="Karsilastirma.KurKaynagi"][value="@((int)KurKaynagi.SabitKur)"]');
            var alan = document.getElementById('bfSabitKurAlan');
            alan.style.display = (sabitSecili && sabitSecili.checked) ? 'block' : 'none';
        }

        document.addEventListener('DOMContentLoaded', bfKurDegisti);
    </script>
}
