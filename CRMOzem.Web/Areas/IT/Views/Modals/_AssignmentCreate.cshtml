@model CRMOzem.Web.Vm.AssignmentCreateVm
@{
    var postUrl = Url.Action("AssignmentCreate", "Modals", new { area = "IT" });
}

<div class="modal-header">
    <h5 class="modal-title"><i class="fe fe-log-in me-2" style="color:#15803d"></i>Yeni Zimmet Oluştur</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
</div>

<form method="post" action="@postUrl" onsubmit="return postForm(this)">
    @Html.AntiForgeryToken()
    <div class="modal-body">

        <!-- Kişi seç -->
        <div class="iv-form-group">
            <label>Zimmetlenecek Kişi <span style="color:#e53e3e">*</span></label>
            <select class="form-select" name="AssigneeId" required id="az-assignee">
                <option value="">Kişi seçiniz…</option>
                @foreach (var p in Model.RecentAssignees)
                {
                    <option value="@p.Id">
                        @p.FullName@(string.IsNullOrWhiteSpace(p.Department) ? "" : $" — {p.Department}")
                    </option>
                }
            </select>
        </div>

        <div class="iv-form-row">
            <div class="iv-form-group">
                <label>Teslim Durumu</label>
                <input class="form-control" name="ConditionOut" placeholder="örn. Sıfır, İkinci El…" />
            </div>
            <div class="iv-form-group">
                <label>Not</label>
                <input class="form-control" name="Notes" placeholder="İsteğe bağlı not" />
            </div>
        </div>

        <!-- Cihaz listesi -->
        <div class="iv-form-group" style="margin-top:4px">
            <label>Müsait Cihazlar <span style="color:#e53e3e">*</span></label>

            @if (!Model.AvailableAssets.Any())
            {
                <div style="background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:10px 12px;font-size:11.5px;color:#b45309;display:flex;gap:8px;align-items:center">
                    <i class="fe fe-alert-triangle"></i> Müsait cihaz bulunmuyor.
                </div>
            }
            else
            {
                <!-- Arama kutusu -->
                <div style="position:relative;margin-bottom:6px">
                    <i class="fe fe-search" style="position:absolute;left:9px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:11px"></i>
                    <input id="az-asset-q" type="text" class="form-control" style="padding-left:28px;font-size:12px"
                           placeholder="Cihaz filtrele…" oninput="azFilterAssets()" autocomplete="off" />
                </div>

                <div id="az-asset-list" style="max-height:240px;overflow-y:auto;border:1px solid #e2e8f0;border-radius:8px">
                    @foreach (var a in Model.AvailableAssets)
                    {
                        <label id="az-row-@a.Id" style="display:flex;align-items:center;gap:10px;padding:9px 12px;cursor:pointer;border-bottom:1px solid #f1f5f9;transition:background .08s"
                               onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background=''">
                            <input type="checkbox" name="AssetIds" value="@a.Id"
                                   class="form-check-input az-asset-cb" style="flex-shrink:0;margin:0"
                                   onchange="azUpdateCount()" />
                            <div style="flex:1;min-width:0">
                                <div style="font-size:12px;font-weight:600;color:#0f172a">
                                    @a.Category — @a.Brand @a.Model
                                </div>
                                <div style="font-size:10.5px;color:#94a3b8;font-family:monospace">
                                    @(a.SerialNumber != null ? $"SN: {a.SerialNumber}" : "")
                                    @(a.InventoryTag != null ? $" | Tag: {a.InventoryTag}" : "")
                                </div>
                            </div>
                        </label>
                    }
                </div>

                <div id="az-count" style="font-size:11px;color:#64748b;margin-top:5px;padding-left:2px">
                    0 cihaz seçildi
                </div>
            }
        </div>

    </div>
    <div class="modal-footer">
        <button type="button" class="iv-btn iv-btn-ghost" data-bs-dismiss="modal">İptal</button>
        <button type="submit" class="iv-btn iv-btn-success" id="az-submit-btn">
            <i class="fe fe-log-in"></i> Zimmetle
        </button>
    </div>
</form>

<script>
    function azFilterAssets(){
        const q = document.getElementById('az-asset-q').value.trim().toLowerCase();
        document.querySelectorAll('#az-asset-list label').forEach(lbl => {
            lbl.style.display = (!q || lbl.innerText.toLowerCase().includes(q)) ? '' : 'none';
        });
    }
    function azUpdateCount(){
        const n = document.querySelectorAll('.az-asset-cb:checked').length;
        const el = document.getElementById('az-count');
        if (el) el.textContent = n + ' cihaz seçildi';
        const btn = document.getElementById('az-submit-btn');
        if (btn) btn.disabled = n === 0;
    }
    document.getElementById('az-submit-btn').disabled = true;
</script>
