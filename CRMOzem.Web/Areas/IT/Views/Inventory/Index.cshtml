@model CRMOzem.Web.Vm.InventoryDashboardVm
@{
    ViewData["Title"] = "Envanter & Zimmet";
    var error = TempData["Error"] as string;
    Layout = "~/Views/Shared/_Layout.cshtml";

    // URL'leri Razor ile üretelim (Area kırılmaz)
    var urlAssetsTable = Url.Action("AssetsTable", "Inventory", new { area = "IT" });
    var urlActiveTable = Url.Action("ActiveAssignmentsTable", "Inventory", new { area = "IT" });
    var urlBrandTable = Url.Action("BrandSummaryTable", "Inventory", new { area = "IT" });

    var urlModalAssetCreate = Url.Action("AssetCreate", "Modals", new { area = "IT" });
    var urlModalAssigneeFromUser = Url.Action("AssigneeFromUser", "Modals", new { area = "IT" });
    var urlModalAssigneeExternal = Url.Action("AssigneeExternalCreate", "Modals", new { area = "IT" });
    var urlModalAssignmentCreate = Url.Action("AssignmentCreate", "Modals", new { area = "IT" });

    // Dış controller'lar (area dışıysa area verme)
    var urlReturnItem = Url.Action("ReturnItem", "Assignments");
    var urlGeneratePdf = Url.Action("GeneratePdf", "Assignments");
}

<div class="container-fluid py-3">

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h3 class="mb-0">Envanter & Zimmet</h3>
            <div class="text-muted small">IT – Envanter yönetimi ve zimmet işlemleri</div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary" onclick="openModal('@urlModalAssetCreate')">
                <i class="bi bi-plus-circle me-1"></i> Cihaz
            </button>

            <button class="btn btn-outline-secondary" onclick="openModal('@urlModalAssigneeFromUser')">
                <i class="bi bi-person-check me-1"></i> Kayıtlı Kullanıcıdan Kişi
            </button>

            <button class="btn btn-outline-secondary" onclick="openModal('@urlModalAssigneeExternal')">
                <i class="bi bi-person-plus me-1"></i> Kayıtsız Kişi
            </button>

            <button class="btn btn-success" onclick="openModal('@urlModalAssignmentCreate')">
                <i class="bi bi-box-arrow-in-right me-1"></i> Zimmet
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <div>@error</div>
        </div>
    }

    <!-- Özet kartları -->
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Son 200 Cihaz</div>
                    <div class="fs-4 fw-semibold">@Model.Assets?.Count</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Aktif Zimmet</div>
                    <div class="fs-4 fw-semibold">@Model.ActiveItems?.Count</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Marka / Model Özeti</div>
                    <div class="fs-4 fw-semibold">@Model.BrandSummary?.Count</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab yapısı -->
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <ul class="nav nav-tabs card-header-tabs" id="invTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="tab-assets" data-bs-toggle="tab" data-bs-target="#pane-assets" type="button" role="tab">
                        Envanter
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-active" data-bs-toggle="tab" data-bs-target="#pane-active" type="button" role="tab">
                        Aktif Zimmetler
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-brand" data-bs-toggle="tab" data-bs-target="#pane-brand" type="button" role="tab">
                        Marka / Model Raporu
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                <div class="input-group" style="max-width: 420px;">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input id="q" type="text" class="form-control" placeholder="Tablodan filtrele (anlık)" oninput="filterTables()" />
                </div>

                <button class="btn btn-outline-primary" onclick="refreshAll()">
                    <i class="bi bi-arrow-repeat me-1"></i> Yenile
                </button>
            </div>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="pane-assets" role="tabpanel">
                    <div id="assetsTable">
                        @await Html.PartialAsync("Partials/_AssetsTable", Model.Assets)
                    </div>
                </div>

                <div class="tab-pane fade" id="pane-active" role="tabpanel">
                    <div id="activeTable">
                        @await Html.PartialAsync("Partials/_ActiveAssignmentsTable", Model.ActiveItems)
                    </div>
                </div>

                <div class="tab-pane fade" id="pane-brand" role="tabpanel">
                    <div id="brandTable">
                        @await Html.PartialAsync("Partials/_BrandSummaryTable", Model.BrandSummary)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="appModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content" id="appModalContent"></div>
    </div>
</div>

@section Scripts {
    <script>
        const modalEl = document.getElementById('appModal');
        const modal = new bootstrap.Modal(modalEl);

        // URL'leri backend'den aldık
        const urlAssetsTable = '@urlAssetsTable';
        const urlActiveTable = '@urlActiveTable';
        const urlBrandTable  = '@urlBrandTable';

        const urlReturnItem  = '@urlReturnItem';
        const urlGeneratePdf = '@urlGeneratePdf';

        async function openModal(url) {
            const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            const html = await res.text();
            document.getElementById('appModalContent').innerHTML = html;
            modal.show();
        }

        async function postForm(form) {
            const fd = new FormData(form);
            const res = await fetch(form.action, {
                method: form.method || 'POST',
                body: fd,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            const data = await res.json().catch(() => null);
            if (!res.ok || !data || data.ok === false) {
                alert((data && data.message) ? data.message : 'Hata oluştu.');
                return false;
            }

            modal.hide();
            await refreshAll();
            return false;
        }

        async function refreshAll() {
            document.getElementById('assetsTable').innerHTML =
                await fetch(urlAssetsTable, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(r => r.text());

            document.getElementById('activeTable').innerHTML =
                await fetch(urlActiveTable, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(r => r.text());

            document.getElementById('brandTable').innerHTML =
                await fetch(urlBrandTable, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(r => r.text());

            filterTables(); // yenilemeden sonra filtreyi koru
        }

        function filterTables() {
            const q = (document.getElementById('q').value || '').toLowerCase();
            const tables = document.querySelectorAll('#assetsTable table tbody tr, #activeTable table tbody tr, #brandTable table tbody tr');
            tables.forEach(tr => {
                const text = tr.innerText.toLowerCase();
                tr.style.display = text.includes(q) ? '' : 'none';
            });
        }

        async function returnItem(itemId) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const fd = new FormData();
            fd.append('itemId', itemId);
            if (token) fd.append('__RequestVerificationToken', token);

            const res = await fetch(urlReturnItem, {
                method: 'POST',
                body: fd,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            const data = await res.json().catch(() => null);
            if (!res.ok || !data || data.ok === false) {
                alert((data && data.message) ? data.message : 'Hata oluştu.');
                return;
            }
            await refreshAll();
        }

        async function generatePdf(assignmentId) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const fd = new FormData();
            fd.append('assignmentId', assignmentId);
            if (token) fd.append('__RequestVerificationToken', token);

            const res = await fetch(urlGeneratePdf, {
                method: 'POST',
                body: fd,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            const data = await res.json().catch(() => null);
            if (!res.ok || !data || data.ok === false) {
                alert((data && data.message) ? data.message : 'PDF üretilemedi.');
                return;
            }
            alert('PDF oluşturuldu ve kaydedildi.');
        }
    </script>
}
