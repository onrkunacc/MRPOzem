@model CRMOzem.Core.ViewModels.KotaCreateVm
@using CRMOzem.Core.Models

@{
    ViewData["Title"] = "Yeni Kota";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var hospitals = ViewBag.Hospitals as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var secilenIdler = Model?.SecilenHastaneIdler ?? new List<int>();
}

@await Html.PartialAsync("~/Views/Shared/_KotaDesignSystem.cshtml")

<div class="kt-page">

    @* ═══ HEADER ═══ *@
    <div class="kt-header theme-primary">
        <div class="kt-header-inner">
            <div class="kt-header-title">
                <div class="kt-header-icon"><i class="fas fa-plus"></i></div>
                <div>
                    <h1>Yeni Kota Oluştur</h1>
                    <p>Proforma bilgilerini, süreleri ve kotaya dahil hastaneleri girin.</p>
                </div>
            </div>
            <div class="kt-header-actions">
                <a asp-action="Index" class="kt-btn kt-btn-ghost">
                    <i class="fas fa-arrow-left"></i> Kotalar
                </a>
            </div>
        </div>
    </div>

    @* ═══ FORM ═══ *@
    <div class="kt-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            @* ─── GENEL BİLGİLER ─── *@
            <div class="kt-section section-primary">
                <div class="kt-section-icon"><i class="fas fa-clipboard-list"></i></div>
                <div>
                    <span class="kt-section-title">Genel Bilgiler</span>
                    <span class="kt-section-desc">Kotanın kimlik bilgileri ve mevcut durumu</span>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-8">
                    <div class="kt-form-group">
                        <label class="kt-label">İş Adı <span class="req">*</span></label>
                        <input type="text" name="IsAdi" value="@Model.IsAdi" class="kt-input"
                               placeholder="Örn: İzmir İSM İlçeler" required />
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="kt-form-group">
                        <label class="kt-label">Kota Kodu</label>
                        <input type="text" name="KotaKodu" value="@Model.KotaKodu" class="kt-input"
                               placeholder="Q-00400577" />
                    </div>
                </div>

                <div class="col-6 col-md-4">
                    <div class="kt-form-group">
                        <label class="kt-label">Bölge</label>
                        <select name="Bolge" class="kt-select">
                            <option value="">— Bölge seçiniz —</option>
                            <option value="İzmir" selected="@(Model.Bolge == "İzmir")">İzmir</option>
                            <option value="Aydın" selected="@(Model.Bolge == "Aydın")">Aydın</option>
                            <option value="Isparta" selected="@(Model.Bolge == "Isparta")">Isparta</option>
                            <option value="Denizli" selected="@(Model.Bolge == "Denizli")">Denizli</option>
                            <option value="Burdur" selected="@(Model.Bolge == "Burdur")">Burdur</option>
                            <option value="Manisa" selected="@(Model.Bolge == "Manisa")">Manisa</option>
                            <option value="Diğer" selected="@(Model.Bolge == "Diğer")">Diğer</option>
                        </select>
                    </div>
                </div>

                <div class="col-6 col-md-4">
                    <div class="kt-form-group">
                        <label class="kt-label">Durum <span class="req">*</span></label>
                        <select name="Durum" class="kt-select">
                            <option value="0" selected="@(Model.Durum == CRMOzem.Core.Enums.KotaDurum.YeniBaslayacak)">Yeni Başlayacak</option>
                            <option value="1" selected="@(Model.Durum == CRMOzem.Core.Enums.KotaDurum.Onayda)">Onayda</option>
                            <option value="2" selected="@(Model.Durum == CRMOzem.Core.Enums.KotaDurum.Bekleyen)">Bekleyen</option>
                            <option value="3" selected="@(Model.Durum == CRMOzem.Core.Enums.KotaDurum.Aktif)">Aktif</option>
                            <option value="4" selected="@(Model.Durum == CRMOzem.Core.Enums.KotaDurum.Kapandi)">Kapandı</option>
                        </select>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="kt-form-group">
                        <label class="kt-label">Sorumlu</label>
                        <input type="text" name="Sorumlu" value="@Model.Sorumlu" class="kt-input"
                               placeholder="Örn: Erkan TARA" />
                    </div>
                </div>
            </div>

            @* ─── HASTANELER ─── *@
            <div class="kt-section section-hospital">
                <div class="kt-section-icon"><i class="fas fa-hospital"></i></div>
                <div>
                    <span class="kt-section-title">Kotaya Dahil Hastaneler</span>
                    <span class="kt-section-desc">Fatura girerken bu listedeki hastaneler seçilebilecek</span>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-12">
                    <div class="hospital-picker">
                        <div class="hospital-toolbar">
                            <input type="text" id="hospitalSearch" class="hospital-search" placeholder="Hastane ara..." />
                            <button type="button" class="btn-mini btn-mini-outline" id="btnSelectAll">
                                <i class="fas fa-check-double"></i> Tümü
                            </button>
                            <button type="button" class="btn-mini btn-mini-outline" id="btnClearAll">
                                <i class="fas fa-xmark"></i> Temizle
                            </button>
                            <button type="button" class="btn-mini btn-mini-success" id="btnYeniHastane">
                                <i class="fas fa-plus"></i> Yeni Hastane
                            </button>
                            <span class="badge-selected" id="secilenSayi">0 seçili</span>
                        </div>

                        <div class="hospital-list" id="hospitalList">
                            @if (!hospitals.Any())
                            {
                                <div class="hospital-empty" id="hospitalEmpty">
                                    <div class="hospital-empty-icon"><i class="fas fa-hospital"></i></div>
                                    <div>Sistemde hastane yok</div>
                                    <small><strong>"Yeni Hastane"</strong> ile hızlıca ekleyebilirsiniz</small>
                                </div>
                            }
                            else
                            {
                                @foreach (var h in hospitals)
                                {
                                    var isSecili = secilenIdler.Contains((int)h.HospitalID);
                                    <label class="hospital-item" data-name="@h.HospitalName.ToString().ToLowerInvariant()">
                                        <input type="checkbox" name="SecilenHastaneIdler" value="@h.HospitalID"
                                               class="hospital-check" @(isSecili ? "checked" : "") />
                                        <span>@h.HospitalName</span>
                                    </label>
                                }
                            }
                        </div>

                        <div class="kt-hint">
                            <i class="fas fa-lightbulb"></i>
                            Bu kotaya dahil olan hastaneleri işaretleyin. Listede yoksa yukarıdaki
                            <strong>&nbsp;Yeni Hastane&nbsp;</strong> butonu ile ekleyin.
                        </div>
                    </div>
                </div>
            </div>

            @* ─── PROFORMA & SÜRE ─── *@
            <div class="kt-section section-money">
                <div class="kt-section-icon"><i class="fas fa-money-bill-wave"></i></div>
                <div>
                    <span class="kt-section-title">Proforma &amp; Süre</span>
                    <span class="kt-section-desc">USD bazında proforma tutarı ve ihale süresi</span>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <div class="kt-form-group">
                        <label class="kt-label">Proforma Tarihi</label>
                        <input type="date" name="ProformaTarihi"
                               value="@(Model.ProformaTarihi?.ToString("yyyy-MM-dd"))" class="kt-input" />
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="kt-form-group">
                        <label class="kt-label">Proforma Tutarı (USD)</label>
                        <div class="kt-input-group">
                            <div class="kt-input-group-prefix is-usd">$</div>
                            <input type="number" step="0.01" name="ProformaTutarUsd"
                                   value="@Model.ProformaTutarUsd" placeholder="Örn: 2459629.18" />
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="kt-form-group">
                        <label class="kt-label">Süre (Ay)</label>
                        <input type="number" name="AySayisi" value="@Model.AySayisi"
                               class="kt-input" placeholder="Örn: 36" />
                        <div class="kt-hint"><i class="fas fa-circle-info"></i> Boş bırakılırsa tarihlerden otomatik hesaplanır.</div>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="kt-form-group">
                        <label class="kt-label">Başlama Tarihi</label>
                        <input type="date" name="BaslamaTarihi"
                               value="@(Model.BaslamaTarihi?.ToString("yyyy-MM-dd"))" class="kt-input" />
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="kt-form-group">
                        <label class="kt-label">Bitiş Tarihi</label>
                        <input type="date" name="BitisTarihi"
                               value="@(Model.BitisTarihi?.ToString("yyyy-MM-dd"))" class="kt-input" />
                    </div>
                </div>

                <div class="col-12">
                    <div class="kt-form-group">
                        <label class="kt-label">Açıklama</label>
                        <textarea name="Aciklama" class="kt-textarea" rows="3"
                                  placeholder="Notlar, özel durumlar, hatırlatmalar...">@Model.Aciklama</textarea>
                    </div>
                </div>
            </div>

            @* ─── ACTIONS ─── *@
            <div class="kt-actions">
                <a asp-action="Index" class="kt-btn kt-btn-ghost">
                    <i class="fas fa-arrow-left"></i> Geri
                </a>
                <button type="submit" class="kt-btn kt-btn-primary">
                    <i class="fas fa-floppy-disk"></i> Kotayı Kaydet
                </button>
            </div>
        </form>
    </div>
</div>

@* ═══ YENİ HASTANE MODAL — FORM DIŞINDA ═══ *@
<div class="kt-modal-backdrop" id="modalYeniHastane">
    <div class="kt-modal kt-modal-sm">
        <div class="kt-modal-head">
            <h5 class="kt-modal-title"><i class="fas fa-hospital"></i> Yeni Hastane Ekle</h5>
            <button type="button" class="kt-modal-close" id="modalCloseX" aria-label="Kapat">&times;</button>
        </div>
        <div class="kt-modal-body">
            <div class="kt-form-group">
                <label class="kt-label">Hastane Adı <span class="req">*</span></label>
                <input type="text" id="yeniHastaneAd" class="kt-input"
                       placeholder="Örn: Bergama Devlet Hastanesi" maxlength="200" autocomplete="off" />
            </div>
            <div class="kt-hint"><i class="fas fa-circle-info"></i> Enter tuşu ile hızlıca kaydedebilirsiniz.</div>
            <div class="modal-error" id="yeniHastaneHata"></div>
        </div>
        <div class="kt-modal-foot">
            <button type="button" class="kt-btn kt-btn-ghost" id="modalCloseBtn">İptal</button>
            <button type="button" class="kt-btn kt-btn-success" id="btnHastaneKaydet">
                <i class="fas fa-floppy-disk"></i> Kaydet ve Seç
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const list        = document.getElementById('hospitalList');
    const search      = document.getElementById('hospitalSearch');
    const btnAll      = document.getElementById('btnSelectAll');
    const btnClear    = document.getElementById('btnClearAll');
    const btnYeni     = document.getElementById('btnYeniHastane');
    const btnKaydet   = document.getElementById('btnHastaneKaydet');
    const sayiBadge   = document.getElementById('secilenSayi');
    const modal       = document.getElementById('modalYeniHastane');
    const yeniAd      = document.getElementById('yeniHastaneAd');
    const hata        = document.getElementById('yeniHastaneHata');
    const empty       = document.getElementById('hospitalEmpty');
    const modalCloseX = document.getElementById('modalCloseX');
    const modalCloseB = document.getElementById('modalCloseBtn');

    if (!list) return;

    const getItems  = () => list.querySelectorAll('.hospital-item');
    const getChecks = () => list.querySelectorAll('.hospital-check');

    function updateSayi() {
        const n = Array.from(getChecks()).filter(c => c.checked).length;
        sayiBadge.textContent = n + ' seçili';
    }
    function bindItem(item) {
        const cb = item.querySelector('.hospital-check');
        if (cb) cb.addEventListener('change', updateSayi);
    }

    // ── Arama ──
    search.addEventListener('input', () => {
        const q = search.value.toLowerCase().trim();
        getItems().forEach(item => {
            item.style.display = (!q || (item.dataset.name || '').includes(q)) ? '' : 'none';
        });
    });

    // ── Toplu seçim ──
    btnAll.addEventListener('click', () => {
        getItems().forEach(i => {
            if (i.style.display !== 'none') {
                const cb = i.querySelector('.hospital-check');
                if (cb) cb.checked = true;
            }
        });
        updateSayi();
    });
    btnClear.addEventListener('click', () => {
        getChecks().forEach(c => c.checked = false);
        updateSayi();
    });

    getItems().forEach(bindItem);
    updateSayi();

    // ── Modal ──
    function openModal() {
        hata.classList.remove('active');
        yeniAd.value = '';
        modal.classList.add('open');
        document.body.style.overflow = 'hidden';
        setTimeout(() => yeniAd.focus(), 80);
    }
    function closeModal() {
        modal.classList.remove('open');
        document.body.style.overflow = '';
    }
    btnYeni.addEventListener('click', openModal);
    modalCloseX.addEventListener('click', closeModal);
    modalCloseB.addEventListener('click', closeModal);
    modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && modal.classList.contains('open')) closeModal();
    });
    yeniAd.addEventListener('keypress', e => {
        if (e.key === 'Enter') { e.preventDefault(); btnKaydet.click(); }
    });

    // ── Hastane kaydet (AJAX) ──
    btnKaydet.addEventListener('click', async () => {
        const ad = yeniAd.value.trim();
        if (!ad) {
            hata.textContent = 'Hastane adı boş olamaz.';
            hata.classList.add('active');
            yeniAd.focus();
            return;
        }

        btnKaydet.disabled = true;
        const orig = btnKaydet.innerHTML;
        btnKaydet.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Kaydediliyor...';

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const fd = new FormData();
            fd.append('hospitalName', ad);
            fd.append('__RequestVerificationToken', token);

            const res = await fetch('@Url.Action("AddHospitalAjax", "Kota", new { area = "Finans" })',
                                    { method: 'POST', body: fd });
            if (!res.ok) throw new Error('HTTP ' + res.status);

            const data = await res.json();
            if (!data.success) {
                hata.textContent = data.message || 'Hata oluştu.';
                hata.classList.add('active');
                return;
            }

            if (empty) empty.style.display = 'none';

            const existing = list.querySelector('.hospital-check[value="' + data.hospitalId + '"]');
            if (existing) {
                existing.checked = true;
                const item = existing.closest('.hospital-item');
                item.classList.add('yeni-eklendi');
                item.scrollIntoView({ behavior: 'smooth', block: 'center' });
                setTimeout(() => item.classList.remove('yeni-eklendi'), 2300);
            } else {
                const label = document.createElement('label');
                label.className = 'hospital-item yeni-eklendi';
                label.dataset.name = data.hospitalName.toLowerCase();
                label.innerHTML =
                    '<input type="checkbox" name="SecilenHastaneIdler" value="' + data.hospitalId +
                    '" class="hospital-check" checked /><span></span>';
                label.querySelector('span').textContent = data.hospitalName;
                list.prepend(label);
                bindItem(label);
                label.scrollIntoView({ behavior: 'smooth', block: 'center' });
                setTimeout(() => label.classList.remove('yeni-eklendi'), 2300);
            }

            updateSayi();
            closeModal();
        } catch (err) {
            hata.textContent = 'Sunucu hatası: ' + err.message;
            hata.classList.add('active');
        } finally {
            btnKaydet.disabled = false;
            btnKaydet.innerHTML = orig;
        }
    });
})();
</script>
}
