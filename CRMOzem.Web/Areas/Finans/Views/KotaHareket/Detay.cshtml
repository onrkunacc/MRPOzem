<div class="kt-page">

    @* ═════════ HERO HEADER ═════════ *@
    <div class="kt-card" style="padding:0; overflow:hidden; margin-bottom:20px;">
        <div style="padding: 28px 32px; background: var(--kt-ink-900); color:#fff;">
            <div class="kt-flex-between">
                <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
                    @if (!string.IsNullOrEmpty(k.KotaKodu))
                    {
                        <span class="kt-code-badge primary" style="font-size:14px; padding:6px 12px;">@k.KotaKodu</span>
                    }
                    <div>
                        <h1 style="font-size:22px; font-weight:700; margin:0; color:#fff; letter-spacing:-0.015em;">@k.IsAdi</h1>
                        <div style="margin-top:6px; display:flex; align-items:center; gap:14px; flex-wrap:wrap; font-size:13px; color:#cbd5e1;">
                            @if (!string.IsNullOrEmpty(k.Bolge))
                            {
                                <span><i class="fas fa-map-marker-alt" style="margin-right:5px;"></i>@k.Bolge</span>
                            }
                            @if (!string.IsNullOrEmpty(k.Sorumlu))
                            {
                                <span><i class="fas fa-user" style="margin-right:5px;"></i>@k.Sorumlu</span>
                            }
                            @if (k.BaslamaTarihi.HasValue || k.BitisTarihi.HasValue)
                            {
                                <span>
                                    <i class="fas fa-calendar" style="margin-right:5px;"></i>
                                    @(k.BaslamaTarihi?.ToString("dd.MM.yyyy") ?? "—") → @(k.BitisTarihi?.ToString("dd.MM.yyyy") ?? "—")
                                </span>
                            }
                        </div>
                    </div>
                </div>
                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                    @switch (k.Durum)
                    {
                        case KotaDurum.Aktif:
                            <span class="kt-badge kt-badge-success" style="padding:6px 14px; font-size:12.5px;"><i class="fas fa-circle-check"></i> Aktif</span>
                            break;
                        case KotaDurum.YeniBaslayacak:
                            <span class="kt-badge kt-badge-info" style="padding:6px 14px; font-size:12.5px;"><i class="fas fa-circle-plus"></i> Yeni Başlayacak</span>
                            break;
                        case KotaDurum.Onayda:
                            <span class="kt-badge kt-badge-warning" style="padding:6px 14px; font-size:12.5px;"><i class="fas fa-hourglass"></i> Onayda</span>
                            break;
                        case KotaDurum.Bekleyen:
                            <span class="kt-badge kt-badge-secondary" style="padding:6px 14px; font-size:12.5px;"><i class="fas fa-pause"></i> Bekleyen</span>
                            break;
                        case KotaDurum.Kapandi:
                            <span class="kt-badge kt-badge-danger" style="padding:6px 14px; font-size:12.5px;"><i class="fas fa-lock"></i> Kapandı</span>
                            break;
                    }
                    <a href="@Url.Action("Index", "Kota", new { area = "Finans" })" class="kt-btn" style="background:rgba(255,255,255,0.1); color:#fff; border:1px solid rgba(255,255,255,0.2);">
                        <i class="fas fa-arrow-left"></i> Kotalar
                    </a>
                </div>
            </div>
        </div>

        @* Alt şerit: proforma + kullanım *@
        <div style="padding: 20px 32px; background:#fff;">
            <div class="kt-flex-between" style="margin-bottom:10px;">
                <div>
                    <div style="font-size:11px; font-weight:600; color:var(--kt-ink-500); text-transform:uppercase; letter-spacing:0.05em;">
                        Toplam Proforma
                    </div>
                    <div style="font-size:30px; font-weight:800; color:var(--kt-ink-900); letter-spacing:-0.025em; font-variant-numeric: tabular-nums;">
                        $@k.ProformaTutarUsd.ToString("N0")
                    </div>
                </div>
                <div style="text-align:right;">
                    <div style="font-size:11px; font-weight:600; color:var(--kt-ink-500); text-transform:uppercase; letter-spacing:0.05em;">
                        Kullanım
                    </div>
                    <div style="font-size:22px; font-weight:700; color:@(kullanim > 100 ? "var(--kt-neg)" : kullanim > 80 ? "var(--kt-warn)" : "var(--kt-pos)");">
                        %@kullanim.ToString("N1")
                    </div>
                </div>
            </div>
            <div class="kt-progress">
                <div class="kt-progress-bar @kullanimCls" style="width:@(Math.Min(kullanim, 100).ToString("F0", inv))%;"></div>
            </div>
            <div class="kt-flex-between" style="margin-top:6px; font-size:12px; color:var(--kt-ink-500);">
                <span>Harcanan: $@toplamGider.ToString("N0")</span>
                <span>Kalan: $@((k.ProformaTutarUsd - toplamGider).ToString("N0"))</span>
            </div>
        </div>
    </div>

    @* ═════════ KPI ═════════ *@
    <div class="kt-kpi-grid">
        <div class="kt-kpi accent-neg">
            <div class="kt-kpi-head">
                <div class="kt-kpi-label">Toplam Gider</div>
                <div class="kt-kpi-icon"><i class="fas fa-arrow-trend-down"></i></div>
            </div>
            <div class="kt-kpi-value">$@toplamGider.ToString("N0")</div>
            <div class="kt-kpi-foot">@Model.Hareketler.Count(h => h.Tur == KotaHareketTuru.Gider) hareket</div>
        </div>
        <div class="kt-kpi accent-pos">
            <div class="kt-kpi-head">
                <div class="kt-kpi-label">Toplam Gelir</div>
                <div class="kt-kpi-icon"><i class="fas fa-arrow-trend-up"></i></div>
            </div>
            <div class="kt-kpi-value">$@toplamGelir.ToString("N0")</div>
            <div class="kt-kpi-foot">@Model.Hareketler.Count(h => h.Tur == KotaHareketTuru.Gelir) hareket</div>
        </div>
        <div class="kt-kpi @(pos ? "accent-pos" : "accent-warn")">
            <div class="kt-kpi-head">
                <div class="kt-kpi-label">Brüt Fark</div>
                <div class="kt-kpi-icon"><i class="fas @(pos ? "fa-chart-line" : "fa-triangle-exclamation")"></i></div>
            </div>
            <div class="kt-kpi-value" style="color:@(pos ? "var(--kt-pos)" : "var(--kt-neg)");">
                @(pos ? "+" : "")$@brutFark.ToString("N0")
            </div>
            <div class="kt-kpi-foot">
                @if (toplamGelir > 0)
                {
                    <span>marj %@(((brutFark / toplamGelir) * 100).ToString("N1"))</span>
                }
                else
                {
                    <span>gelir girilmemiş</span>
                }
            </div>
        </div>
        <div class="kt-kpi accent-primary">
            <div class="kt-kpi-head">
                <div class="kt-kpi-label">Toplam Hareket</div>
                <div class="kt-kpi-icon"><i class="fas fa-list"></i></div>
            </div>
            <div class="kt-kpi-value">@Model.Hareketler.Count</div>
            <div class="kt-kpi-foot">@aylikSatirlar.Count(x => x.Adet > 0) ayda kayıt var</div>
        </div>
    </div>

    @* ═════════════════════════════════════════════════════════
       AYLIK GELİR / GİDER / BRÜT FARK  — bu kotanın ay ay dökümü
       ═════════════════════════════════════════════════════════ *@
    @if (aylikSatirlar.Any())
    {
        <div class="kt-card kt-card-flush">
            <div style="padding:18px 24px; border-bottom:1px solid var(--kt-border);">
                <div class="kt-flex kt-gap-md">
                    <div class="kt-section-icon"><i class="fas fa-calendar-days"></i></div>
                    <div style="flex:1;">
                        <div style="font-weight:700; color:var(--kt-ink-900); font-size:15px;">Aylık Gelir / Gider Dağılımı</div>
                        <div style="font-size:12px; color:var(--kt-ink-500);">
                            @aylikSatirlar.First().Ay.ToString("MMMM yyyy", tr) — @aylikSatirlar.Last().Ay.ToString("MMMM yyyy", tr)
                            · @aylikSatirlar.Count ay
                            @if (aylikSatirlar.Any(x => x.Adet == 0))
                            {
                                <span> · </span>
                                <span style="color:var(--kt-warn);">@aylikSatirlar.Count(x => x.Adet == 0) ayda hiç hareket yok</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="kt-monthly-wrap">
                <table class="kt-monthly">
                    <thead>
                        <tr>
                            <th>Ay</th>
                            <th class="num">Gelir (USD)</th>
                            <th class="num">Gider (USD)</th>
                            <th class="num">Brüt Fark</th>
                            <th class="num col-marj">Fark %</th>
                            <th class="num">Toplam</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            decimal kumulatif = 0m;
                        }
                        @foreach (var s in aylikSatirlar)
                        {
                            var fark = s.Gelir - s.Gider;
                            kumulatif += fark;
                            var bos = s.Adet == 0;
                            var farkCls = bos ? "nul" : (fark > 0 ? "pos" : fark < 0 ? "neg" : "nul");
                            var marj = s.Gelir > 0 ? (fark / s.Gelir) * 100 : (decimal?)null;

                            <tr class="@(bos ? "ay-bos" : "")">
                                <td>
                                    <div class="ay-adi">@s.Ay.ToString("MMMM yyyy", tr)</div>
                                    <div class="ay-adet">@(bos ? "hareket yok" : $"{s.Adet} hareket")</div>
                                </td>

                                <td class="num">
                                    @if (s.Gelir > 0)
                                    {
                                        <span class="tutar-usd m-gelir">@Usd(s.Gelir, true)</span>
                                        @if (s.GelirTl > 0)
                                        {
                                            <span class="tutar-tl">@Tl(s.GelirTl)</span>
                                        }
                                        <div class="m-bar gelir"><i style="width:@BarW(s.Gelir)%;"></i></div>
                                    }
                                    else
                                    {
                                        <span class="tutar-usd m-sifir">—</span>
                                    }
                                </td>

                                <td class="num">
                                    @if (s.Gider > 0)
                                    {
                                        <span class="tutar-usd m-gider">-@Usd(s.Gider)</span>
                                        @if (s.GiderTl > 0)
                                        {
                                            <span class="tutar-tl">@Tl(s.GiderTl)</span>
                                        }
                                        <div class="m-bar gider"><i style="width:@BarW(s.Gider)%;"></i></div>
                                    }
                                    else
                                    {
                                        <span class="tutar-usd m-sifir">—</span>
                                    }
                                </td>

                                <td class="num">
                                    <span class="fark-chip @farkCls">@(bos ? "—" : Usd(fark, true))</span>
                                </td>

                                <td class="num col-marj">
                                    @if (marj.HasValue)
                                    {
                                        <span class="marj-val" style="color:@(marj.Value >= 0 ? "var(--kt-pos)" : "var(--kt-neg)");">
                                            %@marj.Value.ToString("N1")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="m-sifir">—</span>
                                    }
                                </td>

                                <td class="num">
                                    <span class="kumul-val @(kumulatif >= 0 ? "pos" : "neg")">@Usd(kumulatif, true)</span>
                                </td>
                            </tr>
                        }
                    </tbody>

                    @* ─── DİP TOPLAM ─── *@
                    <tfoot>
                        <tr>
                            <td>
                                <span class="dip-label">Dip Toplam</span>
                                @Model.Hareketler.Count hareket · @aylikSatirlar.Count ay
                            </td>
                            <td class="num">
                                <span class="dip-gelir">@Usd(toplamGelir, true)</span>
                                @if (toplamGelirTl > 0)
                                {
                                    <span class="dip-tl">@Tl(toplamGelirTl)</span>
                                }
                            </td>
                            <td class="num">
                                <span class="dip-gider">-@Usd(toplamGider)</span>
                                @if (toplamGiderTl > 0)
                                {
                                    <span class="dip-tl">@Tl(toplamGiderTl)</span>
                                }
                            </td>
                            <td class="num">
                                <span class="@(pos ? "dip-net-pos" : "dip-net-neg")">@Usd(brutFark, true)</span>
                                @if (brutFarkTl != 0)
                                {
                                    <span class="dip-tl">@Tl(brutFarkTl, true)</span>
                                }
                            </td>
                            <td class="num col-marj">
                                @if (toplamGelir > 0)
                                {
                                    <span class="@(pos ? "dip-net-pos" : "dip-net-neg")">%@(((brutFark / toplamGelir) * 100).ToString("N1"))</span>
                                }
                                else
                                {
                                    <span style="color:var(--kt-ink-500);">—</span>
                                }
                            </td>
                            <td class="num">
                                <span class="@(pos ? "dip-net-pos" : "dip-net-neg")">@Usd(brutFark, true)</span>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }

    @* ═════════ İŞLEM BUTONLARI ═════════ *@
    <div class="kt-card" style="padding:14px 20px; display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
        <a class="kt-btn kt-btn-primary" href="@Url.Action("Create", "KotaHareket", new { area = "Finans", kotaId = k.KotaID })">
            <i class="fas fa-plus"></i> Yeni Hareket
        </a>
        <a class="kt-btn kt-btn-ghost" href="@Url.Action("Edit", "Kota", new { area = "Finans", id = k.KotaID })">
            <i class="fas fa-pen"></i> Kotayı Düzenle
        </a>
        <div class="kt-filtre-grup">
            <input type="text" id="hareketSearch" class="kt-input" placeholder="Ara: fatura no, açıklama…" style="width:205px;" />

            <select id="turFilter" class="kt-select" style="width:130px;" title="Hareket türü">
                <option value="">Tüm türler</option>
                <option value="0">Giderler</option>
                <option value="1">Gelirler</option>
            </select>

            @if (Model.Tedarikciler.Any())
            {
                <select id="tedarikciFilter" class="kt-select" style="width:175px;" title="Tedarikçi / müşteri">
                    <option value="">Tüm tedarikçiler</option>
                    @foreach (var t in Model.Tedarikciler)
                    {
                        <option value="@t.Deger">@t.Etiket (@t.Adet)</option>
                    }
                </select>
            }

            @if (Model.Hastaneler.Any())
            {
                <select id="hastaneFilter" class="kt-select" style="width:185px;" title="Hastane">
                    <option value="">Tüm hastaneler</option>
                    @foreach (var hs in Model.Hastaneler)
                    {
                        <option value="@hs.Deger">@hs.Etiket (@hs.Adet)</option>
                    }
                    <option value="yok">— Hastanesiz —</option>
                </select>
            }

            <select id="siralamaSec" class="kt-select" style="width:170px;" title="Sıralama">
                <option value="tarih-desc">Tarih: yeni → eski</option>
                <option value="tarih-asc">Tarih: eski → yeni</option>
                <option value="tutar-desc">Tutar: büyük → küçük</option>
                <option value="tutar-asc">Tutar: küçük → büyük</option>
                <option value="fatura-asc">Fatura No: A → Z</option>
            </select>

            <button type="button" class="kt-btn kt-btn-ghost" id="filtreSifirla" title="Filtre ve sıralamayı sıfırla">
                <i class="fas fa-rotate-left"></i>
            </button>
        </div>
    </div>

    @* ═════════ HAREKETLER TABLOSU ═════════ *@
    <div class="kt-card kt-card-flush">
        <div style="padding:18px 24px; border-bottom:1px solid var(--kt-border);">
            <div class="kt-flex kt-gap-md">
                <div class="kt-section-icon"><i class="fas fa-list-check"></i></div>
                <div>
                    <div style="font-weight:700; color:var(--kt-ink-900); font-size:15px;">Hareketler</div>
                    <div style="font-size:12px; color:var(--kt-ink-500);">Gider ve gelir kayıtları — sıralama ve filtreler üstteki çubuktan</div>
                </div>
            </div>
        </div>

        @if (Model.Hareketler.Any())
        {
            @* Filtre aktifken dip toplamın neyi kapsadığını açıkça söyle *@
            <div class="kt-filtre-uyari" id="hareketFiltreUyari">
                <i class="fas fa-filter"></i>
                <span>Filtre aktif — aşağıdaki dip toplam yalnızca <strong>filtreye uyan</strong> hareketleri kapsıyor.</span>
            </div>

            <div class="kt-table-wrap">
                <table class="kt-table" id="hareketTable">
                    <thead>
                        <tr>
                            <th class="col-sira">#</th>
                            <th class="th-sortable" data-sort="tarih" title="Tarihe göre sırala">
                                Tarih <i class="fas fa-sort sort-ikon"></i>
                            </th>
                            <th>Fatura No</th>
                            <th>Tür</th>
                            <th>Tedarikçi / Müşteri</th>
                            <th>Grup</th>
                            @if (hastaneKolonVar)
                            {
                                <th>Hastane</th>
                            }
                            <th>Açıklama</th>
                            <th class="text-right">Tutar (USD)</th>
                            <th class="text-right">Tutar (TL)</th>
                            <th class="text-center" style="width:1%;">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var sira = 0;
                        }
                        @foreach (var h in Model.Hareketler.OrderByDescending(x => x.Tarih))
                        {
                            sira++;
                            var gider = h.Tur == KotaHareketTuru.Gider;

                            // Razor ifadelerini sadeleştirmek için önce yerel değişkenler
                            var tarihMetni = h.TarihYok ? "" : h.Tarih.ToString("dd.MM.yyyy");
                            var tarihIso = h.TarihYok ? "" : h.Tarih.ToString("yyyy-MM-dd");
                            var hastaneAnahtar = h.HospitalID.HasValue ? h.HospitalID.Value.ToString() : "yok";
                            var faturaNo = h.FaturaNo ?? "";
                            var aramaMetni = string.Join(" ",
                                tarihMetni, faturaNo, h.TedarikciAdi, h.Aciklama, h.HospitalName).ToLowerInvariant();

                            <tr data-search="@aramaMetni"
                                data-tur="@((int)h.Tur)"
                                data-usd="@h.TutarUsd.ToString(inv)"
                                data-tl="@((h.TutarTl ?? 0m).ToString(inv))"
                                data-tedarikci="@h.TedarikciID"
                                data-hastane="@hastaneAnahtar"
                                data-tarih="@tarihIso"
                                data-fatura="@faturaNo">
                                <td class="col-sira">@sira</td>
                                <td style="white-space:nowrap;">
                                    @if (h.TarihYok)
                                    {
                                        <span class="text-muted" title="Fatura tarihi girilmemiş">—</span>
                                    }
                                    else
                                    {
                                        <strong>@h.Tarih.ToString("dd.MM.yyyy")</strong>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(h.FaturaNo))
                                    {
                                        <span class="fatura-no">@h.FaturaNo</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (gider)
                                    {
                                        <span class="kt-badge kt-badge-danger"><i class="fas fa-arrow-down"></i> Gider</span>
                                    }
                                    else
                                    {
                                        <span class="kt-badge kt-badge-success"><i class="fas fa-arrow-up"></i> Gelir</span>
                                    }
                                </td>
                                <td class="kt-cell-primary">@(h.TedarikciAdi ?? "—")</td>
                                <td>
                                    @if (h.TedarikciGrup.HasValue)
                                    {
                                        <span class="kt-tag">@h.TedarikciGrup.Value</span>
                                    }
                                    else
                                    {

                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                @if (hastaneKolonVar)
                                {
                                    <td>
                                        @if (!string.IsNullOrEmpty(h.HospitalName))
                                        {
                                            <span style="font-size:12px; color:var(--kt-ink-700);">@h.HospitalName</span>
                                        }
                                        else
                                        {

                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                }
                                <td style="max-width:300px; color:var(--kt-ink-500); font-size:12.5px;">
                                    @(string.IsNullOrEmpty(h.Aciklama) ? "—" : h.Aciklama)
                                </td>
                                <td class="text-right">
                                    <span class="@(gider ? "kt-money-neg" : "kt-money-pos")" style="font-size:14px;">
                                        @(gider ? "-" + Usd(h.TutarUsd) : Usd(h.TutarUsd, true))
                                    </span>
                                </td>
                                <td class="text-right kt-money-muted" style="font-size:12.5px;">
                                    @(h.TutarTl.HasValue ? Tl(h.TutarTl.Value) : "—")
                                </td>
                                <td class="text-center">
                                    <div style="display:flex; gap:4px; justify-content:flex-end;">
                                        <a class="kt-btn kt-btn-sm kt-btn-ghost"
                                           href="@Url.Action("Edit", "KotaHareket", new { area = "Finans", id = h.ID })" title="Düzenle">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <form method="post" action="@Url.Action("Delete", "KotaHareket", new { area = "Finans", id = h.ID })" style="display:inline;"
                                              onsubmit="return confirm('Bu hareketi silmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="kt-btn kt-btn-sm kt-btn-ghost" style="color:var(--kt-neg);" title="Sil">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                    @* ─── DİP TOPLAM ─── *@
                    @* Değerler JS ile filtreye göre yeniden hesaplanır; aşağıdakiler
                       sunucudan gelen tam toplamlardır (JS kapalıysa da doğru görünür). *@
                    <tfoot>
                        <tr>
                            <td colspan="@footColspan" class="text-right">
                                <span class="foot-label" id="footKapsamGelir">Toplam Gelir</span>
                            </td>
                            <td class="text-right kt-money-pos" id="footGelirUsd">@Usd(toplamGelir, true)</td>
                            <td class="text-right kt-money-muted" id="footGelirTl">@(toplamGelirTl > 0 ? Tl(toplamGelirTl) : "—")</td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan="@footColspan" class="text-right">
                                <span class="foot-label" id="footKapsamGider">Toplam Gider</span>
                            </td>
                            <td class="text-right kt-money-neg" id="footGiderUsd">-@Usd(toplamGider)</td>
                            <td class="text-right kt-money-muted" id="footGiderTl">@(toplamGiderTl > 0 ? Tl(toplamGiderTl) : "—")</td>
                            <td></td>
                        </tr>
                        <tr class="net-row">
                            <td colspan="@footColspan" class="text-right">
                                <span class="foot-label">Net Brüt Fark</span>
                            </td>
                            <td class="text-right" id="footNetUsd" style="color:@(pos ? "#6ee7b7" : "#fca5a5");">@Usd(brutFark, true)</td>
                            <td class="text-right" id="footNetTl" style="color:var(--kt-ink-400); font-weight:600;">
                                @(brutFarkTl != 0 ? Tl(brutFarkTl, true) : "—")
                            </td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            @* Filtre hiçbir şeye uymadığında *@
            <div class="kt-sonuc-yok" id="hareketSonucYok">
                <i class="fas fa-magnifying-glass"></i>
                Aramanıza uyan hareket bulunamadı.
                <div style="margin-top:12px;">
                    <button type="button" class="kt-btn kt-btn-sm kt-btn-ghost" id="hareketFiltreTemizle">
                        <i class="fas fa-xmark"></i> Filtreyi temizle
                    </button>
                </div>
            </div>

            @* ─── SAYFALAMA ─── *@
            <div class="kt-pager" id="hareketPager">
                <div class="kt-pager-info" id="hareketPagerInfo"></div>

                <div class="kt-pager-nav">
                    <button type="button" class="kt-pager-btn" id="hareketIlk" title="İlk sayfa">
                        <i class="fas fa-angles-left"></i>
                    </button>
                    <button type="button" class="kt-pager-btn" id="hareketPrev" title="Önceki sayfa">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <div class="kt-pager-pages" id="hareketPagerPages"></div>
                    <button type="button" class="kt-pager-btn" id="hareketNext" title="Sonraki sayfa">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                    <button type="button" class="kt-pager-btn" id="hareketSon" title="Son sayfa">
                        <i class="fas fa-angles-right"></i>
                    </button>
                </div>

                <div class="kt-pager-size">
                    <label for="sayfaBoyut">Sayfa başına</label>
                    <select id="sayfaBoyut" class="kt-select">
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="all">Tümü</option>
                    </select>
                </div>
            </div>
        }
        else
        {
            <div class="kt-empty">
                <i class="fas fa-receipt"></i>
                <p>Henüz bu kota için hareket girilmemiş</p>
                <a class="kt-btn kt-btn-primary" href="@Url.Action("Create", "KotaHareket", new { area = "Finans", kotaId = k.KotaID })" style="margin-top:14px;">
                    <i class="fas fa-plus"></i> İlk Hareketi Ekle
                </a>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            var tablo = document.getElementById('hareketTable');
            if (!tablo) return;

            var govdeEl   = tablo.querySelector('tbody');
            var satirlar  = Array.prototype.slice.call(tablo.querySelectorAll('tbody tr'));
            var aramaEl   = document.getElementById('hareketSearch');
            var turEl     = document.getElementById('turFilter');
            var boyutEl   = document.getElementById('sayfaBoyut');

            var tedarikciEl = document.getElementById('tedarikciFilter');
            var hastaneEl   = document.getElementById('hastaneFilter');
            var siralamaEl  = document.getElementById('siralamaSec');
            var sifirlaEl   = document.getElementById('filtreSifirla');
            var tarihBasligi = tablo.querySelector('.th-sortable[data-sort="tarih"]');

            var pagerEl   = document.getElementById('hareketPager');
            var bilgiEl   = document.getElementById('hareketPagerInfo');
            var sayfalarEl= document.getElementById('hareketPagerPages');
            var ilkBtn    = document.getElementById('hareketIlk');
            var oncekiBtn = document.getElementById('hareketPrev');
            var sonrakiBtn= document.getElementById('hareketNext');
            var sonBtn    = document.getElementById('hareketSon');

            var sonucYokEl= document.getElementById('hareketSonucYok');
            var temizleBtn= document.getElementById('hareketFiltreTemizle');
            var uyariEl   = document.getElementById('hareketFiltreUyari');
            var tfootEl   = tablo.querySelector('tfoot');

            var footGelirUsd = document.getElementById('footGelirUsd');
            var footGelirTl  = document.getElementById('footGelirTl');
            var footGiderUsd = document.getElementById('footGiderUsd');
            var footGiderTl  = document.getElementById('footGiderTl');
            var footNetUsd   = document.getElementById('footNetUsd');
            var footNetTl    = document.getElementById('footNetTl');
            var kapsamGelir  = document.getElementById('footKapsamGelir');
            var kapsamGider  = document.getElementById('footKapsamGider');

            var DEPO_ANAHTARI = 'kotaHareketSayfaBoyutu';
            var sayfa = 1;

            // ── Kaydedilmiş sayfa boyutunu geri yükle ──
            try {
                var kayitli = localStorage.getItem(DEPO_ANAHTARI);
                if (kayitli && boyutEl.querySelector('option[value="' + kayitli + '"]')) {
                    boyutEl.value = kayitli;
                }
            } catch (e) { /* gizli sekme vb. — varsayılanla devam */ }

            function boyutAl() {
                return boyutEl.value === 'all' ? Number.MAX_SAFE_INTEGER : parseInt(boyutEl.value, 10) || 25;
            }

            function paraTr(deger) {
                return deger.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            // ── Filtreye uyan satırlar ──
            function eslesenler() {
                var q  = (aramaEl && aramaEl.value ? aramaEl.value : '').trim().toLowerCase();
                var t  = turEl ? turEl.value : '';
                var td = tedarikciEl ? tedarikciEl.value : '';
                var hs = hastaneEl ? hastaneEl.value : '';

                return satirlar.filter(function (tr) {
                    if (q && (tr.dataset.search || '').indexOf(q) === -1) return false;
                    if (t && tr.dataset.tur !== t) return false;
                    if (td && tr.dataset.tedarikci !== td) return false;
                    if (hs && tr.dataset.hastane !== hs) return false;
                    return true;
                });
            }

            function filtreAktifMi() {
                return (aramaEl && aramaEl.value.trim().length > 0)
                    || (turEl && turEl.value.length > 0)
                    || (tedarikciEl && tedarikciEl.value.length > 0)
                    || (hastaneEl && hastaneEl.value.length > 0);
            }

            // ── Sıralama ──────────────────────────────────────────────
            // Satırlar DOM'da yeniden diziliyor. Sayfalama da `satirlar`
            // dizisi üzerinden çalıştığı için ikisi aynı sırayı görüyor.
            function sirala() {
                var secim = siralamaEl ? siralamaEl.value : 'tarih-desc';
                var parca = secim.split('-');
                var alan  = parca[0];
                var artan = parca[1] === 'asc';

                satirlar.sort(function (a, b) {
                    var x, y;

                    if (alan === 'tutar') {
                        x = parseFloat(a.dataset.usd) || 0;
                        y = parseFloat(b.dataset.usd) || 0;
                    } else if (alan === 'fatura') {
                        x = (a.dataset.fatura || '').toLowerCase();
                        y = (b.dataset.fatura || '').toLowerCase();
                        // Fatura numarası olmayanlar her zaman sona
                        if (!x && y) return 1;
                        if (x && !y) return -1;
                        var fk = x.localeCompare(y, 'tr', { numeric: true });
                        return artan ? fk : -fk;
                    } else {
                        // Tarihsiz kayıtlar her zaman sona (ISO metin karşılaştırması)
                        x = a.dataset.tarih || '';
                        y = b.dataset.tarih || '';
                        if (!x && y) return 1;
                        if (x && !y) return -1;
                    }

                    if (x < y) return artan ? -1 : 1;
                    if (x > y) return artan ? 1 : -1;
                    return 0;
                });

                // Yeni sırayı DOM'a tek seferde yaz
                var frag = document.createDocumentFragment();
                satirlar.forEach(function (tr) { frag.appendChild(tr); });
                govdeEl.appendChild(frag);

                // Tarih başlığındaki ok işaretini tazele
                if (tarihBasligi) {
                    var tarihe = alan === 'tarih';
                    var ikon = tarihBasligi.querySelector('.sort-ikon');
                    tarihBasligi.classList.toggle('is-sorted', tarihe);
                    if (ikon) {
                        ikon.className = 'fas sort-ikon ' +
                            (tarihe ? (artan ? 'fa-sort-up' : 'fa-sort-down') : 'fa-sort');
                    }
                }
            }

            // ── Dip toplamı görünen kümeye göre yeniden hesapla ──
            function toplamlariYaz(kume, filtreli) {
                var gelirUsd = 0, gelirTl = 0, giderUsd = 0, giderTl = 0;

                kume.forEach(function (tr) {
                    var usd = parseFloat(tr.dataset.usd) || 0;
                    var tl  = parseFloat(tr.dataset.tl) || 0;
                    if (tr.dataset.tur === '1') { gelirUsd += usd; gelirTl += tl; }
                    else                        { giderUsd += usd; giderTl += tl; }
                });

                var netUsd = gelirUsd - giderUsd;
                var netTl  = gelirTl - giderTl;
                var artiMi = netUsd >= 0;

                footGelirUsd.textContent = '+$' + paraTr(gelirUsd);
                footGelirTl.textContent  = gelirTl > 0 ? '₺' + paraTr(gelirTl) : '—';
                footGiderUsd.textContent = '-$' + paraTr(giderUsd);
                footGiderTl.textContent  = giderTl > 0 ? '₺' + paraTr(giderTl) : '—';

                footNetUsd.textContent = (artiMi ? '+$' : '-$') + paraTr(Math.abs(netUsd));
                footNetUsd.style.color = artiMi ? '#6ee7b7' : '#fca5a5';
                footNetTl.textContent  = netTl !== 0 ? (netTl >= 0 ? '+₺' : '-₺') + paraTr(Math.abs(netTl)) : '—';

                kapsamGelir.textContent = filtreli ? 'Filtrelenmiş Gelir' : 'Toplam Gelir';
                kapsamGider.textContent = filtreli ? 'Filtrelenmiş Gider' : 'Toplam Gider';
            }

            // ── Sayfa düğmelerini kur ──
            function sayfaDugmeleri(toplamSayfa) {
                sayfalarEl.innerHTML = '';

                if (toplamSayfa <= 1) return;

                var gosterilecek = [];

                if (toplamSayfa <= 7) {
                    for (var i = 1; i <= toplamSayfa; i++) gosterilecek.push(i);
                } else {
                    gosterilecek.push(1);
                    if (sayfa > 3) gosterilecek.push('...');

                    var bas = Math.max(2, sayfa - 1);
                    var bit = Math.min(toplamSayfa - 1, sayfa + 1);
                    for (var j = bas; j <= bit; j++) gosterilecek.push(j);

                    if (sayfa < toplamSayfa - 2) gosterilecek.push('...');
                    gosterilecek.push(toplamSayfa);
                }

                gosterilecek.forEach(function (p) {
                    if (p === '...') {
                        var ara = document.createElement('span');
                        ara.className = 'kt-pager-ara';
                        ara.textContent = '…';
                        sayfalarEl.appendChild(ara);
                        return;
                    }

                    var btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'kt-pager-btn' + (p === sayfa ? ' aktif' : '');
                    btn.textContent = p;
                    if (p !== sayfa) {
                        btn.addEventListener('click', function () { sayfa = p; ciz(); kaydir(); });
                    }
                    sayfalarEl.appendChild(btn);
                });
            }

            function kaydir() {
                var kart = tablo.closest('.kt-card');
                if (kart) kart.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            // ── Ana çizim ──
            function ciz() {
                sirala();
                var kume   = eslesenler();
                var toplam = kume.length;
                var boyut  = boyutAl();
                var filtreli = filtreAktifMi();

                var toplamSayfa = Math.max(1, Math.ceil(toplam / boyut));
                if (sayfa > toplamSayfa) sayfa = toplamSayfa;
                if (sayfa < 1) sayfa = 1;

                var bas = (sayfa - 1) * boyut;
                var bit = Math.min(bas + boyut, toplam);

                // Önce hepsini gizle, sonra sayfadakileri aç ve numaralandır
                satirlar.forEach(function (tr) { tr.style.display = 'none'; });

                for (var i = bas; i < bit; i++) {
                    kume[i].style.display = '';
                    var hucre = kume[i].querySelector('.col-sira');
                    if (hucre) hucre.textContent = (i + 1);
                }

                // Sonuç yok durumu
                var bos = toplam === 0;
                sonucYokEl.classList.toggle('gorunur', bos);
                tablo.style.display = bos ? 'none' : '';
                pagerEl.style.display = bos ? 'none' : '';
                if (tfootEl) tfootEl.style.display = bos ? 'none' : '';

                uyariEl.classList.toggle('gorunur', filtreli && !bos);

                if (bos) {
                    bilgiEl.textContent = '';
                    return;
                }

                toplamlariYaz(kume, filtreli);

                // Bilgi satırı
                var kapsamNotu = filtreli ? ' (' + satirlar.length + ' kayıt içinden)' : '';
                bilgiEl.innerHTML = '<strong>' + (bas + 1) + '–' + bit + '</strong> / ' +
                                    '<strong>' + toplam + '</strong> kayıt' + kapsamNotu;

                // Düğmeler
                ilkBtn.disabled    = sayfa === 1;
                oncekiBtn.disabled = sayfa === 1;
                sonrakiBtn.disabled= sayfa === toplamSayfa;
                sonBtn.disabled    = sayfa === toplamSayfa;

                sayfaDugmeleri(toplamSayfa);
            }

            // ── Olaylar ──
            function filtreDegisti() { sayfa = 1; ciz(); }

            function filtreleriSifirla() {
                if (aramaEl) aramaEl.value = '';
                if (turEl) turEl.value = '';
                if (tedarikciEl) tedarikciEl.value = '';
                if (hastaneEl) hastaneEl.value = '';
                filtreDegisti();
            }

            if (aramaEl)     aramaEl.addEventListener('input', filtreDegisti);
            if (turEl)       turEl.addEventListener('change', filtreDegisti);
            if (tedarikciEl) tedarikciEl.addEventListener('change', filtreDegisti);
            if (hastaneEl)   hastaneEl.addEventListener('change', filtreDegisti);
            if (siralamaEl)  siralamaEl.addEventListener('change', filtreDegisti);

            // Tarih başlığına tıklayınca yönü ters çevir
            if (tarihBasligi && siralamaEl) {
                tarihBasligi.addEventListener('click', function () {
                    siralamaEl.value = (siralamaEl.value === 'tarih-desc') ? 'tarih-asc' : 'tarih-desc';
                    filtreDegisti();
                });
            }

            if (sifirlaEl) {
                sifirlaEl.addEventListener('click', function () {
                    if (siralamaEl) siralamaEl.value = 'tarih-desc';
                    filtreleriSifirla();
                });
            }

            boyutEl.addEventListener('change', function () {
                try { localStorage.setItem(DEPO_ANAHTARI, boyutEl.value); } catch (e) { }
                sayfa = 1;
                ciz();
            });

            ilkBtn.addEventListener('click', function ()    { sayfa = 1; ciz(); kaydir(); });
            oncekiBtn.addEventListener('click', function () { sayfa--; ciz(); kaydir(); });
            sonrakiBtn.addEventListener('click', function (){ sayfa++; ciz(); kaydir(); });
            sonBtn.addEventListener('click', function ()    {
                sayfa = Math.max(1, Math.ceil(eslesenler().length / boyutAl()));
                ciz(); kaydir();
            });

            if (temizleBtn) {
                temizleBtn.addEventListener('click', filtreleriSifirla);
            }

            ciz();
        })();
    </script>
}
