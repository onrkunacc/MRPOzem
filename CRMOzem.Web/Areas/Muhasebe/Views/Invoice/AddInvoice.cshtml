@model CRMOzem.Core.Models.Invoices
@using System.Text.Encodings.Web

@{
    ViewData["Title"] = "Fatura Ekle";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var triggerModal = TempData["TriggerEvrakModal"]?.ToString() == "true";
    var cariUnvan = TempData["CariUnvan"]?.ToString() ?? "";
    var evrakKod = TempData["EvrakKod"]?.ToString() ?? "";
    var odemeYazisiLinki = TempData["OdemeYazisiLinki"]?.ToString();
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-light text-center">
            <h3 class="mb-0 fw-bold">Yeni Fatura Ekle</h3>
        </div>
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success text-center">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger text-center">@TempData["ErrorMessage"]</div>
            }

            <form asp-action="AddInvoice" method="post">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="CariId" class="form-label fw-bold">Cari Seç:</label>
                        <select id="CariId" name="CariId" class="form-select">
                            <option value="">Seçiniz</option>
                            @foreach (var cari in ViewBag.Cariler)
                            {
                                <option value="@cari.Id" selected="@(cari.Id == ViewBag.SelectedCariId ? "selected" : null)">
                                    @cari.Unvan
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Donemi" class="form-label fw-bold">Dönem (Yıl):</label>
                        <input name="Donemi" type="number" class="form-control" min="2020" max="2100" placeholder="Yıl giriniz..." />
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <label asp-for="Ay" class="form-label fw-bold">Ay:</label>
                        <select name="Ay" class="form-select">
                            <option value="1">Ocak</option>
                            <option value="2">Şubat</option>
                            <option value="3">Mart</option>
                            <option value="4">Nisan</option>
                            <option value="5">Mayıs</option>
                            <option value="6">Haziran</option>
                            <option value="7">Temmuz</option>
                            <option value="8">Ağustos</option>
                            <option value="9">Eylül</option>
                            <option value="10">Ekim</option>
                            <option value="11">Kasım</option>
                            <option value="12">Aralık</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Tutar" class="form-label fw-bold">Tutar:</label>
                        <div class="input-group">
                            <span class="input-group-text">₺</span>
                            <input name="Tutar" type="text" class="form-control"
                                   oninput="formatCurrency(this)"
                                   value="@Model.Tutar.ToString("N2", new System.Globalization.CultureInfo("tr-TR"))"
                                   placeholder="0,00" />
                        </div>
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-12">
                        <label asp-for="Ekler" class="form-label fw-bold">Ekler:</label>
                        <textarea name="Ekler" class="form-control" rows="3" placeholder="Varsa açıklama girin..."></textarea>
                    </div>
                </div>

                <div class="text-center mt-3">
                    <button type="submit" class="btn btn-success px-4"><i class="fe fe-save"></i> Kaydet</button>
                    <a href="~/Invoice/Invoice/Index" class="btn btn-danger px-4"><i class="fe fe-x-circle"></i> İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 📦 Evrak Modal -->
<div class="modal fade" id="evrakModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Evrak Oluştur</h5>
                <button type="button" class="btn-close text-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="evrakForm">
                    <input type="hidden" name="CategoryId" value="4" />
                    <div class="mb-3">
                        <label class="form-label">Evrak Kodu</label>
                        <input type="text" id="evrakKod" name="Code" class="form-control" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Açıklama (Unvan)</label>
                        <input type="text" id="evrakSubject" name="Subject" class="form-control" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Teslimat Şekli</label>
                        <select name="DeliveryMethod" id="deliveryMethod" class="form-select">
                            <option value="Elden">Elden</option>
                            <option value="Kargo">Kargo</option>
                        </select>
                    </div>
                    <div class="mb-3" id="cargoField" style="display:none">
                        <label class="form-label">Kargo Firması</label>
                        <select name="CargoCompany" class="form-select">
                            <option value="">Seçiniz</option>
                            <option value="Yurtiçi">Yurtiçi</option>
                            <option value="MNG">MNG</option>
                            <option value="Aras">Aras</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" id="saveEvrak">Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- 🎨 Stil -->
<style>
    .form-select, .form-control {
        height: 45px;
        border-radius: 8px;
        border: 1px solid #ced4da;
        font-size: 16px;
    }

        .form-select:focus, .form-control:focus {
            border-color: #007bff;
            box-shadow: 0 0 8px rgba(0, 123, 255, 0.3);
        }

    .input-group-text {
        background-color: #f8f9fa;
        border: 1px solid #ced4da;
        border-radius: 8px 0 0 8px;
    }

    .modal-header .btn-close {
        filter: invert(1);
    }
</style>

@section Scripts {
    <script>
        function formatCurrency(input) {
            let value = input.value.replace(/[^0-9,]/g, '');
            let parts = value.split(',');
            parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
            input.value = parts.join(',');
        }

        $(function () {
            $('#deliveryMethod').on('change', function () {
                $('#cargoField').toggle(this.value === 'Kargo');
            });

            @if (triggerModal)
            {
                <text>
                     $('#evrakKod').val('@Html.Raw(JavaScriptEncoder.Default.Encode(evrakKod))');
                     $('#evrakSubject').val('@Html.Raw(JavaScriptEncoder.Default.Encode(cariUnvan))');
                     new bootstrap.Modal(document.getElementById('evrakModal')).show();
                </text>
            }

            $('#saveEvrak').on('click', function () {
                $.post('/Evrak/Document/AddDocument', $('#evrakForm').serialize())
                    .done(() => {
                        alert('Evrak başarıyla kaydedildi.');

                        const odemeLink = '@TempData["OdemeYazisiLinki"]';

                        if (odemeLink && odemeLink !== '') {
                            if (confirm("Ödeme yazısını görüntülemek ister misiniz?")) {
                                window.open(odemeLink, '_blank'); 
                            }
                        } else {
                            alert("Bu cariye ait ödeme yazısı bağlantısı bulunmamaktadır.");
                        }

                        window.location.href = '/Muhasebe/Invoice/Index'; 
                    })
                    .fail(() => {
                        alert('Evrak kaydedilirken hata oluştu.');
                    });
            });
        });
    </script>
}
