@model CRMOzem.Core.ViewModels.RaporIndexVm
@{
    ViewData["Title"] = "Stok Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var tr = new System.Globalization.CultureInfo("tr-TR");

    string DengeText(DengeDurumu d) => d switch
    {
        DengeDurumu.Dengeli => "Dengeli",
        DengeDurumu.Birikiyor => "Stok birikiyor",
        DengeDurumu.Eriyor => "Stok eriyor",
        DengeDurumu.KontrolEdilmeli => "Kayıtları kontrol edin",
        _ => "Kullanım girilmemiş"
    };
    string DengeCls(DengeDurumu d) => d switch
    {
        DengeDurumu.Dengeli => "kt-badge-success",
        DengeDurumu.Birikiyor => "kt-badge-warning",
        DengeDurumu.Eriyor => "kt-badge-warning",
        DengeDurumu.KontrolEdilmeli => "kt-badge-danger",
        _ => "kt-badge-secondary"
    };
    string Sayi(decimal d) => d.ToString("N0", tr);
}

@await Html.PartialAsync("~/Views/Shared/_KotaDesignSystem.cshtml")

<style>
    tr.rp-satir { cursor: pointer; }
    tr.rp-satir:hover td { background: var(--kt-bg); }
    .rp-sekme { display: flex; gap: 8px; }
    .rp-cubuk { display: flex; height: 8px; border-radius: 4px; overflow: hidden; background: var(--kt-border); min-width: 110px; }
    .rp-cubuk span { display: block; height: 100%; }
    .rp-cubuk .g { background: #4338ca; }
    .rp-cubuk .k { background: #0891b2; }
    .rp-ikili { display: grid; grid-template-columns: 62px 1fr; gap: 2px 8px; align-items: center; font-size: 12px; }
    .rp-ikili .et { color: var(--kt-ink-500); }
    .rp-fark-arti { color: #b45309; font-weight: 700; }
    .rp-fark-eksi { color: #b91c1c; font-weight: 700; }
    .rp-aciklama { display: flex; gap: 18px; flex-wrap: wrap; font-size: 12px; color: var(--kt-ink-500); }
    .rp-aciklama i { margin-right: 5px; }
</style>

<div class="kt-page">

    <div class="kt-header">
        <div class="kt-header-inner">
            <div class="kt-header-title">
                <div class="kt-header-icon"><i class="fas fa-chart-column"></i></div>
                <div>
                    <h1>Stok Raporu</h1>
                    <p>Her hastanede elde ne var, ne gönderdik, ne kullanıldı — rakamlar birbirini tutuyor mu?</p>
                </div>
            </div>
            <div class="kt-header-actions">
                <form method="get" style="display:inline-flex; align-items:center; gap:6px;">
                    <span style="font-size:12px; color:var(--kt-ink-500);">Dönem</span>
                    <select name="ay" class="kt-select" style="width:120px;" onchange="this.form.submit()">
                        @foreach (var a in new[] { 3, 6, 12 })
                        {
                            <option value="@a" selected="@(a == Model.DonemAy)">Son @a ay</option>
                        }
                    </select>
                </form>
                <a class="kt-btn kt-btn-dark" asp-action="Excel" asp-route-ay="@Model.DonemAy">
                    <i class="fas fa-file-excel"></i> Excel
                </a>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="kt-card" style="border-left:3px solid var(--kt-neg); padding:12px 18px; font-size:13px;">
            <i class="fas fa-circle-exclamation" style="color:var(--kt-neg); margin-right:7px;"></i>@TempData["Error"]
        </div>
    }

    @* ═══ SEKMELER ═══ *@
    <div class="rp-sekme">
        <a class="kt-chip active" asp-action="Index" asp-route-ay="@Model.DonemAy"><i class="fas fa-hospital" style="margin-right:6px;"></i>Hastaneler</a>
        <a class="kt-chip" asp-action="Urun"><i class="fas fa-box" style="margin-right:6px;"></i>Nerede ne var? (ürüne göre)</a>
    </div>

    @* ═══ ÖZET ═══ *@
    <div class="kt-kpi-grid">
        <div class="kt-kpi accent-dark">
            <div class="kt-kpi-head">
                <div class="kt-kpi-label">Hastanelerdeki Stok</div>
                <div class="kt-kpi-icon"><i class="fas fa-boxes-stacked"></i></div>
            </div>
            @if (Model.SayimliHastane > 0)
            {
                <div class="kt-kpi-value">@Sayi(Model.ToplamStok)</div>
                <div class="kt-kpi-foot">
                    test · @Model.SayimliHastane hastanenin sayımından
                    @if (Model.ToplamStokAy.HasValue)
                    {
                        <text> · @Model.ToplamStokAy.Value.ToString("0.#", tr) ay yeter</text>
                    }
                </div>
            }
            else
            {
                <div class="kt-kpi-value" style="color:var(--kt-ink-400);">—</div>
                <div class="kt-kpi-foot">fiziki sayım girilince hesaplanır</div>
            }
        </div>
        <div class="kt-kpi accent-primary">
            <div class="kt-kpi-head">
                <div class="kt-kpi-label">Gönderilen</div>
                <div class="kt-kpi-icon"><i class="fas fa-truck"></i></div>
            </div>
            <div class="kt-kpi-value">@Sayi(Model.ToplamGonderilen)</div>
            <div class="kt-kpi-foot">test · son @Model.DonemAy ay</div>
        </div>
        <div class="kt-kpi accent-pos">
            <div class="kt-kpi-head">
                <div class="kt-kpi-label">Kullanılan</div>
                <div class="kt-kpi-icon"><i class="fas fa-vial"></i></div>
            </div>
            <div class="kt-kpi-value">@Sayi(Model.ToplamKullanilan)</div>
            <div class="kt-kpi-foot">test · son @Model.DonemAy ay</div>
        </div>
        <div class="kt-kpi accent-warn">
            <div class="kt-kpi-head">
                <div class="kt-kpi-label">Gönderim − Kullanım</div>
                <div class="kt-kpi-icon"><i class="fas fa-scale-balanced"></i></div>
            </div>
            <div class="kt-kpi-value">@((Model.ToplamGonderilen - Model.ToplamKullanilan).ToString("+#,0;-#,0;0", tr))</div>
            <div class="kt-kpi-foot">@Model.Dengeli dengeli · @Model.Birikiyor birikiyor · @Model.Eriyor eriyor@(Model.KontrolEdilmeli > 0 ? $" · {Model.KontrolEdilmeli} kontrol edilmeli" : "")</div>
        </div>
    </div>

    @if (Model.SayimsizHastane > 0)
    {
        <div class="kt-card" style="border-left:3px solid var(--kt-warn); padding:12px 18px; font-size:13px; color:var(--kt-ink-700);">
            <i class="fas fa-clipboard-list" style="color:var(--kt-warn); margin-right:6px;"></i>
            <strong>@Model.SayimsizHastane hastanenin fiziki sayımı yok</strong> — bu hastanelerde eldeki stok ve kaç ay yeteceği hesaplanmaz.
            Sayımlar girilip Dashboard'dan "Sayımları Yenile" denince oluşur.
        </div>
    }

    @* ═══ HASTANELER ═══ *@
    <div class="kt-card kt-card-flush">
        <div style="padding:14px 20px; border-bottom:1px solid var(--kt-border); display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
            <div style="margin-right:auto;">
                <div style="font-weight:700; color:var(--kt-ink-900); font-size:15px;">Hastaneler</div>
                <div style="font-size:12px; color:var(--kt-ink-500);">
                    @Model.DonemBas.ToString("MMMM yyyy", tr) – @Model.DonemSon.ToString("MMMM yyyy", tr) · satıra tıklayınca hastanenin ayrıntısı açılır
                </div>
            </div>
            <select id="dengeSec" class="kt-select" style="width:190px;">
                <option value="">Tüm durumlar</option>
                <option value="Dengeli">Dengeli</option>
                <option value="Birikiyor">Stok birikiyor</option>
                <option value="Eriyor">Stok eriyor</option>
                <option value="KontrolEdilmeli">Kayıtları kontrol edin</option>
                <option value="Bilinmiyor">Kullanım girilmemiş</option>
            </select>
            <input type="text" id="hastaneAra" class="kt-input" placeholder="Hastane ara…" style="width:220px;" />
        </div>

        @if (Model.Hastaneler.Any())
        {
            <div class="kt-table-wrap">
                <table class="kt-table" id="hastaneTablo" data-sayfala="25">
                    <thead>
                        <tr>
                            <th>Hastane</th>
                            <th>Son Sayım</th>
                            <th class="text-right">Eldeki Stok</th>
                            <th class="text-right">Aylık Tüketim</th>
                            <th class="text-center">Kaç Ay Yeter</th>
                            <th>Gönderilen / Kullanılan</th>
                            <th class="text-right">Fark</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.Hastaneler)
                        {
                            var url = Url.Action("Hastane", new { id = h.HospitalID, ay = Model.DonemAy });
                            var enBuyuk = Math.Max(1m, Math.Max(h.GonderilenTest, h.KullanilanTest));
                            var gYuzde = (h.GonderilenTest * 100m / enBuyuk).ToString("0", System.Globalization.CultureInfo.InvariantCulture);
                            var kYuzde = (h.KullanilanTest * 100m / enBuyuk).ToString("0", System.Globalization.CultureInfo.InvariantCulture);

                            <tr class="rp-satir" data-url="@url" data-ara="@h.HospitalName.ToLower(tr)" data-denge="@h.Denge">
                                <td class="kt-cell-primary">
                                    @h.HospitalName
                                    @if (h.KritikUrun > 0)
                                    {
                                        <div style="font-size:11px; color:var(--kt-neg);">@h.KritikUrun üründe stok kritik</div>
                                    }
                                </td>
                                <td style="white-space:nowrap; font-size:12.5px;">
                                    @if (h.SonSayimTarihi.HasValue)
                                    {
                                        @h.SonSayimTarihi.Value.ToString("dd.MM.yyyy")
                                    }
                                    else
                                    {
                                        <span style="color:var(--kt-warn-700);">sayım yok</span>
                                    }
                                </td>
                                <td class="text-right">
                                    @if (h.StokTest.HasValue)
                                    {
                                        <strong style="@(h.StokTest < 0 ? "color:var(--kt-neg);" : "")" title="@(h.StokTest < 0 ? "Sayımdan sonra kaydedilen kullanım, gönderimden fazla" : "")">@Sayi(h.StokTest.Value)</strong> <span class="text-muted" style="font-size:11px;">test</span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--kt-warn-700); font-size:12.5px;" title="Fiziki sayım girilmeden stok hesaplanmaz">sayım yok</span>
                                    }
                                </td>
                                <td class="text-right">@h.AylikTest.ToString("N0", tr)</td>
                                <td class="text-center">
                                    @if (h.StokAy.HasValue)
                                    {
                                        <strong style="color:@(h.StokAy < 1 ? "var(--kt-neg)" : h.StokAy < 2 ? "var(--kt-warn-700)" : "var(--kt-ink-900)");">@h.StokAy.Value.ToString("0.#", tr) ay</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="rp-ikili">
                                        <span class="et">@Sayi(h.GonderilenTest)</span>
                                        <div class="rp-cubuk"><span class="g" style="width:@gYuzde%"></span></div>
                                        <span class="et">@Sayi(h.KullanilanTest)</span>
                                        <div class="rp-cubuk"><span class="k" style="width:@kYuzde%"></span></div>
                                    </div>
                                </td>
                                <td class="text-right" style="white-space:nowrap;">
                                    @if (h.Denge == DengeDurumu.Bilinmiyor)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        <span class="@(h.Denge == DengeDurumu.Birikiyor ? "rp-fark-arti" : h.Denge == DengeDurumu.Eriyor ? "rp-fark-eksi" : "")">
                                            @h.FarkTest.ToString("+#,0;-#,0;0", tr)
                                        </span>
                                    }
                                </td>
                                <td><span class="kt-badge @DengeCls(h.Denge)">@DengeText(h.Denge)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="hastaneYok" style="display:none; padding:34px 20px; text-align:center; color:var(--kt-ink-400); font-size:13px;">
                <i class="fas fa-magnifying-glass" style="margin-right:6px;"></i> Bu süzgece uyan hastane yok
            </div>
        }
        else
        {
            <div class="kt-empty">
                <i class="fas fa-chart-column"></i>
                <p>Henüz raporlanacak veri yok. Sayımları alın ve gönderim / kullanım girişlerini tamamlayın.</p>
            </div>
        }
    </div>

    @* ═══ NASIL OKUNUR ═══ *@
    <div class="kt-card" style="padding:12px 18px; background:var(--kt-bg); border-style:dashed;">
        <div class="rp-aciklama">
            <span><i class="fas fa-square" style="color:#4338ca;"></i>Gönderilen</span>
            <span><i class="fas fa-square" style="color:#0891b2;"></i>Kullanılan</span>
            <span><strong style="color:var(--kt-ink-700);">Dengeli</strong>: gönderilen ile kullanılan arasındaki fark %15'in altında</span>
            <span><strong style="color:var(--kt-ink-700);">Stok birikiyor</strong>: kullanılandan fazla gönderilmiş</span>
            <span><strong style="color:var(--kt-ink-700);">Stok eriyor</strong>: gönderilenden fazla kullanılmış</span>
            <span><strong style="color:var(--kt-ink-700);">Kayıtları kontrol edin</strong>: fark 3 katı aşıyor — gerçek tüketim farkı değil, kayıt sorunu (eksik gönderim ya da kutu / test karışıklığı); ayrıntı Veri Kontrol'de</span>
        </div>
        <div style="font-size:11.5px; color:var(--kt-ink-400); margin-top:6px;">
            Miktarlar test adedidir. Eldeki stok yalnızca fiziki sayımı olan hastanede hesaplanır.
            Gönderilen / kullanılan karşılaştırması, kullanımı girilen ürünler ve aylar üzerinden yapılır.
        </div>
    </div>
</div>

@section Scripts {
@await Html.PartialAsync("_Sayfalama")
<script>
    (function () {
        var satirlar = Array.prototype.slice.call(document.querySelectorAll('tr.rp-satir'));
        var ara = document.getElementById('hastaneAra');
        var denge = document.getElementById('dengeSec');
        var tablo = document.getElementById('hastaneTablo');
        var yok = document.getElementById('hastaneYok');

        satirlar.forEach(function (tr) {
            tr.addEventListener('click', function () { if (tr.dataset.url) window.location.href = tr.dataset.url; });
        });

        function uygula() {
            var q = ara ? ara.value.trim().toLocaleLowerCase('tr-TR') : '';
            var d = denge ? denge.value : '';
            var gorunen = 0;

            satirlar.forEach(function (tr) {
                var ok = (!q || (tr.dataset.ara || '').indexOf(q) !== -1)
                      && (!d || tr.dataset.denge === d);
                tr.dataset.suz = ok ? '1' : '0';
                if (ok) gorunen++;
            });

            if (tablo) tablo.style.display = gorunen > 0 ? '' : 'none';
            if (yok) yok.style.display = gorunen > 0 ? 'none' : 'block';
            if (tablo && window.LjSayfala) window.LjSayfala.yenile(tablo);
        }

        if (ara) ara.addEventListener('input', uygula);
        if (denge) denge.addEventListener('change', uygula);
    })();
</script>
}
