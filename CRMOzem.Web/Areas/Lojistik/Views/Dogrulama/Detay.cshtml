@model CRMOzem.Core.ViewModels.Dogrulama.DogrulamaDetayVm
@{
    ViewData["Title"] = $"Doğrulama · {Model.HospitalName}";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var bekliyor = Model.Bekliyor;
    var tr = new System.Globalization.CultureInfo("tr-TR");
    var inv = System.Globalization.CultureInfo.InvariantCulture;

    string Sayi(decimal v) => v.ToString("0.##", tr);

    string RozetCls(DogrulamaRengi r) => r switch
    {
        DogrulamaRengi.Kirmizi => "sorunlu",
        DogrulamaRengi.Sari => "incele",
        DogrulamaRengi.Yesil => "uygun",
        _ => "veriyok"
    };
    string RozetIkon(DogrulamaRengi r) => r switch
    {
        DogrulamaRengi.Kirmizi => "fa-circle-exclamation",
        DogrulamaRengi.Sari => "fa-magnifying-glass",
        DogrulamaRengi.Yesil => "fa-check",
        _ => "fa-circle-question"
    };
    string TipText(UrunTipi t) => t switch
    {
        UrunTipi.Reaktif => "Reaktif",
        UrunTipi.Kalibrator => "Kalibratör",
        UrunTipi.Kontrol => "Kontrol",
        UrunTipi.Sarf => "Sarf",
        _ => "Diğer"
    };
    string DurumBadge(SiparisTalepDurumu d) => d switch
    {
        SiparisTalepDurumu.Beklemede => "kt-badge-warning",
        SiparisTalepDurumu.OnaylandiAynen => "kt-badge-success",
        SiparisTalepDurumu.OnaylandiDuzeltildi => "kt-badge-primary",
        SiparisTalepDurumu.Reddedildi => "kt-badge-danger",
        _ => "kt-badge-secondary"
    };
    string DurumText(SiparisTalepDurumu d) => d switch
    {
        SiparisTalepDurumu.Beklemede => "Bekliyor",
        SiparisTalepDurumu.OnaylandiAynen => "Onaylandı",
        SiparisTalepDurumu.OnaylandiDuzeltildi => "Düzeltilerek onaylandı",
        SiparisTalepDurumu.Reddedildi => "Reddedildi",
        SiparisTalepDurumu.Gonderildi => "Gönderildi",
        _ => d.ToString()
    };
    string GuvenText(VeriGuveni g) => g switch
    {
        VeriGuveni.Yuksek => "Yüksek",
        VeriGuveni.Orta => "Orta",
        VeriGuveni.Dusuk => "Düşük",
        _ => "—"
    };
    string GuvenCls(VeriGuveni g) => g switch
    {
        VeriGuveni.Yuksek => "gv-yuksek",
        VeriGuveni.Orta => "gv-orta",
        VeriGuveni.Dusuk => "gv-dusuk",
        _ => "gv-yok"
    };
}

@await Html.PartialAsync("~/Views/Shared/_KotaDesignSystem.cshtml")

<style>
    .dg-rozet {
        display: inline-flex; align-items: center; gap: 5px;
        font-size: 12px; font-weight: 700; padding: 4px 10px;
        border-radius: 999px; white-space: nowrap;
    }
    .dg-rozet.sorunlu { background: var(--kt-neg-50); color: var(--kt-neg-700); }
    .dg-rozet.incele { background: var(--kt-warn-50); color: var(--kt-warn-700); }
    .dg-rozet.uygun { background: var(--kt-pos-50); color: var(--kt-pos-700); }
    .dg-rozet.veriyok { background: var(--kt-bg-soft); color: var(--kt-ink-500); }

    .gv { display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 600; white-space: nowrap; }
    .gv::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--kt-ink-400); }
    .gv-yuksek { color: var(--kt-pos-700); } .gv-yuksek::before { background: var(--kt-pos); }
    .gv-orta { color: var(--kt-warn-700); } .gv-orta::before { background: var(--kt-warn); }
    .gv-dusuk { color: var(--kt-neg-700); } .gv-dusuk::before { background: var(--kt-neg); }
    .gv-yok { color: var(--kt-ink-400); }

    /* ── Hastane veri şeridi ─────────────────────────────────── */
    .dg-serit {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 1px; background: var(--kt-border);
        border: 1px solid var(--kt-border); border-radius: var(--kt-r-md); overflow: hidden;
    }
    .dg-serit > div { background: var(--kt-paper); padding: 12px 15px; }
    .dg-serit .et { font-size: 10.5px; font-weight: 700; color: var(--kt-ink-500); text-transform: uppercase; letter-spacing: .05em; }
    .dg-serit .dg { font-size: 14px; font-weight: 700; color: var(--kt-ink-900); margin-top: 3px; }
    .dg-serit .alt { font-size: 11px; color: var(--kt-ink-400); margin-top: 1px; }

    .dg-uyari {
        display: flex; gap: 9px; align-items: flex-start;
        background: var(--kt-warn-50); border: 1px solid #fde68a; color: var(--kt-warn-700);
        border-radius: var(--kt-r-sm); padding: 9px 13px; font-size: 12.5px; line-height: 1.5; margin-top: 8px;
    }

    /* ── Kalem satırı ────────────────────────────────────────── */
    tr.dg-kalem > td { vertical-align: top; }
    tr.dg-kalem.sorunlu > td:first-child { box-shadow: inset 3px 0 0 var(--kt-neg); }
    tr.dg-kalem.incele > td:first-child { box-shadow: inset 3px 0 0 var(--kt-warn); }
    tr.dg-kalem.uygun > td:first-child { box-shadow: inset 3px 0 0 var(--kt-pos); }
    tr.dg-kalem.veriyok > td:first-child { box-shadow: inset 3px 0 0 var(--kt-ink-400); }

    .dg-urun { font-weight: 600; color: var(--kt-ink-900); font-size: 13.5px; }
    .dg-alt { font-size: 11px; color: var(--kt-ink-400); margin-top: 3px; display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }

    .dg-buyuk { font-size: 17px; font-weight: 700; color: var(--kt-ink-900); line-height: 1.1; }
    .dg-birim { font-size: 11px; color: var(--kt-ink-500); font-weight: 500; }
    .dg-kucuk { font-size: 11px; color: var(--kt-ink-400); margin-top: 2px; }

    .dg-gerekce { font-size: 12.5px; color: var(--kt-ink-700); line-height: 1.5; margin-top: 6px; max-width: 420px; }

    .dg-nasil {
        background: none; border: none; padding: 0; margin-top: 5px; cursor: pointer;
        font-size: 11.5px; color: var(--kt-primary); font-weight: 600;
    }
    .dg-nasil:hover { text-decoration: underline; }

    tr.dg-adimlar { display: none; }
    tr.dg-adimlar.acik { display: table-row; }
    tr.dg-adimlar > td { background: var(--kt-bg); padding: 12px 20px 14px 26px; }

    .dg-adim-tablo { border-collapse: collapse; font-size: 12.5px; }
    .dg-adim-tablo td { padding: 3px 12px 3px 0; color: var(--kt-ink-700); }
    .dg-adim-tablo td.isaret { width: 16px; font-weight: 700; color: var(--kt-ink-500); text-align: center; }
    .dg-adim-tablo td.deger { text-align: right; font-weight: 600; color: var(--kt-ink-900); white-space: nowrap; }
    .dg-adim-tablo td.not { color: var(--kt-ink-400); font-size: 11.5px; }
    .dg-adim-tablo tr.sonuc td { border-top: 1px solid var(--kt-border-strong); padding-top: 5px; font-weight: 700; }

    /* ── Onay girişi ─────────────────────────────────────────── */
    .dg-onay { display: flex; align-items: center; gap: 6px; }
    .dg-onay input { width: 78px; text-align: right; font-weight: 700; font-size: 14px; }
    .dg-onay input.degisti { border-color: var(--kt-primary); background: var(--kt-primary-50); }
    .dg-fark { font-size: 11px; margin-top: 3px; min-height: 15px; }
    .dg-fark.arti { color: var(--kt-warn-700); }
    .dg-fark.eksi { color: var(--kt-primary-700); }

    .dg-oneri-btn {
        background: none; border: 1px dashed var(--kt-border-strong); border-radius: 6px;
        font-size: 11px; padding: 3px 7px; cursor: pointer; color: var(--kt-ink-700); white-space: nowrap;
    }
    .dg-oneri-btn:hover { border-color: var(--kt-primary); color: var(--kt-primary); }

    .dg-ozet-cumle { font-size: 14px; color: var(--kt-ink-700); line-height: 1.6; }
    .dg-ozet-cumle strong { color: var(--kt-ink-900); }

    .dg-alt-cubuk {
        position: sticky; bottom: 0; z-index: 20;
        background: var(--kt-paper); border: 1px solid var(--kt-border);
        border-radius: var(--kt-r-lg); box-shadow: var(--kt-shadow-lg);
        padding: 14px 20px; display: flex; gap: 14px; align-items: center; flex-wrap: wrap;
    }

    @@media (max-width: 900px) {
        .dg-gerekce { max-width: none; }
    }
</style>

<div class="kt-page">

    <div class="kt-header">
        <div class="kt-header-inner">
            <div class="kt-header-title">
                <div class="kt-header-icon"><i class="fas fa-hospital"></i></div>
                <div>
                    <h1>@Model.HospitalName</h1>
                    <p>
                        @Model.TalepTarihi.ToString("dd MMMM yyyy HH:mm", tr) tarihli sipariş
                        · no @(Model.ExternalRefNo ?? "—")
                        · @Model.Kalemler.Count kalem
                    </p>
                </div>
            </div>
            <div class="kt-header-actions">
                <span class="kt-badge @DurumBadge(Model.Durum)" style="padding:7px 14px; font-size:12.5px;">
                    @DurumText(Model.Durum)
                </span>
                <a class="kt-btn kt-btn-ghost" asp-area="Lojistik" asp-controller="StokOneri" asp-action="HastaneDetay" asp-route-id="@Model.HospitalID">
                    <i class="fas fa-boxes-stacked"></i> Hastanenin Stoku
                </a>
                <a class="kt-btn kt-btn-ghost" asp-action="Index">
                    <i class="fas fa-arrow-left"></i> Liste
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="kt-card" style="border-left:3px solid var(--kt-pos); padding:12px 18px; font-size:13px;">
            <i class="fas fa-circle-check" style="color:var(--kt-pos); margin-right:7px;"></i>@TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="kt-card" style="border-left:3px solid var(--kt-neg); padding:12px 18px; font-size:13px;">
            <i class="fas fa-circle-exclamation" style="color:var(--kt-neg); margin-right:7px;"></i>@TempData["Error"]
        </div>
    }

    @* ═══ ÖZET + HASTANENİN VERİ DURUMU ═══ *@
    <div class="kt-card">
        <div class="dg-ozet-cumle" style="margin-bottom:14px;">
            @if (Model.TumuUygun)
            {
                <span>
                    <i class="fas fa-circle-check" style="color:var(--kt-pos);"></i>
                    <strong>Tüm kalemler hesaplanan ihtiyaçla uyumlu.</strong>
                    @if (bekliyor)
                    {
                        <text> Değişiklik yapmadan onaylayabilirsiniz.</text>
                    }
                </span>
            }
            else
            {
                <span>
                    @Model.Kalemler.Count kalemin
                    <strong>@Model.YesilSayisi tanesi uygun</strong>@(Model.SariSayisi > 0 ? $", {Model.SariSayisi} tanesi incelenecek" : "")@(Model.KirmiziSayisi > 0 ? $", {Model.KirmiziSayisi} tanesi sorunlu" : "")@(Model.VeriYokSayisi > 0 ? $", {Model.VeriYokSayisi} tanesinde veri yok" : "").
                    @if (bekliyor)
                    {
                        <text> Sorunlu olanlar en üstte listelendi.</text>
                    }
                </span>
            }
        </div>

        @if (bekliyor)
        {
            <div class="dg-serit">
                <div>
                    <div class="et">Son Fiziki Sayım</div>
                    <div class="dg">@(Model.SonSayimTarihi.HasValue ? Model.SonSayimTarihi.Value.ToString("dd.MM.yyyy") : "Yok")</div>
                    <div class="alt">
                        @if (Model.SonSayimTarihi.HasValue)
                        {
                            <text>@((DateTime.Today - Model.SonSayimTarihi.Value.Date).Days) gün önce</text>
                        }
                        else
                        {
                            <text>stok kayıt farkından hesaplanıyor</text>
                        }
                    </div>
                </div>
                <div>
                    <div class="et">Kullanım Verisi</div>
                    <div class="dg">@(Model.KullanimSonAy.HasValue ? Model.KullanimSonAy.Value.ToString("MMMM yyyy", tr) : "Yok")</div>
                    <div class="alt">@(Model.KullanimSonAy.HasValue ? "raporlanan son ay — sonrası tahmin" : "tüketim gönderimden tahmin ediliyor")</div>
                </div>
                <div>
                    <div class="et">Veri Güveni</div>
                    <div class="dg"><span class="gv @GuvenCls(Model.Guven)" style="font-size:14px;">@GuvenText(Model.Guven)</span></div>
                    <div class="alt">hastane geneli</div>
                </div>
                <div>
                    <div class="et">Hedef Stok</div>
                    <div class="dg">@Model.HedefAy ay</div>
                    <div class="alt">öneri bu hedefe tamamlar</div>
                </div>
            </div>

            foreach (var u in Model.HastaneUyarilari)
            {
                <div class="dg-uyari">
                    <i class="fas fa-triangle-exclamation" style="margin-top:2px;"></i>
                    <span>@u</span>
                </div>
            }

            if (Model.DigerBekleyenTalep > 0)
            {
                <div class="dg-uyari">
                    <i class="fas fa-layer-group" style="margin-top:2px;"></i>
                    <span>
                        Bu hastanenin <strong>@Model.DigerBekleyenTalep bekleyen talebi daha</strong> var.
                        Aynı ürün birden çok talepte geçiyorsa, sonradan gelen talep öncekiler onaylanmış gibi değerlendirilir.
                    </span>
                </div>
            }
        }

        @if (!string.IsNullOrWhiteSpace(Model.HastaneNotu))
        {
            <div style="margin-top:12px; padding:10px 14px; background:var(--kt-bg); border-radius:var(--kt-r-sm); font-size:13px; color:var(--kt-ink-700);">
                <strong style="color:var(--kt-ink-900);"><i class="fas fa-comment-dots"></i> Hastanenin notu:</strong> @Model.HastaneNotu
            </div>
        }

        @if (!bekliyor && Model.OnayTarihi.HasValue)
        {
            <div style="margin-top:12px; padding:10px 14px; background:var(--kt-bg); border-radius:var(--kt-r-sm); font-size:13px; color:var(--kt-ink-700);">
                <strong style="color:var(--kt-ink-900);">@DurumText(Model.Durum)</strong>
                · @(Model.OnaylayanKullanici ?? "—") · @Model.OnayTarihi.Value.ToString("dd.MM.yyyy HH:mm")
                @if (!string.IsNullOrWhiteSpace(Model.OnayNotu))
                {
                    <div style="margin-top:4px;">@Model.OnayNotu</div>
                }
                <div style="margin-top:4px; font-size:11.5px; color:var(--kt-ink-400);">
                    Aşağıdaki rakamlar karar anındaki haliyle saklanmıştır.
                </div>
            </div>
        }
    </div>

    @* ═══ KALEMLER ═══ *@
    <form asp-action="Onayla" method="post" id="onayForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="TalepID" value="@Model.TalepID" />

        <div class="kt-card kt-card-flush">
            <div style="padding:14px 20px; border-bottom:1px solid var(--kt-border); display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
                <div style="font-weight:700; color:var(--kt-ink-900); font-size:15px; margin-right:auto;">Kalemler</div>

                @if (bekliyor)
                {
                    <button type="button" class="kt-btn kt-btn-sm kt-btn-ghost" id="oneriHepsi"
                            title="Sorunlu ve incelenecek kalemlerde onaylanan miktarı sistem önerisine çeker">
                        <i class="fas fa-wand-magic-sparkles"></i> Sorunlulara Öneriyi Uygula
                    </button>
                    <button type="button" class="kt-btn kt-btn-sm kt-btn-ghost" id="istegeDon">
                        <i class="fas fa-rotate-left"></i> Hastanenin İstediğine Dön
                    </button>
                }
            </div>

            <div class="kt-table-wrap">
                <table class="kt-table">
                    <thead>
                        <tr>
                            <th>Ürün</th>
                            <th class="text-right">Hastane İstedi</th>
                            <th class="text-right">Stok</th>
                            <th class="text-right">Sistem Önerisi</th>
                            <th>Sonuç</th>
                            <th style="width:1%;">Onaylanan</th>
                            <th>Not</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var idx = 0; }
                        @foreach (var k in Model.Kalemler)
                        {
                            var cls = RozetCls(k.DogrulamaRengi);
                            var stokBiliniyor = k.StokKaynagi != StokKaynagi.Yok;

                            // "Öneriyi uygula": stok biliniyorsa öneri, bilinmiyorsa hastanenin isteği
                            var oneriDeger = (k.Eslesti && stokBiliniyor && k.OrtalamaAylikKullanim.GetValueOrDefault() > 0)
                                ? k.OneriMiktar
                                : k.TalepMiktar;

                            <tr class="dg-kalem @cls">
                                <td>
                                    <div class="dg-urun">@k.ProductName</div>
                                    <div class="dg-alt">
                                        @if (!string.IsNullOrWhiteSpace(k.ReferenceNumber))
                                        {
                                            <span class="kt-code-badge ghost">@k.ReferenceNumber</span>
                                        }
                                        <span>@TipText(k.UrunTipi)</span>
                                        @if (k.KutuBirimli)
                                        {
                                            <span>1 kutu = @k.Carpan.ToString("N0", tr) test</span>
                                        }
                                        @if (!k.Eslesti)
                                        {
                                            <span style="color:var(--kt-warn-700); font-weight:600;">
                                                <i class="fas fa-link-slash"></i> katalogla eşleşmedi
                                            </span>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(k.TestAdi) && k.TestAdi != k.ProductName)
                                        {
                                            <span title="Katalogdaki karşılığı"><i class="fas fa-link"></i> @k.TestAdi</span>
                                        }
                                    </div>
                                </td>

                                <td class="text-right" style="white-space:nowrap;">
                                    <div class="dg-buyuk">@Sayi(k.TalepMiktar) <span class="dg-birim">@k.Birim</span></div>
                                    @if (k.KutuBirimli)
                                    {
                                        <div class="dg-kucuk">@k.HastaneTalepTest.ToString("N0", tr) test</div>
                                    }
                                </td>

                                <td class="text-right" style="white-space:nowrap;">
                                    @if (k.Eslesti && k.KayitTutarsiz)
                                    {
                                        <span style="color:var(--kt-warn-700); font-size:12.5px;" title="Sayımdan sonra kaydedilen kullanım, sayım + gönderimden fazla — gönderim kaydı eksik olabilir">kayıt tutarsız</span>
                                        <div class="dg-kucuk">ayda @((k.OrtalamaAylikKullanim ?? 0).ToString("N0", tr)) test</div>
                                    }
                                    else if (k.Eslesti && (stokBiliniyor || !bekliyor) && k.OrtalamaAylikKullanim.GetValueOrDefault() > 0)
                                    {
                                        if (k.StokAy.HasValue)
                                        {
                                            <div class="dg-buyuk" style="color:@(k.StokAy.Value < 1 ? "var(--kt-neg)" : "var(--kt-ink-900)");">
                                                @Sayi(k.StokAy.Value) <span class="dg-birim">ay yeter</span>
                                            </div>
                                        }
                                        <div class="dg-kucuk">
                                            @(Math.Max(0m, k.HesapGuncelStok ?? 0).ToString("N0", tr)) test · ayda @((k.OrtalamaAylikKullanim ?? 0).ToString("N0", tr))
                                        </div>
                                        if (k.Yolda > 0)
                                        {
                                            <div class="dg-kucuk" style="color:var(--kt-primary-700);">+ @k.Yolda.ToString("N0", tr) test yolda</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">bilinmiyor</span>
                                    }
                                </td>

                                <td class="text-right" style="white-space:nowrap;">
                                    @if (k.Eslesti && stokBiliniyor && k.OrtalamaAylikKullanim.GetValueOrDefault() > 0)
                                    {
                                        if (k.OneriMiktar > 0)
                                        {
                                            <div class="dg-buyuk" style="color:var(--kt-primary);">@Sayi(k.OneriMiktar) <span class="dg-birim">@k.Birim</span></div>
                                        }
                                        else
                                        {
                                            <div style="font-weight:700; color:var(--kt-ink-500);">gerek yok</div>
                                        }
                                    }
                                    else if (!bekliyor && (k.OnerilenTest ?? 0) > 0)
                                    {
                                        <div class="dg-buyuk" style="color:var(--kt-primary);">@Sayi(k.OneriMiktar) <span class="dg-birim">@k.Birim</span></div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    <span class="dg-rozet @cls"><i class="fas @RozetIkon(k.DogrulamaRengi)"></i> @k.KararBaslik</span>
                                    @if (bekliyor && k.Eslesti && k.Guven != VeriGuveni.Yok && k.Guven != VeriGuveni.Yuksek)
                                    {
                                        <span class="gv @GuvenCls(k.Guven)" style="margin-left:6px;" title="@k.GuvenNedeni">güven @GuvenText(k.Guven).ToLower(tr)</span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(k.Gerekce))
                                    {
                                        <div class="dg-gerekce">@k.Gerekce</div>
                                    }

                                </td>

                                <td>
                                    <input type="hidden" name="Kalemler[@idx].KalemID" value="@k.KalemID" />
                                    <div class="dg-onay">
                                        <input type="number" step="any" min="0"
                                               name="Kalemler[@idx].OnaylananMiktar"
                                               class="kt-input onay-giris"
                                               value="@(k.OnaylananMiktar.ToString("0.##", inv))"
                                               data-istek="@(k.TalepMiktar.ToString("0.##", inv))"
                                               data-oneri="@(oneriDeger.ToString("0.##", inv))"
                                               data-renk="@cls"
                                               @(bekliyor ? "" : "disabled") />
                                        <span class="dg-birim">@k.Birim</span>
                                    </div>
                                    <div class="dg-fark"></div>
                                    @if (bekliyor && oneriDeger != k.TalepMiktar)
                                    {
                                        <button type="button" class="dg-oneri-btn oneri-tek">
                                            öneri: @Sayi(oneriDeger)
                                        </button>
                                    }
                                </td>

                                <td>
                                    <input type="text" name="Kalemler[@idx].KalemNotu" class="kt-input"
                                           value="@k.KalemNotu" placeholder="not" maxlength="500"
                                           style="width:130px; font-size:12px;"
                                           @(bekliyor ? "" : "disabled") />
                                </td>
                            </tr>


                            idx++;
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* ═══ SİPARİŞTE OLMAYAN AMA STOKU AZALAN ÜRÜNLER ═══ *@
        @if (bekliyor && Model.EksikKritikler.Any())
        {
            <div class="kt-card">
                <div class="kt-section">
                    <div class="kt-section-icon" style="background:var(--kt-neg);"><i class="fas fa-bell"></i></div>
                    <div>
                        <span class="kt-section-title">Siparişte Yok Ama Stoku Azalıyor</span>
                        <span class="kt-section-desc">
                            Hastane bu ürünleri istememiş; hesaba göre stokları hedefin altında. Bilgi amaçlıdır —
                            hastaneyle görüşüp bir sonraki siparişe eklenebilir.
                        </span>
                    </div>
                </div>

                <div class="kt-table-wrap">
                    <table class="kt-table">
                        <thead>
                            <tr>
                                <th>Ürün</th>
                                <th class="text-right">Stok</th>
                                <th class="text-right">Aylık Tüketim</th>
                                <th class="text-right">Önerilen</th>
                                <th>Veri Güveni</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in Model.EksikKritikler)
                            {
                                <tr>
                                    <td class="kt-cell-primary">
                                        @e.TestAdi
                                        @if (!string.IsNullOrWhiteSpace(e.ReferenceNumber))
                                        {
                                            <span class="kt-code-badge ghost" style="margin-left:6px;">@e.ReferenceNumber</span>
                                        }
                                    </td>
                                    <td class="text-right" style="white-space:nowrap;">
                                        <strong style="color:@(e.Durum == StokDurumu.Kritik ? "var(--kt-neg)" : "var(--kt-warn-700)");">
                                            @(e.StokAy.HasValue ? Sayi(e.StokAy.Value) + " ay" : "—")
                                        </strong>
                                        <div class="dg-kucuk">@Math.Max(0, e.HesapGuncelStok).ToString("N0", tr) test</div>
                                    </td>
                                    <td class="text-right">@e.OrtalamaAylikKullanim.ToString("N0", tr)</td>
                                    <td class="text-right"><strong>@e.OnerilenKutu @e.Birim</strong></td>
                                    <td><span class="gv @GuvenCls(e.Guven)" title="@e.GuvenNedeni">@GuvenText(e.Guven)</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* ═══ ONAY ÇUBUĞU ═══ *@
        @if (bekliyor)
        {
            <div class="dg-alt-cubuk">
                <div style="flex:1; min-width:240px;">
                    <input type="text" name="OnayNotu" class="kt-input" maxlength="1000"
                           placeholder="Onay notu (opsiyonel)" style="width:100%;" />
                    <div id="degisimOzeti" style="font-size:12px; color:var(--kt-ink-500); margin-top:5px;">
                        Miktarlarda değişiklik yok — hastanenin istediği gibi onaylanacak.
                    </div>
                </div>
                <button type="button" class="kt-btn kt-btn-danger" onclick="redAc()">
                    <i class="fas fa-ban"></i> Reddet
                </button>
                <button type="submit" class="kt-btn kt-btn-success" style="padding:11px 26px; font-size:14px;">
                    <i class="fas fa-check"></i> Onayla
                </button>
            </div>
        }
    </form>
</div>

@if (bekliyor)
{
    <div class="kt-modal-backdrop" id="redModal">
        <div class="kt-modal kt-modal-sm">
            <div class="kt-modal-head">
                <h5 class="kt-modal-title"><i class="fas fa-ban" style="color:var(--kt-neg);"></i> Talebi Reddet</h5>
                <button type="button" class="kt-modal-close" onclick="redKapat()">&times;</button>
            </div>
            <form asp-action="Reddet" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.TalepID" />
                <div class="kt-modal-body">
                    <p style="font-size:13px; color:var(--kt-ink-500); margin:0 0 12px;">
                        <strong style="color:var(--kt-ink-900);">@Model.HospitalName</strong> siparişinin tamamı reddedilecek.
                        Yalnızca bazı kalemleri çıkarmak istiyorsanız reddetmek yerine o kalemlerin miktarını 0 yapıp onaylayın.
                    </p>
                    <div class="kt-form-group">
                        <label class="kt-label">Red Nedeni <span class="req">*</span></label>
                        <textarea name="redNedeni" class="kt-textarea" rows="3" required></textarea>
                    </div>
                </div>
                <div class="kt-modal-foot">
                    <button type="button" class="kt-btn kt-btn-ghost" onclick="redKapat()">Vazgeç</button>
                    <button type="submit" class="kt-btn kt-btn-danger"><i class="fas fa-ban"></i> Reddet</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
<script>
    function redAc() { var m = document.getElementById('redModal'); if (m) { m.classList.add('open'); document.body.style.overflow = 'hidden'; } }
    function redKapat() { var m = document.getElementById('redModal'); if (m) { m.classList.remove('open'); document.body.style.overflow = ''; } }

    (function () {
        var modal = document.getElementById('redModal');
        if (modal) modal.addEventListener('click', function (e) { if (e.target === modal) redKapat(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') redKapat(); });

        // ── Onaylanan miktarlar ──
        var girisler = Array.prototype.slice.call(document.querySelectorAll('.onay-giris'));
        var ozet = document.getElementById('degisimOzeti');

        function sayi(v) {
            var n = parseFloat(String(v).replace(',', '.'));
            return isNaN(n) ? 0 : n;
        }
        function yaz(n) {
            return (Math.round(n * 100) / 100).toString().replace('.', ',');
        }

        function satirGuncelle(inp) {
            var istek = sayi(inp.dataset.istek);
            var deger = sayi(inp.value);
            var fark = deger - istek;
            var kutu = inp.closest('td').querySelector('.dg-fark');

            inp.classList.toggle('degisti', Math.abs(fark) > 0.0001);

            if (!kutu) return;
            if (Math.abs(fark) < 0.0001) {
                kutu.textContent = '';
                kutu.className = 'dg-fark';
            } else if (fark > 0) {
                kutu.textContent = 'istenenden ' + yaz(fark) + ' fazla';
                kutu.className = 'dg-fark arti';
            } else {
                kutu.textContent = deger === 0 ? 'kalem çıkarıldı' : 'istenenden ' + yaz(-fark) + ' az';
                kutu.className = 'dg-fark eksi';
            }
        }

        function ozetGuncelle() {
            if (!ozet) return;
            var degisen = girisler.filter(function (i) {
                return Math.abs(sayi(i.value) - sayi(i.dataset.istek)) > 0.0001;
            }).length;

            ozet.textContent = degisen === 0
                ? 'Miktarlarda değişiklik yok — hastanenin istediği gibi onaylanacak.'
                : degisen + ' kalemin miktarı değiştirildi — "düzeltilerek onaylandı" olarak kaydedilecek.';
            ozet.style.color = degisen === 0 ? '' : 'var(--kt-primary-700)';
        }

        girisler.forEach(function (inp) {
            inp.addEventListener('input', function () { satirGuncelle(inp); ozetGuncelle(); });
            satirGuncelle(inp);
        });
        ozetGuncelle();

        // Tek satırda öneriyi uygula
        document.querySelectorAll('.oneri-tek').forEach(function (b) {
            b.addEventListener('click', function () {
                var inp = b.closest('td').querySelector('.onay-giris');
                if (!inp) return;
                inp.value = inp.dataset.oneri;
                satirGuncelle(inp); ozetGuncelle();
            });
        });

        // Sorunlu + incelenecek kalemlerin hepsine öneriyi uygula
        var hepsi = document.getElementById('oneriHepsi');
        if (hepsi) hepsi.addEventListener('click', function () {
            girisler.forEach(function (inp) {
                if (inp.dataset.renk === 'sorunlu' || inp.dataset.renk === 'incele') {
                    inp.value = inp.dataset.oneri;
                    satirGuncelle(inp);
                }
            });
            ozetGuncelle();
        });

        var don = document.getElementById('istegeDon');
        if (don) don.addEventListener('click', function () {
            girisler.forEach(function (inp) { inp.value = inp.dataset.istek; satirGuncelle(inp); });
            ozetGuncelle();
        });
    })();
</script>
}
