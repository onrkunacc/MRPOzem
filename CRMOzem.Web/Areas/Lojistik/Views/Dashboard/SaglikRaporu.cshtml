@using CRMOzem.Core.ViewModels
@using CRMOzem.Business.Interfaces
@model SaglikRaporuVm
@{
    ViewData["Title"] = "Veri Kontrol";
    var siparis = ViewBag.SiparisTeshis as SiparisTeshisSonuc;
    var sayim = ViewBag.SayimRapor as EslesmeRaporuVm;

    // Engeli olan (kendiliğinden gelmeyecek) siparişler
    var engelli = siparis?.Gelmeyenler.Where(g => g.Neden != "Henüz çekilmedi").ToList() ?? new List<GelmeyenSiparis>();
    var sayimSorunlu = sayim?.ApidenGelenHastaneler
        .Where(h => !h.ManuelYoksay && (!h.Eslesti || h.BizdeEski)).ToList() ?? new List<EslesmeDetay>();
    Layout = "~/Views/Shared/_Layout.cshtml";

    string DurumIcon(KontrolDurumu d) => d switch
    {
        KontrolDurumu.Gecti => "fa-check-circle",
        KontrolDurumu.Dikkat => "fa-circle-exclamation",
        KontrolDurumu.Hata => "fa-triangle-exclamation",
        _ => "fa-circle-question"
    };
    string DurumColor(KontrolDurumu d) => d switch
    {
        KontrolDurumu.Gecti => "#16a34a",
        KontrolDurumu.Dikkat => "#f59e0b",
        KontrolDurumu.Hata => "#dc2626",
        _ => "#94a3b8"
    };
    string DurumBg(KontrolDurumu d) => d switch
    {
        KontrolDurumu.Gecti => "#f0fdf4",
        KontrolDurumu.Dikkat => "#fffbeb",
        KontrolDurumu.Hata => "#fef2f2",
        _ => "#f8fafc"
    };
    string DurumText(KontrolDurumu d) => d switch
    {
        KontrolDurumu.Gecti => "Geçti",
        KontrolDurumu.Dikkat => "Dikkat",
        KontrolDurumu.Hata => "Hata",
        _ => "—"
    };
}

@await Html.PartialAsync("~/Views/Shared/_KotaDesignSystem.cshtml")

<style>
    .sr-kontrol {
        background: #fff;
        border: 1px solid var(--kt-border);
        border-radius: 10px;
        margin-bottom: 10px;
        overflow: hidden;
    }

    .sr-kontrol-head {
        padding: 14px 18px;
        display: flex;
        align-items: center;
        gap: 14px;
        cursor: pointer;
        transition: background 0.1s;
        border-left: 4px solid var(--durum-color, transparent);
    }

        .sr-kontrol-head:hover {
            background: var(--kt-bg);
        }

    .sr-kontrol-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 16px;
    }

    .sr-kontrol-info {
        flex: 1;
        min-width: 0;
    }

    .sr-kontrol-baslik {
        font-weight: 700;
        color: var(--kt-ink-900);
        font-size: 14px;
    }

    .sr-kontrol-aciklama {
        font-size: 11.5px;
        color: var(--kt-ink-500);
        margin-top: 2px;
    }

    .sr-kontrol-sayac {
        font-size: 22px;
        font-weight: 800;
        min-width: 48px;
        text-align: center;
    }

    .sr-kontrol-kategori {
        display: inline-block;
        padding: 2px 8px;
        background: var(--kt-bg);
        color: var(--kt-ink-500);
        font-size: 10.5px;
        font-weight: 600;
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .sr-kontrol-body {
        padding: 16px 18px;
        border-top: 1px solid var(--kt-border);
        background: var(--body-bg, #fff);
        display: none;
    }

    .sr-kontrol.acik .sr-kontrol-body {
        display: block;
    }

    .sr-bulgu-list {
        font-size: 12px;
        max-height: 320px;
        overflow-y: auto;
        background: #fff;
        border: 1px solid var(--kt-border);
        border-radius: 6px;
        padding: 8px 12px;
        font-family: ui-monospace, Menlo, monospace;
    }

        .sr-bulgu-list .item {
            padding: 4px 0;
            border-bottom: 1px dashed #e2e8f0;
        }

            .sr-bulgu-list .item:last-child {
                border-bottom: 0;
            }

    .sr-aksiyon {
        margin-top: 10px;
        padding: 8px 12px;
        background: #eef2ff;
        border-left: 3px solid #4338ca;
        border-radius: 4px;
        font-size: 12px;
        color: var(--kt-ink-700);
    }

    .sr-cozum {
        margin-top: 8px;
        padding: 10px 14px;
        background: #fffbeb;
        border-left: 3px solid #f59e0b;
        border-radius: 4px;
        font-size: 12px;
        color: var(--kt-ink-700);
    }

    .sr-ozet-kart {
        padding: 20px;
        border-radius: 10px;
        text-align: center;
        border: 1px solid;
        min-width: 140px;
    }

    .sr-ozet-sayi {
        font-size: 36px;
        font-weight: 800;
        font-variant-numeric: tabular-nums;
    }

    .sr-ozet-label {
        font-size: 12px;
        font-weight: 600;
        margin-top: 4px;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }
</style>

<div class="kt-page">

    @* ═════════ HEADER ═════════ *@
    <div class="kt-header">
        <div class="kt-header-inner">
            <div class="kt-header-title">
                <div class="kt-header-icon"><i class="fas fa-stethoscope"></i></div>
                <div>
                    <h1>Veri Kontrol</h1>
                    <p>
                        Gelmeyen siparişler, düşmeyen sayımlar ve veri tutarlılığı · @Model.HesaplamaZamani.ToString("dd.MM.yyyy HH:mm")
                    </p>
                </div>
            </div>
            <div class="kt-header-actions">
                <a class="kt-btn kt-btn-ghost" href="@Url.Action("Index")">
                    <i class="fas fa-arrow-left"></i> Dashboard
                </a>
                <a class="kt-btn kt-btn-primary" href="@Url.Action("SaglikRaporu")">
                    <i class="fas fa-rotate"></i> Yeniden Kontrol Et
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="kt-card" style="border-left:3px solid var(--kt-pos); padding:12px 20px;">
            <i class="fas fa-check-circle" style="color:var(--kt-pos); margin-right:8px;"></i>@TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="kt-card" style="border-left:3px solid var(--kt-neg); padding:12px 20px;">
            <i class="fas fa-exclamation-circle" style="color:var(--kt-neg); margin-right:8px;"></i>@TempData["Error"]
        </div>
    }

    @* ═════════ GELMEYEN SİPARİŞLER ═════════ *@
    <div class="kt-card kt-card-flush">
        <div style="padding:16px 20px; border-bottom:1px solid var(--kt-border); display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
            <div class="kt-section-icon"><i class="fas fa-cart-arrow-down"></i></div>
            <div style="flex:1; min-width:220px;">
                <div style="font-weight:700; color:var(--kt-ink-900); font-size:14px;">Gelmeyen siparişler</div>
                <div style="font-size:12px; color:var(--kt-ink-500);">
                    Sipariş yazılımında bekleyen ama bizde görünmeyen siparişler ve nedenleri
                </div>
            </div>
            @if (siparis != null && siparis.ApiyeUlasildi)
            {
                <div style="font-size:12px; color:var(--kt-ink-500); text-align:right;">
                    Sipariş yazılımında <strong>@siparis.ApidekiSiparis</strong> bekleyen sipariş ·
                    <strong>@siparis.Alinmis</strong> tanesi bizde
                </div>
            }
        </div>

        @if (siparis == null || !siparis.ApiyeUlasildi)
        {
            <div style="padding:16px 20px; color:#991b1b; background:#fef2f2; font-size:13px;">
                <i class="fas fa-plug-circle-xmark"></i>
                Sipariş yazılımına ulaşılamadı; karşılaştırma yapılamadı.
                @(siparis?.HataMesaji)
                Adres ve API anahtarı (appsettings → SiparisApi) ile sunucunun erişilebilir olduğunu kontrol edin.
            </div>
        }
        else
        {
            if (siparis.CekilmeyiBekleyen > 0)
            {
                <div style="padding:12px 20px; background:#eff6ff; font-size:13px; color:#1e40af; display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                    <span><i class="fas fa-circle-info"></i>
                        <strong>@siparis.CekilmeyiBekleyen</strong> yeni sipariş çekilmeyi bekliyor — bir engeli yok.</span>
                    <a class="kt-btn kt-btn-primary" href="@Url.Action("Index", "Dogrulama")" style="margin-left:auto;">
                        Doğrulamaya git ve "Siparişleri Çek"e bas
                    </a>
                </div>
            }

            if (siparis.ApiSinirinaTakildi)
            {
                <div style="padding:12px 20px; background:#fffbeb; font-size:13px; color:#92400e;">
                    <i class="fas fa-triangle-exclamation"></i>
                    Son 60 günde 500'den fazla sipariş var; sipariş yazılımı en yeni 500'ünü gönderdiği için daha eskileri okunamadı.
                </div>
            }

            if (siparis.EskiOlduguIcinAlinmayan > 0)
            {
                <div style="padding:10px 20px; font-size:12.5px; color:var(--kt-ink-500); border-bottom:1px solid var(--kt-border);">
                    <i class="fas fa-clock-rotate-left"></i>
                    @siparis.EskiOlduguIcinAlinmayan sipariş 60 günden eski olduğu için bilerek alınmıyor
                    (sipariş yazılımında işlenen siparişler de "bekliyor" görünmeye devam ediyor; bu bir sorun değil).
                </div>
            }

            if (engelli.Count == 0)
            {
                <div style="padding:16px 20px; color:#15803d; font-size:13px;">
                    <i class="fas fa-circle-check"></i> Engele takılan sipariş yok.
                </div>
            }
            else
            {
                <div class="kt-table-wrap">
                    <table class="kt-table" data-sayfala="25">
                        <thead>
                            <tr>
                                <th>Sipariş No</th>
                                <th>Kurum</th>
                                <th>Müşteri Kodu</th>
                                <th class="text-center">Tarih</th>
                                <th>Neden gelmedi?</th>
                                <th>Ne yapılmalı?</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var g in engelli)
                            {
                                <tr>
                                    <td style="font-variant-numeric:tabular-nums;">#@g.OrderId</td>
                                    <td>@(g.KurumAdi ?? "—")</td>
                                    <td><code>@(string.IsNullOrEmpty(g.MusteriKodu) ? "—" : g.MusteriKodu)</code></td>
                                    <td class="text-center" style="font-size:12px;">@(g.Tarih?.ToString("dd.MM.yyyy") ?? "—")</td>
                                    <td style="font-weight:600; color:#b45309;">@g.Neden</td>
                                    <td style="font-size:12.5px; color:var(--kt-ink-700);">@g.Cozum</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>

    @* ═════════ DÜŞMEYEN SAYIMLAR ═════════ *@
    <div class="kt-card kt-card-flush">
        <div style="padding:16px 20px; border-bottom:1px solid var(--kt-border); display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
            <div class="kt-section-icon"><i class="fas fa-clipboard-list"></i></div>
            <div style="flex:1; min-width:220px;">
                <div style="font-weight:700; color:var(--kt-ink-900); font-size:14px;">Düşmeyen sayımlar</div>
                <div style="font-size:12px; color:var(--kt-ink-500);">
                    Sayım uygulamasında olup bize yansımamış sayımlar ve nedenleri
                </div>
            </div>
            <form method="post" action="@Url.Action("SayimlariYenile")" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="donus" value="SaglikRaporu" />
                <button type="submit" class="kt-btn kt-btn-success"><i class="fas fa-rotate"></i> Sayımları Yenile</button>
            </form>
        </div>

        @if (sayim == null || !sayim.ApiyeUlasildi)
        {
            <div style="padding:16px 20px; color:#991b1b; background:#fef2f2; font-size:13px;">
                <i class="fas fa-plug-circle-xmark"></i>
                Sayım uygulamasına ulaşılamadı; karşılaştırma yapılamadı.
                Adres ve API anahtarı (appsettings → StokSayimApi) ile sunucunun erişilebilir olduğunu kontrol edin.
            </div>
        }
        else if (sayimSorunlu.Count == 0)
        {
            <div style="padding:16px 20px; color:#15803d; font-size:13px;">
                <i class="fas fa-circle-check"></i>
                Sayım uygulamasındaki @sayim.ApidenGelenHastaneler.Count hastanenin tamamı eşleşmiş ve sayımları güncel.
            </div>
        }
        else
        {
            <div class="kt-table-wrap">
                <table class="kt-table" data-sayfala="25">
                    <thead>
                        <tr>
                            <th>Sayım uygulamasındaki hastane</th>
                            <th class="text-center">Oradaki son sayım</th>
                            <th class="text-center">Bizdeki son sayım</th>
                            <th>Neden düşmedi?</th>
                            <th>Ne yapılmalı?</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in sayimSorunlu.OrderBy(x => x.Eslesti).ThenBy(x => x.ApiHospitalName))
                        {
                            <tr>
                                <td>
                                    @h.ApiHospitalName
                                    <div style="font-size:11px; color:var(--kt-ink-400);">@h.SatirSayisi sayım satırı</div>
                                </td>
                                <td class="text-center" style="font-size:12px;">@(h.ApiSonSayim?.ToString("dd.MM.yyyy") ?? "—")</td>
                                <td class="text-center" style="font-size:12px;">@(h.BizdekiSonSayim?.ToString("dd.MM.yyyy") ?? "yok")</td>
                                @if (!h.Eslesti)
                                {
                                    <td style="font-weight:600; color:#b45309;">Hastane adı bizdeki hiçbir hastaneyle eşleşmiyor</td>
                                    <td style="font-size:12.5px;">
                                        <a href="@Url.Action("SayimEslesme")">Sayım Eşleşme</a> ekranında bu adı bir hastaneye bağlayın, sonra "Sayımları Yenile".
                                    </td>
                                }
                                else
                                {
                                    <td style="font-weight:600; color:#b45309;">Yeni sayım henüz alınmamış</td>
                                    <td style="font-size:12.5px;">"Sayımları Yenile" düğmesine basın.</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @* ═════════ TUTARLILIK KONTROLLERİ ═════════ *@
    <div style="font-weight:700; color:var(--kt-ink-900); font-size:14px; margin: 6px 2px -4px;">
        Tutarlılık kontrolleri
        <span style="font-weight:400; font-size:12px; color:var(--kt-ink-500);">
            · @Model.ToplamGecen sorunsuz · @Model.ToplamDikkat dikkat · @Model.ToplamHata hata — ayrıntı için satıra tıklayın
        </span>
    </div>

    @* ═════════ KONTROLLER ═════════ *@
    <div>
        @foreach (var k in Model.Kontroller.OrderByDescending(x => (int)x.Durum))
        {
            var color = DurumColor(k.Durum);
            var bg = DurumBg(k.Durum);
            <div class="sr-kontrol" id="ctrl-@k.Kod" style="--durum-color: @color; --body-bg: @bg;">
                <div class="sr-kontrol-head" onclick="document.getElementById('ctrl-@k.Kod').classList.toggle('acik')">
                    <div class="sr-kontrol-icon" style="background: @color;">
                        <i class="fas @DurumIcon(k.Durum)"></i>
                    </div>
                    <div class="sr-kontrol-info">
                        <div class="sr-kontrol-baslik">
                                                        @k.Baslik
                            <span class="sr-kontrol-kategori" style="margin-left: 6px;">@k.Kategori</span>
                        </div>
                        <div class="sr-kontrol-aciklama">@k.Aciklama</div>
                    </div>
                    <div class="sr-kontrol-sayac" style="color: @color;">
                        @if (k.BulguAdeti == 0)
                        {
                            <i class="fas fa-check" style="font-size: 18px;"></i>
                        }
                        else
                        {
                            @k.BulguAdeti
                        }
                    </div>
                    <i class="fas fa-chevron-down" style="color: var(--kt-ink-400); transition: transform 0.2s;"></i>
                </div>

                @if (k.BulguAdeti > 0)
                {
                    <div class="sr-kontrol-body">
                        @if (!string.IsNullOrWhiteSpace(k.CozumOnerisi))
                        {
                            <div class="sr-cozum">
                                <strong><i class="fas fa-lightbulb"></i> Çözüm önerisi:</strong>
                                @k.CozumOnerisi
                            </div>
                        }

                        <div style="margin-top: 10px; font-size: 12px; color: var(--kt-ink-500); margin-bottom: 6px;">
                            <strong>Bulgular</strong>@(k.BulguAdeti > k.BulguDetaylar.Count ? $" (toplam {k.BulguAdeti}, ilk {k.BulguDetaylar.Count} tanesi)" : "")
                        </div>
                        <div class="sr-bulgu-list">
                            @foreach (var b in k.BulguDetaylar)
                            {
                                <div class="item">@b</div>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(k.AksiyonUrl))
                        {
                            <div class="sr-aksiyon">
                                <a href="@k.AksiyonUrl" style="color: #4338ca; font-weight: 600; text-decoration: none;">
                                    <i class="fas fa-arrow-right"></i> @(k.AksiyonText ?? "Devam")
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <div class="kt-card" style="padding: 12px 18px; background: var(--kt-bg); border-style: dashed;">
        <div style="font-size: 11.5px; color: var(--kt-ink-500); line-height: 1.6;">
            <strong style="color: #dc2626;">Hata</strong> = stok ve öneri rakamlarını doğrudan bozuyor, öncelikle düzeltilmeli ·
            <strong style="color: #f59e0b;">Dikkat</strong> = izlenmeli, işi durdurmaz.
            Bu sayfa yalnızca okur; hiçbir kaydı değiştirmez.
        </div>
    </div>

</div>

@await Html.PartialAsync("_Sayfalama")
