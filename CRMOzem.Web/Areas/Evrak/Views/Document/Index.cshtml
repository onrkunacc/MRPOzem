@model CRMOzem.Core.ViewModels.DocumentListViewModel

@{
    ViewData["Title"] = "Evrak Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="card shadow-sm border-0">
        <div class="card-header text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Evrak Listesi</h4>
            <form method="get" asp-action="Index" class="d-flex">
                <input type="text" name="searchTerm" class="form-control form-control-sm me-2" placeholder="Kod / Konu ara..." value="@Model.SearchTerm" />
                &nbsp;&nbsp;
                <button type="submit" class="btn btn-light btn-sm">Ara</button>
            </form>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table">
                    <tr>
                        <th>Kod</th>
                        <th>Konu</th>
                        <th>Kategori</th>
                        <th>Tarih</th>
                        <th>Gönderim</th>
                        <th>Kargo</th>
                        <th class="text-center align-middle">Durum</th>
                        <th>Not</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var document in Model.Documents)
                    {
                        <tr>
                            <td>@document.Code</td>
                            <td>@document.Subject</td>
                            <td>@document.Category?.Description</td>
                            <td>@document.Date.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@document.DeliveryMethod</td>
                            <td>@(string.IsNullOrWhiteSpace(document.CargoCompany) ? "-" : document.CargoCompany)</td>
                            <td class="text-center align-middle">
                                @if (!document.IsSent)
                                {
                                    <div class="form-check d-flex justify-content-center">
                                        <input type="checkbox" class="form-check-input sent-checkbox" data-id="@document.Id" />
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-success" style="font-size: 0.9rem;">@document.SentDate?.ToString("dd.MM.yyyy HH:mm")</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm @(string.IsNullOrEmpty(document.Notes) ? "btn-danger" : "btn-success") note-btn" data-id="@document.Id" data-notes="@document.Notes">
                                    📝 Not
                                </button>
                            </td>
                            <td class="text-center">
                                <a href="@Url.Action("EditDocument", new { id = document.Id })" class="btn btn-warning btn-sm me-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer text-center">
            <nav>
                <ul class="pagination justify-content-center mb-0">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = i, searchTerm = Model.SearchTerm })">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>

<!-- Not Modal -->
<div class="modal fade" id="noteModal" tabindex="-1" aria-labelledby="noteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Not Ekle / Görüntüle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <textarea id="noteContent" class="form-control" rows="5"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" id="saveNoteBtn">Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentDocumentId = null;

        document.querySelectorAll(".note-btn").forEach(btn => {
            btn.addEventListener("click", function () {
                currentDocumentId = this.dataset.id;
                document.getElementById("noteContent").value = this.dataset.notes || "";
                new bootstrap.Modal(document.getElementById('noteModal')).show();
            });
        });

        document.getElementById("saveNoteBtn").addEventListener("click", function () {
            let note = document.getElementById("noteContent").value;
            fetch(`/Evrak/Document/AddNote/${currentDocumentId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ note })
            })
            .then(res => res.json())
            .then(data => {
                if (data.message.includes("başarı")) location.reload();
            });
        });

        document.querySelectorAll(".sent-checkbox").forEach(cb => {
            cb.addEventListener("change", function () {
                if (confirm("Evrak gönderildi olarak işaretlensin mi?")) {
                    fetch(`/Evrak/Document/MarkAsSent/${this.dataset.id}`, { method: 'POST' })
                        .then(() => location.reload());
                } else {
                    this.checked = false;
                }
            });
        });

        function deleteDocument(id) {
            if (!confirm("Bu evrağı silmek istediğinize emin misiniz?")) return;
            fetch(`/Evrak/Document/DeleteDocument/${id}`, {
                method: 'DELETE',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(r => r.ok ? location.reload() : alert("Silinemedi."));
        }
    </script>
}
