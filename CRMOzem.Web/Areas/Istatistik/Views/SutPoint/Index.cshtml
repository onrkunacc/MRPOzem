@model SutPointVm

@{
    ViewData["Title"] = "SUT Puanları";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .table-sticky thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: #fff;
    }

    .num {
        text-align: right;
        white-space: nowrap;
    }

    .code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono","Courier New", monospace;
        font-weight: 600;
        letter-spacing: .2px;
    }

    .toolbar {
        position: sticky;
        top: 0;
        z-index: 3;
        background: #f8f9fa;
        border: 1px solid rgba(0,0,0,.06);
        border-radius: .75rem;
        padding: .75rem;
    }

    .point-input {
        max-width: 140px;
        font-weight: 600;
    }

    .row-dirty td {
        box-shadow: inset 3px 0 0 rgba(255,193,7,.9); /* sarı şerit */
    }

    .hint {
        font-size: .85rem;
        color: #6c757d;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        border: 1px solid rgba(0,0,0,.08);
        background: #fff;
        border-radius: 999px;
        padding: .25rem .6rem;
        font-size: .85rem;
        color: #495057;
        white-space: nowrap;
    }

        .pill strong {
            font-weight: 700;
        }

    .badge-muted {
        background-color: #eef1f4;
        color: #495057;
        border: 1px solid rgba(0,0,0,.06);
    }

    .empty-badge {
        background: rgba(220,53,69,.08);
        color: #dc3545;
        border: 1px solid rgba(220,53,69,.15);
    }
</style>

<div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-2 mb-3">
    <div>
        <h4 class="mb-1">SUT Puanları</h4>
    </div>

    <form method="get" class="d-flex gap-2">
        <input type="number" class="form-control" name="year" value="@Model.Year" style="max-width:140px;" />
        <button class="btn btn-outline-primary" type="submit">
            <i class="fe fe-refresh-cw mr-2"></i> Getir
        </button>
    </form>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form method="post" asp-action="CopyFrom" class="row g-2">
            @Html.AntiForgeryToken()
            <div class="col-6 col-md-2">
                <label class="form-label">Kaynak Yıl</label>
                <input type="number" class="form-control" name="fromYear" value="@(Model.Year - 1)" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label">Hedef Yıl</label>
                <input type="number" class="form-control" name="toYear" value="@Model.Year" />
            </div>
            <div class="col-12 col-md-6 d-flex align-items-end gap-2 flex-wrap">
                <button class="btn btn-outline-secondary" type="submit" name="overwrite" value="false">
                    <i class="fe fe-copy mr-2"></i> Kopyala (Boşları Doldur)
                </button>
                &nbsp; &nbsp;
                <button class="btn btn-outline-warning" type="submit" name="overwrite" value="true">
                    <i class="fe fe-alert-triangle mr-2"></i> Kopyala (Üzerine Yaz)
                </button>
                <span class="hint">İpucu: Yeni yılda hızlı başlangıç için idealdir.</span>
            </div>
        </form>
    </div>
</div>

<form method="post" asp-action="Save" id="sutForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="year" value="@Model.Year" />

    <!-- Modern Toolbar -->
    <div class="toolbar mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-5">
                <label class="form-label mb-1">Ara</label>
                <input id="q" type="text" class="form-control" placeholder="Test adı veya SUT kodu ile ara…">
            </div>

            <div class="col-6 col-md-3">
                <label class="form-label mb-1">Filtre</label>
                <div class="d-flex gap-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="onlyEmpty" />
                        <label class="form-check-label" for="onlyEmpty">Sadece boşlar</label>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-4 d-flex justify-content-md-end gap-2">
                <span class="pill"><i class="fe fe-list"></i> <strong id="shownCount">0</strong> / <span id="totalCount">0</span></span>
                <span class="pill"><i class="fe fe-alert-circle"></i> Boş: <strong id="emptyCount">0</strong></span>
                <span class="pill d-none" id="dirtyPill"><i class="fe fe-edit-3"></i> Kaydedilmedi</span>

                <button class="btn btn-primary px-4" type="submit">
                    <i class="fe fe-save mr-2"></i> Kaydet
                </button>
            </div>

            <div class="col-12">
                <div class="hint">
                    Klavye: <b>Enter / ↓</b> alt satıra geçer, <b>↑</b> üst satıra çıkar.
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover table-sm mb-0 table-sticky" id="sutTable">
                    <thead class="border-bottom">
                        <tr>
                            <th style="width:60px">#</th>
                            <th>Test</th>
                            <th style="width:160px">SUT Kodu</th>
                            <th style="width:170px" class="num">SUT Puanı</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Rows.Count; i++)
                        {
                            var r = Model.Rows[i];
                            var val = r.Point.HasValue ? r.Point.Value.ToString("N2") : "";
                            <tr data-testname="@((r.TestName ?? "").ToLowerInvariant())" data-sutcode="@((r.SutCode ?? "").ToLowerInvariant())" data-hasvalue="@(string.IsNullOrWhiteSpace(val) ? "0" : "1")">
                                <td>@(i + 1)</td>
                                <td>
                                    <div class="fw-semibold">@r.TestName</div>
                                </td>
                                <td class="code">
                                    @if (!string.IsNullOrWhiteSpace(r.SutCode))
                                    {
                                        <span class="badge badge-muted">@r.SutCode</span>
                                    }
                                    else
                                    {
                                        <span class="badge empty-badge">Kod yok</span>
                                    }
                                </td>
                                <td class="num">
                                    <input type="hidden" name="testId" value="@r.TestID" />
                                    <input type="text"
                                           name="point"
                                           class="form-control form-control-sm text-end point-input"
                                           value="@val"
                                           placeholder="0,00"
                                           inputmode="decimal"
                                           data-index="@i" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-3 d-flex justify-content-between align-items-center">
                <button class="btn btn-primary px-4" type="submit">
                    <i class="fe fe-save mr-2"></i> Kaydet
                </button>
            </div>
        </div>
    </div>
</form>

<script>
    (function(){
        const trTR = 'tr-TR';
        const table = document.getElementById('sutTable');
        const q = document.getElementById('q');
        const onlyEmpty = document.getElementById('onlyEmpty');
        const dirtyPill = document.getElementById('dirtyPill');

        const totalCountEl = document.getElementById('totalCount');
        const shownCountEl = document.getElementById('shownCount');
        const emptyCountEl = document.getElementById('emptyCount');

        const rows = Array.from(table.querySelectorAll('tbody tr'));
        const inputs = Array.from(table.querySelectorAll('input.point-input'));

        totalCountEl.textContent = rows.length.toString();

        function normalizeDecimalInput(v){
            // 10.08 -> 10,08 / "  " -> ""
            v = (v ?? '').toString().trim();
            if(!v) return '';
            v = v.replace(/\./g, ','); // TR için
            // sadece rakam , - izin ver (kullanıcı hatasını azalt)
            v = v.replace(/[^0-9,\-]/g, '');
            return v;
        }

        function toNumberTR(v){
            v = normalizeDecimalInput(v);
            if(!v) return null;
            // "10,08" -> 10.08
            const n = Number(v.replace(',', '.'));
            if(Number.isFinite(n)) return n;
            return null;
        }

        function formatN2TR(n){
            try{
                return n.toLocaleString(trTR, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }catch{
                return n.toFixed(2).replace('.', ',');
            }
        }

        function updateCounts(){
            let shown = 0;
            let empty = 0;

            rows.forEach(r=>{
                if(r.style.display === 'none') return;
                shown++;
                const hasValue = r.getAttribute('data-hasvalue') === '1';
                if(!hasValue) empty++;
            });

            shownCountEl.textContent = shown.toString();
            emptyCountEl.textContent = empty.toString();
        }

        function applyFilter(){
            const query = (q.value || '').trim().toLocaleLowerCase(trTR);
            const only = !!onlyEmpty.checked;

            rows.forEach(r=>{
                const tn = r.getAttribute('data-testname') || '';
                const sc = r.getAttribute('data-sutcode') || '';
                const hasValue = r.getAttribute('data-hasvalue') === '1';

                const match = !query || tn.includes(query) || sc.includes(query);
                const passEmpty = !only || !hasValue;

                r.style.display = (match && passEmpty) ? '' : 'none';
            });

            updateCounts();
        }

        let dirty = false;
        function setDirty(isDirty){
            dirty = isDirty;
            dirtyPill.classList.toggle('d-none', !dirty);
        }

        // satır işaretleme + data-hasvalue güncelleme
        inputs.forEach((inp, idx)=>{
            const tr = inp.closest('tr');
            const initial = (inp.value || '').trim();

            inp.dataset.initial = initial;

            inp.addEventListener('input', ()=>{
                const v = normalizeDecimalInput(inp.value);
                inp.value = v;

                const isNow = (v || '').trim();
                const isChanged = isNow !== (inp.dataset.initial || '');
                tr.classList.toggle('row-dirty', isChanged);

                // boş mu dolu mu
                tr.setAttribute('data-hasvalue', isNow ? '1' : '0');

                setDirty(rows.some(r => r.classList.contains('row-dirty')));
                if (onlyEmpty.checked) applyFilter();
                else updateCounts();
            });

            // blur: N2 formatla
            inp.addEventListener('blur', ()=>{
                const n = toNumberTR(inp.value);
                if(n === null){
                    // boş veya hatalı ise sadece normalize bırak
                    inp.value = normalizeDecimalInput(inp.value);
                    return;
                }
                inp.value = formatN2TR(n);
                // data-hasvalue güncelle
                tr.setAttribute('data-hasvalue', inp.value.trim() ? '1' : '0');
                if (onlyEmpty.checked) applyFilter();
                else updateCounts();
            });

            // klavye navigasyon: Enter/↓/↑
            inp.addEventListener('keydown', (e)=>{
                if(e.key === 'Enter' || e.key === 'ArrowDown'){
                    e.preventDefault();
                    focusNext(idx, +1);
                } else if(e.key === 'ArrowUp'){
                    e.preventDefault();
                    focusNext(idx, -1);
                }
            });
        });

        function focusNext(currentIndex, dir){
            // Görünür satırların inputlarını topla
            const visibleInputs = inputs.filter(i => i.closest('tr').style.display !== 'none');
            const pos = visibleInputs.indexOf(inputs[currentIndex]);
            if(pos === -1) return;

            const next = visibleInputs[pos + dir];
            if(next){
                next.focus();
                next.select();
            }
        }

        // filtre events
        let t = null;
        q.addEventListener('input', ()=>{
            clearTimeout(t);
            t = setTimeout(applyFilter, 150);
        });
        onlyEmpty.addEventListener('change', applyFilter);

        // sayfa kapanırken uyar
        window.addEventListener('beforeunload', (e)=>{
            if(!dirty) return;
            e.preventDefault();
            e.returnValue = '';
        });

        // submit olunca dirty kapat (kaydedildi varsay)
        document.getElementById('sutForm').addEventListener('submit', ()=>{
            setDirty(false);
        });

        // initial count
        // data-hasvalue doğru olsun diye initial değerlerden say
        rows.forEach(r=>{
            const inp = r.querySelector('input.point-input');
            const v = (inp?.value || '').trim();
            r.setAttribute('data-hasvalue', v ? '1' : '0');
            r.setAttribute('data-testname', (r.getAttribute('data-testname') || '').toLowerCase());
            r.setAttribute('data-sutcode', (r.getAttribute('data-sutcode') || '').toLowerCase());
        });

        applyFilter();
    })();
</script>