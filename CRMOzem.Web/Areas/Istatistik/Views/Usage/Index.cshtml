@model IEnumerable<CRMOzem.Core.ViewModels.UsageViewModel>
@using System.Text.Json
@using System.Text.Json.Serialization

@{
    ViewData["Title"] = "İstatistik Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var flat = Model.Select(m => new
    {
        id = m.Id,
        hospitalID = m.HospitalID,
        hospitalName = m.HospitalName ?? "",
        testID = m.TestID,
        testName = m.TestName ?? "",
        month = m.Month,
        testCount = m.TestCount
    });

    var json = JsonSerializer.Serialize(flat, new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    });
}

<style>
    .filter-toolbar {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: .75rem;
        padding: .75rem
    }

        .filter-toolbar .form-label {
            font-size: .8rem;
            color: #6c757d;
            margin-bottom: .25rem
        }

        .filter-toolbar .form-select, .filter-toolbar .form-control {
            font-size: .9rem
        }

        .filter-toolbar .input-group-text {
            background: #fff;
            border-right: 0
        }

        .filter-toolbar .input-group .form-control, .filter-toolbar .input-group .form-select {
            border-left: 0
        }

    .sticky-head thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        background: #fff
    }

    .table-sm td, .table-sm th {
        padding-top: .5rem;
        padding-bottom: .5rem
    }

    .sortable {
        cursor: pointer;
        user-select: none
    }

    .sort-indicator {
        opacity: .5;
        margin-left: .25rem
    }

    .btn-icon {
        width: 2rem;
        height: 2rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0
    }

    .pagination .page-link {
        min-width: 2.25rem;
        text-align: center
    }

    .badge-muted {
        background-color: #eef1f4;
        color: #495057
    }
</style>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <h5 class="mb-0"><i class="fa fa-vials me-2"></i> İstatistik Listesi</h5>
            <span class="badge badge-muted" id="totalBadge">Toplam: 0</span>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fa fa-plus me-1"></i> Yeni İstatistik
        </a>
    </div>

    <div class="card-body">
        <form class="filter-toolbar mb-3" id="filterForm" onsubmit="return false;">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-lg-3">
                    <label class="form-label">Hastane</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="fa fa-hospital"></i></span>
                        <select class="form-select form-select-sm" id="hospitalId">
                            <option value="">Tüm Hastaneler</option>
                        </select>
                    </div>
                </div>

                <div class="col-12 col-lg-3">
                    <label class="form-label">Test</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="fa fa-vial"></i></span>
                        <select class="form-select form-select-sm" id="testId">
                            <option value="">Tüm Testler</option>
                        </select>
                    </div>
                </div>

                <div class="col-6 col-lg-2">
                    <label class="form-label">Başlangıç</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                        <input type="date" class="form-control form-control-sm" id="startDate" />
                    </div>
                </div>

                <div class="col-6 col-lg-2">
                    <label class="form-label">Bitiş</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="fa fa-calendar-day"></i></span>
                        <input type="date" class="form-control form-control-sm" id="endDate" />
                    </div>
                </div>

                <div class="col-6 col-lg-2">
                    <label class="form-label">Min Adet</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="fa fa-arrow-down-1-9"></i></span>
                        <input type="number" min="0" class="form-control form-control-sm" id="minCount" />
                    </div>
                </div>

                <div class="col-6 col-lg-2">
                    <label class="form-label">Max Adet</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="fa fa-arrow-up-9-1"></i></span>
                        <input type="number" min="0" class="form-control form-control-sm" id="maxCount" />
                    </div>
                </div>

                <div class="col-12 col-lg-3">
                    <label class="form-label">Ara (Hastane / Test)</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="fa fa-magnifying-glass"></i></span>
                        <input type="text" class="form-control form-control-sm" id="q" placeholder="Örn: Denizli Devlet Hastanesi" />
                    </div>
                </div>

                <div class="col-6 col-lg-2">
                    <label class="form-label">Sayfa Boyutu</label>
                    <select class="form-select form-select-sm" id="pageSize">
                        <option>5</option>
                        <option>10</option>
                        <option selected>20</option>
                        <option>50</option>
                        <option>100</option>
                    </select>
                </div>

                <div class="col-6 col-lg-2 ms-lg-auto d-grid">
                    <button type="button" class="btn btn-sm btn-primary" id="applyBtn">
                        <i class="fa fa-filter me-1"></i> Uygula
                    </button>
                </div>

                <div class="col-6 col-lg-2 d-grid">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="clearBtn">
                        <i class="fa fa-broom me-1"></i> Temizle
                    </button>
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle sticky-head" id="dataTable">
                <thead class="table-light">
                    <tr>
                        <th data-sort="hospitalName" class="sortable">Hastane <span class="sort-indicator"></span></th>
                        <th data-sort="testName" class="sortable">Test <span class="sort-indicator"></span></th>
                        <th data-sort="month" class="sortable">Ay <span class="sort-indicator"></span></th>
                        <th data-sort="testCount" class="sortable">Kullanılan Adet <span class="sort-indicator"></span></th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td colspan="5" class="text-center text-muted py-4">Yükleniyor…</td></tr>
                </tbody>
            </table>
        </div>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 mt-2">
            <div id="pageInfo" class="text-muted small">Sayfa 1 / 1</div>
            <nav aria-label="Sayfalama">
                <ul class="pagination mb-0" id="pager"></ul>
            </nav>
        </div>
    </div>
</div>

<div id="af" class="d-none">
    <form method="post">
        @Html.AntiForgeryToken()
    </form>
</div>

<script>
    (function(){
        const trTR = 'tr-TR';
        const raw = @Html.Raw(json);

        const state = {
            q:'', hospitalId:'', testId:'',
            startDate:'', endDate:'',
            minCount:'', maxCount:'',
            sortKey:'month', sortDir:'desc',
            page:1, pageSize: parseInt(document.getElementById('pageSize').value, 10) || 20
        };

        const els = {
            hospitalId: document.getElementById('hospitalId'),
            testId: document.getElementById('testId'),
            startDate: document.getElementById('startDate'),
            endDate: document.getElementById('endDate'),
            minCount: document.getElementById('minCount'),
            maxCount: document.getElementById('maxCount'),
            q: document.getElementById('q'),
            pageSize: document.getElementById('pageSize'),
            applyBtn: document.getElementById('applyBtn'),
            clearBtn: document.getElementById('clearBtn'),
            tbody: document.querySelector('#dataTable tbody'),
            thead: document.querySelector('#dataTable thead'),
            pager: document.getElementById('pager'),
            pageInfo: document.getElementById('pageInfo'),
            totalBadge: document.getElementById('totalBadge')
        };

        const hospitals = [...new Map(raw.map(x => [x.hospitalID, { id: x.hospitalID, name: x.hospitalName }])).values()]
            .sort((a,b)=>a.name.localeCompare(b.name, trTR));
        const tests = [...new Map(raw.map(x => [x.testID, { id: x.testID, name: x.testName }])).values()]
            .sort((a,b)=>a.name.localeCompare(b.name, trTR));

        hospitals.forEach(h=>{ const o=document.createElement('option'); o.value=h.id; o.textContent=h.name; els.hospitalId.appendChild(o); });
        tests.forEach(t=>{ const o=document.createElement('option'); o.value=t.id; o.textContent=t.name; els.testId.appendChild(o); });

        [els.hospitalId, els.testId, els.startDate, els.endDate, els.minCount, els.maxCount, els.pageSize]
            .forEach(e=>e.addEventListener('change', applyFilters));
        els.applyBtn.addEventListener('click', applyFilters);
        els.clearBtn.addEventListener('click', resetAll);

        let t=null;
        els.q.addEventListener('input', ()=>{ clearTimeout(t); t=setTimeout(applyFilters, 200); });

        els.thead.addEventListener('click', (ev)=>{
            const th = ev.target.closest('.sortable'); if(!th) return;
            const key = th.dataset.sort;
            if(state.sortKey === key){ state.sortDir = state.sortDir === 'asc' ? 'desc' : 'asc'; }
            else { state.sortKey = key; state.sortDir = (key==='month' || key==='testCount') ? 'desc':'asc'; }
            state.page = 1; render();
        });

        function resetAll(){
            Object.assign(state,{
                q:'', hospitalId:'', testId:'',
                startDate:'', endDate:'',
                minCount:'', maxCount:'',
                sortKey:'month', sortDir:'desc', page:1, pageSize: parseInt(els.pageSize.value,10) || 20
            });
            els.hospitalId.value=''; els.testId.value='';
            els.startDate.value=''; els.endDate.value='';
            els.minCount.value=''; els.maxCount.value='';
            els.q.value='';
            render();
        }

        function applyFilters(){
            state.q = (els.q.value||'').trim();
            state.hospitalId = els.hospitalId.value || '';
            state.testId = els.testId.value || '';
            state.startDate = els.startDate.value || '';
            state.endDate = els.endDate.value || '';
            state.minCount = els.minCount.value || '';
            state.maxCount = els.maxCount.value || '';
            state.pageSize = parseInt(els.pageSize.value,10) || 20;
            state.page = 1; render();
        }

        function filterData(data){
            const q = state.q.toLocaleLowerCase(trTR);
            return data.filter(x=>{
                if(state.hospitalId && String(x.hospitalID)!==String(state.hospitalId)) return false;
                if(state.testId && String(x.testID)!==String(state.testId)) return false;

                const d = new Date(x.month);
                if(state.startDate && d < new Date(state.startDate)) return false;
                if(state.endDate && d > new Date(state.endDate)) return false;

                if(state.minCount && x.testCount < Number(state.minCount)) return false;
                if(state.maxCount && x.testCount > Number(state.maxCount)) return false;

                if(q){
                    const hay = `${x.hospitalName} ${x.testName}`.toLocaleLowerCase(trTR);
                    if(!hay.includes(q)) return false;
                }
                return true;
            });
        }

        function sortData(data){
            const key = state.sortKey;
            const dir = state.sortDir === 'asc' ? 1 : -1;
            return [...data].sort((a,b)=>{
                let va=a[key], vb=b[key];
                if(key==='month'){ va=new Date(a.month); vb=new Date(b.month); }
                if(key==='testCount'){ va=Number(a.testCount)||0; vb=Number(b.testCount)||0; }
                if(typeof va==='string' && typeof vb==='string'){ return va.localeCompare(vb, trTR)*dir; }
                if(va<vb) return -1*dir; if(va>vb) return 1*dir; return 0;
            });
        }

        function paginate(data){
            const total = data.length;
            const size = state.pageSize;
            const totalPages = Math.max(1, Math.ceil(total/size));
            if(state.page>totalPages) state.page=totalPages;
            const start=(state.page-1)*size;
            const items=data.slice(start,start+size);
            return { items,total,totalPages,start,end:Math.min(start+size,total) };
        }

        function formatMonth(iso){
            const d=new Date(iso);
            return d.toLocaleDateString(trTR,{month:'long',year:'numeric'});
        }

        function renderSortIndicators(){
            document.querySelectorAll('.sortable .sort-indicator').forEach(si=>si.textContent='');
            const th=document.querySelector(`.sortable[data-sort="${state.sortKey}"] .sort-indicator`);
            if(th) th.textContent = state.sortDir==='asc' ? '▲' : '▼';
        }

        function render(){
            const filtered=filterData(raw);
            const sorted=sortData(filtered);
            const {items,total,totalPages,start,end}=paginate(sorted);

            els.totalBadge.textContent=`Toplam: ${total}`;
            els.pageInfo.textContent=`Sayfa ${state.page} / ${totalPages} (${total ? (start+1) : 0} - ${end} / ${total})`;
            renderSortIndicators();

            const fr=document.createDocumentFragment();
            if(items.length===0){
                const tr=document.createElement('tr');
                tr.innerHTML=`<td colspan="5" class="text-center text-muted py-4">Kayıt bulunamadı.</td>`;
                fr.appendChild(tr);
            }else{
                const token=(document.querySelector('#af input[name="__RequestVerificationToken"]')||{}).value||'';
                items.forEach(x=>{
                    const tr=document.createElement('tr');
                    tr.innerHTML=`
                        <td>${escapeHtml(x.hospitalName)}</td>
                        <td>${escapeHtml(x.testName)}</td>
                        <td>${escapeHtml(formatMonth(x.month))}</td>
                        <td>${Number(x.testCount).toLocaleString(trTR)}</td>
                        <td class="text-end">
                            <a class="btn btn-warning btn-icon me-1" title="Düzenle" href="@Url.Action("Edit", "Usage", new { area = "Istatistik" })/${x.id}">
                                <i class="fa fa-edit"></i>
                            </a>
                            <form class="d-inline" method="post" action="@Url.Action("Delete", "Usage", new { area = "Istatistik" })/${x.id}">
                                <input name="__RequestVerificationToken" type="hidden" value="${token}">
                                <button type="submit" class="btn btn-danger btn-icon" title="Sil"
                                    onclick="return confirm('Silmek istediğinize emin misiniz?')">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </form>
                        </td>`;
                    fr.appendChild(tr);
                });
            }
            els.tbody.innerHTML=''; els.tbody.appendChild(fr);
            renderPager(totalPages);
        }

        function renderPager(totalPages){
            const p=state.page, ul=els.pager; ul.innerHTML='';

            const makeItem=(label,page,disabled=false,active=false)=>{
                const li=document.createElement('li');
                li.className=`page-item ${disabled?'disabled':''} ${active?'active':''}`;
                const a=document.createElement('a'); a.className='page-link'; a.href='#'; a.textContent=label;
                if(!disabled && !active){ a.addEventListener('click',e=>{e.preventDefault(); state.page=page; render();}); }
                li.appendChild(a); return li;
            };

            ul.appendChild(makeItem('«',1,p<=1));
            ul.appendChild(makeItem('Önceki',Math.max(1,p-1),p<=1));

            const start=Math.max(1,p-2), end=Math.min(totalPages,p+2);
            for(let i=start;i<=end;i++) ul.appendChild(makeItem(String(i),i,false,i===p));

            ul.appendChild(makeItem('Sonraki',Math.min(totalPages,p+1),p>=totalPages));
            ul.appendChild(makeItem('»',totalPages,p>=totalPages));
        }

        function escapeHtml(s){ return String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m])); }

        render();
    })();
</script>
