@model CRMOzem.Core.ViewModels.ShipmentViewModel
@{
    ViewData["Title"] = "Yeni Gönderim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm">
    <div class="card-header">
        <h5><i class="fa fa-plus-circle me-2"></i> Yeni Gönderim</h5>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post" class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Hastane</label>
                <select asp-for="HospitalID" asp-items="ViewBag.Hospitals" class="form-select"></select>
                <span asp-validation-for="HospitalID" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label">Test</label>
                <select asp-for="TestID" asp-items="ViewBag.Tests" class="form-select"></select>
                <span asp-validation-for="TestID" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label">Tarih</label>
                <input asp-for="Month" type="date" class="form-control" />
                <span asp-validation-for="Month" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label">Test Sayısı</label>
                <input asp-for="SentCount" class="form-control" />
                <span asp-validation-for="SentCount" class="text-danger"></span>
            </div>
            <div class="col-12 text-end">
                <a asp-action="Index" class="btn btn-secondary">Geri</a>
                <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Kaydet</button>
            </div>
        </form>
    </div>
</div>
