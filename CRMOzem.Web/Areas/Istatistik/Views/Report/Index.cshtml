@model CRMOzem.Core.ViewModels.ReportFilterViewModel

@{
    ViewData["Title"] = "Raporlama";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="mb-0"><i class="fa fa-filter me-2"></i> Raporlama Filtreleri</h5>
    </div>
    <div class="card-body">
        <form asp-action="Index" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-md-6">
                <label class="form-label">Hastane</label>
                <select asp-for="HospitalID" asp-items="ViewBag.Hospitals" class="form-select"></select>
                <span asp-validation-for="HospitalID" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label">Ay Seç</label>
                <input asp-for="StartDate" type="month" class="form-control" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100"><i class="fa fa-search"></i> Getir</button>
            </div>
        </form>
    </div>
</div>