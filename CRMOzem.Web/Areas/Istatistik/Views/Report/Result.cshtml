@model IEnumerable<CRMOzem.Core.ViewModels.HospitalTestBalanceViewModel>

@{
    ViewData["Title"] = "Rapor Sonuçları";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fa fa-chart-bar me-2"></i> Rapor Sonuçları</h5>
        <a asp-action="Index" class="btn btn-secondary btn-sm"><i class="fa fa-arrow-left"></i> Filtreye Geri Dön</a>
    </div>
    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead class="table-light">
                <tr>
                    <th>Ay</th>
                    <th>Test Adı</th>
                    <th>Gönderilen</th>
                    <th>Kullanılan</th>
                    <th>Kalan</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Month.ToString("yyyy-MM")</td>
                        <td>@item.TestName</td>
                        <td>@item.TotalSent</td>
                        <td>@item.TotalUsed</td>
                        <td class="fw-bold @(item.Remaining < 0 ? "text-danger" : "text-success")">@item.Remaining</td>
                    </tr>
                }

            </tbody>
        </table>

        <div class="mt-4">
            <canvas id="balanceChart" height="120"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('balanceChart').getContext('2d');
        const chartData = {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    Model.Select(m => $"{m.TestName} ({m.Month:yyyy-MM})"))),
            datasets: [
                {
                    label: 'Gönderilen',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => m.TotalSent))),
                    backgroundColor: 'rgba(54, 162, 235, 0.6)'
                },
                {
                    label: 'Kullanılan',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => m.TotalUsed))),
                    backgroundColor: 'rgba(255, 99, 132, 0.6)'
                },
                {
                    label: 'Kalan',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => m.Remaining))),
                    backgroundColor: 'rgba(75, 192, 192, 0.6)'
                }
            ]
        };

        new Chart(ctx, {
            type: 'bar',
            data: chartData,
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    </script>
}

