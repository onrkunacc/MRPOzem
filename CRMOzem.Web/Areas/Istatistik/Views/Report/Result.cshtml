@model IPagedList<CRMOzem.Core.ViewModels.HospitalTestBalanceViewModel>
@using X.PagedList
@using X.PagedList.Mvc.Core
@using System.Globalization

@{
    ViewData["Title"] = "Rapor Sonuçları";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm mt-3">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <h5 class="mb-0"><i class="fa fa-chart-bar me-2"></i> Rapor Sonuçları</h5>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-secondary btn-sm">
                <i class="fa fa-arrow-left"></i> Filtreye Geri Dön
            </a>
            &nbsp;
            &nbsp;
            <a asp-action="ExportExcel"
               asp-route-hospitalId="@ViewBag.HospitalID"
               asp-route-startDate="@ViewBag.StartDate"
               asp-route-endDate="@ViewBag.EndDate"
               class="btn btn-success btn-sm">
                <i class="fa fa-file-excel"></i> Excel
            </a>
            &nbsp;
            &nbsp;
            <a asp-action="ExportPdf"
               asp-route-hospitalId="@ViewBag.HospitalID"
               asp-route-startDate="@ViewBag.StartDate"
               asp-route-endDate="@ViewBag.EndDate"
               class="btn btn-danger btn-sm">
                <i class="fa fa-file-pdf"></i> PDF
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="mb-2 text-muted small">
            <span class="me-3">
                <strong>Tarih:</strong> @(ViewBag.StartDate ?? "-")
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Ay</th>
                        <th>Test Adı</th>
                        <th>Gönderilen</th>
                        <th>Kullanılan</th>
                        <th>Kalan</th>
                        <th>Detay</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                Kayıt bulunamadı.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Month.ToString("MMMM yyyy", new CultureInfo("tr-TR"))</td>
                                <td>@item.TestName</td>
                                <td>@item.TotalSent</td>
                                <td>@item.TotalUsed</td>
                                <td class="fw-bold @(item.Remaining < 0 ? "text-danger" : "text-success")">@item.Remaining</td>
                                <td>
                                    <button type="button" class="btn btn-outline-info btn-sm btnChart"
                                            data-test="@item.TestName"
                                            data-month="@item.Month.ToString("MMMM yyyy", new CultureInfo("tr-TR"))"
                                            data-sent="@item.TotalSent"
                                            data-used="@item.TotalUsed"
                                            data-remaining="@item.Remaining">
                                        <i class="fa fa-chart-line"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-center mt-3">
            @Html.PagedListPager(
            Model,
            page => Url.Action("Result", new
            {
                page,
                hospitalId = ViewBag.HospitalID,
                startDate = ViewBag.StartDate,
                endDate = ViewBag.EndDate
            }),
                        new PagedListRenderOptions
                        {
                            LiElementClasses = new[] { "page-item" },
                            PageClasses = new[] { "page-link" }
                        })
        </div>
    </div>
</div>

<div class="modal fade" id="chartModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Test Detayı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <canvas id="detailChart" height="100"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var detailChart;

        $(document).on("click", ".btnChart", function () {
            var test = $(this).data("test");
            var month = $(this).data("month");
            var sent = $(this).data("sent");
            var used = $(this).data("used");
            var remaining = $(this).data("remaining");

            if (detailChart) {
                detailChart.destroy();
            }

            const ctx = document.getElementById('detailChart').getContext('2d');
            detailChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ["Gönderilen", "Kullanılan", "Kalan"],
                    datasets: [{
                        label: test + " (" + month + ")",
                        data: [sent, used, remaining],
                        backgroundColor: [
                            'rgba(54, 162, 235, 0.6)',
                            'rgba(255, 99, 132, 0.6)',
                            'rgba(75, 192, 192, 0.6)'
                        ]
                    }]
                },
                options: { responsive: true }
            });

            var modal = new bootstrap.Modal(document.getElementById('chartModal'));
            modal.show();
        });
    </script>
}
