@model CRMOzem.Core.ViewModels.UploadStatisticsViewModel
@{
    ViewData["Title"] = "Toplu İstatistik Yükleme";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var validCount = Model?.PreviewItems?.Count(x => !x.HasError) ?? 0;
    var errorCount = Model?.PreviewItems?.Count(x => x.HasError) ?? 0;
    var totalCount = Model?.PreviewItems?.Count ?? 0;
    var totalAmount = Model?.PreviewItems?.Where(x => !x.HasError).Sum(x => x.TestCount) ?? 0;
}

<style>
    .up-page {
        padding: 1rem 0;
    }

    .up-header {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        color: #fff;
        padding: 1.5rem;
        border-radius: 18px;
        margin-bottom: 1.25rem;
        box-shadow: 0 8px 28px rgba(99,102,241,.25);
    }

        .up-header h1 {
            margin: 0;
            font-size: 1.4rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: .6rem;
        }

        .up-header p {
            margin: .35rem 0 0;
            opacity: .92;
            font-size: .87rem;
        }

    .up-info-banner {
        background: rgba(255,255,255,.85);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,.6);
        border-radius: 14px;
        padding: 1rem 1.25rem;
        margin-bottom: 1rem;
        display: flex;
        gap: 1rem;
        align-items: center;
        border-left: 4px solid #6366f1;
    }

    .up-info-icon {
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .up-info-content {
        flex: 1;
    }

    .up-info-title {
        font-weight: 700;
        color: #1e293b;
        margin-bottom: .15rem;
    }

    .up-info-text {
        color: #64748b;
        font-size: .85rem;
    }

    .up-card {
        background: rgba(255,255,255,.85);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,.6);
        border-radius: 18px;
        box-shadow: 0 4px 20px rgba(0,0,0,.04);
        padding: 1.5rem;
        margin-bottom: 1.25rem;
    }

    .up-form-label {
        font-size: .78rem;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        letter-spacing: .03em;
        margin-bottom: .35rem;
        display: block;
    }

    .up-btn-template {
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        border: none;
        color: #fff;
        padding: .55rem 1.2rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: .87rem;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
    }

        .up-btn-template:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    .up-btn-preview {
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        border: none;
        color: #fff;
        padding: .65rem 1.5rem;
        border-radius: 10px;
        font-weight: 700;
        font-size: .95rem;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
    }

        .up-btn-preview:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    .up-btn-save {
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        border: none;
        color: #fff;
        padding: .65rem 1.75rem;
        border-radius: 10px;
        font-weight: 700;
        font-size: .95rem;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
    }

        .up-btn-save:hover {
            transform: translateY(-1px);
            color: #fff;
        }

        .up-btn-save:disabled {
            opacity: .5;
            cursor: not-allowed;
            transform: none;
        }

    .up-file-drop {
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        padding: 1.5rem;
        text-align: center;
        background: #f8fafc;
        transition: border-color .15s, background .15s;
        cursor: pointer;
    }

        .up-file-drop:hover {
            border-color: #6366f1;
            background: #eef2ff;
        }

        .up-file-drop.has-file {
            border-color: #6366f1;
            background: #eef2ff;
        }

    .up-file-drop-icon {
        font-size: 2rem;
        color: #94a3b8;
        margin-bottom: .5rem;
    }

    .up-file-drop-text {
        font-weight: 600;
        color: #475569;
    }

    .up-file-drop-hint {
        font-size: .8rem;
        color: #94a3b8;
        margin-top: .25rem;
    }

    .up-preview-kpi {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    @@media (max-width: 992px) {
        .up-preview-kpi {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 576px) {
        .up-preview-kpi {
            grid-template-columns: 1fr;
        }
    }

    .up-kpi {
        background: rgba(255,255,255,.85);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,.6);
        border-radius: 14px;
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: .85rem;
    }

    .up-kpi-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: #fff;
        flex-shrink: 0;
    }

    .up-kpi-1 .up-kpi-icon {
        background: linear-gradient(135deg,#3b82f6,#2563eb);
    }

    .up-kpi-2 .up-kpi-icon {
        background: linear-gradient(135deg,#10b981,#059669);
    }

    .up-kpi-3 .up-kpi-icon {
        background: linear-gradient(135deg,#ef4444,#dc2626);
    }

    .up-kpi-4 .up-kpi-icon {
        background: linear-gradient(135deg,#6366f1,#4f46e5);
    }

    .up-kpi-label {
        color: #64748b;
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        font-weight: 600;
    }

    .up-kpi-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1e293b;
        line-height: 1.1;
    }

    .up-table-wrap {
        background: rgba(255,255,255,.85);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,.6);
        border-radius: 16px;
        overflow: hidden;
    }

    .up-table {
        width: 100%;
        margin: 0;
        font-size: .88rem;
    }

        .up-table thead th {
            background: #f8fafc;
            border-bottom: 2px solid #e2e8f0;
            font-weight: 700;
            text-transform: uppercase;
            font-size: .72rem;
            letter-spacing: .04em;
            color: #475569;
            padding: .75rem 1rem;
        }

        .up-table tbody td {
            padding: .6rem 1rem;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

    .up-row-error {
        background: rgba(239,68,68,.06);
    }

    .up-row-warning {
        background: rgba(245,158,11,.06);
    }

    .up-row-ok {
        background: rgba(99,102,241,.03);
    }

    .up-badge {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        padding: .2rem .55rem;
        font-size: .7rem;
        border-radius: 999px;
        font-weight: 600;
    }

    .up-badge-sut {
        background: linear-gradient(135deg, #10b981, #059669);
        color: #fff;
    }

    .up-badge-name {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #fff;
    }

    .up-badge-none {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: #fff;
    }

    .up-badge-sutcode {
        background: #eef1f4;
        color: #475569;
        font-family: ui-monospace, monospace;
    }

    .up-amount-input {
        max-width: 110px;
        text-align: right;
        font-weight: 700;
        border: 1.5px solid #e2e8f0;
        border-radius: 8px;
        padding: .35rem .5rem;
    }

        .up-amount-input:focus {
            border-color: #6366f1;
            outline: none;
            box-shadow: 0 0 0 3px rgba(99,102,241,.15);
        }

    .up-btn-add {
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: #fff;
        border: none;
        padding: .25rem .75rem;
        border-radius: 6px;
        font-size: .78rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: .3rem;
    }

        .up-btn-add:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .up-alert {
        border-radius: 12px;
        border: none;
        padding: .85rem 1.25rem;
    }
</style>

<div class="up-page">

    <div class="up-header">
        <h1>📊 Toplu İstatistik Yükleme</h1>
        <p>Excel veya PDF ile birden fazla kullanım kaydını tek seferde ekleyin.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success up-alert"><i class="fa fa-check-circle me-2"></i>@TempData["Success"]</div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success up-alert"><i class="fa fa-check-circle me-2"></i>@TempData["SuccessMessage"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger up-alert"><i class="fa fa-exclamation-circle me-2"></i>@TempData["Error"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger up-alert"><i class="fa fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]</div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning up-alert"><i class="fa fa-exclamation-triangle me-2"></i>@TempData["Warning"]</div>
    }

    <!-- Bilgi Banner -->
    <div class="up-info-banner">
        <div class="up-info-icon">📋</div>
        <div class="up-info-content">
            <div class="up-info-title">Şablon nasıl kullanılır?</div>
            <div class="up-info-text">
                Önce <strong>hastane ve ay seçin</strong>, ardından <strong>"Şablon İndir"</strong>e tıklayın.
                Şablonda o hastanenin aktif testleri SUT kodlarıyla birlikte ön dolu gelir — sadece <strong>Kullanılan Miktar</strong> kolonunu doldurup yükleyin.
            </div>
        </div>
        <a id="btnDownloadTemplate" class="up-btn-template">
            <i class="fa fa-download"></i> Şablon İndir
        </a>
    </div>

    <!-- Form Card -->
    <div class="up-card">
        <form asp-action="Index" method="post" enctype="multipart/form-data" id="uploadForm">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="up-form-label">Hastane</label>
                    <select asp-for="HospitalID" asp-items="ViewBag.Hospitals" class="form-select form-select-lg">
                        <option value="">— Hastane seçiniz —</option>
                    </select>
                    <span asp-validation-for="HospitalID" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label class="up-form-label">Ay</label>
                    <input asp-for="Month" type="month" class="form-control form-control-lg" />
                    <span asp-validation-for="Month" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label class="up-form-label">Dosya</label>
                    <label for="fileInput" class="up-file-drop" id="fileDrop">
                        <div class="up-file-drop-icon">📁</div>
                        <div class="up-file-drop-text" id="fileText">Dosya seçmek için tıklayın</div>
                        <div class="up-file-drop-hint">Kabul edilen formatlar: .xlsx, .pdf</div>
                    </label>
                    <input asp-for="File" type="file" accept=".xlsx,.pdf" class="d-none" id="fileInput" />
                    <span asp-validation-for="File" class="text-danger small"></span>
                </div>

                <div class="col-12 text-end mt-3">
                    <button type="submit" class="up-btn-preview">
                        <i class="fa fa-search"></i> Önizle
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Preview -->
    @if (Model?.PreviewItems != null && Model.PreviewItems.Any())
    {
        <div class="up-preview-kpi">
            <div class="up-kpi up-kpi-1">
                <div class="up-kpi-icon">📋</div>
                <div>
                    <div class="up-kpi-label">Toplam Satır</div>
                    <div class="up-kpi-value">@totalCount</div>
                </div>
            </div>
            <div class="up-kpi up-kpi-2">
                <div class="up-kpi-icon">✅</div>
                <div>
                    <div class="up-kpi-label">Geçerli</div>
                    <div class="up-kpi-value">@validCount</div>
                </div>
            </div>
            <div class="up-kpi up-kpi-3">
                <div class="up-kpi-icon">⚠️</div>
                <div>
                    <div class="up-kpi-label">Hatalı</div>
                    <div class="up-kpi-value">@errorCount</div>
                </div>
            </div>
            <div class="up-kpi up-kpi-4">
                <div class="up-kpi-icon">📊</div>
                <div>
                    <div class="up-kpi-label">Toplam Miktar</div>
                    <div class="up-kpi-value">@totalAmount.ToString("N0")</div>
                </div>
            </div>
        </div>

        <div class="up-card p-0">
            <div class="p-3" style="border-bottom: 1px solid #e2e8f0;">
                <h6 class="mb-0"><i class="fa fa-table me-2"></i>Önizleme</h6>
            </div>

            <form asp-action="Confirm" method="post" id="confirmForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="hospitalId" value="@Model.HospitalID" />
                <input type="hidden" name="month" value="@(Model.Month == DateTime.MinValue ? DateTime.Now.ToString("yyyy-MM-dd") : Model.Month.ToString("yyyy-MM-dd"))" />

                <div class="table-responsive">
                    <table class="up-table">
                        <thead>
                            <tr>
                                <th style="width:110px;">SUT</th>
                                <th>Test Adı</th>
                                <th style="width:130px;">Eşleşme</th>
                                <th style="width:130px;" class="text-end">Kullanılan Miktar</th>
                                <th style="width:220px;">Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.PreviewItems.Count; i++)
                            {
                                var item = Model.PreviewItems[i];
                                var rowClass = item.HasError
                                    ? "up-row-error"
                                    : (item.MatchSource == "name" ? "up-row-warning" : "up-row-ok");

                                <tr id="row-@i" class="@rowClass">
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.SutCode))
                                        {
                                            <span class="up-badge up-badge-sutcode">@item.SutCode</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        <input type="hidden" name="items[@i].TestID" value="@item.TestID" id="testId-@i" />
                                        <input type="hidden" name="items[@i].SutCode" value="@item.SutCode" />
                                        <input type="hidden" name="items[@i].TestName" value="@item.TestName" />
                                        <input type="hidden" name="items[@i].MatchSource" value="@item.MatchSource" />
                                        <input type="hidden" name="items[@i].HasError" value="@item.HasError" />
                                        <input type="hidden" name="items[@i].ErrorMessage" value="@item.ErrorMessage" />
                                    </td>

                                    <td class="fw-semibold">@item.TestName</td>

                                    <td>
                                        @switch (item.MatchSource)
                                        {
                                            case "sut":
                                                <span class="up-badge up-badge-sut" title="SUT kodu ile eşleşti">
                                                    <i class="fa fa-check"></i> SUT
                                                </span>
                                                break;
                                            case "name":
                                                <span class="up-badge up-badge-name" title="İsim ile eşleşti">
                                                    <i class="fa fa-exclamation"></i> İSİM
                                                </span>
                                                break;
                                            default:
                                                <span class="up-badge up-badge-none">
                                                    <i class="fa fa-times"></i> YOK
                                                </span>
                                                break;
                                        }
                                    </td>

                                    <td class="text-end">
                                        <input type="number" min="0" name="items[@i].TestCount" value="@item.TestCount" class="up-amount-input" />
                                    </td>

                                    <td id="status-@i">
                                        @if (item.HasError && item.ErrorMessage != null && item.ErrorMessage.Contains("Test bulunamadı"))
                                        {
                                            <span class="text-danger small">
                                                <i class="fa fa-exclamation-circle me-1"></i> Test bulunamadı
                                            </span>
                                            <button type="button"
                                                    class="up-btn-add ms-2 btnAddTest"
                                                    data-index="@i"
                                                    data-testname="@item.TestName">
                                                <i class="fa fa-plus"></i> Ekle
                                            </button>
                                        }
                                        else if (item.HasError)
                                        {
                                            <span class="text-danger small">
                                                <i class="fa fa-exclamation-circle me-1"></i>@item.ErrorMessage
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-success small fw-semibold">
                                                <i class="fa fa-check-circle me-1"></i> Geçerli
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="p-3 text-end">
                    <button type="submit" class="up-btn-save">
                        <i class="fa fa-save"></i> Kaydet (@validCount satır)
                    </button>
                </div>
            </form>
        </div>
    }
</div>

<!-- Yeni Test Modal -->
<div class="modal fade" id="addTestModal" tabindex="-1" aria-labelledby="addTestModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addTestForm">
                <div class="modal-header" style="background: linear-gradient(135deg, #6366f1, #4f46e5); color: #fff;">
                    <h5 class="modal-title">
                        <i class="fa fa-plus-circle me-2"></i>Yeni Test Ekle
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="rowIndex" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Test Adı</label>
                        <input type="text" id="modalTestName" class="form-control" readonly />
                        <small class="text-muted">Bu test veritabanına eklenecek.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="up-btn-save">
                        <i class="fa fa-save"></i> Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            // Şablon indirme
            const btn = document.getElementById('btnDownloadTemplate');
            const hospitalSelect = document.querySelector('select[name="HospitalID"]');
            const monthInput = document.querySelector('input[name="Month"]');

            btn?.addEventListener('click', (e) => {
                e.preventDefault();
                const hospitalId = hospitalSelect?.value;
                const month = monthInput?.value;
                if (!hospitalId) {
                    alert('Lütfen önce hastane seçin.');
                    hospitalSelect?.focus();
                    return;
                }
                const url = `@Url.Action("DownloadUsageTemplate", "Dashboard", new { area = "Istatistik" })?hospitalId=${hospitalId}&month=${month}`;
                window.location.href = url;
            });

            // Dosya seçici
            const fileInput = document.getElementById('fileInput');
            const fileDrop = document.getElementById('fileDrop');
            const fileText = document.getElementById('fileText');

            fileInput?.addEventListener('change', (e) => {
                const file = e.target.files?.[0];
                if (file) {
                    fileText.textContent = `📄 ${file.name} (${(file.size / 1024).toFixed(1)} KB)`;
                    fileDrop.classList.add('has-file');
                } else {
                    fileText.textContent = 'Dosya seçmek için tıklayın';
                    fileDrop.classList.remove('has-file');
                }
            });
        })();

        // Yeni Test Modal (jQuery)
        $(document).on("click", ".btnAddTest", function() {
            var testName = $(this).data("testname");
            var index = $(this).data("index");

            $("#modalTestName").val(testName);
            $("#rowIndex").val(index);

            var modal = new bootstrap.Modal(document.getElementById('addTestModal'));
            modal.show();
        });

        $("#addTestForm").submit(function(e) {
            e.preventDefault();

            var testName = $("#modalTestName").val();
            var index = $("#rowIndex").val();

            $.ajax({
                url: '@Url.Action("CreateFromUpload", "Test", new { area = "Istatistik" })',
                type: "POST",
                data: { testName: testName },
                success: function(res) {
                    if (res.success) {
                        var modal = bootstrap.Modal.getInstance(document.getElementById('addTestModal'));
                        modal.hide();

                        $("#status-" + index).html('<span class="text-success small fw-semibold"><i class="fa fa-check-circle me-1"></i> Geçerli</span>');
                        $("#row-" + index).removeClass("up-row-error up-row-warning").addClass("up-row-ok");
                        $("#testId-" + index).val(res.testId);
                    } else {
                        alert("Hata: " + res.message);
                    }
                },
                error: function() {
                    alert("Sunucu hatası oluştu!");
                }
            });
        });
    </script>
}

