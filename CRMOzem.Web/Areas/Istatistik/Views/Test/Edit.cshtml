@model CRMOzem.Core.ViewModels.TestEditViewModel
@using CRMOzem.Core.Models

@{
    ViewData["Title"] = "Test Düzenle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i class="fa fa-edit me-2"></i> Test Düzenle</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="TestID" />

            <div class="col-md-8">
                <label class="form-label">Test Adı</label>
                <input asp-for="TestName" class="form-control" />
                <span asp-validation-for="TestName" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label">SUT Kodu</label>
                <input asp-for="SutCode" class="form-control" placeholder="Örn: L102890" />
                <span asp-validation-for="SutCode" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label">Giriş Tipi</label>
                <div class="d-flex gap-3 mt-2">
                    <div class="form-check">
                        <input class="form-check-input giris-tipi-radio" type="radio" id="girisAdet"
                               name="GirisTipi" value="@TestGirisTipi.Adet"
                        @(Model.GirisTipi == TestGirisTipi.Adet ? "checked" : "") />
                        <label class="form-check-label" for="girisAdet">
                            <strong>Adet</strong>
                            <small class="text-muted d-block">Birebir adet girilir</small>
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input giris-tipi-radio" type="radio" id="girisKutu"
                               name="GirisTipi" value="@TestGirisTipi.Kutu"
                        @(Model.GirisTipi == TestGirisTipi.Kutu ? "checked" : "") />
                        <label class="form-check-label" for="girisKutu">
                            <strong>Kutu</strong>
                            <small class="text-muted d-block">Kutu sayısı girilir, adet hesaplanır</small>
                        </label>
                    </div>
                </div>
            </div>

            <div class="col-md-6" id="kutuBasinaAdetWrap"
                 style="@(Model.GirisTipi == TestGirisTipi.Kutu ? "" : "display:none;")">
                <label class="form-label">Kutu Başına Adet</label>
                <div class="input-group">
                    <input asp-for="KutuBasinaAdet" type="number" min="1" class="form-control" placeholder="Örn: 100" />
                    <span class="input-group-text">adet/kutu</span>
                </div>
                <small class="text-muted">Bir kutuda kaç adet test bulunduğunu girin.</small>
                <span asp-validation-for="KutuBasinaAdet" class="text-danger d-block"></span>
            </div>

            <div class="col-12 text-end">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fa fa-arrow-left"></i> Geri
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-save"></i> Güncelle
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const radios = document.querySelectorAll('.giris-tipi-radio');
            const wrap = document.getElementById('kutuBasinaAdetWrap');
            const kbaInput = document.querySelector('input[name="KutuBasinaAdet"]');

            function toggle() {
                const selected = document.querySelector('.giris-tipi-radio:checked')?.value;
                if (selected === '@TestGirisTipi.Kutu') {
                    wrap.style.display = '';
                } else {
                    wrap.style.display = 'none';
                    if (kbaInput) kbaInput.value = '';
                }
            }

            radios.forEach(r => r.addEventListener('change', toggle));
            toggle();
        })();
    </script>
}