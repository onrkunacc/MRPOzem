@model CRMOzem.Core.ViewModels.TestEditViewModel
@using CRMOzem.Core.Models

@{
    ViewData["Title"] = "Test Düzenle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .test-page {
        padding: 1rem 0;
    }

    .test-header {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: #fff;
        padding: 1.5rem;
        border-radius: 16px;
        margin-bottom: 1.5rem;
        box-shadow: 0 8px 28px rgba(245,158,11,.25);
    }

        .test-header h1 {
            margin: 0;
            font-size: 1.4rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: .5rem;
        }

        .test-header p {
            margin: .35rem 0 0;
            opacity: .92;
            font-size: .87rem;
        }

    .test-card {
        background: rgba(255,255,255,.85);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,.6);
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,.04);
        padding: 1.5rem;
    }

    .test-form-label {
        font-size: .8rem;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        letter-spacing: .03em;
        margin-bottom: .4rem;
        display: block;
    }

    .test-tip-selector {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .75rem;
    }

    .test-tip-option {
        cursor: pointer;
        padding: 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        transition: all .15s;
        text-align: center;
        background: #fff;
    }

        .test-tip-option:hover {
            border-color: #94a3b8;
            background: #f8fafc;
        }

        .test-tip-option input {
            display: none;
        }

        .test-tip-option.active {
            border-color: #f59e0b;
            background: linear-gradient(135deg, rgba(245,158,11,.08), rgba(217,119,6,.08));
        }

    .test-tip-icon {
        font-size: 1.75rem;
        margin-bottom: .35rem;
    }

    .test-tip-title {
        font-weight: 700;
        color: #1e293b;
        font-size: 1rem;
    }

    .test-tip-desc {
        color: #64748b;
        font-size: .78rem;
        margin-top: .2rem;
    }

    .test-kutu-adet-wrap {
        transition: opacity .2s, max-height .3s;
        overflow: hidden;
        max-height: 300px;
    }

        .test-kutu-adet-wrap.hidden {
            opacity: 0;
            max-height: 0;
            margin: 0 !important;
            padding: 0;
        }

    .test-btn-save {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #fff;
        border: none;
        padding: .65rem 1.75rem;
        border-radius: 10px;
        font-weight: 700;
        font-size: .95rem;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        transition: transform .15s;
    }

        .test-btn-save:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    .test-btn-cancel {
        background: #f1f5f9;
        color: #475569;
        border: 1.5px solid #e2e8f0;
        padding: .6rem 1.35rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: .9rem;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        text-decoration: none;
    }

        .test-btn-cancel:hover {
            background: #e2e8f0;
            color: #334155;
            text-decoration: none;
        }
</style>

<div class="test-page">

    <div class="test-header">
        <h1>✏️ Test Düzenle</h1>
        <p>Mevcut test tanımını güncelleyin. Değişiklikler tüm hastane test setlerine yansır.</p>
    </div>

    <div class="test-card">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="TestID" />

            <div class="row g-3">
                <!-- Test Adı -->
                <div class="col-12 col-lg-8">
                    <label asp-for="TestName" class="test-form-label">Test Adı *</label>
                    <input asp-for="TestName" class="form-control form-control-lg" />
                    <span asp-validation-for="TestName" class="text-danger small"></span>
                </div>

                <!-- Stok Kodu -->
                <div class="col-12 col-lg-4">
                    <label asp-for="SutCode" class="test-form-label">Stok Kodu</label>
                    <input asp-for="SutCode" class="form-control form-control-lg" />
                    <span asp-validation-for="SutCode" class="text-danger small"></span>
                </div>

                <!-- Kategori -->
                <div class="col-12 col-md-6">
                    <label asp-for="Kategori" class="test-form-label">Kategori</label>
                    <select asp-for="Kategori" class="form-select form-select-lg">
                        <option value="">— Kategori seçiniz —</option>
                        <option>Alinity Sarf</option>
                        <option>Alinity CC</option>
                        <option>Alinity Küçük Kutu</option>
                        <option>Alinity Büyük Kutu</option>
                        <option>Architect Sarf</option>
                        <option>Architect CC</option>
                        <option>Architect CC Sarf</option>
                        <option>Architect Küçük Kutu</option>
                        <option>Architect Büyük Kutu</option>
                        <option>Archem</option>
                        <option>Cell Dyn Sarf</option>
                    </select>
                    <span asp-validation-for="Kategori" class="text-danger small"></span>
                </div>

                <!-- Platform -->
                <div class="col-12 col-md-6">
                    <label asp-for="Platform" class="test-form-label">Platform (Cihaz)</label>
                    <select asp-for="Platform" class="form-select form-select-lg">
                        <option value="">— Platform seçiniz —</option>
                        <option>Architect IA</option>
                        <option>Architect CC</option>
                        <option>Alinity i</option>
                        <option>Alinity C</option>
                        <option>Alinity Hs</option>
                        <option>Cell Dyn</option>
                        <option>Cell Dyn Ruby</option>
                        <option>Cell Dyn Emerald</option>
                        <option>Cell Dyn Sapphire</option>
                    </select>
                    <span asp-validation-for="Platform" class="text-danger small"></span>
                </div>

                <!-- Giriş Tipi -->
                <div class="col-12">
                    <label class="test-form-label">Giriş Tipi *</label>
                    <div class="test-tip-selector">
                        <label class="test-tip-option" id="tipAdet">
                            <input type="radio" asp-for="GirisTipi" value="Adet" />
                            <div class="test-tip-icon">🔢</div>
                            <div class="test-tip-title">Adet</div>
                            <div class="test-tip-desc">Birebir adet girilir</div>
                        </label>
                        <label class="test-tip-option" id="tipKutu">
                            <input type="radio" asp-for="GirisTipi" value="Kutu" />
                            <div class="test-tip-icon">📦</div>
                            <div class="test-tip-title">Kutu</div>
                            <div class="test-tip-desc">Kutu sayısı girilir, adet hesaplanır</div>
                        </label>
                    </div>
                    <span asp-validation-for="GirisTipi" class="text-danger small"></span>
                </div>

                <!-- Kutu Başına Adet -->
                <div class="col-12 test-kutu-adet-wrap" id="kutuAdetWrap">
                    <label asp-for="KutuBasinaAdet" class="test-form-label">Kutu Başına Adet *</label>
                    <div class="input-group input-group-lg">
                        <input asp-for="KutuBasinaAdet" type="number" min="1" class="form-control" />
                        <span class="input-group-text">adet / kutu</span>
                    </div>
                    <small class="text-muted">Bir kutuda kaç adet test bulunduğunu girin.</small>
                    <div>
                        <span asp-validation-for="KutuBasinaAdet" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Butonlar -->
                <div class="col-12 d-flex gap-2 justify-content-end mt-4">
                    <a asp-action="Index" class="test-btn-cancel">
                        <i class="fa fa-arrow-left"></i> Geri
                    </a>
                    <button type="submit" class="test-btn-save">
                        <i class="fa fa-save"></i> Güncelle
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const tipAdet = document.getElementById('tipAdet');
            const tipKutu = document.getElementById('tipKutu');
            const kutuWrap = document.getElementById('kutuAdetWrap');
            const kutuInput = document.querySelector('input[name="KutuBasinaAdet"]');
            const radios = document.querySelectorAll('input[name="GirisTipi"]');

            function updateUI() {
                const checked = document.querySelector('input[name="GirisTipi"]:checked');
                const isKutu = checked?.value === 'Kutu';

                tipAdet.classList.toggle('active', !isKutu);
                tipKutu.classList.toggle('active', isKutu);
                kutuWrap.classList.toggle('hidden', !isKutu);
            }

            radios.forEach(r => r.addEventListener('change', updateUI));
            updateUI();
        })();
    </script>
}