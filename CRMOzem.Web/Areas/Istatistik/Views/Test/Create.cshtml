@model CRMOzem.Core.ViewModels.TestCreateViewModel

@{
    ViewData["Title"] = "Yeni Test Ekle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="mb-0"><i class="fa fa-plus-circle me-2"></i> Yeni Test Ekle</h5>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post" class="row g-3">
            <div class="col-md-12">
                <label class="form-label">Test Adı</label>
                <input asp-for="TestName" class="form-control" />
                <span asp-validation-for="TestName" class="text-danger"></span>
            </div>
            <div class="col-12 text-end">
                <a asp-action="Index" class="btn btn-secondary"><i class="fa fa-arrow-left"></i> Geri</a>
                <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Kaydet</button>
            </div>
        </form>
    </div>
</div>

