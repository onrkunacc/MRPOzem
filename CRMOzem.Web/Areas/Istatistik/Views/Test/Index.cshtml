@model IEnumerable<CRMOzem.Core.ViewModels.TestViewModel>
@using CRMOzem.Core.Models

@{
    ViewData["Title"] = "Test Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var kategoriler = ViewBag.Kategoriler as List<string> ?? new List<string>();
    var platformlar = ViewBag.Platformlar as List<string> ?? new List<string>();
    var selectedSearch = ViewBag.SelectedSearch as string ?? "";
    var selectedKategori = ViewBag.SelectedKategori as string ?? "";
    var selectedPlatform = ViewBag.SelectedPlatform as string ?? "";
    var selectedGirisTipi = ViewBag.SelectedGirisTipi as string ?? "";
    var toplamKayit = Model.Count();
}

<style>
    .tst-page {
        padding: 1rem 0;
    }

    .tst-header {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        color: #fff;
        padding: 1.5rem;
        border-radius: 16px;
        margin-bottom: 1.25rem;
        box-shadow: 0 8px 28px rgba(59,130,246,.25);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .tst-header h1 {
            margin: 0;
            font-size: 1.4rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: .5rem;
        }

        .tst-header p {
            margin: .3rem 0 0;
            opacity: .92;
            font-size: .87rem;
        }

    .tst-total-badge {
        background: rgba(255,255,255,.25);
        backdrop-filter: blur(8px);
        border: 1.5px solid rgba(255,255,255,.4);
        color: #fff;
        padding: .3rem .75rem;
        border-radius: 999px;
        font-size: .85rem;
        font-weight: 700;
    }

    .tst-btn-new {
        background: rgba(255,255,255,.2);
        backdrop-filter: blur(8px);
        border: 1.5px solid rgba(255,255,255,.4);
        color: #fff;
        padding: .55rem 1.2rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: .9rem;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        text-decoration: none;
        transition: all .2s;
    }

        .tst-btn-new:hover {
            background: rgba(255,255,255,.3);
            color: #fff;
            transform: translateY(-1px);
            text-decoration: none;
        }

    .tst-card {
        background: rgba(255,255,255,.78);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,.6);
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,.04);
        padding: 1.1rem;
        margin-bottom: 1rem;
    }

    .tst-filter-label {
        font-size: .72rem;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        letter-spacing: .03em;
        margin-bottom: .25rem;
        display: block;
    }

    .tst-btn-apply {
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        border: none;
        color: #fff;
        padding: .5rem 1rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: .87rem;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
    }

        .tst-btn-apply:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    .tst-btn-clear {
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
        padding: .5rem 1rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: .87rem;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        text-decoration: none;
    }

        .tst-btn-clear:hover {
            background: #e2e8f0;
            color: #334155;
            text-decoration: none;
        }

    .tst-table-wrap {
        background: rgba(255,255,255,.85);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,.6);
        border-radius: 16px;
        overflow: hidden;
    }

    .tst-table {
        width: 100%;
        margin: 0;
        font-size: .9rem;
    }

        .tst-table thead th {
            position: sticky;
            top: 0;
            background: #f8fafc;
            border-bottom: 2px solid #e2e8f0;
            font-weight: 700;
            text-transform: uppercase;
            font-size: .72rem;
            letter-spacing: .04em;
            color: #475569;
            padding: .8rem 1rem;
            z-index: 1;
        }

        .tst-table tbody td {
            padding: .7rem 1rem;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .tst-table tbody tr:hover {
            background: rgba(59,130,246,.04);
        }

    .tst-badge {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        padding: .2rem .55rem;
        font-size: .72rem;
        border-radius: 999px;
        font-weight: 600;
    }

    .tst-badge-sut {
        background: #eef1f4;
        color: #475569;
        font-family: ui-monospace, monospace;
        letter-spacing: .03em;
    }

    .tst-badge-kategori {
        background: #eef2ff;
        color: #4338ca;
    }

    .tst-badge-tip-adet {
        background: linear-gradient(135deg,#6366f1,#4f46e5);
        color: #fff;
    }

    .tst-badge-tip-kutu {
        background: linear-gradient(135deg,#10b981,#059669);
        color: #fff;
    }

    .tst-kba-pill {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .25rem .65rem;
        background: linear-gradient(135deg, rgba(16,185,129,.1), rgba(5,150,105,.1));
        border: 1px solid rgba(16,185,129,.3);
        color: #047857;
        border-radius: 999px;
        font-weight: 700;
        font-size: .82rem;
    }

    .tst-btn-icon {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        border: none;
        transition: transform .15s;
    }

        .tst-btn-icon:hover {
            transform: translateY(-1px);
        }

    .tst-btn-edit {
        background: linear-gradient(135deg,#f59e0b,#d97706);
        color: #fff;
    }

    .tst-btn-delete {
        background: linear-gradient(135deg,#ef4444,#dc2626);
        color: #fff;
    }

    .tst-empty {
        text-align: center;
        padding: 3rem 1rem;
        color: #94a3b8;
    }

    .tst-empty-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: .5;
    }
</style>

<div class="tst-page">

    <div class="tst-header">
        <div>
            <h1>🧪 Test Listesi</h1>
            <p>Sistem genelinde tanımlı testler — hastane test setlerinde kullanılır.</p>
        </div>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <span class="tst-total-badge"><i class="fa fa-list me-1"></i> Toplam: @toplamKayit</span>
            <a asp-action="Create" class="tst-btn-new">
                <i class="fa fa-plus"></i> Yeni Test
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa fa-exclamation-circle me-1"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filtreler -->
    <div class="tst-card">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="tst-filter-label">Ara</label>
                <input type="text" name="search" class="form-control" value="@selectedSearch" placeholder="Test adı veya Stok Kodu ile ara..." />
            </div>

            <div class="col-6 col-md-2">
                <label class="tst-filter-label">Kategori</label>
                <select name="kategori" class="form-select">
                    <option value="">Tüm Kategoriler</option>
                    @foreach (var k in kategoriler)
                    {
                        <option value="@k" selected="@(selectedKategori == k)">@k</option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-2">
                <label class="tst-filter-label">Platform</label>
                <select name="platform" class="form-select">
                    <option value="">Tüm Platformlar</option>
                    @foreach (var p in platformlar)
                    {
                        <option value="@p" selected="@(selectedPlatform == p)">@p</option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-2">
                <label class="tst-filter-label">Giriş Tipi</label>
                <select name="girisTipi" class="form-select">
                    <option value="">Tümü</option>
                    <option value="Adet" selected="@(selectedGirisTipi == "Adet")">Adet</option>
                    <option value="Kutu" selected="@(selectedGirisTipi == "Kutu")">Kutu</option>
                </select>
            </div>

            <div class="col-6 col-md-2 d-flex gap-2">
                <button type="submit" class="tst-btn-apply flex-fill">
                    <i class="fa fa-filter"></i> Uygula
                </button>
                <a asp-action="Index" class="tst-btn-clear">
                    <i class="fa fa-broom"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Tablo -->
    <div class="tst-table-wrap">
        <div class="table-responsive">
            <table class="tst-table">
                <thead>
                    <tr>
                        <th>Test Adı</th>
                        <th style="width:130px;">Stok Kodu</th>
                        <th style="width:140px;">Kategori</th>
                        <th style="width:120px;">Platform</th>
                        <th style="width:90px;">Tip</th>
                        <th style="width:110px;">Kutu Adet</th>
                        <th style="width:110px;" class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="tst-empty">
                                <div class="tst-empty-icon">🧪</div>
                                <h5 class="text-muted">Kayıt bulunamadı</h5>
                                <small>Filtreleri temizleyip tekrar deneyin veya yeni test ekleyin.</small>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var t in Model)
                        {
                            var tipClass = t.GirisTipi == TestGirisTipi.Kutu ? "tst-badge-tip-kutu" : "tst-badge-tip-adet";

                            <tr>
                                <td class="fw-semibold">@t.TestName</td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(t.SutCode))
                                    {
                                        <span class="tst-badge tst-badge-sut">@t.SutCode</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(t.Kategori))
                                    {
                                        <span class="tst-badge tst-badge-kategori">@t.Kategori</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(t.Platform))
                                    {
                                        <small class="text-muted fw-semibold">@t.Platform</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    <span class="tst-badge @tipClass">@t.GirisTipi</span>
                                </td>

                                <td>
                                    @if (t.GirisTipi == TestGirisTipi.Kutu && t.KutuBasinaAdet.HasValue)
                                    {
                                        <span class="tst-kba-pill">
                                            <i class="fa fa-box"></i> @t.KutuBasinaAdet
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@t.TestID" class="tst-btn-icon tst-btn-edit me-1" title="Düzenle">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                    <form method="post" asp-action="Delete" asp-route-id="@t.TestID" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="tst-btn-icon tst-btn-delete" title="Sil"
                                                onclick="return confirm('Bu testi silmek istediğinize emin misiniz?')">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>