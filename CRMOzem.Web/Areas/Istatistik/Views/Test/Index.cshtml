@model IEnumerable<CRMOzem.Core.ViewModels.TestViewModel>
@using System.Text.Json
@using System.Text.Json.Serialization
@using CRMOzem.Core.Models

@{
    ViewData["Title"] = "Test Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var flat = Model.Select(m => new
    {
        testID = m.TestID,
        testName = m.TestName ?? "",
        sutCode = m.SutCode ?? "",
        girisTipi = m.GirisTipi.ToString(),    
        kutuBasinaAdet = m.KutuBasinaAdet
    });

    var json = JsonSerializer.Serialize(flat, new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    });
}

<style>
    .sticky-head thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        background: #fff;
    }

    .table-sm td, .table-sm th {
        padding-top: .5rem;
        padding-bottom: .5rem
    }

    .pagination .page-link {
        min-width: 2.25rem;
        text-align: center
    }

    .badge-muted {
        background-color: #eef1f4;
        color: #495057
    }

    .code-badge {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono","Courier New", monospace;
        font-weight: 600;
        letter-spacing: .2px;
    }

    .badge-tip-adet {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        color: #fff;
        border: none;
    }

    .badge-tip-kutu {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #fff;
        border: none;
    }

    .kba-pill {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        padding: .15rem .5rem;
        font-size: .78rem;
        border-radius: 999px;
        background: rgba(16,185,129,.08);
        color: #047857;
        border: 1px solid rgba(16,185,129,.2);
        font-weight: 600;
    }
</style>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <h5 class="mb-0"><i class="fa fa-flask me-2"></i> Test Listesi</h5>
            <span class="badge badge-muted" id="totalBadge">Toplam: 0</span>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fa fa-plus"></i> Yeni Test
        </a>
    </div>

    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row g-2 align-items-end mb-3">
            <div class="col-12 col-md-6 col-lg-4">
                <label class="form-label mb-1">Ara</label>
                <input type="text" id="q" class="form-control form-control-sm" placeholder="Test adı veya SUT kodu ile ara">
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label mb-1">Giriş Tipi</label>
                <select id="tipFilter" class="form-select form-select-sm">
                    <option value="">Tümü</option>
                    <option value="Adet">Adet</option>
                    <option value="Kutu">Kutu</option>
                </select>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label mb-1">Sayfa Boyutu</label>
                <select id="pageSize" class="form-select form-select-sm">
                    <option>5</option>
                    <option selected>10</option>
                    <option>20</option>
                    <option>50</option>
                </select>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle sticky-head" id="dataTable">
                <thead class="table-light">
                    <tr>
                        <th>Test Adı</th>
                        <th style="width:140px;">SUT Kodu</th>
                        <th style="width:110px;">Giriş Tipi</th>
                        <th style="width:130px;">Kutu Adet</th>
                        <th class="text-end" style="width:140px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td colspan="5" class="text-center text-muted py-4">Yükleniyor…</td></tr>
                </tbody>
            </table>
        </div>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 mt-2">
            <div id="pageInfo" class="text-muted small">Sayfa 1 / 1</div>
            <nav aria-label="Sayfalama">
                <ul class="pagination mb-0" id="pager"></ul>
            </nav>
        </div>
    </div>
</div>

<div id="af" class="d-none">
    <form method="post">
        @Html.AntiForgeryToken()
    </form>
</div>

<script>
    (function () {
        const trTR = 'tr-TR';
        const raw = @Html.Raw(json);

        const state = {
            q: '',
            tip: '',
            page: 1,
            pageSize: parseInt(document.getElementById('pageSize').value, 10) || 10
        };

        const els = {
            q: document.getElementById('q'),
            tipFilter: document.getElementById('tipFilter'),
            pageSize: document.getElementById('pageSize'),
            tbody: document.querySelector('#dataTable tbody'),
            pager: document.getElementById('pager'),
            pageInfo: document.getElementById('pageInfo'),
            totalBadge: document.getElementById('totalBadge')
        };

        let t = null;
        els.q.addEventListener('input', () => {
            clearTimeout(t);
            t = setTimeout(() => {
                state.q = (els.q.value || '').trim();
                state.page = 1;
                render();
            }, 200);
        });

        els.tipFilter.addEventListener('change', () => {
            state.tip = els.tipFilter.value;
            state.page = 1;
            render();
        });

        els.pageSize.addEventListener('change', () => {
            state.pageSize = parseInt(els.pageSize.value, 10) || 10;
            state.page = 1;
            render();
        });

        function filterData(data) {
            const q = state.q.toLocaleLowerCase(trTR);
            return data.filter(x => {
                const matchQ = !q
                    || (x.testName || '').toLocaleLowerCase(trTR).includes(q)
                    || (x.sutCode || '').toLocaleLowerCase(trTR).includes(q);
                const matchTip = !state.tip || x.girisTipi === state.tip;
                return matchQ && matchTip;
            });
        }

        function paginate(data) {
            const total = data.length;
            const size = state.pageSize;
            const totalPages = Math.max(1, Math.ceil(total / size));
            if (state.page > totalPages) state.page = totalPages;
            const start = (state.page - 1) * size;
            const items = data.slice(start, start + size);
            return { items, total, totalPages, start, end: Math.min(start + size, total) };
        }

        function render() {
            const filtered = filterData(raw);
            const { items, total, totalPages, start, end } = paginate(filtered);

            els.totalBadge.textContent = `Toplam: ${total}`;
            els.pageInfo.textContent = `Sayfa ${state.page} / ${totalPages} (${total ? (start + 1) : 0} - ${end} / ${total})`;

            const fr = document.createDocumentFragment();

            if (items.length === 0) {
                const tr = document.createElement('tr');
                tr.innerHTML = `<td colspan="5" class="text-center text-muted py-4">Kayıt bulunamadı.</td>`;
                fr.appendChild(tr);
            } else {
                const token = (document.querySelector('#af input[name="__RequestVerificationToken"]') || {}).value || '';
                items.forEach(x => {
                    const tr = document.createElement('tr');

                    const sut = (x.sutCode || '').trim();
                    const sutHtml = sut
                        ? `<span class="badge badge-muted code-badge">${escapeHtml(sut)}</span>`
                        : `<span class="text-muted">-</span>`;

                    const tipClass = x.girisTipi === 'Kutu' ? 'badge-tip-kutu' : 'badge-tip-adet';
                    const tipHtml = `<span class="badge ${tipClass}">${escapeHtml(x.girisTipi)}</span>`;

                    const kbaHtml = (x.girisTipi === 'Kutu' && x.kutuBasinaAdet)
                        ? `<span class="kba-pill"><i class="fe fe-package"></i> ${x.kutuBasinaAdet} adet</span>`
                        : `<span class="text-muted">-</span>`;

                    tr.innerHTML = `
                        <td class="fw-semibold">${escapeHtml(x.testName)}</td>
                        <td>${sutHtml}</td>
                        <td>${tipHtml}</td>
                        <td>${kbaHtml}</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-warning" href="@Url.Action("Edit", "Test", new { area = "Istatistik" })/${x.testID}">
                                <i class="fa fa-edit"></i>
                            </a>
                            <form class="d-inline" method="post" action="@Url.Action("Delete", "Test", new { area = "Istatistik" })/${x.testID}">
                                <input name="__RequestVerificationToken" type="hidden" value="${token}">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Silmek istediğinize emin misiniz?')">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </form>
                        </td>`;
                    fr.appendChild(tr);
                });
            }

            els.tbody.innerHTML = '';
            els.tbody.appendChild(fr);
            renderPager(totalPages);
        }

        function renderPager(totalPages) {
            const ul = els.pager; ul.innerHTML = '';
            const p = state.page;

            const makeItem = (label, page, disabled = false, active = false) => {
                const li = document.createElement('li');
                li.className = `page-item ${disabled ? 'disabled' : ''} ${active ? 'active' : ''}`;
                const a = document.createElement('a'); a.className = 'page-link'; a.href = '#'; a.textContent = label;
                if (!disabled && !active) {
                    a.addEventListener('click', e => { e.preventDefault(); state.page = page; render(); });
                }
                li.appendChild(a); return li;
            };

            ul.appendChild(makeItem('«', 1, p <= 1));
            ul.appendChild(makeItem('Önceki', Math.max(1, p - 1), p <= 1));

            const start = Math.max(1, p - 2), end = Math.min(totalPages, p + 2);
            for (let i = start; i <= end; i++) ul.appendChild(makeItem(String(i), i, false, i === p));

            ul.appendChild(makeItem('Sonraki', Math.min(totalPages, p + 1), p >= totalPages));
            ul.appendChild(makeItem('»', totalPages, p >= totalPages));
        }

        function escapeHtml(s) {
            return String(s ?? '').replace(/[&<>"']/g,
                m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
        }

        render();
    })();
</script>