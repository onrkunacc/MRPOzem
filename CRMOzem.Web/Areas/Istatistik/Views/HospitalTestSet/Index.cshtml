@model HospitalTestSetVm
@using Microsoft.AspNetCore.Mvc.Rendering
@using CRMOzem.Core.Models

@{
    ViewData["Title"] = "Hastane Test Seti";
    var hospitals = ViewBag.Hospitals as List<SelectListItem> ?? new List<SelectListItem>();
    int? selectedHospitalId = ViewBag.SelectedHospitalId as int?;
    Layout = "~/Views/Shared/_Layout.cshtml";

    int? activeCount = Model?.Rows.Count(r => r.IsActive);
    int? linkedCount = Model?.Rows.Count(r => r.IsLinked);
    int? totalCount = Model?.Rows.Count;
    int? kutuTipiAktif = Model?.Rows.Count(r => r.IsActive && r.GirisTipi == TestGirisTipi.Kutu);
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />

<style>
    .hts-page {
        padding: 1rem 0;
    }

    .hts-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        padding: 1.75rem 1.5rem;
        border-radius: 18px;
        margin-bottom: 1.5rem;
        box-shadow: 0 8px 28px rgba(102,126,234,.25);
    }

        .hts-header h1 {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: .6rem;
        }

        .hts-header p {
            margin: .4rem 0 0;
            opacity: .92;
            font-size: .92rem;
        }

    .hts-card {
        background: rgba(255,255,255,.75);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,.6);
        border-radius: 18px;
        box-shadow: 0 4px 20px rgba(0,0,0,.04);
        padding: 1.25rem;
        margin-bottom: 1.25rem;
    }

    .hts-kpi-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    @@media (max-width: 992px) {
        .hts-kpi-row {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 576px) {
        .hts-kpi-row {
            grid-template-columns: 1fr;
        }
    }

    .hts-kpi {
        background: rgba(255,255,255,.85);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,.6);
        border-radius: 16px;
        padding: 1rem 1.1rem;
        display: flex;
        align-items: center;
        gap: .85rem;
        transition: transform .2s, box-shadow .2s;
    }

        .hts-kpi:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0,0,0,.08);
        }

    .hts-kpi-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    .hts-kpi-primary .hts-kpi-icon {
        background: linear-gradient(135deg,#6366f1,#4f46e5);
        color: #fff;
    }

    .hts-kpi-success .hts-kpi-icon {
        background: linear-gradient(135deg,#10b981,#059669);
        color: #fff;
    }

    .hts-kpi-info .hts-kpi-icon {
        background: linear-gradient(135deg,#3b82f6,#2563eb);
        color: #fff;
    }

    .hts-kpi-warning .hts-kpi-icon {
        background: linear-gradient(135deg,#f59e0b,#d97706);
        color: #fff;
    }

    .hts-kpi-label {
        color: #64748b;
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .03em;
    }

    .hts-kpi-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1e293b;
        line-height: 1.1;
    }

    .hts-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        align-items: center;
        justify-content: space-between;
    }

    .hts-btn-grad {
        background: linear-gradient(135deg,#6366f1,#4f46e5);
        color: #fff;
        border: none;
        padding: .5rem 1rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: .87rem;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        transition: transform .15s;
    }

        .hts-btn-grad:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    .hts-btn-success {
        background: linear-gradient(135deg,#10b981,#059669);
        color: #fff;
    }

    .hts-btn-outline {
        background: transparent;
        border: 1.5px solid #ef4444;
        color: #ef4444;
        padding: .5rem 1rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: .87rem;
    }

        .hts-btn-outline:hover {
            background: #ef4444;
            color: #fff;
        }

    .hts-toolbar {
        position: sticky;
        top: 0;
        z-index: 5;
        background: rgba(255,255,255,.92);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,.6);
        border-radius: 14px;
        padding: 1rem;
        margin-bottom: 1rem;
    }

    .hts-table-wrap {
        background: rgba(255,255,255,.8);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,.6);
        border-radius: 16px;
        overflow: hidden;
    }

    .hts-table {
        width: 100%;
        margin: 0;
        font-size: .9rem;
    }

        .hts-table thead th {
            position: sticky;
            top: 0;
            background: #f8fafc;
            border-bottom: 2px solid #e2e8f0;
            font-weight: 700;
            text-transform: uppercase;
            font-size: .75rem;
            letter-spacing: .04em;
            color: #475569;
            padding: .75rem 1rem;
            z-index: 1;
        }

        .hts-table tbody td {
            padding: .65rem 1rem;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .hts-table tbody tr:hover {
            background: rgba(99,102,241,.04);
        }

    .hts-row-dirty {
        background: rgba(245,158,11,.08) !important;
        box-shadow: inset 4px 0 0 #f59e0b;
    }

    .hts-badge {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        padding: .2rem .55rem;
        font-size: .72rem;
        border-radius: 999px;
        font-weight: 600;
    }

    .hts-badge-sut {
        background: #eef1f4;
        color: #475569;
        font-family: ui-monospace, monospace;
        letter-spacing: .03em;
    }

    .hts-badge-tip-adet {
        background: linear-gradient(135deg,#6366f1,#4f46e5);
        color: #fff;
    }

    .hts-badge-tip-kutu {
        background: linear-gradient(135deg,#10b981,#059669);
        color: #fff;
    }

    .hts-badge-linked {
        background: #cbd5e1;
        color: #1e293b;
    }

    .hts-badge-notlinked {
        background: #fef3c7;
        color: #92400e;
    }

    .hts-kba-pill {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        padding: .15rem .45rem;
        font-size: .72rem;
        border-radius: 999px;
        background: rgba(16,185,129,.08);
        color: #047857;
        border: 1px solid rgba(16,185,129,.2);
        font-weight: 600;
    }

    .hts-switch {
        transform: scale(1.15);
        cursor: pointer;
    }

    .hts-empty {
        text-align: center;
        padding: 3rem 1rem;
        color: #94a3b8;
    }

    .hts-empty-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: .5;
    }

    .hts-pill-info {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .35rem .7rem;
        border-radius: 999px;
        background: rgba(255,255,255,.7);
        border: 1px solid rgba(0,0,0,.06);
        font-size: .82rem;
        color: #334155;
        font-weight: 500;
    }

        .hts-pill-info strong {
            color: #1e293b;
            font-weight: 700;
        }

    .hts-search-wrap {
        position: relative;
    }

        .hts-search-wrap i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
        }

        .hts-search-wrap input {
            padding-left: 35px;
        }
</style>

<div class="hts-page">

    <!-- ═══ BAŞLIK ═══ -->
    <div class="hts-header">
        <h1>📋 Hastane Test Seti</h1>
        <p>Hastane bazında hangi testlerin aktif olduğunu yönet — gönderim ve istatistik girişlerinde bu liste kullanılır.</p>
    </div>

    <!-- ═══ HASTANE SEÇİMİ ═══ -->
    <div class="hts-card">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-8 col-lg-6">
                <label class="form-label fw-semibold">Hastane Seç</label>
                <select name="hospitalId" class="form-select" onchange="this.form.submit()" required>
                    <option value="">— Hastane seçiniz —</option>
                    @foreach (var h in hospitals)
                    {
                        <option value="@h.Value" selected="@(selectedHospitalId?.ToString() == h.Value)">
                            @h.Text
                        </option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4 col-lg-6">
                <small class="text-muted">Hastane seçildiğinde test listesi otomatik yüklenir.</small>
            </div>
        </form>
    </div>

    @if (Model == null)
    {
        <div class="hts-card text-center py-5">
            <div class="hts-empty-icon">🏥</div>
            <h5 class="text-muted">Devam etmek için hastane seçiniz</h5>
            <small class="text-muted">Yukarıdan bir hastane seçtiğinizde testler listelenecek.</small>
        </div>
        return;
    }

    <!-- ═══ KPI ŞERİT ═══ -->
    <div class="hts-kpi-row">
        <div class="hts-kpi hts-kpi-primary">
            <div class="hts-kpi-icon">🧪</div>
            <div>
                <div class="hts-kpi-label">Toplam Test</div>
                <div class="hts-kpi-value">@totalCount</div>
            </div>
        </div>
        <div class="hts-kpi hts-kpi-success">
            <div class="hts-kpi-icon">✅</div>
            <div>
                <div class="hts-kpi-label">Aktif</div>
                <div class="hts-kpi-value">@activeCount</div>
            </div>
        </div>
        <div class="hts-kpi hts-kpi-info">
            <div class="hts-kpi-icon">🔗</div>
            <div>
                <div class="hts-kpi-label">Bağlı</div>
                <div class="hts-kpi-value">@linkedCount</div>
            </div>
        </div>
        <div class="hts-kpi hts-kpi-warning">
            <div class="hts-kpi-icon">📦</div>
            <div>
                <div class="hts-kpi-label">Kutu Tipinde Aktif</div>
                <div class="hts-kpi-value">@kutuTipiAktif</div>
            </div>
        </div>
    </div>

    <!-- ═══ AKSİYONLAR ═══ -->
    <div class="hts-card">
        <div class="hts-actions">
            <div class="d-flex flex-wrap gap-2">
                <form method="post" asp-action="ApplyStandardSet" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="HospitalId" value="@Model.HospitalID" />
                    <button class="hts-btn-grad" type="submit" title="Sistemdeki tüm testleri bu hastaneye bağlar (eksik olanları)">
                        <i class="fe fe-plus-circle"></i> Standart Seti Uygula
                    </button>
                </form>

                <form method="post" asp-action="SetAll" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="HospitalId" value="@Model.HospitalID" />

                    <input type="hidden" name="isActive" value="true" />
                    <button class="hts-btn-grad hts-btn-success" type="submit">
                        <i class="fe fe-check-circle"></i> Tümünü Aktif
                    </button>
                </form>

                <form method="post" asp-action="SetAll" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="HospitalId" value="@Model.HospitalID" />

                    <input type="hidden" name="isActive" value="false" />
                    <button class="hts-btn-outline" type="submit">
                        <i class="fe fe-x-circle"></i> Tümünü Pasif
                    </button>
                </form>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <span class="hts-pill-info">
                    <i class="fe fe-home"></i> <strong>@Model.HospitalName</strong>
                </span>
                <span class="hts-pill-info">
                    <i class="fe fe-list"></i> Görüntülenen: <strong id="shownCount">0</strong> / <span id="totalShown">@totalCount</span>
                </span>
                <span class="hts-pill-info d-none" id="dirtyPill" style="background: rgba(245,158,11,.15); border-color: #f59e0b; color: #92400e;">
                    <i class="fe fe-edit-3"></i> Kaydedilmedi
                </span>
            </div>
        </div>
    </div>

    <!-- ═══ FORM + TABLE ═══ -->
    <form method="post" asp-action="Save" id="setForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="HospitalId" value="@Model.HospitalID" />


        <!-- Toolbar -->
        <div class="hts-toolbar">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-5">
                    <label class="form-label mb-1 small fw-semibold">Ara</label>
                    <div class="hts-search-wrap">
                        <i class="fe fe-search"></i>
                        <input id="q" class="form-control" placeholder="Test adı veya SUT kodu ile ara…">
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <label class="form-label mb-1 small fw-semibold">Filtre</label>
                    <select id="filterMode" class="form-select">
                        <option value="all">Tümü</option>
                        <option value="active">Sadece aktifler</option>
                        <option value="inactive">Sadece pasifler</option>
                        <option value="linked">Sadece bağlı olanlar</option>
                        <option value="kutu">Sadece kutu tipinde</option>
                        <option value="adet">Sadece adet tipinde</option>
                    </select>
                </div>

                <div class="col-6 col-md-4 d-flex justify-content-md-end align-items-end">
                    <button class="hts-btn-grad" type="submit" style="padding: .55rem 1.25rem; font-size: .9rem;">
                        <i class="fe fe-save"></i> Kaydet
                    </button>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="hts-table-wrap">
            <div class="table-responsive">
                <table class="hts-table" id="tbl">
                    <thead>
                        <tr>
                            <th style="width:80px" class="text-center">Aktif</th>
                            <th>Test</th>
                            <th style="width:140px">SUT</th>
                            <th style="width:110px">Giriş Tipi</th>
                            <th style="width:130px">Kutu Adet</th>
                            <th style="width:120px">Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="hts-empty">
                                    <div class="hts-empty-icon">🧪</div>
                                    Sistemde henüz test yok.
                                    <br />
                                    <a asp-area="Istatistik" asp-controller="Test" asp-action="Create" class="hts-btn-grad mt-3 d-inline-flex">
                                        <i class="fe fe-plus"></i> Test Ekle
                                    </a>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @for (int i = 0; i < Model.Rows.Count; i++)
                            {
                                var r = Model.Rows[i];
                                var tipText = r.GirisTipi.ToString();
                                var tipClass = r.GirisTipi == TestGirisTipi.Kutu ? "hts-badge-tip-kutu" : "hts-badge-tip-adet";

                                <tr data-testname="@((r.TestName ?? "").ToLowerInvariant())"
                                    data-sutcode="@((r.SutCode ?? "").ToLowerInvariant())"
                                    data-linked="@(r.IsLinked ? "1" : "0")"
                                    data-active-initial="@(r.IsActive ? "1" : "0")"
                                    data-tip="@tipText.ToLowerInvariant()">
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input hts-switch js-row-check"
                                               data-testid="@r.TestID"
                                               data-initial="@(r.IsActive ? "1" : "0")"
                                        @(r.IsActive ? "checked" : "") />
                                    </td>

                                    <td class="fw-semibold">@r.TestName</td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(r.SutCode))
                                        {
                                            <span class="hts-badge hts-badge-sut">@r.SutCode</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                    <td>
                                        <span class="hts-badge @tipClass">@tipText</span>
                                    </td>

                                    <td>
                                        @if (r.GirisTipi == TestGirisTipi.Kutu && r.KutuBasinaAdet.HasValue)
                                        {
                                            <span class="hts-kba-pill">
                                                <i class="fe fe-package"></i> @r.KutuBasinaAdet adet
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                    <td>
                                        @if (r.IsLinked)
                                        {
                                            <span class="hts-badge hts-badge-linked">Bağlı</span>
                                        }
                                        else
                                        {
                                            <span class="hts-badge hts-badge-notlinked">Bağlı değil</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center p-3" style="border-top: 1px solid #e2e8f0;">
                <small class="text-muted">Değişen satırlar sarı çizgi ile işaretlenir.</small>
                <button class="hts-btn-grad" type="submit">
                    <i class="fe fe-save"></i> Kaydet
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            const trTR = 'tr-TR';

            const els = {
                q: document.getElementById('q'),
                filterMode: document.getElementById('filterMode'),
                shownCount: document.getElementById('shownCount'),
                dirtyPill: document.getElementById('dirtyPill'),
                form: document.getElementById('setForm')
            };

            const table = document.getElementById('tbl');
            const rows = Array.from(table.querySelectorAll('tbody tr[data-testname]'));
            const checks = Array.from(table.querySelectorAll('.js-row-check'));

            function applyFilter() {
                const query = (els.q.value || '').trim().toLocaleLowerCase(trTR);
                const mode = els.filterMode.value;

                let shown = 0;
                rows.forEach(r => {
                    const tn = r.getAttribute('data-testname') || '';
                    const sc = r.getAttribute('data-sutcode') || '';
                    const isLinked = r.getAttribute('data-linked') === '1';
                    const tip = r.getAttribute('data-tip') || '';
                    const chk = r.querySelector('.js-row-check');
                    const isActive = chk && chk.checked;

                    const matchQ = !query || tn.includes(query) || sc.includes(query);

                    let matchMode = true;
                    switch (mode) {
                        case 'active': matchMode = isActive; break;
                        case 'inactive': matchMode = !isActive; break;
                        case 'linked': matchMode = isLinked; break;
                        case 'kutu': matchMode = tip === 'kutu'; break;
                        case 'adet': matchMode = tip === 'adet'; break;
                    }

                    const visible = matchQ && matchMode;
                    r.style.display = visible ? '' : 'none';
                    if (visible) shown++;
                });

                els.shownCount.textContent = shown.toString();
            }

            function updateDirty() {
                const dirty = rows.some(r => r.classList.contains('hts-row-dirty'));
                els.dirtyPill.classList.toggle('d-none', !dirty);
                return dirty;
            }

            checks.forEach(chk => {
                chk.addEventListener('change', () => {
                    const tr = chk.closest('tr');
                    const initial = chk.dataset.initial === '1';
                    const changed = (chk.checked !== initial);
                    tr.classList.toggle('hts-row-dirty', changed);
                    updateDirty();
                    applyFilter();
                });
            });

            window.addEventListener('beforeunload', (e) => {
                if (!updateDirty()) return;
                e.preventDefault();
                e.returnValue = '';
            });

            els.form.addEventListener('submit', function (e) {
            // Önce eski dinamik input'ları temizle (varsa)
            els.form.querySelectorAll('.js-dynamic-row').forEach(x => x.remove());

            // Tüm satırları topla (görünür/gizli fark etmez)
            const allChecks = Array.from(table.querySelectorAll('.js-row-check'));

            allChecks.forEach((chk, i) => {
                const testId = chk.dataset.testid;
                const isActive = chk.checked ? 'true' : 'false';

                const hTestId = document.createElement('input');
                hTestId.type = 'hidden';
                hTestId.name = `Rows[${i}].TestId`;
                hTestId.value = testId;
                hTestId.classList.add('js-dynamic-row');
                els.form.appendChild(hTestId);

                const hIsActive = document.createElement('input');
                hIsActive.type = 'hidden';
                hIsActive.name = `Rows[${i}].IsActive`;
                hIsActive.value = isActive;
                hIsActive.classList.add('js-dynamic-row');
                els.form.appendChild(hIsActive);
            });

            // dirty pill'i sıfırla
            els.dirtyPill.classList.add('d-none');
            rows.forEach(r => r.classList.remove('hts-row-dirty'));

            // ✅ form normal şekilde submit olsun
            });

            let t = null;
            els.q.addEventListener('input', () => {
                clearTimeout(t);
                t = setTimeout(applyFilter, 150);
            });
            els.filterMode.addEventListener('change', applyFilter);

            applyFilter();
        })();
    </script>
}