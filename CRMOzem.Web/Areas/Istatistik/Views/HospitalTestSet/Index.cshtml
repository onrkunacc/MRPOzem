@model HospitalTestSetVm
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Hastane Test Seti";
    var hospitals = ViewBag.Hospitals as List<SelectListItem> ?? new List<SelectListItem>();
    int? selectedHospitalId = ViewBag.SelectedHospitalId as int?;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .table-sticky thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: #fff;
    }

    .toolbar {
        position: sticky;
        top: 0;
        z-index: 3;
        background: #f8f9fa;
        border: 1px solid rgba(0,0,0,.06);
        border-radius: .75rem;
        padding: .75rem;
    }

    .code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono","Courier New", monospace;
        font-weight: 600;
        letter-spacing: .2px;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        border: 1px solid rgba(0,0,0,.08);
        background: #fff;
        border-radius: 999px;
        padding: .25rem .6rem;
        font-size: .85rem;
        color: #495057;
        white-space: nowrap;
    }

        .pill strong {
            font-weight: 800;
        }

    .hint {
        font-size: .85rem;
        color: #6c757d;
    }

    .badge-muted {
        background-color: #eef1f4;
        color: #495057;
        border: 1px solid rgba(0,0,0,.06);
    }

    .row-dirty td {
        box-shadow: inset 3px 0 0 rgba(255,193,7,.9);
    }

    .switch {
        transform: scale(1.05);
    }
</style>

<div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-2 mb-3">
    <div>
        <h4 class="mb-1">Hastane Test Seti</h4>
        <div class="text-muted small">Seçilen hastane için aktif testleri hızlıca yönetin.</div>
    </div>
</div>

<!-- Hastane seçimi -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-8 col-lg-6">
                <label class="form-label">Hastane</label>
                <select name="hospitalId" class="form-select" onchange="this.form.submit()" required>
                    <option value="">Seçiniz...</option>
                    @foreach (var h in hospitals)
                    {
                        <option value="@h.Value" selected="@(selectedHospitalId?.ToString() == h.Value)">
                            @h.Text
                        </option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4 col-lg-6">
                <div class="hint">Hastane seçildiğinde liste otomatik yüklenir.</div>
            </div>
        </form>
    </div>
</div>

@if (Model == null)
{
    <div class="alert alert-info">Devam etmek için hastane seçin.</div>
    return;
}

<!-- Aksiyonlar -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center justify-content-between">
        <div class="d-flex gap-2 flex-wrap">
            <form method="post" asp-action="ApplyStandardSet">
                @Html.AntiForgeryToken()
                <input type="hidden" name="hospitalId" value="@Model.HospitalID" />
                <button class="btn btn-primary" type="submit">
                    <i class="fe fe-plus-circle mr-2"></i> Standart Seti Uygula (Eksikleri Ekle)
                </button>
            </form>

            <form method="post" asp-action="SetAll">
                @Html.AntiForgeryToken()
                <input type="hidden" name="hospitalId" value="@Model.HospitalID" />
                <input type="hidden" name="isActive" value="true" />
                <button class="btn btn-success" type="submit">
                    <i class="fe fe-check-circle mr-2"></i> Tümünü Aktif Et
                </button>
            </form>

            <form method="post" asp-action="SetAll">
                @Html.AntiForgeryToken()
                <input type="hidden" name="hospitalId" value="@Model.HospitalID" />
                <input type="hidden" name="isActive" value="false" />
                <button class="btn btn-outline-danger" type="submit">
                    <i class="fe fe-x-circle mr-2"></i> Tümünü Pasif Et
                </button>
            </form>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <span class="pill"><i class="fe fe-home"></i> <strong>@Model.HospitalName</strong></span>
            <span class="pill"><i class="fe fe-list"></i> <strong id="shownCount">0</strong> / <span id="totalCount">0</span></span>
            <span class="pill"><i class="fe fe-check"></i> Aktif: <strong id="activeCount">0</strong></span>
            <span class="pill"><i class="fe fe-link"></i> Bağlı: <strong id="linkedCount">0</strong></span>
            <span class="pill d-none" id="dirtyPill"><i class="fe fe-edit-3"></i> Kaydedilmedi</span>
        </div>
    </div>
</div>

<form method="post" asp-action="Save" id="setForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="hospitalId" value="@Model.HospitalID" />

    <!-- Toolbar -->
    <div class="toolbar mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-6">
                <label class="form-label mb-1">Ara</label>
                <input id="q" class="form-control" placeholder="Test adı veya SUT kodu ile ara…">
            </div>

            <div class="col-6 col-md-3">
                <label class="form-label mb-1">Filtre</label>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="onlyLinked" />
                    <label class="form-check-label" for="onlyLinked">Sadece bağlı olanlar</label>
                </div>
            </div>

            <div class="col-6 col-md-3 d-flex justify-content-md-end">
                <button class="btn btn-dark px-4" type="submit">
                    <i class="fe fe-save mr-2"></i> Kaydet
                </button>
            </div>

            <div class="col-12">
                <div class="hint">
                    İpucu: Checkbox değişiklikleri otomatik işaretlenir. Arama ile hızlı filtreleyebilirsiniz.
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover table-sm mb-0 table-sticky" id="tbl">
                    <thead class="border-bottom">
                        <tr>
                            <th style="width:70px" class="text-center">Aktif</th>
                            <th>Test</th>
                            <th style="width:170px">SUT Kodu</th>
                            <th style="width:140px">Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Rows.Count; i++)
                        {
                            var r = Model.Rows[i];
                            <tr data-testname="@((r.TestName ?? "").ToLowerInvariant())"
                                data-sutcode="@((r.SutCode ?? "").ToLowerInvariant())"
                                data-linked="@(r.IsLinked ? "1" : "0")">
                                <td class="text-center">
                                    <input type="hidden" name="testId" value="@r.TestID" />
                                    <input type="hidden" name="isActive" value="false" />
                                    <input type="checkbox" class="form-check-input switch" name="isActive" value="true" @(r.IsActive ? "checked" : "") data-initial="@(r.IsActive ? "1" : "0")" />
                                </td>

                                <td class="test-name fw-semibold">@r.TestName</td>

                                <td class="code">
                                    @if (!string.IsNullOrWhiteSpace(r.SutCode))
                                    {
                                        <span class="badge badge-muted">@r.SutCode</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>

                                <td>
                                    @if (r.IsLinked)
                                    {
                                        <span class="badge bg-secondary">Bağlı</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Bağlı değil</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-3 d-flex justify-content-between align-items-center">
                <div class="hint">Değişen satırlar sarı çizgi ile işaretlenir.</div>
                <button class="btn btn-dark px-4" type="submit">
                    <i class="fe fe-save mr-2"></i> Kaydet
                </button>
            </div>
        </div>
    </div>
</form>

<script>
    (function(){
        const trTR = 'tr-TR';

        const q = document.getElementById('q');
        const onlyLinked = document.getElementById('onlyLinked');

        const totalCountEl = document.getElementById('totalCount');
        const shownCountEl = document.getElementById('shownCount');
        const activeCountEl = document.getElementById('activeCount');
        const linkedCountEl = document.getElementById('linkedCount');
        const dirtyPill = document.getElementById('dirtyPill');

        const table = document.getElementById('tbl');
        const rows = Array.from(table.querySelectorAll('tbody tr'));
        const checks = Array.from(table.querySelectorAll('input[type="checkbox"][name="isActive"]'));

        totalCountEl.textContent = rows.length.toString();

        function counts(){
            let shown = 0, active = 0, linked = 0;

            rows.forEach(r=>{
                if(r.style.display === 'none') return;
                shown++;

                const isLinked = (r.getAttribute('data-linked') === '1');
                if(isLinked) linked++;

                const chk = r.querySelector('input[type="checkbox"][name="isActive"]');
                if(chk && chk.checked) active++;
            });

            shownCountEl.textContent = shown.toString();
            activeCountEl.textContent = active.toString();
            linkedCountEl.textContent = linked.toString();
        }

        function applyFilter(){
            const query = (q.value || '').trim().toLocaleLowerCase(trTR);
            const only = !!onlyLinked.checked;

            rows.forEach(r=>{
                const tn = r.getAttribute('data-testname') || '';
                const sc = r.getAttribute('data-sutcode') || '';
                const isLinked = (r.getAttribute('data-linked') === '1');

                const match = !query || tn.includes(query) || sc.includes(query);
                const passLinked = !only || isLinked;

                r.style.display = (match && passLinked) ? '' : 'none';
            });

            counts();
        }

        function updateDirty(){
            const dirty = rows.some(r => r.classList.contains('row-dirty'));
            dirtyPill.classList.toggle('d-none', !dirty);
            return dirty;
        }

        // checkbox değişince satırı işaretle
        checks.forEach(chk=>{
            chk.addEventListener('change', ()=>{
                const tr = chk.closest('tr');
                const initial = chk.dataset.initial === '1';
                const changed = (chk.checked !== initial);
                tr.classList.toggle('row-dirty', changed);
                updateDirty();
                counts();
            });
        });

        // kaydetmeden çıkış uyarısı
        window.addEventListener('beforeunload', (e)=>{
            if(!updateDirty()) return;
            e.preventDefault();
            e.returnValue = '';
        });

        document.getElementById('setForm').addEventListener('submit', ()=>{
            // submit edince uyarıyı kapat
            dirtyPill.classList.add('d-none');
            rows.forEach(r => r.classList.remove('row-dirty'));
        });

        // filtre events
        let t = null;
        q.addEventListener('input', ()=>{
            clearTimeout(t);
            t = setTimeout(applyFilter, 150);
        });
        onlyLinked.addEventListener('change', applyFilter);

        // initial
        applyFilter();
    })();
</script>