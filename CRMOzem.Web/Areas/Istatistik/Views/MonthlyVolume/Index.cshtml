@model MonthlyVolumeEntryVm
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Aylık Tetkik Girişi";
    var hospitals = ViewBag.Hospitals as List<SelectListItem> ?? new List<SelectListItem>();
    int? selectedHospitalId = ViewBag.SelectedHospitalId as int?;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .table-sticky thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: #fff;
    }

    .toolbar {
        position: sticky;
        top: 0;
        z-index: 3;
        background: #f8f9fa;
        border: 1px solid rgba(0,0,0,.06);
        border-radius: .75rem;
        padding: .75rem;
    }

    .code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono","Courier New", monospace;
        font-weight: 600;
        letter-spacing: .2px;
    }

    .num {
        text-align: right;
        white-space: nowrap;
    }

    .count-input {
        max-width: 160px;
        font-weight: 700;
    }

    .row-dirty td {
        box-shadow: inset 3px 0 0 rgba(255,193,7,.9);
    }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        border: 1px solid rgba(0,0,0,.08);
        background: #fff;
        border-radius: 999px;
        padding: .25rem .6rem;
        font-size: .85rem;
        color: #495057;
        white-space: nowrap;
    }

        .pill strong {
            font-weight: 800;
        }

    .hint {
        font-size: .85rem;
        color: #6c757d;
    }

    .badge-muted {
        background-color: #eef1f4;
        color: #495057;
        border: 1px solid rgba(0,0,0,.06);
    }
</style>

<div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-2 mb-3">
    <div>
        <h4 class="mb-1">Aylık Tetkik Girişi</h4>
        <div class="text-muted small">Seçilen hastane ve dönem için aktif testlerin tetkik sayılarını girin.</div>
    </div>
</div>

<!-- Seçim Alanı -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-6 col-lg-5">
                <label class="form-label">Hastane</label>
                <select name="hospitalId" class="form-select" required>
                    <option value="">Seçiniz...</option>
                    @foreach (var h in hospitals)
                    {
                        <option value="@h.Value" selected="@(selectedHospitalId?.ToString() == h.Value)">
                            @h.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label">Yıl</label>
                <input type="number" name="year" class="form-control" value="@(Model?.Year ?? DateTime.Now.Year)" />
            </div>

            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label">Ay</label>
                <input type="number" name="month" class="form-control" min="1" max="12" value="@(Model?.Month ?? DateTime.Now.Month)" />
            </div>

            <div class="col-12 col-lg-3">
                <button class="btn btn-primary w-100" type="submit">
                    <i class="fe fe-search mr-2"></i> Getir
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model == null)
{
    <div class="alert alert-info">Devam etmek için hastane seçin.</div>
    return;
}

<!-- Kopyalama Butonları -->
<div class="d-flex gap-2 flex-wrap mb-3">
    <form method="post" asp-action="CopyPrev">
        @Html.AntiForgeryToken()
        <input type="hidden" name="hospitalId" value="@Model.HospitalID" />
        <input type="hidden" name="year" value="@Model.Year" />
        <input type="hidden" name="month" value="@Model.Month" />
        <input type="hidden" name="overwriteExisting" value="false" />
        <button class="btn btn-outline-secondary" type="submit">
            <i class="fe fe-copy mr-2"></i> Geçen Ayı Kopyala (Boşları Doldur)
        </button>
    </form>
    &nbsp;&nbsp;&nbsp;
    <form method="post" asp-action="CopyPrev">
        @Html.AntiForgeryToken()
        <input type="hidden" name="hospitalId" value="@Model.HospitalID" />
        <input type="hidden" name="year" value="@Model.Year" />
        <input type="hidden" name="month" value="@Model.Month" />
        <input type="hidden" name="overwriteExisting" value="true" />
        <button class="btn btn-outline-warning" type="submit">
            <i class="fe fe-alert-triangle mr-2"></i> Geçen Ayı Kopyala (Üzerine Yaz)
        </button>
    </form>
</div>

<form method="post" asp-action="Save" id="volumeForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="hospitalId" value="@Model.HospitalID" />
    <input type="hidden" name="year" value="@Model.Year" />
    <input type="hidden" name="month" value="@Model.Month" />

    <!-- Modern Toolbar -->
    <div class="toolbar mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-5">
                <label class="form-label mb-1">Ara</label>
                <input id="q" type="text" class="form-control" placeholder="Test adı veya Stok Kodu ile ara…">
            </div>

            <div class="col-6 col-md-3">
                <label class="form-label mb-1">Filtre</label>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="onlyZero" />
                    <label class="form-check-label" for="onlyZero">Sadece 0 olanlar</label>
                </div>
            </div>

            <div class="col-6 col-md-4 d-flex justify-content-md-end gap-2 flex-wrap">
                <span class="pill"><i class="fe fe-home"></i> <strong>@Model.HospitalName</strong></span>
                <span class="pill"><i class="fe fe-calendar"></i> <strong>@Model.Year/@Model.Month</strong></span>
                <span class="pill"><i class="fe fe-list"></i> <strong id="shownCount">0</strong> / <span id="totalCount">0</span></span>
                <span class="pill d-none" id="dirtyPill"><i class="fe fe-edit-3"></i> Kaydedilmedi</span>
            </div>

            <div class="col-12 d-flex gap-2 flex-wrap mt-1">
                <div class="input-group" style="max-width: 320px;">
                    <span class="input-group-text">Hepsine</span>
                    <input id="fillAll" type="number" class="form-control" min="0" placeholder="Sayı (örn 0)">
                    <button type="button" id="applyFillAll" class="btn btn-outline-dark">Uygula</button>
                </div>
                &nbsp;&nbsp;
                <button type="button" id="setAllZero" class="btn btn-outline-secondary">
                    <i class="fe fe-x-circle mr-2"></i> Hepsini 0 Yap
                </button>
                &nbsp;&nbsp;
                <button class="btn btn-primary ms-auto" type="submit">
                    <i class="fe fe-save mr-2"></i> Kaydet
                </button>
            </div>
            
            <div class="col-12">
                <div class="hint">
                    Klavye: <b>Enter / ↓</b> alt satıra geçer, <b>↑</b> üst satıra çıkar. Değişen satırlar sarı çizgi ile işaretlenir.
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover table-sm mb-0 table-sticky" id="volTable">
                    <thead class="border-bottom">
                        <tr>
                            <th style="width:60px">#</th>
                            <th>Test</th>
                            <th style="width:160px">Stok Kodu</th>
                            <th style="width:200px" class="num">Tetkik Sayısı</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Rows.Count; i++)
                        {
                            var r = Model.Rows[i];
                            <tr data-testname="@((r.TestName ?? "").ToLowerInvariant())"
                                data-sutcode="@((r.SutCode ?? "").ToLowerInvariant())"
                                data-count="@(r.Count)">
                                <td>@r.Sira</td>
                                <td class="fw-semibold">@r.TestName</td>
                                <td class="code">
                                    @if (!string.IsNullOrWhiteSpace(r.SutCode))
                                    {
                                        <span class="badge badge-muted">@r.SutCode</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="num">
                                    <input type="hidden" name="testId" value="@r.TestID" />
                                    <input type="number"
                                           name="count"
                                           class="form-control form-control-sm text-end count-input"
                                           min="0"
                                           value="@r.Count"
                                           data-index="@i" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-3 d-flex justify-content-between align-items-center">
                <button class="btn btn-primary px-4" type="submit">
                    <i class="fe fe-save mr-2"></i> Kaydet
                </button>
            </div>
        </div>
    </div>
</form>

<script>
    (function(){
        const trTR = 'tr-TR';

        const q = document.getElementById('q');
        const onlyZero = document.getElementById('onlyZero');
        const dirtyPill = document.getElementById('dirtyPill');

        const totalCountEl = document.getElementById('totalCount');
        const shownCountEl = document.getElementById('shownCount');

        const setAllZeroBtn = document.getElementById('setAllZero');
        const fillAll = document.getElementById('fillAll');
        const applyFillAll = document.getElementById('applyFillAll');

        const table = document.getElementById('volTable');
        const rows = Array.from(table.querySelectorAll('tbody tr'));
        const inputs = Array.from(table.querySelectorAll('input.count-input'));

        totalCountEl.textContent = rows.length.toString();

        let dirty = false;
        function setDirty(v){
            dirty = v;
            dirtyPill.classList.toggle('d-none', !dirty);
        }

        function updateShownCount(){
            let shown = 0;
            rows.forEach(r=>{
                if(r.style.display === 'none') return;
                shown++;
            });
            shownCountEl.textContent = shown.toString();
        }

        function applyFilter(){
            const query = (q.value || '').trim().toLocaleLowerCase(trTR);
            const only = !!onlyZero.checked;

            rows.forEach(r=>{
                const tn = r.getAttribute('data-testname') || '';
                const sc = r.getAttribute('data-sutcode') || '';
                const c = parseInt((r.querySelector('input.count-input')?.value || '0'), 10) || 0;

                const match = !query || tn.includes(query) || sc.includes(query);
                const passZero = !only || (c === 0);

                r.style.display = (match && passZero) ? '' : 'none';
            });

            updateShownCount();
        }

        // input change tracking + row highlight + key navigation
        inputs.forEach((inp, idx)=>{
            const tr = inp.closest('tr');
            const initial = inp.value;
            inp.dataset.initial = initial;

            inp.addEventListener('input', ()=>{
                const val = Math.max(0, parseInt(inp.value || '0', 10) || 0);
                inp.value = val;

                const changed = String(val) !== String(inp.dataset.initial || '0');
                tr.classList.toggle('row-dirty', changed);

                setDirty(rows.some(r => r.classList.contains('row-dirty')));

                if (onlyZero.checked) applyFilter();
                else updateShownCount();
            });

            inp.addEventListener('keydown', (e)=>{
                if(e.key === 'Enter' || e.key === 'ArrowDown'){
                    e.preventDefault();
                    focusNext(idx, +1);
                } else if(e.key === 'ArrowUp'){
                    e.preventDefault();
                    focusNext(idx, -1);
                }
            });
        });

        function focusNext(currentIndex, dir){
            const visibleInputs = inputs.filter(i => i.closest('tr').style.display !== 'none');
            const pos = visibleInputs.indexOf(inputs[currentIndex]);
            if(pos === -1) return;
            const next = visibleInputs[pos + dir];
            if(next){
                next.focus();
                next.select();
            }
        }

        // bulk actions
        function setAll(val){
            inputs.forEach(inp=>{
                inp.value = val;
                inp.dispatchEvent(new Event('input'));
            });
        }

        setAllZeroBtn.addEventListener('click', ()=>{
            if(confirm('Tüm tetkik sayılarını 0 yapmak istiyor musunuz?')){
                setAll(0);
            }
        });

        applyFillAll.addEventListener('click', ()=>{
            const val = Math.max(0, parseInt(fillAll.value || '0', 10) || 0);
            setAll(val);
        });

        // filter events
        let t = null;
        q.addEventListener('input', ()=>{
            clearTimeout(t);
            t = setTimeout(applyFilter, 150);
        });
        onlyZero.addEventListener('change', applyFilter);

        // leave warning
        window.addEventListener('beforeunload', (e)=>{
            if(!dirty) return;
            e.preventDefault();
            e.returnValue = '';
        });

        document.getElementById('volumeForm').addEventListener('submit', ()=>{
            setDirty(false);
        });

        applyFilter();
    })();
</script>