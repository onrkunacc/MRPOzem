@{
    Layout = null;
    ViewData["Title"] = "Erişim Engellendi";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Erişim Engellendi - Özem CRM</title>

    <!-- Template CSS -->
    <link rel="stylesheet" href="~/tinydash-master/light/css/simplebar.css">
    <link rel="stylesheet" href="~/tinydash-master/light/css/feather.css">
    <link rel="stylesheet" href="~/tinydash-master/light/css/app-light.css" id="lightTheme">
    <link rel="stylesheet" href="~/tinydash-master/dark/css/app-dark.css" id="darkTheme" disabled>
    <link rel="shortcut icon" href="~/favicon/ozemLogo.ico" />
</head>
<body class="light">
    <div class="wrapper vh-100 d-flex align-items-center justify-content-center">
        <div class="text-center">
            <img src="~/tinydash-master/light/assets/images/logo.jpeg" width="180" alt="Özem Logo" class="mb-4">
            <h1 class="display-4 text-danger">403</h1>
            <h3 class="mb-3">Erişim Engellendi</h3>
            <p class="text-muted">Bu sayfaya erişim yetkiniz bulunmamaktadır.</p>
            
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
                <i class="fe fe-arrow-left mr-2"></i> Ana Sayfaya Dön
            </a>
        </div>
    </div>

    <!-- Template JS -->
    <script src="~/tinydash-master/light/js/jquery.min.js"></script>
    <script src="~/tinydash-master/light/js/bootstrap.min.js"></script>
    <script src="~/tinydash-master/light/js/simplebar.min.js"></script>
    <script src="~/tinydash-master/light/js/tinycolor-min.js"></script>
    <script src="~/tinydash-master/light/js/config.js"></script>
    <script src="~/tinydash-master/light/js/apps.js"></script>
</body>
</html>
