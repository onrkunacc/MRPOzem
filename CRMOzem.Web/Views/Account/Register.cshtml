@model CRMOzem.Core.ViewModels.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Kayıt Ol";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Kayıt Ol - Özem MRP</title>

    <!-- Template CSS -->
    <link rel="stylesheet" href="~/tinydash-master/light/css/app-light.css">
    <link rel="shortcut icon" href="~/favicon/ozemLogo.ico" />
    <style>
        .form-container {
            max-width: 800px;
            padding: 30px;
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

        .form-control-lg {
            font-size: 1rem;
            padding: 12px;
        }

        .alert-danger ul {
            margin-bottom: 0;
        }
    </style>
</head>
<body class="light">
    <div class="wrapper vh-100 d-flex align-items-center justify-content-center">
        <div class="form-container">
            <div class="text-center mb-3">
                <a class="navbar-brand">
                    <img src="~/tinydash-master/light/assets/images/logo.jpeg" width="160" alt="Özem Logo" />
                </a>
                <h2 class="h5 mt-2 font-weight-bold text-primary">Hesap Oluştur</h2>
            </div>

            <!-- 📌 Başarı Mesajı (Admin Onayı Bekleniyor) -->
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle"></i> @TempData["Message"]
                </div>
            }

            <!-- 📌 Türkçe Hata Mesajları -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-left">
                    <ul>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Register" asp-controller="Account" method="post">
                <div class="row">
                    <!-- Sol Sütun -->
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="FullName">Ad-Soyad</label>
                            <input asp-for="FullName" class="form-control form-control-lg" placeholder="Ad Soyad" required>
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="UserName">Kullanıcı Adı</label>
                            <input asp-for="UserName" class="form-control form-control-lg" placeholder="Kullanıcı Adı" required>
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Email">E-Posta</label>
                            <input asp-for="Email" type="email" class="form-control form-control-lg" placeholder="E-Posta (Opsiyonel)">
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="PhoneNumber">Telefon Numarası</label>
                            <input asp-for="PhoneNumber" type="tel" class="form-control form-control-lg phone-mask" placeholder="(5XX) XXX XX XX">
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Sağ Sütun -->
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Title">Unvan</label>
                            <input asp-for="Title" class="form-control form-control-lg" placeholder="Unvan (Opsiyonel)">
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Password">Şifre</label>
                            <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="Şifre" required>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="ConfirmPassword">Şifre Tekrar</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control form-control-lg" placeholder="Şifreyi Tekrar Girin" required>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <button class="btn btn-lg btn-primary btn-block mt-3" type="submit">Kayıt Ol</button>

                <div class="text-center mt-3">
                    <a asp-action="Login" class="text-primary">Giriş Yap</a>
                </div>
                <p class="mt-4 text-muted text-center">&copy; 2025 - Özem CRM</p>
            </form>
        </div>
    </div>

    <!-- JS -->
    <script src="~/tinydash-master/light/js/jquery.min.js"></script>
    <script src="~/tinydash-master/light/js/bootstrap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>

    <script>
        $(document).ready(function () {
            $(".phone-mask").mask("(599) 999 99 99");
        });
    </script>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>
