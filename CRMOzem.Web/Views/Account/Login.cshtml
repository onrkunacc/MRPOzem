@model CRMOzem.Core.ViewModels.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Giriş Yap";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Özem MRP kurumsal çalışma alanınıza giriş yapın." />
    <meta name="theme-color" content="#102f3d" />
    <title>Giriş Yap - Özem MRP</title>
    <link rel="shortcut icon" href="~/favicon/ozemLogo.ico" />
    <style>

        :root {
            color-scheme: light;
            --ink: #152c3b;
            --muted: #637786;
            --accent: #087e83;
            --accent-dark: #05666b;
            --line: #e3eaf0;
            --danger: #b53142;
        }
        *, *::before, *::after { box-sizing: border-box; }
        body { margin: 0; min-width: 320px; min-height: 100vh; min-height: 100svh; background: #f2f5f7; color: var(--ink); font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, Arial, sans-serif; -webkit-font-smoothing: antialiased; }
        button, input { font: inherit; }
        button, a { -webkit-tap-highlight-color: transparent; }
        a { color: var(--accent); text-decoration: none; }
        a:hover { text-decoration: underline; text-underline-offset: 4px; }
        button { cursor: pointer; }
        button:disabled { cursor: wait; opacity: .7; }
        a:focus-visible, button:focus-visible, input:focus-visible, dialog:focus-visible { outline: 3px solid #0b878c; outline-offset: 4px; }
        .icon { display: inline-block; flex-shrink: 0; vertical-align: middle; }
        .page-frame { max-width: 1280px; padding: 0 40px; margin: 0 auto; }
        .site-header { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 104px; }
        .brand { display: flex; align-items: center; gap: 18px; color: var(--ink); }
        .brand:hover { text-decoration: none; }
        .brand-logo { display: block; width: 112px; height: 48px; object-fit: cover; mix-blend-mode: multiply; }
        .brand-name { padding-left: 18px; border-left: 1px solid #ccd7df; display: flex; flex-direction: column; gap: 3px; }
        .brand-name strong { font-size: 15px; letter-spacing: .09em; font-weight: 700; }
        .brand-name span { font-size: 11px; color: var(--muted); letter-spacing: .03em; }
        .header-link { display: inline-flex; align-items: center; gap: 9px; font-size: 13px; font-weight: 600; white-space: nowrap; }
        .header-link .icon { width: 16px; height: 16px; }
        .auth-shell { display: grid; grid-template-columns: .94fr 1.06fr; background: #fff; border: 1px solid #e1e8ed; border-radius: 26px; overflow: hidden; box-shadow: 0 24px 70px -42px #17394a55; min-height: 656px; }
        .brand-panel { background: #102f3d; color: #fff; padding: 46px 42px 34px; position: relative; display: flex; flex-direction: column; overflow: hidden; isolation: isolate; }
        .brand-panel::before { content: ""; position: absolute; width: 460px; height: 460px; border-radius: 50%; background: radial-gradient(circle, #138b8850, transparent 70%); left: -180px; bottom: -150px; z-index: -1; }
        .brand-panel::after { content: ""; position: absolute; width: 370px; height: 370px; border: 1px solid #ffffff0d; border-radius: 50%; top: -220px; right: -130px; box-shadow: 0 0 0 46px #ffffff03, 0 0 0 92px #ffffff02; z-index: -1; }
        .eyebrow { display: flex; align-items: center; gap: 9px; color: #a5d4d4; font-size: 10px; letter-spacing: .18em; font-weight: 700; text-transform: uppercase; margin: 0 0 26px; }
        .eyebrow-mark { width: 7px; height: 7px; background: #74d5c9; border-radius: 2px; transform: rotate(45deg); }
        .brand-heading { font-size: clamp(34px, 3.5vw, 45px); line-height: 1.16; font-weight: 600; letter-spacing: -.045em; margin: 0 0 20px; }
        .brand-heading em { font-style: normal; color: #8bddcf; }
        .brand-description { margin: 0; max-width: 345px; font-size: 14px; line-height: 1.75; color: #bdcfd7; }
        .workspace-art { margin: auto 0 26px; padding-top: 38px; }
        .workspace-card { background: linear-gradient(120deg, #214654, #183b49); border: 1px solid #ffffff1c; border-radius: 16px; padding: 20px; box-shadow: 0 18px 35px #041e312b; transform: rotate(-2deg); }
        .workspace-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; }
        .workspace-caption { font-size: 10px; font-weight: 600; letter-spacing: .12em; color: #c7e2e4; }
        .workspace-dots { display: flex; gap: 4px; }
        .workspace-dots i { width: 4px; height: 4px; border-radius: 50%; background: #75939e; }
        .module-row { display: flex; align-items: center; gap: 12px; background: #ffffff08; border: 1px solid #ffffff0a; border-radius: 10px; padding: 11px 12px; margin-top: 9px; }
        .module-icon { width: 34px; height: 34px; display: grid; place-items: center; background: #9ee5d219; color: #a1e3d6; border-radius: 9px; }
        .module-name { font-size: 12px; font-weight: 600; }
        .module-caption { font-size: 10px; color: #a9c0cb; display: block; margin-top: 3px; }
        .module-arrow { margin-left: auto; color: #789fae; }
        .brand-bottom { display: flex; align-items: center; gap: 9px; font-size: 11px; color: #a8c3cb; }
        .brand-bottom .icon { color: #8bddcf; width: 16px; height: 16px; }
        .form-panel { padding: 50px 55px 38px; display: flex; flex-direction: column; justify-content: center; min-width: 0; }
        .form-tag { font-size: 10px; font-weight: 700; letter-spacing: .16em; color: var(--accent); margin: 0 0 12px; text-transform: uppercase; }
        .form-title { font-size: 31px; letter-spacing: -.04em; line-height: 1.2; margin: 0 0 12px; font-weight: 650; }
        .form-description { color: var(--muted); font-size: 13px; line-height: 1.7; margin: 0 0 29px; }
        .form-field { margin-bottom: 20px; min-width: 0; }
        .form-label { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 12px; font-weight: 650; margin: 0 0 8px; }
        .form-label a { font-size: 11px; font-weight: 600; }
        .optional { color: var(--muted); font-size: 10px; font-weight: 400; margin-left: 4px; }
        .input-wrap { position: relative; }
        .input-icon { position: absolute; left: 15px; top: 17px; width: 18px; height: 18px; color: #8395a1; pointer-events: none; }
        .form-input { display: block; width: 100%; height: 52px; border: 1px solid #dce5eb; border-radius: 10px; padding: 0 15px 0 44px; font-size: 13px; color: var(--ink); background: #fbfcfd; transition: border-color .18s, box-shadow .18s, background .18s; }
        .form-input::placeholder { color: #8797a3; opacity: 1; }
        .form-input:hover { border-color: #a9bdc9; }
        .form-input:focus { outline: none; background: #fff; border-color: var(--accent); box-shadow: 0 0 0 3px #087e8314; }
        .form-input.input-validation-error, .form-input[aria-invalid="true"] { border-color: var(--danger); background: #fffafb; }
        .password-input { padding-right: 52px; }
        .password-toggle { position: absolute; top: 4px; right: 4px; border: 0; width: 44px; height: 44px; display: grid; place-items: center; border-radius: 8px; color: #6d8391; background: transparent; }
        .password-toggle:hover, .password-toggle[aria-pressed="true"] { color: var(--accent); background: #eaf4f4; }
        .field-validation-valid, .validation-summary-valid { display: none; }
        .field-validation-error { display: block; font-size: 11px; line-height: 1.5; margin-top: 6px; color: var(--danger); }
        .message { display: flex; align-items: flex-start; gap: 10px; border: 1px solid; border-radius: 10px; padding: 12px 14px; margin: 0 0 20px; font-size: 12px; line-height: 1.6; overflow-wrap: anywhere; }
        .message .icon { margin-top: 2px; width: 17px; height: 17px; }
        .message-info { background: #eef8f8; border-color: #cee8e7; color: #23696c; }
        .message-error { background: #fff4f5; border-color: #f1d4da; color: #a12d40; }
        .message ul { margin: 0; padding-left: 16px; }
        .primary-button { min-height: 51px; border: 1px solid var(--accent); border-radius: 10px; background: var(--accent); color: #fff; font-size: 13px; font-weight: 650; display: inline-flex; justify-content: center; align-items: center; gap: 12px; padding: 13px 20px; text-decoration: none; transition: background .18s, box-shadow .18s; }
        .primary-button:hover { color: #fff; background: var(--accent-dark); border-color: var(--accent-dark); box-shadow: 0 5px 15px #087e831b; text-decoration: none; }
        .primary-button .icon { width: 18px; height: 18px; }
        .button-full { width: 100%; }
        .account-switch { text-align: center; font-size: 12px; line-height: 1.7; color: var(--muted); margin: 23px 0 0; }
        .account-switch a { font-weight: 700; margin-left: 4px; }
        .form-utility { border-top: 1px solid var(--line); margin-top: 29px; padding-top: 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
        .utility-label { display: inline-flex; align-items: center; gap: 6px; color: #71838e; font-size: 10px; }
        .utility-label .icon { width: 14px; height: 14px; }
        .text-button { border: 0; background: transparent; padding: 6px 0; display: inline-flex; align-items: center; justify-content: center; gap: 7px; color: var(--accent); font-size: 11px; font-weight: 600; }
        .text-button:hover { text-decoration: underline; text-underline-offset: 4px; }
        .text-button .icon { width: 15px; height: 15px; }
        .site-footer { display: flex; justify-content: space-between; align-items: center; gap: 14px; padding: 24px 1px 28px; color: #73848f; font-size: 11px; line-height: 1.6; }
        .footer-note { display: inline-flex; align-items: center; gap: 7px; }
        .footer-note::before { content: ""; width: 5px; height: 5px; border-radius: 50%; background: #70a69f; }
        .form-grid { display: grid; grid-template-columns: 1fr 1fr; column-gap: 18px; }
        .field-wide { grid-column: 1 / -1; }
        .register-shell { grid-template-columns: .78fr 1.22fr; }
        .register-shell .brand-panel { padding: 42px 35px 32px; }
        .register-shell .form-panel { padding: 37px 43px 32px; }
        .register-shell .form-description { margin-bottom: 23px; }
        .register-shell .form-field { margin-bottom: 16px; }
        .register-shell .form-title { font-size: 28px; }
        .register-shell .form-input { height: 48px; font-size: 12px; }
        .register-shell .input-icon { top: 15px; }
        .register-shell .password-toggle { height: 40px; width: 40px; }
        .register-shell .password-toggle .icon { width: 18px; height: 18px; }
        .register-shell .brand-heading { font-size: clamp(32px, 3vw, 40px); }
        .register-shell .brand-description { font-size: 13px; }
        .approval-note { display: flex; align-items: flex-start; gap: 9px; padding: 12px; border: 1px solid #e0ebed; background: #f6fafa; border-radius: 9px; color: #526f7a; font-size: 11px; line-height: 1.6; margin: 2px 0 18px; }
        .approval-note .icon { width: 16px; height: 16px; margin-top: 1px; color: var(--accent); }
        .register-shell .account-switch { margin-top: 18px; }
        .steps { margin: auto 0 25px; padding: 38px 0 0; list-style: none; counter-reset: steps; }
        .steps li { display: flex; align-items: flex-start; gap: 14px; padding: 0 0 26px; position: relative; }
        .steps li:last-child { padding-bottom: 0; }
        .steps li:not(:last-child)::after { content: ""; position: absolute; width: 1px; background: #ffffff1c; top: 34px; left: 16px; bottom: 0; }
        .step-index { display: grid; place-items: center; width: 33px; height: 33px; border: 1px solid #ffffff33; border-radius: 50%; background: #ffffff07; color: #a8d3d4; font-size: 11px; flex-shrink: 0; }
        .steps li:first-child .step-index { color: #102f3d; background: #9be2d2; border-color: #9be2d2; }
        .step-title { display: block; font-size: 13px; font-weight: 600; margin: 2px 0 5px; }
        .step-description { display: block; font-size: 11px; line-height: 1.65; color: #acc4ce; }
        .invoice-dialog { width: min(600px, calc(100% - 32px)); max-height: calc(100vh - 40px); max-height: calc(100svh - 40px); padding: 0; border: 1px solid #d9e4e9; border-radius: 20px; color: var(--ink); background: #fff; box-shadow: 0 35px 100px #081e3d40; }
        .invoice-dialog::backdrop { background: #0b253b99; backdrop-filter: blur(5px); }
        body.dialog-open { overflow: hidden; }
        .dialog-header { padding: 24px 26px 20px; display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; border-bottom: 1px solid var(--line); }
        .dialog-heading { display: flex; align-items: center; gap: 12px; }
        .dialog-icon { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 11px; background: #eaf6f4; color: var(--accent); }
        .dialog-kicker { margin: 0 0 4px; color: var(--muted); font-size: 10px; letter-spacing: .07em; }
        .dialog-title { font-size: 19px; margin: 0; letter-spacing: -.02em; }
        .close-button { border: 0; background: #f2f5f7; border-radius: 8px; width: 36px; height: 36px; display: grid; place-items: center; color: #6b7f8d; }
        .close-button:hover { background: #e5ecef; color: var(--ink); }
        .dialog-body { padding: 6px 26px 24px; }
        .invoice-details { margin: 0; }
        .invoice-row { display: grid; grid-template-columns: 112px 1fr; gap: 15px; border-bottom: 1px solid var(--line); padding: 16px 0; font-size: 12px; line-height: 1.65; }
        .invoice-row dt { color: var(--muted); }
        .invoice-row dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
        .invoice-note { font-size: 11px; line-height: 1.65; color: var(--muted); margin: 17px 0; }
        .invoice-actions { display: flex; gap: 10px; }
        .secondary-button { min-height: 44px; display: inline-flex; justify-content: center; align-items: center; gap: 8px; border: 1px solid #dbe4e9; border-radius: 10px; padding: 11px 18px; background: #fff; color: #536e7c; font-size: 12px; font-weight: 600; text-decoration: none; }
        .secondary-button:hover { background: #f3f7f8; text-decoration: none; }
        .invoice-actions .primary-button { min-height: 44px; font-size: 12px; padding: 11px 18px; }
        .copy-status { display: block; min-height: 18px; margin-top: 10px; font-size: 11px; color: var(--accent); }
        .denied-shell { min-height: 620px; grid-template-columns: .92fr 1.08fr; }
        .denied-panel { text-align: center; align-items: center; padding: 56px 45px; }
        .denied-icon { width: 72px; height: 72px; border: 1px solid #edd8cb; background: #fff7f0; color: #b27648; border-radius: 21px; display: grid; place-items: center; margin-bottom: 25px; }
        .denied-icon .icon { width: 32px; height: 32px; }
        .status-badge { display: inline-flex; border: 1px solid #e0e7ed; border-radius: 6px; padding: 5px 9px; color: #738693; font-size: 10px; letter-spacing: .08em; margin-bottom: 13px; font-weight: 600; }
        .denied-panel .form-title { font-size: 32px; }
        .denied-panel .form-description { max-width: 340px; margin-bottom: 22px; }
        .denied-note { max-width: 340px; background: #f6f8fa; border: 1px solid #e6ecf0; border-radius: 11px; padding: 15px 18px; font-size: 12px; line-height: 1.75; color: #617987; margin: 0 0 25px; }
        .denied-actions { display: flex; flex-direction: column; gap: 14px; width: 100%; max-width: 300px; }
        .denied-actions .text-button { min-height: 40px; }
        .access-art { min-height: 245px; margin: auto 0 30px; padding-top: 30px; position: relative; display: grid; place-items: center; }
        .access-ring { width: 175px; height: 175px; display: grid; place-items: center; position: relative; border: 1px solid #91d6d73b; border-radius: 50%; box-shadow: 0 0 0 24px #91d6d708, 0 0 0 49px #91d6d704; }
        .access-ring .icon { width: 74px; height: 74px; color: #a4e3d5; stroke-width: 1; }
        .access-tag { position: absolute; right: -35px; bottom: 5px; border-radius: 10px; border: 1px solid #ffffff26; background: #244854; padding: 12px 16px; font-size: 10px; letter-spacing: .09em; color: #c2e5e2; box-shadow: 0 10px 20px #061b282b; }
        @@media (min-width: 1600px) { .page-frame { padding-top: 32px; } }
        @@media (max-width: 1100px) {
            .page-frame { padding: 0 28px; }
            .brand-panel { padding: 38px 30px 30px; }
            .form-panel { padding: 42px 36px 34px; }
            .brand-heading { font-size: 37px; }
            .register-shell { grid-template-columns: .72fr 1.28fr; }
            .register-shell .brand-panel { padding: 38px 27px 28px; }
            .register-shell .form-panel { padding: 36px 30px 30px; }
            .register-shell .brand-heading { font-size: 33px; }
            .denied-panel { padding: 40px 28px; }
        }
        @@media (max-width: 850px) {
            .page-frame { max-width: 650px; }
            .site-header { min-height: 88px; }
            .auth-shell { grid-template-columns: 1fr; min-height: auto; border-radius: 20px; }
            .brand-panel { padding: 30px 34px; }
            .eyebrow { margin-bottom: 15px; font-size: 9px; }
            .brand-heading, .register-shell .brand-heading { font-size: 31px; margin-bottom: 13px; max-width: 450px; }
            .brand-heading br { display: none; }
            .brand-description, .register-shell .brand-description { font-size: 12px; max-width: 460px; }
            .workspace-art, .brand-bottom, .steps, .access-art { display: none; }
            .form-panel { padding: 34px; }
            .form-title { font-size: 29px; }
            .register-shell .brand-panel, .register-shell .form-panel { padding: 30px 34px; }
            .denied-shell .brand-panel { display: none; }
            .denied-panel { min-height: 540px; padding: 40px 34px; }
            .denied-panel .form-title { font-size: 29px; }
        }
        @@media (max-width: 520px) {
            .page-frame { padding: 0 16px; }
            .site-header { min-height: 80px; gap: 10px; }
            .brand { gap: 10px; }
            .brand-logo { width: 83px; height: 36px; }
            .brand-name { padding-left: 10px; }
            .brand-name strong { font-size: 12px; }
            .brand-name span { font-size: 9px; }
            .header-link { font-size: 11px; gap: 5px; }
            .header-link .icon { width: 14px; }
            .brand-panel, .register-shell .brand-panel { padding: 25px 23px; }
            .brand-heading, .register-shell .brand-heading { font-size: 28px; }
            .brand-description, .register-shell .brand-description { font-size: 12px; line-height: 1.7; }
            .form-panel, .register-shell .form-panel { padding: 29px 23px 26px; }
            .form-title, .register-shell .form-title { font-size: 27px; }
            .form-description { font-size: 12px; margin-bottom: 24px; }
            .form-grid { grid-template-columns: 1fr; }
            .form-label { font-size: 12px; }
            .form-input, .register-shell .form-input { font-size: 16px; }
            .site-footer { font-size: 10px; align-items: flex-start; padding: 19px 1px 24px; }
            .footer-note { max-width: 140px; text-align: right; justify-content: flex-end; }
            .footer-note::before { display: none; }
            .form-utility { gap: 8px; }
            .utility-label { font-size: 9px; }
            .denied-panel { min-height: 540px; }
            .denied-panel .form-title { font-size: 26px; }
            .dialog-header { padding: 20px; }
            .dialog-body { padding: 3px 20px 16px; }
            .invoice-row { grid-template-columns: 1fr; gap: 4px; padding: 12px 0; }
            .invoice-actions { flex-direction: column; }
        }
        @@media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition: none !important; scroll-behavior: auto !important; } }
    </style>
</head>
<body>
    <div class="page-frame">

        <header class="site-header">
            <a class="brand" asp-controller="Account" asp-action="Login" aria-label="Özem MRP giriş sayfası">
                <img class="brand-logo" src="~/tinydash-master/light/assets/images/logo.jpeg" width="112" height="48" alt="Özem" />
                <span class="brand-name"><strong>MRP</strong><span>Kurumsal çalışma alanı</span></span>
            </a>
            <a class="header-link" asp-controller="Account" asp-action="Register">Hesap oluştur <svg class="icon " width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
        </header>
        <main class="auth-shell" aria-labelledby="pageTitle">

                <aside class="brand-panel" aria-label="Özem MRP">
                    <p class="eyebrow"><span class="eyebrow-mark" aria-hidden="true"></span> ÖZEM MRP</p>
                    <h2 class="brand-heading">İşinizin tüm parçaları,<br /> <em>tek bir yerde.</em></h2>
                    <p class="brand-description">Günlük iş akışınızı yönetin, ekibinizle bağlantıda kalın. Çalışma alanınıza kaldığınız yerden devam edin.</p>
                    <div class="workspace-art" aria-hidden="true"><div class="workspace-card">
                            <div class="workspace-top"><span class="workspace-caption">ÖZEM / ÇALIŞMA ALANI</span><span class="workspace-dots"><i></i><i></i><i></i></span></div><div class="module-row"><span class="module-icon"><svg class="icon " width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></svg></span><span class="module-name">Operasyon<span class="module-caption">İş akışınızı bir arada tutun</span></span><svg class="icon module-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></div><div class="module-row"><span class="module-icon"><svg class="icon " width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 3v17h17M9 15v-4m5 4V7m5 8V4"/></svg></span><span class="module-name">Finans<span class="module-caption">Verilerinize daha net bakın</span></span><svg class="icon module-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></div><div class="module-row"><span class="module-icon"><svg class="icon " width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2m2-15a3 3 0 0 1 0 6m2 9v-2a6 6 0 0 0-3-5"/></svg></span><span class="module-name">Ekip<span class="module-caption">Aynı hedefte buluşun</span></span><svg class="icon module-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></div></div></div>
                    <div class="brand-bottom"><svg class="icon " width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z"/><path d="m8 12 3 3 5-6"/></svg> Özem kurumsal çalışma alanı</div>
                </aside>
            <section class="form-panel">
                <p class="form-tag">ÇALIŞMA ALANINIZA HOŞ GELDİNİZ</p>
                <h1 class="form-title" id="pageTitle">Tekrar merhaba.</h1>
                <p class="form-description">Devam etmek için hesabınıza giriş yapın.</p>

                    @if (TempData["Message"] != null)
                    {
                        <div class="message message-info" role="status">
                            <svg class="icon " width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 11v6m0-10v.01"/></svg>
                            <div>@TempData["Message"]</div>
                        </div>
                    }
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="message message-error" role="alert">
                            <svg class="icon " width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 11v6m0-10v.01"/></svg>
                            <ul>
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                <form asp-action="Login" asp-controller="Account" method="post" asp-antiforgery="true">

                        <div class="form-field">
                            <label class="form-label" asp-for="UserName"><span>Kullanıcı adı</span></label>
                            <div class="input-wrap">
                                <svg class="icon input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg>
                                <input asp-for="UserName" class="form-input" placeholder="Kullanıcı adınızı girin" required autocomplete="username" autocapitalize="none" spellcheck="false" aria-describedby="UserNameError" />
                                
                            </div>
                            <span asp-validation-for="UserName" id="UserNameError"></span>
                        </div>

                        <div class="form-field">
                            <div class="form-label"><label asp-for="Password">Şifre</label><a asp-controller="Account" asp-action="ForgotPassword">Şifremi unuttum</a></div>
                            <div class="input-wrap">
                                <svg class="icon input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="5" y="10" width="14" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                                <input asp-for="Password" class="form-input password-input" placeholder="Şifrenizi girin" type="password" required autocomplete="current-password" aria-describedby="PasswordError" />
                                <button class="password-toggle" type="button" data-password-toggle aria-controls="Password" aria-label="Şifreyi göster" aria-pressed="false"><svg class="icon " width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button>
                            </div>
                            <span asp-validation-for="Password" id="PasswordError"></span>
                        </div>
                    <button class="primary-button button-full" type="submit">Giriş yap <svg class="icon " width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button>
                </form>
                <p class="account-switch">Henüz hesabınız yok mu? <a asp-action="Register" asp-controller="Account">Hesap oluşturun</a></p>
                <div class="form-utility">
                    <span class="utility-label"><svg class="icon " width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z"/><path d="m8 12 3 3 5-6"/></svg> Kurumsal hesap erişimi</span>
                    <button class="text-button" type="button" id="openInvoiceInfo" aria-haspopup="dialog" aria-controls="invoiceInfoModal"><svg class="icon " width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9l-6-6Z"/><path d="M14 3v6h6M8 13h8m-8 4h5"/></svg> Fatura bilgileri</button>
                </div>
            </section>
        </main>

        <footer class="site-footer">
            <span>&copy; @DateTime.Now.Year Özem MRP</span>
            <span class="footer-note">Birlikte daha düzenli, daha verimli.</span>
        </footer>
    </div>

    <dialog class="invoice-dialog" id="invoiceInfoModal" aria-labelledby="invoiceInfoModalLabel" aria-describedby="invoiceInfoNote">
        <div class="dialog-header">
            <div class="dialog-heading">
                <span class="dialog-icon"><svg class="icon " width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9l-6-6Z"/><path d="M14 3v6h6M8 13h8m-8 4h5"/></svg></span>
                <div><p class="dialog-kicker">ÖZEM / KURUMSAL BİLGİLER</p><h2 class="dialog-title" id="invoiceInfoModalLabel">Fatura bilgileri</h2></div>
            </div>
            <button class="close-button" type="button" data-close-invoice aria-label="Fatura bilgilerini kapat"><svg class="icon " width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 6 12 12M6 18 18 6"/></svg></button>
        </div>
        <div class="dialog-body">
            <dl class="invoice-details">
                <div class="invoice-row"><dt>Şirket adı</dt><dd id="invCompanyNameText">Özem Tıbbi Cihazlar Gıda Turizm San. Tic. AŞ</dd></div>
                <div class="invoice-row"><dt>Adres</dt><dd id="invAddressText">Yunusemre, 6452. Sk. NO:5, 20070 Pamukkale/Denizli</dd></div>
                <div class="invoice-row"><dt>Vergi dairesi</dt><dd id="invTaxOfficeText">PAMUKKALE VERGİ DAİRESİ</dd></div>
                <div class="invoice-row"><dt>Vergi no</dt><dd id="invTaxNoText">6860755545</dd></div>
                <div class="invoice-row"><dt>E-Fatura</dt><dd id="invEFaturaText">E-Fatura Mükellefiyeti</dd></div>
            </dl>
            <p class="invoice-note" id="invoiceInfoNote">Bu bilgiler fatura kesimi için referans amaçlı gösterilmektedir.</p>
            <div class="invoice-actions">
                <button class="primary-button" type="button" id="btnCopyInvoiceText"><svg class="icon " width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="8" y="8" width="12" height="13" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/></svg> <span>Bilgileri kopyala</span></button>
                <button class="secondary-button" type="button" data-close-invoice>Kapat</button>
            </div>
            <span class="copy-status" id="invoiceCopyStatus" role="status" aria-live="polite"></span>
        </div>
    </dialog>

    <script src="~/tinydash-master/light/js/jquery.min.js"></script>
    @* Layout = null: doğrulama partial'ı bir section yerine doğrudan yüklenir. *@
    <partial name="_ValidationScriptsPartial" />

    <script>

        (function () {
            document.querySelectorAll('[data-password-toggle]').forEach(function (button) {
                var input = document.getElementById(button.getAttribute('aria-controls'));
                if (!input) return;
                button.addEventListener('click', function () {
                    var show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    button.setAttribute('aria-pressed', show ? 'true' : 'false');
                    button.setAttribute('aria-label', show ? 'Şifreyi gizle' : 'Şifreyi göster');
                });
            });
        })();

        (function () {
            var dialog = document.getElementById('invoiceInfoModal');
            var trigger = document.getElementById('openInvoiceInfo');
            var copyButton = document.getElementById('btnCopyInvoiceText');
            var copyStatus = document.getElementById('invoiceCopyStatus');

            trigger.addEventListener('click', function () {
                dialog.showModal();
                document.body.classList.add('dialog-open');
                copyStatus.textContent = '';
            });
            dialog.querySelectorAll('[data-close-invoice]').forEach(function (button) {
                button.addEventListener('click', function () { dialog.close(); });
            });
            dialog.addEventListener('click', function (event) {
                var rect = dialog.getBoundingClientRect();
                if (event.target === dialog && (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom)) dialog.close();
            });
            dialog.addEventListener('close', function () {
                document.body.classList.remove('dialog-open');
                trigger.focus();
            });

            function fallbackCopy(text) {
                var textarea = document.createElement('textarea');
                textarea.value = text;
                textarea.setAttribute('readonly', '');
                textarea.style.cssText = 'position:fixed;top:0;left:0;opacity:0;pointer-events:none;';
                dialog.appendChild(textarea);
                try {
                    textarea.focus();
                    textarea.select();
                    return document.execCommand('copy');
                } finally {
                    textarea.remove();
                    copyButton.focus();
                }
            }

            copyButton.addEventListener('click', async function () {
                var rows = [
                    ['Şirket Adı', 'invCompanyNameText'],
                    ['Adres', 'invAddressText'],
                    ['Vergi Dairesi', 'invTaxOfficeText'],
                    ['Vergi No', 'invTaxNoText'],
                    ['E-Fatura', 'invEFaturaText']
                ];
                var text = rows.map(function (row) {
                    return row[0] + ': ' + document.getElementById(row[1]).textContent.trim();
                }).join('\n');
                var copied = false;
                try {
                    if (navigator.clipboard && window.isSecureContext) {
                        await navigator.clipboard.writeText(text);
                        copied = true;
                    }
                } catch (error) { copied = false; }
                if (!copied) {
                    try { copied = fallbackCopy(text); } catch (error) { copied = false; }
                }
                copyStatus.textContent = copied ? 'Fatura bilgileri panoya kopyalandı.' : 'Kopyalama yapılamadı. Bilgileri seçerek kopyalayabilirsiniz.';
            });
        })();

    </script>
</body>
</html>
