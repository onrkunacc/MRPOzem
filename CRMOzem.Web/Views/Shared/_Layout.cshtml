@using System.Text.Json
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- TinyDash CSS Dosyaları -->
    <link rel="stylesheet" href="~/tinydash-master/light/css/simplebar.css" />
    <link rel="stylesheet" href="~/tinydash-master/light/css/feather.css" />
    <link rel="stylesheet" href="~/tinydash-master/light/css/select2.css" />
    <link rel="stylesheet" href="~/tinydash-master/light/css/dropzone.css" />
    <link rel="stylesheet" href="~/tinydash-master/light/css/uppy.min.css" />
    <link rel="stylesheet" href="~/tinydash-master/light/css/jquery.steps.css" />
    <link rel="stylesheet" href="~/tinydash-master/light/css/jquery.timepicker.css" />
    <link rel="stylesheet" href="~/tinydash-master/light/css/quill.snow.css" />
    <link rel="stylesheet" href="~/tinydash-master/light/css/daterangepicker.css" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="manifest" href="/app.webmanifest">
    <link rel="shortcut icon" href="~/favicon/ozemLogo.ico" />
    <!-- Tema CSS (Açık & Koyu Mod) -->
    <link rel="stylesheet" href="~/tinydash-master/light/css/app-light.css" id="lightTheme">
    <link rel="stylesheet" href="~/tinydash-master/dark/css/app-dark.css" id="darkTheme" disabled>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
   
</head>
<body class="vertical light">
    <div class="wrapper">
        <!-- Navbar -->
        <nav class="topnav navbar navbar-light">
            <button type="button" class="navbar-toggler text-muted mt-2 p-0 mr-3 collapseSidebar">
                <i class="fe fe-menu navbar-toggler-icon"></i>
            </button>
            <ul class="nav">
                <li class="nav-item">
                    <div id="currentTime" class="nav-link my-2" style="font-weight: bold; font-size: 1rem;"></div>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-muted my-2" href="#" id="modeSwitcher" data-mode="light">
                        <i class="fe fe-sun fe-16"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-muted my-2" href="#" data-toggle="modal" data-target=".modal-shortcut">
                        <span class="fe fe-grid fe-16"></span>
                    </a>
                </li>
                <partial name="_UserInfo" />
            </ul>
        </nav>

        <!-- Sidebar -->
        <aside class="sidebar-left border-right bg-white shadow" id="leftSidebar" data-simplebar>
            <nav class="vertnav navbar navbar-light">

                @{
                    // Logo tıklanınca hangi dashboard?
                    // Öncelik: İstatistik → Istatistik/Dashboard/Index
                    // Yönetici/Admin → Admin/Index
                    // Muhasebe → Muhasebe/Cari/Index
                    // Aksi halde Home/Index
                    var logoArea = "";
                    var logoController = "Home";
                    var logoAction = "Index";

                    if (User.IsInRole("İstatistik"))
                    {
                        logoArea = "Istatistik";
                        logoController = "Dashboard";
                        logoAction = "Index";
                    }
                    else if (User.IsInRole("Yönetici") || User.IsInRole("Admin"))
                    {
                        logoArea = "Admin";
                        logoController = "Admin";
                        logoAction = "Index";
                    }
                    else if (User.IsInRole("Muhasebe"))
                    {
                        logoArea = "Muhasebe";
                        logoController = "Cari";
                        logoAction = "Index";
                    }
                    else if(User.IsInRole("İnsan Kaynakları"))
                    {
                        logoArea = "InsanKaynaklari";
                        logoController = "Leave";
                        logoAction = "Index";
                    }
                }

                <div class="w-100 mb-4 d-flex justify-content-center">
                    <a class="navbar-brand mt-2 flex-fill text-center"
                       asp-area="@logoArea"
                       asp-controller="@logoController"
                       asp-action="@logoAction">
                        <img src="~/tinydash-master/light/assets/images/ozemLogo2.png"
                             alt="CRMozem"
                             class="sidebar-logo" />
                    </a>
                </div>

                @await Component.InvokeAsync("Sidebar")
            </nav>
        </aside>

        <!-- Main Content -->
        <main role="main" class="main-content">
            <div class="container-fluid">
                @RenderBody()
            </div>
        </main>

        <!-- Footer -->
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2025 - Özem MRP
            </div>
        </footer>
    </div>

    <!-- Shortcut Modal -->
    <div class="modal fade modal-shortcut" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body px-5">
                    @await Component.InvokeAsync("Module")
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/tinydash-master/light/js/jquery.min.js"></script>
    <script src="~/tinydash-master/light/js/popper.min.js"></script>
    <script src="~/tinydash-master/light/js/bootstrap.min.js"></script>
    <script src="~/tinydash-master/light/js/simplebar.min.js"></script>
    <script src="~/tinydash-master/light/js/daterangepicker.js"></script>
    <script src="~/tinydash-master/light/js/tinycolor-min.js"></script>
    <script src="~/tinydash-master/light/js/config.js"></script>
    <script src="~/tinydash-master/light/js/apps.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function updateClock() {
            const now = new Date();
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');
            const timeString = `${hours}:${minutes}:${seconds}`;
            document.getElementById("currentTime").innerText = timeString;
        }
        setInterval(updateClock, 1000);
        updateClock();
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const msgs = {
                success: @Html.Raw(JsonSerializer.Serialize(TempData["SuccessMessage"])),
                error: @Html.Raw(JsonSerializer.Serialize(TempData["Error"])),
                warning: @Html.Raw(JsonSerializer.Serialize(TempData["Warning"]))
            };

            const showToast = (icon, title, text, timer) => {
                if (!text) return;
                Swal.fire({
                    icon,
                    title,
                    text,
                    timer,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                });
            };

            showToast('success', 'Başarılı', msgs.success, 3000);
            showToast('error', 'Hata', msgs.error, 4000);
            showToast('warning', 'Uyarı', msgs.warning, 3500);
        });
    </script>

    <script>
        if ("serviceWorker" in navigator) {
            navigator.serviceWorker.register("/js/service-worker.js")
                .then(() => console.log("Service Worker Kayıt Edildi"))
                .catch(error => console.log("Service Worker Hatası:", error));
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
