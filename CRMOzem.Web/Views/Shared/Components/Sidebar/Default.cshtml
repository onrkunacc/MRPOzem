@model IList<string>

<ul class="navbar-nav flex-fill w-100 mb-2">
    @if (Model.Contains("Kullanıcı"))
    {
        <li class="nav-item">
            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="fe fe-home fe-16"></i>
                <span class="ml-3 item-text">Ana Sayfa</span>
            </a>
        </li>
        <!-- Masraf Raporları Menüsü -->
        <li class="nav-item dropdown">
            <a class="dropdown-toggle nav-link" data-toggle="collapse" aria-expanded="false" href="#masraf-menu">
                <i class="fe fe-file-text fe-16"></i>
