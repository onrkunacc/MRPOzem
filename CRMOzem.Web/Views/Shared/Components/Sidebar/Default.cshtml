                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link pl-3" asp-area="" asp-controller="ExpenseReport" asp-action="AddExpense">
                        <i class="fe fe-plus fe-14"></i>
                        <span class="ml-1 item-text">Rapor Ekle</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link pl-3" asp-area="" asp-controller="BillingCycleReport" asp-action="Index">
