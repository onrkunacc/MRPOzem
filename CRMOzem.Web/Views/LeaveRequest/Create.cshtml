@model CRMOzem.Core.Models.LeaveRequest
@{
    ViewData["Title"] = "Yeni İzin Talebi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-body">
            <h3 class="text-primary fw-bold mb-4"><i class="fa fa-calendar-plus"></i> Yeni İzin Talebi</h3>

            <form asp-action="Create" method="post">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">İzin Türü</label>
                        <select asp-for="LeaveTypeId" asp-items="ViewBag.LeaveTypes" class="form-select"></select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Başlangıç</label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Bitiş</label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Açıklama</label>
                    <textarea asp-for="Reason" class="form-control" rows="3"></textarea>
                </div>

                <button type="submit" class="btn btn-success">
                    <i class="fa fa-paper-plane"></i> Gönder
                </button>
                <a asp-action="MyLeaves" class="btn btn-secondary ms-2">Vazgeç</a>
            </form>
        </div>
    </div>
</div>
