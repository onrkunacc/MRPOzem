@model CRMOzem.Core.ViewModels.FileBrowserViewModel
@{
    ViewBag.Title = "NAS Dosya Tarayıcı";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h3 class="mb-3 text-primary">📁 NAS Dosya Tarayıcı</h3>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (!string.IsNullOrEmpty(Model.CurrentPath))
    {
        var sep = System.IO.Path.DirectorySeparatorChar;
        var parentPath = Model.CurrentPath.Contains(sep)
        ? Model.CurrentPath.Substring(0, Model.CurrentPath.LastIndexOf(sep))
        : "";

        <a asp-action="Index" asp-route-path="@parentPath" class="btn btn-sm btn-outline-secondary mb-3">
            ⬅️ Üst Klasöre Dön
        </a>
    }

    <table class="table table-striped table-bordered">
        <thead class="table-light">
            <tr>
                <th>Ad</th>
                <th class="text-center">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items != null && Model.Items.Count > 0)
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            @if (item.IsDirectory)
                            {
                                <a asp-action="Index" asp-route-path="@item.RelativePath">
                                    📁 @item.Name
                                </a>
                            }
                            else
                            {
                                <span>📄 @item.Name</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (!item.IsDirectory)
                            {
                                <a asp-action="Download" asp-route-path="@item.RelativePath"
                                   class="btn btn-sm btn-outline-primary me-2">
                                    İndir
                                </a>

                                @if (item.CanPreview)
                                {
                                    <a asp-action="Preview" asp-route-path="@item.RelativePath"
                                       target="_blank" class="btn btn-sm btn-outline-success">
                                        Önizle
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary" disabled
                                            title="Bu dosya türü önizlenemez">
                                        🚫 Önizlenemez
                                    </button>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Klasör</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="2" class="text-center text-muted">Görüntülenecek dosya veya klasör bulunamadı.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
