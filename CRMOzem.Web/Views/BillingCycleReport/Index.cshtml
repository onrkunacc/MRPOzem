@model List<CRMOzem.Core.ViewModels.BillingCycleReportViewModel>

@{
    ViewData["Title"] = "Ekstre Raporlarım";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int cutOffDay = ViewBag.CutOffDay ?? 1;
}

<div class="container py-4">
    <h2 class="text-center font-bold text-2xl mb-4">@DateTime.Now.Year EKSTRE RAPORLARI</h2>
    <hr />

    <!-- Ekstre Kesim Günü Seçimi -->
    <form method="get" asp-action="Index" class="form-inline mb-4">
        <label class="mr-2 font-medium">Ekstre Kesim Günü:</label>
        <select name="cutOffDay" class="form-control mr-2" onchange="this.form.submit()">
            @for (int day = 1; day <= 28; day++)
            {
                <option value="@day" selected="@(cutOffDay == day ? "selected" : null)">@day</option>
            }
        </select>
        <noscript><button type="submit" class="btn btn-sm btn-primary">Güncelle</button></noscript>
    </form>

    <p class="text-sm text-gray-600 mb-3">
        Gösterilen ekstreler, her ayın <strong>@cutOffDay</strong>'unda kesilmektedir.
    </p>

    <div class="flex justify-between items-center mb-4">
        <h4 class="font-semibold text-lg">
            Toplam Tutar: <span class="text-2xl font-bold text-red-500">
                @(Model?.Sum(r => r.TotalAmount).ToString("C") ?? "0,00 TL")
            </span>
        </h4>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var report in Model.OrderByDescending(r => r.Year).ThenByDescending(r => r.Month))
            {
                <div class="col-md-4">
                    <div class="card shadow-sm mb-4">
                        <div class="card-body text-center">
                            <h3 class="font-weight-bold">@report.MonthName @report.Year</h3>
                            <p class="text-muted">Toplam Tutar:</p>
                            <p class="font-weight-bold text-success">@report.TotalAmount.ToString("C")</p>
                            <a href="@Url.Action("Details", "BillingCycleReport", new { year = report.Year, month = report.Month })"
                               class="btn btn-outline-primary btn-sm">
                                📑 Detaylı Tablo
                            </a>
                            <hr />
                            <a href="@Url.Action("PrintBillingCycleReport", "BillingCycleReport", new { year = report.Year, month = report.Month })"
                               target="_blank" class="btn btn-outline-danger btn-sm">
                                📄 Yazdır / PDF Görüntüle
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <p class="text-center text-muted">Henüz ekstre raporu bulunmamaktadır.</p>
            </div>
        }
    </div>
</div>
