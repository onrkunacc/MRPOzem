@model CRMOzem.Core.ViewModels.CreateReportViewModel
@using System.Globalization
<div class="modal fade" id="createReportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateReportModal" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Yeni Rapor Oluştur</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Ay</label>
                        <select asp-for="Month" class="form-control">
                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i">@(CultureInfo.GetCultureInfo("tr-TR").DateTimeFormat.GetMonthName(i))</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Yıl</label>
                        <select asp-for="Year" class="form-control">
                            @for (int y = DateTime.Now.Year - 1; y <= DateTime.Now.Year + 1; y++)
                            {
                                <option value="@y">@y</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal" type="button">Kapat</button>
                    <button class="btn btn-primary" type="submit">Oluştur</button>
                </div>
            </form>
        </div>
    </div>
</div>