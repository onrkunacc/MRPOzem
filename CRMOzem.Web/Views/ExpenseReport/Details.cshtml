@model CRMOzem.Core.ViewModels.ExpenseReportViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Masraf Raporu Detayları";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-center">@Model.MonthYear.ToString("MMMM yyyy") Masraf Raporu</h2>
    <hr />

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">Toplam Tutar: <strong>@Model.TotalAmount.ToString("C2")</strong></h5>

            <table class="table table-bordered table-striped mt-3">
                <thead class="table-dark">
                    <tr>
                        <th>Tarih</th>
                        <th>Kategori</th>
                        <th>Açıklama</th>
                        <th>Ödeme Yöntemi</th>
                        <th>Tutar (₺)</th>
                        <th>Ekstre Dönemi</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detail in Model.ExpenseDetails)
                    {
                        <tr>
                            <td>@detail.Date.ToString("dd.MM.yyyy")</td>
                            <td>@detail.Category</td>
                            <td>@detail.Description</td>
                            <td>@detail.PaymentMethod</td>
                            <td>@detail.Amount.ToString("C2")</td>
                            <td class="d-flex flex-wrap align-items-center gap-2">
                                @if (detail.OverrideCycleMonth.HasValue && detail.OverrideCycleYear.HasValue)
                                {
                                    <span class="me-2">
                                        <strong>
                                            @CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(detail.OverrideCycleMonth.Value)
                                            @detail.OverrideCycleYear
                                        </strong>
                                    </span>
                                    <button type="button"
                                            class="btn btn-sm btn-light border edit-cycle-btn"
                                            data-id="@detail.Id"
                                            data-month="@detail.OverrideCycleMonth"
                                            data-year="@detail.OverrideCycleYear"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editCycleModal"
                                            title="Ekstre dönemini düzenle">
                                        <i class="fa fa-pen"></i>
                                    </button>
                                }
                                else
                                {
                                    <form class="cycle-form d-flex flex-wrap align-items-center gap-2 mb-1" data-id="@detail.Id">
                                        <select name="overrideMonth" class="form-select form-select-sm" style="min-width: 130px;">
                                            <option value="">Otomatik</option>
                                            @for (int i = 1; i <= 12; i++)
                                            {
                                                <option value="@i">@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                                            }
                                        </select>

                                        <input name="overrideYear" type="number" min="2020" max="2100"
                                               class="form-control form-control-sm"
                                               placeholder="Yıl" style="width: 90px;" />

                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="fa fa-check"></i>
                                        </button>
                                    </form>
                                }
                            </td>


                            <td>
                                <a href="@Url.Action("Edit", "ExpenseReport", new { id = detail.Id })" class="btn btn-sm btn-warning">
                                    <i class="fa fa-edit"></i> Düzenle
                                </a>
                                <form asp-action="DeleteExpense" asp-controller="ExpenseReport" method="post" class="d-inline"
                                      onsubmit="return confirm('Bu masrafı silmek istediğinize emin misiniz?');">
                                    <input type="hidden" name="expenseId" value="@detail.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="fa fa-trash"></i> Sil
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="text-end mt-4">
                <a asp-action="ExportToExcel" asp-route-reportId="@Model.Id" class="btn btn-outline-success">
                    <i class="fa fa-download"></i> Excel Olarak İndir
                </a>
                <a href="@Url.Action("AddExpense", "ExpenseReport", new { reportId = Model.Id })" class="btn btn-outline-primary">
                    <i class="fa fa-plus"></i> Masraf Ekle
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">⬅️ Geri Dön</a>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="editCycleModal" tabindex="-1" aria-labelledby="editCycleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form id="modalCycleForm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editCycleModalLabel">Ekstre Dönemini Düzenle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body d-flex gap-2">
                    <input type="hidden" name="id" id="modal-expense-id" />
                    <select name="overrideMonth" id="modal-override-month" class="form-select">
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i">@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                        }
                    </select>
                    <input type="number" name="overrideYear" id="modal-override-year" class="form-control"
                           placeholder="Yıl" style="width:100px;" min="2020" max="2100" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll(".cycle-form").forEach(form => {
            form.addEventListener("submit", function (e) {
                e.preventDefault();
                const id = form.getAttribute("data-id");
                const formData = new FormData(form);

                fetch(`/ExpenseReport/UpdateCycleInline?id=${id}`, {
                    method: "POST",
                    body: formData
                })
                    .then(res => res.ok ? location.reload() : alert("⚠️ Hata oluştu."));
            });
        });

        document.querySelectorAll(".edit-cycle-btn").forEach(btn => {
            btn.addEventListener("click", () => {
                document.getElementById("modal-expense-id").value = btn.dataset.id;
                document.getElementById("modal-override-month").value = btn.dataset.month;
                document.getElementById("modal-override-year").value = btn.dataset.year;
            });
        });

        document.getElementById("modalCycleForm").addEventListener("submit", function (e) {
            e.preventDefault();
            const id = document.getElementById("modal-expense-id").value;
            const formData = new FormData(this);

            fetch(`/ExpenseReport/UpdateCycleInline?id=${id}`, {
                method: "POST",
                body: formData
            }).then(res => {
                if (res.ok) {
                    location.reload();
                } else {
                    alert("⚠️ Güncelleme başarısız!");
                }
            });
        });
    </script>
}
