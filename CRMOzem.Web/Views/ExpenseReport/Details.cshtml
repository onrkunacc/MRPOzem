@model CRMOzem.Core.Models.ExpenseReport
@using System.Globalization
@using CRMOzem.Core.ViewModels
@{
    ViewData["Title"] = "Rapor Detayı";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var total = (decimal)(ViewBag.CalculatedTotal ?? Model.ExpenseDetails.Sum(x => x.Amount));
}
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="d-flex justify-content-between align-items-center mt-3 mb-3 flex-wrap gap-2">
    <h3>@Model.MonthYear.ToString("MMMM yyyy", CultureInfo.GetCultureInfo("tr-TR")) Raporu</h3>
    <div class="d-grid gap-2 d-md-flex justify-content-md-end flex-wrap">
        <a class="btn btn-outline-danger btn-sm" asp-action="PrintReport" asp-route-id="@Model.Id" target="_blank">🖨️ PDF</a>
        &nbsp;
        <a class="btn btn-outline-secondary btn-sm" asp-action="MonthlyReports">📚 Tüm Raporlar</a>
        &nbsp;
        <button class="btn btn-success btn-sm"
                data-bs-toggle="modal"
                data-bs-target="#addExpenseModal"
                data-report-id="@Model.Id"
                data-report-month="@Model.MonthYear.Month"
                data-report-year="@Model.MonthYear.Year">
            ➕ Masraf Ekle
        </button>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Kategori</th>
                        <th>Açıklama</th>
                        <th>Ödeme</th>
                        <th class="text-end">Tutar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.ExpenseDetails.OrderBy(x => x.Date))
                    {
                        <tr>
                            <td>@e.Date.ToString("dd.MM.yyyy")</td>
                            <td>@e.Category</td>
                            <td>@e.Description</td>
                            <td>@e.PaymentMethod</td>
                            <td class="text-end">@e.Amount.ToString("N2") ₺</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="4" class="text-end">Toplam</th>
                        <th class="text-end">@total.ToString("N2") ₺</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@await Html.PartialAsync("_AddExpenseModal", (AddExpenseInputModel)ViewBag.AddExpenseModel)

<!-- ⚠️ Tarih uyuşmazlığı uyarı modalı -->
<div class="modal fade" id="confirmMismatchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title">⚠️ Tarih Uyuşmazlığı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <p id="confirmMismatchMessage" class="mb-0"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-success" id="confirmMismatchBtn">Onayla</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        (function(){
          const addModalEl = document.getElementById('addExpenseModal');
          const addModal   = addModalEl ? new bootstrap.Modal(addModalEl) : null;

          const mismatchModalEl = document.getElementById('confirmMismatchModal');
          const mismatchModal   = mismatchModalEl ? new bootstrap.Modal(mismatchModalEl) : null;
          const mismatchMsg     = document.getElementById('confirmMismatchMessage');
          const mismatchBtn     = document.getElementById('confirmMismatchBtn');

          const form = document.getElementById('addExpenseForm');

          // Modal açılırken bu raporun bilgileri girilsin
          if (addModalEl) {
            addModalEl.addEventListener('show.bs.modal', function () {
              addModalEl.querySelector('input[name="ReportId"]').value     = '@Model.Id';
              addModalEl.querySelector('input[name="ReportMonth"]').value  = '@Model.MonthYear.Month';
              addModalEl.querySelector('input[name="ReportYear"]').value   = '@Model.MonthYear.Year';
              addModalEl.querySelector('input[name="UserConfirmed"]').value= "false";
              addModalEl.querySelector('input[name="Date"]').valueAsDate   = new Date();
              addModalEl.querySelector('input[name="Amount"]').value       = "";
              addModalEl.querySelector('input[name="Category"]').value     = "";
              addModalEl.querySelector('input[name="Description"]').value  = "";
              const pm = addModalEl.querySelector('select[name="PaymentMethod"]');
              if (pm) pm.selectedIndex = 0;
            });
          }

          // Uyuşmazlık kontrolü
          if (form) {
            form.addEventListener('submit', function (e) {
              const dt = new Date(form.Date.value);
              const m  = dt.getMonth() + 1;
              const y  = dt.getFullYear();
              const rm = parseInt(form.ReportMonth.value || "0");
              const ry = parseInt(form.ReportYear.value  || "0");

              if ((m !== rm || y !== ry) && form.UserConfirmed.value !== "true") {
                e.preventDefault();
                if (mismatchMsg) {
                  mismatchMsg.innerText = `${dt.toLocaleDateString()} tarihli masraf, ${rm}.${ry} raporuna eklenecek. Devam edilsin mi?`;
                }
                mismatchModal?.show();
                mismatchBtn.onclick = () => {
                  form.UserConfirmed.value = "true";
                  mismatchModal?.hide();
                  form.submit();
                };
              }
            });
          }

          // Kaydet & Yeni sonrası modalı otomatik aç
          const openId = '@(TempData["OpenAddModal"] ?? "")';
          if (openId && addModal) {
            addModal.show();
            // reset
            addModalEl.querySelector('input[name="ReportId"]').value     = openId;
            addModalEl.querySelector('input[name="Date"]').valueAsDate   = new Date();
            addModalEl.querySelector('input[name="Amount"]').value       = "";
            addModalEl.querySelector('input[name="Category"]').value     = "";
            addModalEl.querySelector('input[name="Description"]').value  = "";
            const pm = addModalEl.querySelector('select[name="PaymentMethod"]');
            if (pm) pm.selectedIndex = 0;
          }
        })();
    </script>
}

