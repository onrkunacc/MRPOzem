@model CreateReportViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Yeni Masraf Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container mt-4">
    <h3>Yeni Masraf Raporu Oluştur</h3>

    <form asp-action="Create" method="post" class="card p-4 shadow-sm">
        <div class="form-group">
            <label>Ay</label>
            <select asp-for="Month" class="form-control">
                @for (int i = 1; i <= 12; i++)
                {
                    <option value="@i">@(CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i))</option>
                }
            </select>
        </div>
        <div class="form-group mt-2">
            <label>Yıl</label>
            <select asp-for="Year" class="form-control">
                @for (int y = DateTime.Now.Year - 1; y <= DateTime.Now.Year + 1; y++)
                {
                    <option value="@y">@y</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary mt-3">Raporu Oluştur</button>
    </form>
</div>
