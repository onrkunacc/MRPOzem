@model ExpenseDetailViewModel
@{
    ViewData["Title"] = "Masraf Ekle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header text-white text-center">
            <h4 class="mb-0">Masraf Ekle</h4>
        </div>
        <div class="card-body">
            <form asp-action="AddExpense" method="post">
                <input type="hidden" asp-for="ReportId" /> <!-- 📌 Rapor ID'si gönderiliyor -->

                <div class="form-group">
                    <label for="Category">Kategori</label>
                    <input type="text" class="form-control" asp-for="Category" placeholder="Örn: Yemek, Ulaşım" required />
                </div>

                <div class="form-group">
                    <label for="Description">Açıklama</label>
                    <textarea class="form-control" asp-for="Description" rows="3" placeholder="Masraf açıklaması girin" required></textarea>
                </div>

                <div class="form-group">
                    <label for="PaymentMethod">Ödeme Yöntemi</label>
                    <select class="form-control" asp-for="PaymentMethod" asp-items="Html.GetEnumSelectList<PaymentMethod>()">
                        <option selected disabled>Seçiniz...</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="Amount">Tutar (₺)</label>
                    <input type="number" step="0.01" class="form-control" asp-for="Amount" placeholder="0,00" required />
                </div>

                <div class="form-group">
                    <label for="Date">Tarih</label>
                    <input type="date" class="form-control" asp-for="Date" required />
                </div>

                <button type="submit" class="btn btn-outline-dark">Masrafı Kaydet</button>
                <a href="@Url.Action("Details", "ExpenseReport", new { id = Model.ReportId })" class="btn btn-secondary ml-2">Geri Dön</a>
            </form>
        </div>
    </div>
</div>
