@model CRMOzem.Core.ViewModels.UserTrainingDetailViewModel

@{
    ViewData["Title"] = "Eğitim Detayı";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <h2 class="fw-bold text-primary mb-3">@Model.Title</h2>
    <p><strong>Tarih:</strong> @Model.TrainingDate.ToString("dd MMMM yyyy")</p>
    <p><strong>Açıklama:</strong> @Model.Description</p>
    <p>
        <strong>Durum:</strong>
        <span class="badge @(Model.IsCompleted ? "bg-success" : Model.IsJoined ? "bg-info text-dark" : "bg-secondary")">
            @(Model.IsCompleted ? "Tamamlandı" : Model.IsJoined ? "Katıldınız" : "Katılmadınız")
        </span>
    </p>

    <div class="mt-3">
        <a href="@Model.Link" target="_blank" class="btn btn-outline-primary">
            <i class="bi bi-play-circle"></i> Eğitimi Aç
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Geri Dön
        </a>
    </div>
</div>
